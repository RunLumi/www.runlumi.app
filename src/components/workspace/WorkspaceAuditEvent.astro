---
// Admin › Audit log › one event (child screen, R-03). Read-only.
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import DataTable from "./ui/DataTable.astro";
import FactRow from "./ui/FactRow.astro";
import PageHeader from "./ui/PageHeader.astro";
import Panel from "./ui/Panel.astro";
import PanelRow from "./ui/PanelRow.astro";
import { localized } from "../../lib/workspace/nav";
import { actionLabel, moduleLabels } from "../../lib/workspace/audit-log";
import type { AuditEventData } from "../../lib/workspace/audit-pages";
import { dateTime } from "../../lib/workspace/format";

type Props = AuditEventData;
const { lang, vi, user, entry, nearby, names } = Astro.props;
const t = (en: string, viText: string) => (vi ? viText : en);
const base = localized("/workspace/audit", vi);
const value = (item: unknown): string => item === null || item === undefined ? "—" : typeof item === "object" ? JSON.stringify(item) : String(item);
const outcome: Record<string, [string, string]> = { success: ["Success", "Thành công"], denied: ["Denied", "Bị từ chối"], failed: ["Failed", "Lỗi"] };
const via: Record<string, [string, string]> = { web: ["Web", "Web"], api: ["API", "API"], mcp: ["AI agent (MCP)", "AI agent (MCP)"], system: ["System", "Hệ thống"] };
const title = actionLabel(entry.action, vi);
---
<WorkspaceShell title={title} lang={lang} user={user} module="admin" current="audit">
  <PageHeader vi={vi} title={title} crumbs={[{ label: t("Admin", "Quản trị"), href: localized("/workspace/users", vi) }, { label: t("Audit log", "Nhật ký kiểm toán"), href: base }, { label: entry.id }]}>
    <Fragment slot="actions"><a class="crm-button secondary" href={`${base}?actor=${encodeURIComponent(entry.actor_id)}`}>{t("Events by this person", "Sự kiện của người này")}</a></Fragment>
  </PageHeader>
  <FactRow facts={[
    { label: t("Time", "Thời gian"), value: dateTime(entry.created_at, vi) },
    { label: t("Who", "Người thực hiện"), value: names[entry.actor_id] ?? entry.actor_name },
    { label: t("Via", "Qua"), value: via[entry.via]?.[vi ? 1 : 0] ?? entry.via },
    { label: "Module", value: moduleLabels[entry.module]?.[vi ? 1 : 0] ?? entry.module },
    { label: t("Outcome", "Kết quả"), value: outcome[entry.outcome]?.[vi ? 1 : 0] ?? entry.outcome },
  ]} />
  <PanelRow>
    <Panel title={t("What was recorded", "Nội dung được ghi")} note={t("Stored as written; this event cannot be changed or deleted.", "Lưu đúng như khi ghi; sự kiện này không sửa hay xóa được.")}>
      <dl class="crm-facts">
        <div><dt>{t("Action code", "Mã hành động")}</dt><dd><code>{entry.action}</code></dd></div>
        <div><dt>{t("Target", "Đối tượng")}</dt><dd>{names[entry.target] ?? entry.target}</dd></div>
        <div><dt>{t("Source", "Nguồn")}</dt><dd>{entry.source === "finance" ? t("Finance history", "Lịch sử Tài chính") : "workspace_audit"}</dd></div>
        {Object.entries(entry.detail).map(([key, item]) => <div><dt><code>{key}</code></dt><dd style="overflow-wrap:anywhere">{value(item)}</dd></div>)}
      </dl>
    </Panel>
    <Panel title={t("Same person, within an hour", "Cùng người, trong vòng một giờ")} flush>
      {nearby.length
        ? <DataTable vi={vi} label={t("Nearby events", "Sự kiện lân cận")} frozen={1} widths={["11rem"]} minWidth="520px">
            <thead><tr><th scope="col">{t("Time", "Thời gian")}</th><th scope="col">{t("Action", "Hành động")}</th><th scope="col">{t("Outcome", "Kết quả")}</th></tr></thead>
            <tbody>{nearby.map((row) => <tr><th scope="row"><a class="ws-row-link" href={`${base}/${encodeURIComponent(row.id)}`}>{dateTime(row.created_at, vi)}</a></th><td>{actionLabel(row.action, vi)}</td><td>{outcome[row.outcome]?.[vi ? 1 : 0] ?? row.outcome}</td></tr>)}</tbody>
          </DataTable>
        : <p class="crm-empty">{t("No other events.", "Không có sự kiện khác.")}</p>}
    </Panel>
  </PanelRow>
</WorkspaceShell>
