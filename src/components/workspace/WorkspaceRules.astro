---
// Admin › Notification rules (board NotificationRules, R-09). List-view
// header, quick filters, delivery-failure banner and the rules table with the
// name frozen. A row opens the rule editor; "Create rule" opens a new one.
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import "../../styles/workspace-security.css";
import Chips from "./security/Chips.astro";
import Head from "./security/Head.astro";
import { localized } from "../../lib/workspace/nav";
import type { RulesData } from "../../lib/workspace/admin-security-pages";
import { platformLabels } from "../../lib/workspace/notify/destinations";
import { eventLabel } from "../../lib/workspace/notify/labels";
import { dateTime } from "../../lib/workspace/format";
import { roleLabel } from "../../lib/workspace/roles";

type Props = RulesData;
const { lang, vi, user, rules, destinations, stats, saved } = Astro.props;
const t = (en: string, viText: string) => (vi ? viText : en);
const base = localized("/workspace/notifications", vi);
const filter = Astro.url.searchParams.get("filter") ?? "";
const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80).toLocaleLowerCase("vi");
const failing = (rule: typeof rules[number]) => (stats[rule.id]?.failed7d ?? 0) > 0 || rule.destinations.some((id) => destinations.find((item) => item.id === id)?.status === "paused");
const shown = rules.filter((rule) => (filter === "on" ? rule.enabled : filter === "off" ? !rule.enabled : filter === "errors" ? failing(rule) : true) && (!q || rule.name.toLocaleLowerCase("vi").includes(q)));
const destinationName = (id: string) => { const item = destinations.find((destination) => destination.id === id); return item ? `${platformLabels[item.platform]} · ${item.name}` : t("Removed webhook", "Webhook đã gỡ"); };
const recipients = (rule: typeof rules[number]) => [
  ...(rule.recipients.record_owner ? [t("Record owner", "Người phụ trách")] : []),
  ...(rule.recipients.admins ? [roleLabel("admin", vi)] : []),
  ...rule.recipients.roles.map((role) => roleLabel(role, vi)),
  ...(rule.recipients.users.length ? [t(`${rule.recipients.users.length} people`, `${rule.recipients.users.length} người`)] : []),
].join(" · ") || "—";
const conditions = (rule: typeof rules[number]) => [rule.conditions.outcome && t(`Outcome ${rule.conditions.outcome}`, `Kết quả ${rule.conditions.outcome}`), rule.conditions.min_value_vnd !== null && `≥ ${rule.conditions.min_value_vnd.toLocaleString("vi-VN")} ₫`, rule.conditions.playbooks.length && t(`${rule.conditions.playbooks.length} playbooks`, `${rule.conditions.playbooks.length} playbook`)].filter(Boolean).join(" · ") || t("Every record", "Mọi bản ghi");
const paused = destinations.filter((item) => item.status === "paused" && item.consecutive_failures > 0);
const chip = (key: string, label: string, count: number) => ({ label: `${label} (${count})`, href: `${base}${key ? `?filter=${key}` : ""}`, on: filter === key });
---
<WorkspaceShell title={t("Notification rules", "Quy tắc thông báo")} lang={lang} user={user} module="admin" current="notifications">
  <div class="s4 s4-stack">
    <Head vi={vi} crumbs={[{ label: t("Admin", "Quản trị"), href: localized("/workspace/users", vi) }]} title={t("Notification rules", "Quy tắc thông báo")}
      desc={t("Each rule says which CRM event, under which conditions, goes by email to which internal people and to which webhooks. People only hear about records they may see. The Lark team group keeps receiving all CRM activity.", "Mỗi quy tắc nói rõ: khi sự kiện CRM nào xảy ra, với điều kiện gì, gửi Email cho người nội bộ nào và tới Webhook nào. Mỗi người chỉ nhận tin về bản ghi họ được xem. Nhóm Lark vẫn nhận mọi hoạt động CRM.")}>
      <Fragment slot="actions"><div class="s4-group"><a class="s4-btn" href={localized("/workspace/webhooks", vi)}>Webhook</a><a class="s4-btn primary" href={`${base}/new`}>{t("Create rule", "Tạo quy tắc")}</a></div></Fragment>
      <div class="s4-pb"><Chips vi={vi} items={[chip("", t("All", "Tất cả"), rules.length), chip("on", t("On", "Đang bật"), rules.filter((rule) => rule.enabled).length), chip("errors", t("Delivery errors", "Có lỗi gửi"), rules.filter(failing).length), chip("off", t("Off", "Đang tắt"), rules.filter((rule) => !rule.enabled).length)]} /></div>
    </Head>
    {saved && <p class="crm-notice good" role="status">{t("Saved.", "Đã lưu.")}</p>}
    {paused.map((item) => <section class="s4-panel s4-banner"><div class="s4-ph"><p><span class="s4-badge bad dot">{t("Delivery error", "Lỗi gửi")}</span> {t(`${platformLabels[item.platform]} · ${item.name} paused after ${item.consecutive_failures} failures in a row (last: ${item.last_result}).`, `${platformLabels[item.platform]} · ${item.name} đã tạm dừng sau ${item.consecutive_failures} lần lỗi liên tiếp (gần nhất: ${item.last_result}).`)}</p><a class="s4-btn" href={`${localized("/workspace/webhooks", vi)}/${item.id}`}>{t("Open webhook", "Mở Webhook")}</a></div></section>)}
    <p class="crm-notice" role="note">{t("Email: no email provider is connected yet, so email deliveries are recorded as not sent. Webhooks deliver now.", "Email: chưa kết nối nhà cung cấp email, nên lượt gửi email được ghi là chưa gửi. Webhook gửi được ngay.")}</p>
    <section class="s4-panel" aria-label={t("Rules", "Quy tắc")}>
      <div class="s4-lvbar"><p>{t(`${shown.length} rules · sorted by name · select a row to edit the rule`, `${shown.length} quy tắc · sắp xếp theo tên · bấm một dòng để sửa quy tắc`)}</p>
        <form class="s4-search" method="get" role="search">{filter && <input type="hidden" name="filter" value={filter} />}<label class="crm-sr" for="r-q">{t("Search rules", "Tìm quy tắc")}</label><input class="s4-in" id="r-q" name="q" type="search" maxlength="80" value={Astro.url.searchParams.get("q") ?? ""} placeholder={t("Search rules", "Tìm quy tắc")} /><button class="s4-btn" type="submit">{t("Search", "Tìm")}</button></form></div>
      {shown.length
        ? <div class="s4-tw"><table class="s4-tbl wide">
            <thead><tr><th scope="col" class="fz last">{t("Rule", "Tên quy tắc")}</th><th scope="col">Module</th><th scope="col">{t("Trigger events", "Sự kiện kích hoạt")}</th><th scope="col">{t("Conditions", "Điều kiện")}</th><th scope="col">{t("Channels", "Kênh")}</th><th scope="col">{t("Recipients", "Người nhận")}</th><th scope="col">{t("Status", "Trạng thái")}</th><th scope="col">{t("Last sent", "Gửi gần nhất")}</th><th scope="col" class="r">{t("Errors, 7 days", "Lỗi 7 ngày")}</th></tr></thead>
            <tbody>{[...shown].sort((a, b) => a.name.localeCompare(b.name, "vi")).map((rule) => <tr>
              <td class="fz last"><a href={`${base}/${rule.id}`}>{rule.name}</a></td><td>CRM</td>
              <td>{rule.events.map((event) => eventLabel(event, vi)).join(", ")}</td><td>{conditions(rule)}</td>
              <td>{[...(rule.email ? ["Email"] : []), ...rule.destinations.map(destinationName)].join(" · ")}</td><td>{recipients(rule)}</td>
              <td><span class:list={["s4-badge dot", rule.enabled ? "good" : ""]}>{rule.enabled ? t("On", "Đang bật") : t("Off", "Đang tắt")}</span></td>
              <td>{stats[rule.id]?.last ? dateTime(stats[rule.id].last!, vi) : "—"}</td><td class="r">{stats[rule.id]?.failed7d ?? 0}</td>
            </tr>)}</tbody>
          </table></div>
        : <p class="s4-empty">{rules.length ? t("No rule matches.", "Không có quy tắc khớp.") : t("No rules yet. Create one to email internal people or post to a webhook when a CRM event happens.", "Chưa có quy tắc nào. Tạo quy tắc để gửi email cho người nội bộ hoặc gửi tới Webhook khi có sự kiện CRM.")}</p>}
      <p class="s4-note"><span>{t("The rule name stays in place when you scroll sideways.", "Cột Tên quy tắc cố định khi cuộn ngang.")}</span><span>{shown.length ? `1–${shown.length} / ${rules.length}` : ""}</span></p>
    </section>
  </div>
</WorkspaceShell>
