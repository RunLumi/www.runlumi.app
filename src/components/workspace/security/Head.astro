---
// Board page header: breadcrumbs, title (with an optional badge), description
// or meta line, and the action button group on the right.
import Breadcrumbs from "../ui/Breadcrumbs.astro";
interface Props { crumbs: { label: string; href?: string }[]; title: string; vi: boolean; desc?: string }
const { crumbs, title, vi, desc } = Astro.props;
---
<header class="s4-panel"><div class="s4-head">
  <div>
    <Breadcrumbs vi={vi} items={[...crumbs, { label: title }]} />
    <h1 class="s4-title">{title}<slot name="badge" /></h1>
    {desc && <p class="s4-desc">{desc}</p>}
    <slot name="meta" />
  </div>
  <div class="s4-actions"><slot name="actions" /></div>
</div><slot /></header>
