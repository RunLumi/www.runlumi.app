---
// A side sheet (or a centred dialog) that needs no client script. It is
// always in the page; a link to `#id` opens it (:target) and the close link
// returns to the page. `open` keeps it open when the server re-renders a
// form in it with errors or a conflict.
interface Props { id: string; title: string; vi: boolean; open?: boolean; dialog?: boolean; narrow?: boolean; closeHref?: string }
const { id, title, vi, open = false, dialog = false, narrow = false } = Astro.props;
const closeHref = Astro.props.closeHref ?? Astro.url.pathname;
---
<div class:list={["rec-sheet", { dialog, narrow }]} id={id} data-open={open ? "" : undefined} role="dialog" aria-modal="true" aria-labelledby={`${id}-h`} tabindex="-1">
  <a class="rec-sheet-scrim" href={closeHref} tabindex="-1" aria-hidden="true"></a>
  <div class="rec-sheet-card">
    <h2 class="rec-sheet-h" id={`${id}-h`}>{title}</h2>
    <a class="rec-sheet-x" href={closeHref} aria-label={vi ? "Đóng" : "Close"}>×</a>
    <slot />
  </div>
</div>
