---
// Setup page frame (Settings board): an icon header with an eyebrow, a short
// title and a button group, an optional info note, then the page's panels.
// The setup menu itself is the shell's grouped sidebar.
import NavIcon from "../NavIcon.astro";
import Breadcrumbs, { type Crumb } from "../ui/Breadcrumbs.astro";
import type { IconName } from "../../../lib/workspace/nav";

interface Props { vi: boolean; icon: IconName; eyebrow: string; title: string; info?: string; crumbs?: Crumb[]; tone?: string }
const { vi, icon, eyebrow, title, info, crumbs, tone = "setup" } = Astro.props;
---
<div class="rec rec-setup">
  <section class="rec-panel" aria-labelledby="setup-h">
    <div class="rec-setup-head">
      <div class="rec-id">
        <span class="rec-icon" data-tone={tone} aria-hidden="true"><NavIcon name={icon} size={22} /></span>
        <div>
          {crumbs?.length ? <Breadcrumbs items={crumbs} vi={vi} /> : null}
          <p class="rec-eyebrow">{eyebrow}<slot name="badges" /></p>
          <h1 class="rec-h1" id="setup-h">{title}</h1>
        </div>
      </div>
      {Astro.slots.has("actions") && <div class="rec-setup-actions"><slot name="actions" /></div>}
    </div>
    {(info || Astro.slots.has("info")) && <div class="rec-setup-body"><p class="rec-info"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-3px;margin-right:6px"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>{info}<slot name="info" /></p></div>}
  </section>
  <slot />
</div>
