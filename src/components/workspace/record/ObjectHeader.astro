---
// Header panel for list and record pages in modules without boards
// (Tuyển dụng, HRM, Tài chính): object icon, breadcrumbs, eyebrow, title, an
// optional count line and the action button group. It takes the same props
// as ui/PageHeader so those modules can switch to the record frame directly.
import NavIcon from "../NavIcon.astro";
import Breadcrumbs, { type Crumb } from "../ui/Breadcrumbs.astro";
import type { IconName } from "../../../lib/workspace/nav";

interface Props { title: string; vi: boolean; crumbs?: Crumb[]; eyebrow?: string; lede?: string; icon?: IconName; tone?: string; count?: string }
const { title, vi, crumbs, eyebrow, lede, icon = "overview", tone, count } = Astro.props;
---
<section class="rec-panel rec-objhead" aria-labelledby="obj-h">
  <div class="rec-oh">
    <div class="rec-id">
      <span class="rec-icon" data-tone={tone} aria-hidden="true"><NavIcon name={icon} size={22} /></span>
      <div>
        {crumbs?.length ? <Breadcrumbs items={crumbs} vi={vi} /> : null}
        {eyebrow && <p class="rec-eyebrow">{eyebrow}</p>}
        <h1 class="rec-h1" id="obj-h">{title}</h1>
        {count && <p class="rec-sub">{count}</p>}
        <slot name="lede" />
      </div>
    </div>
    {Astro.slots.has("actions") && <div class="rec-setup-actions"><slot name="actions" /></div>}
  </div>
  {lede && <div class="rec-setup-body"><p class="rec-info">{lede}</p></div>}
  <slot />
</section>
