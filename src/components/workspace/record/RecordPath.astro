---
// Path panel: the record's process as chevrons, an action on the right, and
// key fields and guidance below (the default slot).
export interface PathStep { label: string; state: "done" | "current" | "todo" | "won" | "lost" | "paused"; title?: string }
interface Props { vi: boolean; label: string; steps: PathStep[] }
const { vi, label, steps } = Astro.props;
const stateText = (state: PathStep["state"]) => ({ done: vi ? "đã qua" : "done", current: vi ? "hiện tại" : "current", todo: "", won: vi ? "thắng" : "won", lost: vi ? "thua" : "lost", paused: vi ? "tạm hoãn" : "on hold" })[state];
---
<section class="rec-panel rec-pathbar" aria-label={label}>
  <div class="rec-path-row">
    <ol class="rec-path" aria-label={label}>
      {steps.map((step) => <li class:list={["rec-step", step.state]} title={step.title ?? step.label} aria-current={step.state === "current" ? "step" : undefined}>
        {step.state === "done" && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>}
        <span>{step.label}</span>{stateText(step.state) && <span class="crm-sr"> ({stateText(step.state)})</span>}
      </li>)}
    </ol>
    <slot name="action" />
  </div>
  {Astro.slots.has("default") && <div class="rec-path-cols"><slot /></div>}
</section>
