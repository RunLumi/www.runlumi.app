---
// Record tabs as links (?tab=…): each tab is its own server-rendered view, so
// they work without client script and can be bookmarked.
export interface RecordTab { key: string; label: string; href: string }
interface Props { tabs: RecordTab[]; current: string; label: string }
const { tabs, current, label } = Astro.props;
---
<nav class="rec-tabs" aria-label={label}>
  {tabs.map((tab) => <a class="rec-tab" href={tab.href} aria-current={tab.key === current ? "page" : undefined}>{tab.label}</a>)}
</nav>
