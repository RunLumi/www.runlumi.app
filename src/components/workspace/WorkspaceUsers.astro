---
// Admin › Users. One full-width table of everyone with access (R-03); a row
// opens the member's child screen, where roles are changed.
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import DataTable from "./ui/DataTable.astro";
import PageHeader from "./ui/PageHeader.astro";
import Panel from "./ui/Panel.astro";
import { localized } from "../../lib/workspace/nav";
import type { usersPage } from "../../lib/workspace/pages";
import { accessErrors, auditActions, modulesFor } from "../../lib/workspace/access";
import { roleLabel, type Role } from "../../lib/workspace/roles";
import { shortDate, dateTime } from "../../lib/workspace/format";

type Props = Exclude<Awaited<ReturnType<typeof usersPage>>, Response>;
const { lang, vi, user, rows, shown, filter, query, audit, names, state } = Astro.props;
const t = (en: string, viText: string) => vi ? viText : en;
const base = localized("/workspace/users", vi);
const saved = Astro.url.searchParams.get("saved");
const error = Object.values(state.errors)[0];
const count = (test: (row: typeof rows[number]) => boolean) => rows.filter(test).length;
const chips: { key: typeof filter; label: string; n: number }[] = [
  { key: "all", label: t("All", "Tất cả"), n: rows.length },
  { key: "active", label: t("Active", "Đang hoạt động"), n: count((row) => row.enabled && row.active) },
  { key: "revoked", label: t("Revoked or disabled", "Đã thu hồi hoặc bị khóa"), n: count((row) => !row.enabled || !row.active) },
  { key: "admins", label: t("System Super Admins", "Siêu quản trị"), n: count((row) => row.admin) },
  { key: "terms", label: t("Partners without seller terms", "Cộng tác viên chưa khai báo loại người bán"), n: count((row) => row.sellerTermsMissing) },
];
const href = (next: typeof filter) => `${base}${next === "all" && !query ? "" : `?${new URLSearchParams({ ...(next !== "all" ? { filter: next } : {}), ...(query ? { q: query } : {}) })}`}`;
const status = (row: typeof rows[number]): [string, string] => !row.enabled ? ["red", t("Revoked", "Đã thu hồi")] : row.active ? ["green", t("Active", "Đang hoạt động")] : ["red", t("EmDash disabled", "EmDash đã khóa")];
---
<WorkspaceShell title={t("Users", "Người dùng")} lang={lang} user={user} module="admin" current="users">
  <PageHeader vi={vi} eyebrow={t("Admin", "Quản trị")} title={t("Users", "Người dùng")} lede={t("EmDash owns identity and sign-in. Here you grant Workspace roles to existing EmDash accounts. Revoking takes effect on the next request; the person's records stay.", "EmDash quản lý danh tính và đăng nhập. Ở đây bạn cấp vai trò Workspace cho tài khoản EmDash đã có. Thu hồi có hiệu lực từ yêu cầu kế tiếp; hồ sơ người đó phụ trách vẫn được giữ.")}>
    <Fragment slot="actions">
      <a class="crm-button secondary" href={localized("/workspace/roles", vi)}>{t("Roles and permissions", "Vai trò và quyền")}</a>
      <a class="crm-button" href={`${base}/new`}>{t("Grant access", "Cấp quyền")}</a>
    </Fragment>
  </PageHeader>
  {saved && <div class="crm-notice good" role="status">{t("Saved.", "Đã lưu.")}</div>}
  {error && <div class="crm-notice bad" role="alert">{accessErrors[error]?.[vi ? 1 : 0] ?? error}</div>}

  <Panel title={t("People with access", "Người có quyền")} note={t(`${shown.length} of ${rows.length} shown. Select a name to see details and change roles.`, `Đang hiện ${shown.length}/${rows.length}. Bấm vào tên để xem chi tiết và đổi vai trò.`)} flush>
    <div class="ws-toolbar">
      <ul class="ws-chips" aria-label={t("Quick filters", "Lọc nhanh")}>
        {chips.filter((chip) => chip.key === "all" || chip.n > 0 || chip.key === filter).map((chip) => <li><a href={href(chip.key)} aria-current={chip.key === filter ? "true" : undefined}>{chip.label} <span class="crm-count">{chip.n}</span></a></li>)}
      </ul>
      <form class="ws-search" method="get" role="search">
        {filter !== "all" && <input type="hidden" name="filter" value={filter} />}
        <label class="crm-sr" for="q">{t("Search by name or email", "Tìm theo tên hoặc email")}</label>
        <input class="crm-input" id="q" name="q" type="search" value={query} maxlength="100" placeholder={t("Name or email", "Tên hoặc email")} />
        <button class="crm-button secondary" type="submit">{t("Search", "Tìm")}</button>
      </form>
    </div>
    {shown.length
      ? <DataTable vi={vi} label={t("People with access", "Người có quyền")} frozen={1} widths={["17rem"]} frozenNames={t("Name", "Tên")} minWidth="980px" meta={t(`${shown.length} people`, `${shown.length} người`)}>
          <thead><tr>
            <th scope="col">{t("Name", "Tên")}</th><th scope="col" class="w-md">{t("Roles", "Vai trò")}</th><th scope="col" class="w-md">{t("Modules", "Phân hệ")}</th>
            <th scope="col" class="num">Passkey</th><th scope="col" class="num">{t("AI agent tokens", "Token AI agent")}</th>
            <th scope="col" class="w-md">{t("Status", "Trạng thái")}</th><th scope="col">{t("Last change", "Thay đổi gần nhất")}</th>
          </tr></thead>
          <tbody>{shown.map((row) => { const [tone, label] = status(row); return <tr>
            <th scope="row"><a class="ws-row-link" href={`${base}/${encodeURIComponent(row.user_id)}`}>{row.name || t("EmDash account unavailable", "Không còn tài khoản EmDash")}</a><span class="ws-sub">{row.email}</span></th>
            <td>{row.admin ? roleLabel("admin", vi) : row.roles.map((role: Role) => roleLabel(role, vi)).join(", ") || "—"}</td>
            <td>{modulesFor(row.admin, row.roles).map((module) => vi ? module.vi : module.en).join(", ") || "—"}</td>
            <td class="num">{row.passkeys ?? "—"}</td>
            <td class="num">{row.tokens}</td>
            <td><span class="ws-badges"><span class:list={["crm-badge", tone]}>{label}</span>{row.admin && <span class="crm-badge blue">{t("from EmDash", "do EmDash cấp")}</span>}{row.sellerTermsMissing && <a class="crm-badge amber" href={localized("/crm/commission#terms", vi)}>{t("Seller terms not set", "Chưa khai báo loại người bán")}</a>}</span></td>
            <td class="nowrap">{row.updated_at ? shortDate(row.updated_at, vi) : "—"}</td>
          </tr>; })}</tbody>
        </DataTable>
      : <p class="ws-table-empty">{query ? t(`Nobody matches “${query}”.`, `Không có ai khớp “${query}”.`) : t("Nobody in this view.", "Không có ai trong mục này.")}</p>}
  </Panel>

  <Panel title={t("Recent access changes", "Thay đổi quyền gần đây")} note={t("The last ten grants and revocations. Each person's full history is on their page.", "Mười lần cấp hoặc thu hồi gần nhất. Lịch sử đầy đủ nằm trên trang của từng người.")} flush>
    {audit.length
      ? <DataTable vi={vi} label={t("Recent access changes", "Thay đổi quyền gần đây")} frozen={1} widths={["15rem"]} frozenNames={t("Person", "Người")} minWidth="760px">
          <thead><tr><th scope="col">{t("Person", "Người")}</th><th scope="col">{t("Change", "Thay đổi")}</th><th scope="col">{t("Roles after", "Vai trò sau đó")}</th><th scope="col">{t("By", "Người thực hiện")}</th><th scope="col">{t("When", "Thời điểm")}</th></tr></thead>
          <tbody>{audit.map((row) => { const detail = JSON.parse(row.detail || "{}") as { roles_after?: Role[] }; return <tr>
            <th scope="row"><a class="ws-row-link" href={`${base}/${encodeURIComponent(row.target_user_id)}`}>{names.get(row.target_user_id) ?? row.target_user_id}</a></th>
            <td>{auditActions[row.action]?.[vi ? 1 : 0] ?? row.action}</td>
            <td>{(detail.roles_after ?? []).map((role) => roleLabel(role, vi)).join(", ") || "—"}</td>
            <td>{row.actor_name}</td>
            <td class="nowrap">{dateTime(row.created_at, vi)}</td>
          </tr>; })}</tbody>
        </DataTable>
      : <p class="ws-table-empty">{t("No changes yet.", "Chưa có thay đổi.")}</p>}
  </Panel>
</WorkspaceShell>
