---
// Admin › Members (board MembersTeams). List-view header with "View roles"
// and "Add member", quick filters, search, and the full-width table with the
// name frozen (R-03); a row opens the member record. Groups, departments and
// invitations on the board have no Workspace model and are not drawn.
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import "../../styles/workspace-security.css";
import RecordHeader from "./ui/RecordHeader.astro";
import ListToolbar from "./ui/ListToolbar.astro";
import DataTable from "./ui/DataTable.astro";
import { localized } from "../../lib/workspace/nav";
import type { usersPage } from "../../lib/workspace/pages";
import { accessErrors, auditActions, modulesFor } from "../../lib/workspace/access";
import { roleLabel, type Role } from "../../lib/workspace/roles";
import { initials } from "../../lib/workspace/summaries";
import { shortDate, dateTime } from "../../lib/workspace/format";

type Props = Exclude<Awaited<ReturnType<typeof usersPage>>, Response>;
const { lang, vi, user, rows, shown, filter, query, audit, names, state } = Astro.props;
const t = (en: string, viText: string) => vi ? viText : en;
const base = localized("/workspace/users", vi);
const saved = Astro.url.searchParams.get("saved");
const error = Object.values(state.errors)[0];
const count = (test: (row: typeof rows[number]) => boolean) => rows.filter(test).length;
const chips: { key: typeof filter; label: string; n: number }[] = [
  { key: "all", label: t("All", "Tất cả"), n: rows.length },
  { key: "backup", label: t("Missing a second passkey", "Thiếu passkey thứ hai"), n: count((row) => row.passkeys !== null && row.passkeys < 2) },
  { key: "agents", label: t("Has an AI agent", "Có AI agent"), n: count((row) => row.tokens > 0) },
  { key: "active", label: t("Active", "Đang hoạt động"), n: count((row) => row.enabled && row.active) },
  { key: "revoked", label: t("Revoked or disabled", "Đã thu hồi hoặc bị khóa"), n: count((row) => !row.enabled || !row.active) },
  { key: "admins", label: t("System Super Admins", "Siêu quản trị"), n: count((row) => row.admin) },
  { key: "terms", label: t("Partners without seller terms", "Cộng tác viên chưa khai báo loại người bán"), n: count((row) => row.sellerTermsMissing) },
];
const href = (next: typeof filter) => `${base}${next === "all" && !query ? "" : `?${new URLSearchParams({ ...(next !== "all" ? { filter: next } : {}), ...(query ? { q: query } : {}) })}`}`;
const status = (row: typeof rows[number]): [string, string] => !row.enabled ? ["bad", t("Revoked", "Đã thu hồi")] : row.active ? ["ok", t("Active", "Đang hoạt động")] : ["bad", t("EmDash disabled", "EmDash đã khóa")];
const modules = (row: typeof rows[number]) => modulesFor(row.admin, row.roles).map((module) => vi ? module.vi : module.en).join(", ") || "—";
---
<WorkspaceShell title={t("Members", "Thành viên")} lang={lang} user={user} module="admin" current="users">
  <div class="s4 s4-stack">
    <RecordHeader vi={vi} icon="users" tone="setup" object={t("Admin", "Quản trị")} crumbs={[{ label: t("Admin", "Quản trị"), href: base }, { label: t("Members", "Thành viên") }]} title={t("Members", "Thành viên")}>
      <p slot="sub" class="s4-desc">{t(`${rows.length} people with Workspace access. EmDash owns identity and sign-in; here you grant Workspace roles to existing EmDash accounts. Changing access needs your passkey.`, `${rows.length} người có quyền Workspace. EmDash quản lý danh tính và đăng nhập; ở đây bạn cấp vai trò Workspace cho tài khoản EmDash đã có. Đổi quyền phải xác thực lại bằng passkey.`)}</p>
      <Fragment slot="actions"><div class="ws-bg" role="group" aria-label={t("Actions", "Thao tác")}><a class="ws-btn" href={localized("/workspace/roles", vi)}>{t("View roles", "Xem vai trò")}</a><a class="ws-btn primary" href={`${base}/new`}>{t("Add member", "Thêm thành viên")}</a></div></Fragment>
      <div class="s4-pb"><ul class="ws-chips" aria-label={t("Quick filters", "Lọc nhanh")}><li class="s4-qf">{t("Quick filters", "Lọc nhanh")}</li>{(chips.filter((chip) => chip.key === "all" || chip.n > 0 || chip.key === filter).map((chip) => ({ label: `${chip.label} (${chip.n})`, href: href(chip.key), on: chip.key === filter }))).map((item) => <li><a href={item.href} aria-current={item.on ? "true" : undefined}>{item.label}</a></li>)}</ul></div>
    </RecordHeader>
    {saved && <p class="crm-notice good" role="status">{t("Saved.", "Đã lưu.")}</p>}
    {error && <p class="crm-notice bad" role="alert">{accessErrors[error]?.[vi ? 1 : 0] ?? error}</p>}
    <section class="s4-panel" aria-label={t("Members", "Thành viên")}>
      <div class="s4-lvbar"><p>{t(`${shown.length} members · sorted by name · select a name for details`, `${shown.length} thành viên · sắp xếp theo tên · bấm một tên để xem chi tiết`)}</p>
        <ListToolbar vi={vi} q={query} keep={{ filter: filter === "all" ? "" : filter }} placeholder={t("Search by name or email", "Tìm theo tên hoặc email")} /></div>
      {shown.length
        ? <DataTable vi={vi} label={t("Members", "Thành viên")} frozen={1} widths={["17rem"]} frozenNames={t("Name", "Tên")} minWidth="1100px" meta={t(`1–${shown.length} of ${rows.length}`, `1–${shown.length} trên ${rows.length}`)}>
            <thead><tr><th scope="col">{t("Name", "Tên")}</th><th scope="col">Email</th><th scope="col">{t("Roles", "Vai trò")}</th><th scope="col">{t("Modules", "Phân hệ")}</th><th scope="col" class="num">Passkey</th><th scope="col" class="num">{t("AI agents", "AI agent")}</th><th scope="col">{t("Status", "Trạng thái")}</th><th scope="col">{t("Last change", "Thay đổi gần nhất")}</th></tr></thead>
            <tbody>{shown.map((row) => { const [tone, label] = status(row); return <tr>
              <th scope="row"><span class="ws-member-id" style="display:inline-flex;gap:8px;align-items:center"><span class="ws-avatar" aria-hidden="true">{initials(row.name || row.email)}</span><a class="ws-row-link" href={`${base}/${encodeURIComponent(row.user_id)}`}>{row.name || t("EmDash account unavailable", "Không còn tài khoản EmDash")}</a></span></th>
              <td>{row.email}</td>
              <td>{row.admin ? roleLabel("admin", vi) : row.roles.map((role: Role) => roleLabel(role, vi)).join(", ") || "—"}</td>
              <td>{modules(row)}</td>
              <td class="num">{row.passkeys === null ? "—" : <span class:list={["ws-badge", row.passkeys === 0 ? "bad" : row.passkeys === 1 ? "warn" : "ok"]}>{row.passkeys}</span>}</td>
              <td class="num">{row.tokens}</td>
              <td><span class="ws-badges"><span class:list={["ws-badge", tone]}>{label}</span>{row.admin && <span class="ws-badge info">{t("from EmDash", "do EmDash cấp")}</span>}{row.sellerTermsMissing && <a class="ws-badge warn" href={localized("/crm/commission#terms", vi)}>{t("Seller terms not set", "Chưa khai báo loại người bán")}</a>}</span></td>
              <td class="nowrap">{row.updated_at ? shortDate(row.updated_at, vi) : "—"}</td>
            </tr>; })}</tbody>
          </DataTable>
        : <p class="s4-empty">{query ? t(`Nobody matches “${query}”.`, `Không có ai khớp “${query}”.`) : t("Nobody in this view.", "Không có ai trong mục này.")}</p>}
    </section>
    <section class="s4-panel" aria-labelledby="chg-h">
      <div class="s4-ph"><h2 id="chg-h">{t("Recent access changes", "Thay đổi quyền gần đây")}</h2><a class="ws-btn sm" href={`${localized("/workspace/audit", vi)}?kind=access`}>{t("Open the audit log", "Mở Nhật ký kiểm toán")}</a></div>
      {audit.length
        ? <DataTable vi={vi} label={t("Recent access changes", "Thay đổi quyền gần đây")} frozen={1} widths={["15rem"]} frozenNames={t("Person", "Người")} minWidth="760px">
            <thead><tr><th scope="col">{t("Person", "Người")}</th><th scope="col">{t("Change", "Thay đổi")}</th><th scope="col">{t("Roles after", "Vai trò sau đó")}</th><th scope="col">{t("By", "Người thực hiện")}</th><th scope="col">{t("When", "Thời điểm")}</th></tr></thead>
            <tbody>{audit.map((row) => { const detail = JSON.parse(row.detail || "{}") as { roles_after?: Role[] }; return <tr>
              <th scope="row"><a class="ws-row-link" href={`${base}/${encodeURIComponent(row.target_user_id)}`}>{names.get(row.target_user_id) ?? row.target_user_id}</a></th>
              <td>{auditActions[row.action]?.[vi ? 1 : 0] ?? row.action}</td><td>{(detail.roles_after ?? []).map((role) => roleLabel(role, vi)).join(", ") || "—"}</td><td>{row.actor_name}</td><td class="nowrap">{dateTime(row.created_at, vi)}</td>
            </tr>; })}</tbody>
          </DataTable>
        : <p class="s4-empty">{t("No changes yet.", "Chưa có thay đổi.")}</p>}
    </section>
  </div>
</WorkspaceShell>
