---
// Admin › Users › person: the child screen a users-table row opens (R-03).
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import RoleChecks from "./RoleChecks.astro";
import DataTable from "./ui/DataTable.astro";
import FactRow from "./ui/FactRow.astro";
import PageHeader from "./ui/PageHeader.astro";
import Panel from "./ui/Panel.astro";
import PanelRow from "./ui/PanelRow.astro";
import { localized } from "../../lib/workspace/nav";
import type { memberPage } from "../../lib/workspace/pages";
import { accessErrors, auditActions, modulesFor } from "../../lib/workspace/access";
import { type Role, roleLabel } from "../../lib/workspace/roles";
import { initials, moduleSummaries } from "../../lib/workspace/summaries";
import { dateTime, shortDate } from "../../lib/workspace/format";

type Props = Exclude<Awaited<ReturnType<typeof memberPage>>, Response>;
const { lang, vi, user, member, audit, names, state, self } = Astro.props;
const t = (en: string, viText: string) => vi ? viText : en;
const base = localized("/workspace/users", vi);
const saved = Astro.url.searchParams.get("saved");
const error = Object.values(state.errors)[0];
const name = member.name || t("EmDash account unavailable", "Không còn tài khoản EmDash");
const statusText = member.admin ? t("Active (EmDash admin)", "Đang hoạt động (admin EmDash)") : !member.enabled ? t("Revoked", "Đã thu hồi") : member.active ? t("Active", "Đang hoạt động") : t("EmDash account disabled", "Tài khoản EmDash đã khóa");
const opened = modulesFor(member.admin, member.roles);
const editable = !member.admin && !self;
---
<WorkspaceShell title={name} lang={lang} user={user} module="admin" current="users">
  <PageHeader vi={vi} title={name} crumbs={[{ label: t("Admin", "Quản trị"), href: base }, { label: t("Users", "Người dùng"), href: base }, { label: name }]}>
    <p slot="lede" class="crm-lede ws-member-id"><span class="ws-avatar" aria-hidden="true">{initials(name)}</span><span>{member.email}</span></p>
  </PageHeader>
  {saved && <div class="crm-notice good" role="status">{t("Saved.", "Đã lưu.")}</div>}
  {error && <div class="crm-notice bad" role="alert">{accessErrors[error]?.[vi ? 1 : 0] ?? error}</div>}

  <FactRow facts={[
    { label: t("Status", "Trạng thái"), value: statusText },
    { label: t("Roles", "Vai trò"), value: member.admin ? roleLabel("admin", vi) : member.roles.map((role: Role) => roleLabel(role, vi)).join(", ") || "—" },
    { label: "Passkey", value: member.passkeys === null ? t("Unknown", "Không rõ") : String(member.passkeys) },
    { label: t("Active AI agent tokens", "Token AI agent đang dùng"), value: String(member.tokens) },
    { label: t("Access since", "Có quyền từ"), value: member.created_at ? shortDate(member.created_at, vi) : member.admin ? t("EmDash role", "Theo quyền EmDash") : "—" },
  ]} />
  <div style="height:16px" aria-hidden="true"></div>

  {member.sellerTermsMissing && <Panel title={t("Seller terms not set", "Chưa khai báo loại người bán")} tone="warn">
    <p class="crm-help">{t("This partner earns commission only once their seller terms (full-cycle or referral) are declared.", "Cộng tác viên này chỉ được tính hoa hồng sau khi khai báo loại người bán (bán trọn hoặc giới thiệu).")}</p>
    <a slot="foot" class="crm-button secondary small" href={localized("/crm/commission#terms", vi)}>{t("Declare on Commission", "Khai báo ở trang Hoa hồng")}</a>
  </Panel>}

  <PanelRow min="320px">
    <Panel title={t("Identity in EmDash", "Danh tính trong EmDash")} note={t("Name, email and sign-in are managed in EmDash.", "Tên, email và đăng nhập do EmDash quản lý.")}>
      <dl class="ws-kv">
        <div><dt>{t("Name", "Tên")}</dt><dd>{name}</dd></div>
        <div><dt>Email</dt><dd>{member.email || "—"}</dd></div>
        <div><dt>{t("EmDash account", "Tài khoản EmDash")}</dt><dd>{member.active ? t("Active", "Đang hoạt động") : t("Disabled or missing", "Đã khóa hoặc không còn")}</dd></div>
        <div><dt>{t("Last access change", "Lần đổi quyền gần nhất")}</dt><dd>{member.updated_at ? `${dateTime(member.updated_at, vi)}${member.granted_by ? ` · ${names.get(member.granted_by) ?? member.granted_by}` : ""}` : "—"}</dd></div>
      </dl>
    </Panel>
    <Panel title={t("Modules this person can open", "Phân hệ người này được mở")} note={t("Worked out from the roles below. Finance is open only to the System Super Admin.", "Tính từ các vai trò bên dưới. Tài chính chỉ mở cho Siêu quản trị hệ thống.")}>
      {opened.length && member.enabled
        ? <ul class="ws-list">{opened.map((module) => <li><strong>{vi ? module.vi : module.en}</strong><p class="crm-help">{moduleSummaries[module.key][vi ? 1 : 0]}</p></li>)}</ul>
        : <p class="crm-empty">{t("None while access is revoked.", "Không có, vì quyền đang bị thu hồi.")}</p>}
    </Panel>
  </PanelRow>

  {member.admin
    ? <Panel title={t("Roles", "Vai trò")}><p class="crm-help">{t("EmDash admins (role 50) hold every permission and are not stored as Workspace members. Change this in EmDash.", "Admin EmDash (role 50) có mọi quyền và không lưu như thành viên Workspace. Thay đổi việc này trong EmDash.")}</p></Panel>
    : <Panel title={t("Roles", "Vai trò")} note={self ? t("You cannot change your own access. Another admin must do it.", "Bạn không thể tự đổi quyền của mình. Cần một admin khác thực hiện.") : t("Roles combine. CRM roles never open candidate records; HR gets no CRM access. Every change is written to the access log.", "Có thể kết hợp nhiều vai trò. Vai trò CRM không mở hồ sơ ứng viên; HR không vào CRM. Mọi thay đổi đều được ghi vào nhật ký quyền.")}>
        <form method="post" id="roles-form" aria-label={t(`Roles for ${name}`, `Vai trò của ${name}`)}>
          <input type="hidden" name="intent" value="update" /><input type="hidden" name="user_id" value={member.user_id} />
          <RoleChecks vi={vi} checked={member.roles} disabled={!editable} idPrefix="role" />
        </form>
        {editable && <Fragment slot="foot">
          <button class="crm-button" type="submit" form="roles-form" name="enabled" value="1">{member.enabled ? t("Save roles", "Lưu vai trò") : t("Restore with these roles", "Khôi phục với các vai trò này")}</button>
          {member.enabled && <button class="crm-button danger" type="submit" form="roles-form" name="enabled" value="0">{t("Revoke access", "Thu hồi quyền")}</button>}
          <span class="crm-help">{t("Revoking keeps the roles on record so access can be restored, and ends this person's API tokens.", "Thu hồi vẫn giữ vai trò để có thể khôi phục, và chấm dứt các token API của người này.")}</span>
        </Fragment>}
      </Panel>}

  <Panel title={t("Access history", "Lịch sử thay đổi quyền")} flush>
    {audit.length
      ? <DataTable vi={vi} label={t("Access history", "Lịch sử thay đổi quyền")} minWidth="640px">
          <thead><tr><th scope="col">{t("When", "Thời điểm")}</th><th scope="col">{t("Change", "Thay đổi")}</th><th scope="col">{t("Roles before", "Vai trò trước")}</th><th scope="col">{t("Roles after", "Vai trò sau")}</th><th scope="col">{t("By", "Người thực hiện")}</th></tr></thead>
          <tbody>{audit.map((row) => { const detail = JSON.parse(row.detail || "{}") as { roles_before?: Role[]; roles_after?: Role[] }; const list = (items?: Role[]) => (items ?? []).map((role) => roleLabel(role, vi)).join(", ") || "—"; return <tr>
            <td class="nowrap">{dateTime(row.created_at, vi)}</td><td>{auditActions[row.action]?.[vi ? 1 : 0] ?? row.action}</td><td>{list(detail.roles_before)}</td><td>{list(detail.roles_after)}</td><td>{row.actor_name}</td>
          </tr>; })}</tbody>
        </DataTable>
      : <p class="ws-table-empty">{t("No recorded changes.", "Chưa có thay đổi nào được ghi.")}</p>}
  </Panel>
</WorkspaceShell>
