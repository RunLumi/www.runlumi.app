---
// Path panel (boards: LeadRecord, DealRecord): the Path with its main action
// (slot "action"), then key fields and guidance in two columns (default
// slot, usually two <div>s with an <h2> each). Adopted from ui3's record kit.
import Path from "./Path.astro";

export interface PathStep { label: string; state: "done" | "current" | "todo" | "selected" | "won" | "lost"; href?: string }
interface Props { vi: boolean; label: string; steps: PathStep[] }
const { vi, label, steps } = Astro.props;
---
<section class="ws-sheet-panel ws-pathbar" aria-label={label}>
  <Path vi={vi} label={label} steps={steps}>{Astro.slots.has("action") && <Fragment slot="action"><slot name="action" /></Fragment>}</Path>
  {Astro.slots.has("default") && <div class="ws-path-cols"><slot /></div>}
</section>
