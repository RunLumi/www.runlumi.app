---
// Form grid (boards: NewEvent "fgrid2", AccountProfile "pf-grid"): fields in
// 1–3 columns that fall to one column on phones. Wide fields add class "span".
interface Props { cols?: 1 | 2 | 3; title?: string }
const { cols = 2, title } = Astro.props;
---
{title && <p class="ws-fsec">{title}</p>}
<div class="ws-fgrid" style={`--ws-cols:${cols}`}><slot /></div>
