---
// Related list card (boards: DealRecord, AccountRecord, Search): a grey
// header with the object square, title and count, a "View all" link, then
// rows. Pass `items` or write rows (class "ws-rl-row") in the slot.
import ObjectIcon, { type Tone } from "./ObjectIcon.astro";
import type { IconName } from "../../../lib/workspace/nav";

export interface RelatedItem { title: string; href?: string; meta?: string; fields?: [string, string][] }
interface Props { title: string; vi: boolean; icon?: IconName; tone?: Tone | string; count?: number; href?: string; hrefLabel?: string; items?: RelatedItem[]; empty?: string; id?: string }
const { title, vi, icon, tone, count, href, hrefLabel, items, empty } = Astro.props;
const id = Astro.props.id ?? `rl-${title.toLowerCase().normalize("NFD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 40)}`;
---
<section class="ws-rl" aria-labelledby={id}>
  <div class="ws-rl-h">
    <h3 class="ws-rl-t" id={id}>{icon && <ObjectIcon icon={icon} tone={tone} size="sm" />}{title}{count !== undefined && <span class="ws-rl-n"> ({count})</span>}</h3>
    {href && <a href={href}>{hrefLabel ?? (vi ? "Xem tất cả" : "View all")}</a>}
  </div>
  {items
    ? items.length
      ? items.map((item) => <div class="ws-rl-row">
          {item.href ? <a class="ws-rl-title" href={item.href}>{item.title}</a> : <strong class="ws-rl-title">{item.title}</strong>}
          {item.meta && <span class="ws-rl-meta">{item.meta}</span>}
          {item.fields && <dl class="ws-rl-f">{item.fields.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
        </div>)
      : <p class="ws-rl-empty">{empty ?? (vi ? "Chưa có mục nào." : "Nothing here yet.")}</p>
    : <slot />}
</section>
