---
// SignIn and MobileSignIn boards. EmDash is the only sign-in: this page calls
// EmDash's passkey sign-in and sign-in link endpoints, and the middleware
// counts a verified passkey sign-in as the session's Workspace passkey check.
import WorkspaceAuth from "../../layouts/WorkspaceAuth.astro";
import Brand from "./security/Brand.astro";
import type { SignInData } from "../../lib/workspace/sign-in-pages";

type Props = SignInData;
const { lang, vi, next, switchHref, error } = Astro.props;
const t = (en: string, viText: string) => (vi ? viText : en);
const messages = {
  "data-msg-working": t("Waiting for your device…", "Đang chờ thiết bị của bạn…"),
  "data-msg-done": t("Signed in. Opening the Workspace…", "Đã đăng nhập. Đang mở Workspace…"),
  "data-msg-failed": t("That passkey did not sign you in. Try again, or use another of your passkeys.", "Passkey này chưa đăng nhập được. Thử lại hoặc dùng passkey khác của bạn."),
  "data-msg-cancelled": t("No passkey was used. Try again when you are ready.", "Chưa dùng passkey nào. Thử lại khi bạn sẵn sàng."),
  "data-msg-unsupported": t("This browser cannot use passkeys. Open the Workspace in a current version of Chrome, Edge, Firefox or Safari.", "Trình duyệt này không dùng được passkey. Hãy mở Workspace bằng bản mới của Chrome, Edge, Firefox hoặc Safari."),
  "data-msg-email": t("Enter your work email first.", "Hãy nhập email công việc trước."),
  "data-msg-sent": t("If this email has a Workspace account, a sign-in link is on its way. Open it on this device, then come back to the Workspace to create your passkey.", "Nếu email này có tài khoản Workspace, link đăng nhập đang được gửi. Mở link trên thiết bị này rồi quay lại Workspace để tạo passkey."),
  "data-msg-nomail": t("Email sign-in is not set up yet. Ask your admin for an invite or a recovery link.", "Đăng nhập qua email chưa được thiết lập. Hãy nhờ admin gửi lời mời hoặc link khôi phục."),
};
---
<WorkspaceAuth title={t("Sign in", "Đăng nhập")} lang={lang} switchHref={switchHref}>
  <div class="s4-auth">
    <section class="s4-card narrow" aria-labelledby="si-h">
      <Brand />
      <h1 id="si-h">{t("Sign in", "Đăng nhập")}</h1>
      <p>{t("Lumi Workspace uses passkeys instead of passwords. Verify with Face ID, a fingerprint or your device's security key.", "Lumi Workspace dùng passkey thay cho mật khẩu. Xác thực bằng Face ID, vân tay hoặc khóa bảo mật của thiết bị này.")}</p>
      {error && <p class="s4-error" role="alert">{t("That sign-in link did not work. Ask for a new one.", "Link đăng nhập không dùng được. Hãy xin link mới.")}</p>}
      <form class="s4-stack" method="post" data-signin data-next={next} {...messages} style="gap:16px">
        <div class="s4-field"><label for="si-email">{t("Work email", "Email công việc")}</label>
          <input class="s4-in" id="si-email" name="email" type="email" required autocomplete="username webauthn" spellcheck="false" inputmode="email" /></div>
        <button class="s4-btn primary lg block" type="submit" data-signin-passkey>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="9" r="4"></circle><path d="M13 13l7 7M17 17l2-2M15 19l2-2"></path></svg>{t("Sign in with passkey", "Đăng nhập bằng passkey")}</button>
        <button class="s4-btn neutral lg block" type="button" data-signin-link>{t("No passkey yet? Email me a sign-in link", "Chưa có passkey? Gửi link đăng nhập qua email")}</button>
        <p class="s4-live" data-signin-status role="status" aria-live="polite"></p>
        <noscript><p class="s4-error">{t("Passkeys need JavaScript. Turn it on for runlumi.app and reload.", "Passkey cần JavaScript. Hãy bật cho runlumi.app rồi tải lại trang.")}</p></noscript>
      </form>
      <p class="s4-center"><a class="s4-btn link" href={`${vi ? "/vi" : ""}/workspace/recovery`}>{t("Lost the device with your passkey? Recover your account", "Mất thiết bị có passkey? Khôi phục tài khoản")}</a></p>
      <p class="s4-foot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path></svg>
        <span>{vi ? <>Email thật từ Lumi luôn có <strong>mã chống lừa đảo</strong> của bạn ở đầu thư. Email không có mã là giả mạo; đừng bấm link trong đó.</> : <>Real email from Lumi always starts with your <strong>anti-phishing code</strong>. Email without it is fake; do not open its links.</>}</span></p>
    </section>
  </div>
</WorkspaceAuth>
<script>
  import "../../scripts/workspace-signin";
</script>
