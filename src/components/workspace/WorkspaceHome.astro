---
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import PageHeader from "./ui/PageHeader.astro";
import Panel from "./ui/Panel.astro";
import PanelRow from "./ui/PanelRow.astro";
import { localized, moduleByKey } from "../../lib/workspace/nav";
import type { homePage } from "../../lib/workspace/pages";
import { roleLabel } from "../../lib/workspace/roles";
import { moduleSummaries } from "../../lib/workspace/summaries";

type Props = Awaited<ReturnType<typeof homePage>>;
const { lang, vi, user, cards } = Astro.props;
const held = user.admin ? [roleLabel("admin", vi)] : [...user.roles].map((role) => roleLabel(role, vi));
---
<WorkspaceShell title={vi ? "Tổng quan" : "Overview"} lang={lang} user={user} module="home">
  <PageHeader vi={vi} eyebrow={vi ? "Tổng quan" : "Overview"} title={vi ? `Chào ${user.name}.` : `Hello, ${user.name}.`} lede={vi ? "Số liệu dưới đây lấy trực tiếp từ các phân hệ bạn được mở. Bấm vào một số để xem danh sách." : "These figures come straight from the modules you can open. Select a number to see the list."} />
  {cards.length > 0
    ? <PanelRow min="280px" label={vi ? "Phân hệ của bạn" : "Your modules"}>
        {cards.map((card) => { const module = moduleByKey(card.module); return <Panel title={vi ? module.vi : module.en} titleHref={localized(module.path, vi)} note={moduleSummaries[card.module][vi ? 1 : 0]} data-module={card.module}>
          <dl class="ws-home-figures">{card.figures.map((figure) => <div><dt>{figure.label[vi ? 1 : 0]}</dt><dd><a href={localized(figure.href, vi)}>{figure.value}</a></dd></div>)}</dl>
          <a slot="foot" class="crm-button secondary small" href={localized(module.path, vi)}>{vi ? `Mở ${module.vi}` : `Open ${module.en}`}</a>
        </Panel>; })}
      </PanelRow>
    : <p class="crm-empty">{vi ? "Vai trò của bạn chưa mở phân hệ nào có số liệu ở đây." : "Your roles do not open a module with figures here yet."}</p>}
  {user.admin && user.can("finance.configure") && user.financeEnabled !== true && <Panel title={vi ? "Thiết lập Tài chính" : "Set up Finance"} note={vi ? "Xác nhận phạm vi báo cáo, tiền tệ và kỳ bắt đầu trước khi nhập số liệu." : "Confirm the reporting entity, currency and opening period before entering figures."}>
    <a class="crm-button secondary" href={localized("/finance/settings", vi)}>{vi ? "Mở thiết lập" : "Open settings"}</a>
  </Panel>}
  <Panel title={vi ? "Vai trò của bạn" : "Your roles"}>
    <p class="ws-home-roles">{held.join(" · ")}</p>
    <a slot="foot" class="crm-link" href={localized("/workspace/account", vi)}>{vi ? "Xem quyền chi tiết trong Tài khoản của tôi" : "See what they allow in My account"}</a>
  </Panel>
</WorkspaceShell>
