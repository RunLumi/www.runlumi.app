---
// Admin › Notification rules › one rule (child screen). Event, safe
// conditions, channels and internal recipients. Saving needs step-up; a
// stale version is refused so two admins never overwrite each other.
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import PageHeader from "./ui/PageHeader.astro";
import Panel from "./ui/Panel.astro";
import PanelRow from "./ui/PanelRow.astro";
import { localized } from "../../lib/workspace/nav";
import type { RuleData } from "../../lib/workspace/admin-security-pages";
import { platformLabels } from "../../lib/workspace/notify/destinations";
import { eventLabel } from "../../lib/workspace/notify/labels";
import { RULE_EVENTS } from "../../lib/workspace/notify/rules";
import { roleLabel, roles } from "../../lib/workspace/roles";

type Props = RuleData;
const { lang, vi, user, rule, destinations, playbooks, people, typed, error, saved } = Astro.props;
const t = (en: string, viText: string) => (vi ? viText : en);
const base = localized("/workspace/notifications", vi);
const stored: Record<string, string[]> = rule ? {
  name: [rule.name], events: rule.events, playbooks: rule.conditions.playbooks, min_value_vnd: rule.conditions.min_value_vnd === null ? [] : [String(rule.conditions.min_value_vnd)], outcome: [rule.conditions.outcome],
  recipient_roles: rule.recipients.roles, recipient_users: rule.recipients.users, recipient_admins: rule.recipients.admins ? ["1"] : [], record_owner: rule.recipients.record_owner ? ["1"] : [],
  email: rule.email ? ["1"] : [], destinations: rule.destinations, enabled: [rule.enabled ? "1" : "0"],
} : { record_owner: ["1"], email: ["1"], enabled: ["1"] };
const values = (name: string) => typed ? typed.getAll(name).map(String) : stored[name] ?? [];
const has = (name: string, value: string) => values(name).includes(value);
const one = (name: string) => values(name)[0] ?? "";
const errors: Record<string, [string, string]> = {
  "name:required": ["Give the rule a name.", "Hãy đặt tên quy tắc."], "events:required": ["Choose at least one event.", "Chọn ít nhất một sự kiện."],
  "recipients:required": ["Email needs at least one recipient.", "Email cần ít nhất một người nhận."], "channels:required": ["Choose email or at least one webhook.", "Chọn email hoặc ít nhất một Webhook."],
  "min_value_vnd:invalid": ["Enter the value as a whole number of đồng.", "Nhập giá trị là số đồng nguyên."], "version:stale": ["Someone else changed this rule. Reload it and apply your change again.", "Người khác vừa sửa quy tắc này. Tải lại rồi sửa lại."],
  "destinations:invalid": ["A chosen webhook no longer exists.", "Một Webhook đã chọn không còn."],
};
const title = rule ? rule.name : t("New rule", "Quy tắc mới");
---
<WorkspaceShell title={title} lang={lang} user={user} module="admin" current="notifications">
  <PageHeader vi={vi} title={title} crumbs={[{ label: t("Admin", "Quản trị"), href: localized("/workspace/users", vi) }, { label: t("Notification rules", "Quy tắc thông báo"), href: base }, { label: title }]} lede={rule ? t(`Version ${rule.version}. Changes are recorded in the audit log.`, `Phiên bản ${rule.version}. Mọi thay đổi được ghi vào nhật ký kiểm toán.`) : undefined} />
  {saved && <div class="crm-notice good" role="status">{t("Rule saved.", "Đã lưu quy tắc.")}</div>}
  {error && <div class="crm-notice bad" role="alert">{errors[error]?.[vi ? 1 : 0] ?? error}</div>}
  <form class="crm-form" method="post">
    {rule && <input type="hidden" name="version" value={rule.version} />}
    <PanelRow min="340px">
      <Panel title={t("1. When", "1. Khi nào")}>
        <div class="crm-field"><label for="r-name">{t("Rule name", "Tên quy tắc")} *</label><input class="crm-input" id="r-name" name="name" required maxlength="120" value={one("name")} /></div>
        <fieldset class="crm-fieldset"><legend>{t("CRM events", "Sự kiện CRM")} *</legend>
          <div class="crm-actions">{RULE_EVENTS.map((event) => <label class="crm-check"><input type="checkbox" name="events" value={event} checked={has("events", event)} /><span>{eventLabel(event, vi)}</span></label>)}</div>
        </fieldset>
      </Panel>
      <Panel title={t("2. Conditions", "2. Điều kiện")} note={t("All conditions must hold. A value condition never matches an unknown value.", "Thỏa mọi điều kiện. Điều kiện giá trị không khớp giá trị chưa biết.")}>
        <fieldset class="crm-fieldset"><legend>{t("Playbook (product)", "Playbook (sản phẩm)")}</legend>
          <div class="crm-actions">{playbooks.map((playbook) => <label class="crm-check"><input type="checkbox" name="playbooks" value={playbook.id} checked={has("playbooks", playbook.id)} /><span>{playbook.name}</span></label>)}</div>
          <p class="crm-help">{t("None chosen = every playbook.", "Không chọn = mọi playbook.")}</p>
        </fieldset>
        <div class="crm-field"><label for="r-value">{t("Expected value at least (₫)", "Giá trị mong đợi từ (₫)")}</label><input class="crm-input" id="r-value" name="min_value_vnd" inputmode="numeric" maxlength="20" value={one("min_value_vnd")} /></div>
        <div class="crm-field"><label for="r-outcome">{t("Outcome", "Kết quả")}</label><select class="crm-input" id="r-outcome" name="outcome">
          {[["", t("Any", "Bất kỳ")], ["open", t("Open", "Đang mở")], ["won", t("Won", "Thắng")], ["lost", t("Lost", "Mất")]].map(([value, text]) => <option value={value} selected={one("outcome") === value}>{text}</option>)}
        </select></div>
      </Panel>
    </PanelRow>
    <PanelRow min="340px">
      <Panel title={t("3. Channels", "3. Kênh")}>
        <label class="crm-check"><input type="checkbox" name="email" value="1" checked={has("email", "1")} /><span>{t("Email to each recipient, starting with their own anti-phishing code", "Email tới từng người nhận, bắt đầu bằng mã chống lừa đảo riêng của họ")}</span></label>
        <fieldset class="crm-fieldset"><legend>Webhook</legend>
          {destinations.length
            ? <div class="crm-actions">{destinations.map((destination) => <label class="crm-check"><input type="checkbox" name="destinations" value={destination.id} checked={has("destinations", destination.id)} /><span>{platformLabels[destination.platform]} · {destination.name}{destination.status !== "active" && ` (${t("paused", "tạm dừng")})`}</span></label>)}</div>
            : <p class="crm-help">{t("No webhooks yet.", "Chưa có Webhook.")} <a class="crm-link" href={localized("/workspace/webhooks", vi)}>{t("Add one", "Thêm Webhook")}</a></p>}
          <p class="crm-help">{t("A webhook posts one message to a shared channel, without anti-phishing codes. It shows what the Lark card shows: no contact phone numbers or emails.", "Webhook gửi một tin vào kênh chung, không kèm mã chống lừa đảo. Nội dung giống thẻ Lark: không có số điện thoại hay email liên hệ.")}</p>
        </fieldset>
      </Panel>
      <Panel title={t("4. Email recipients", "4. Người nhận email")} note={t("Internal Workspace members only. Each person receives only records their own CRM access lets them see.", "Chỉ thành viên Workspace nội bộ. Mỗi người chỉ nhận bản ghi mà quyền CRM của họ cho phép xem.")}>
        <label class="crm-check"><input type="checkbox" name="record_owner" value="1" checked={has("record_owner", "1")} /><span>{t("The record's owner", "Người phụ trách bản ghi")}</span></label>
        <label class="crm-check"><input type="checkbox" name="recipient_admins" value="1" checked={has("recipient_admins", "1")} /><span>{roleLabel("admin", vi)}</span></label>
        <fieldset class="crm-fieldset"><legend>{t("Roles", "Vai trò")}</legend><div class="crm-actions">{roles.map((role) => <label class="crm-check"><input type="checkbox" name="recipient_roles" value={role} checked={has("recipient_roles", role)} /><span>{roleLabel(role, vi)}</span></label>)}</div></fieldset>
        <div class="crm-field"><label for="r-users">{t("People", "Người dùng")}</label><select class="crm-input" id="r-users" name="recipient_users" multiple size="6">{people.map((person) => <option value={person.id} selected={has("recipient_users", person.id)}>{person.name}</option>)}</select></div>
      </Panel>
    </PanelRow>
    <div class="crm-actions">
      <label class="crm-check"><input type="radio" name="enabled" value="1" checked={one("enabled") !== "0"} /><span>{t("On", "Bật")}</span></label>
      <label class="crm-check"><input type="radio" name="enabled" value="0" checked={one("enabled") === "0"} /><span>{t("Off", "Tắt")}</span></label>
      <button class="crm-button" type="submit">{t("Save rule", "Lưu quy tắc")}</button><a class="crm-link" href={base}>{t("Back to rules", "Về danh sách")}</a>
    </div>
    <p class="crm-help">{t("Saving asks for your passkey if you have not verified in the last 5 minutes.", "Lưu sẽ hỏi passkey nếu bạn chưa xác thực trong 5 phút gần nhất.")}</p>
  </form>
</WorkspaceShell>
