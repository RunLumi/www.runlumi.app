---
import { isMaterialVariance } from "../../lib/finance/calculations";
import type { FinancePageData } from "./types";
import { financeLink, metricLabel, money, percent, selectedPlan, variance } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", report = data.aggregateReport ?? data.report, comparison = data.aggregatePlanReport ?? data.planReport;
const lastPeriod = data.comparisonPeriods?.at(-1) ?? data.period;
const revisionId = (!data.range || data.range === "month") && data.selectedActualRevisionId ? data.selectedActualRevisionId : data.state.periods.find(item => item.period === lastPeriod)?.authoritativeClosedRevisionId;
const revision = data.state.actualRevisions.find(item => item.id === revisionId);
const policy = revision?.reportingSnapshot?.book ?? selectedPlan(data)?.reportingSnapshot?.book ?? data.state.book;
const amountThreshold = policy?.varianceAmountThreshold ?? null, percentThreshold = policy?.variancePercentThresholdBps ?? null, configured = amountThreshold !== null || percentThreshold !== null;
const precision = policy?.precision ?? 0;
const keys = ["revenue", "direct_costs", "gross_profit", "operating_expenses", "operating_profit", "net_profit"];
const rows = keys.map(key => ({ key, actual: report?.metrics[key] ?? null, planned: comparison?.metrics[key] ?? null, material: isMaterialVariance(report?.metrics[key] ?? null, comparison?.metrics[key] ?? null, amountThreshold, percentThreshold), delta: variance(report?.metrics[key], comparison?.metrics[key], ["direct_costs", "operating_expenses"].includes(key) ? "lower" : "higher") }));
const material = rows.filter(row => row.material === true), compared = rows.filter(row => row.material !== null).length;
const criteria = [amountThreshold !== null ? `${money(amountThreshold, precision, vi)} ${policy?.currency}` : "", percentThreshold !== null ? percent(percentThreshold / 10000, vi) : ""].filter(Boolean).join(vi ? " hoặc " : " or ");
---
<section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Chênh lệch đáng chú ý" : "Material variances"}</h2><p>{configured ? `${vi ? "Ngưỡng độ lớn chênh lệch" : "Absolute variance threshold"}: ${criteria} · ${vi ? "Bản chính sách" : "Policy version"} ${policy?.version ?? "—"}` : (vi ? "Chưa cấu hình ngưỡng; chưa đánh giá mức độ đáng chú ý của chênh lệch." : "No thresholds are configured, so materiality is not assessed.")}</p></div>{configured && <span class="fn-badge">{material.length} {vi ? "chỉ tiêu" : "measures"}</span>}</div>
  {!configured ? <p class="fn-help">{vi ? "Thiết lập ngưỡng số tiền, tỷ lệ hoặc cả hai. Chính sách được ghim với bản chốt và bản xuất để giữ nguyên cách đánh giá lịch sử." : "Set an amount threshold, a percentage threshold or both. The policy is pinned with closed revisions and exports to preserve historical interpretation."} <a class="fn-link" href={financeLink(data, "settings")}>{vi ? "Mở thiết lập" : "Open settings"}</a></p>
    : compared === 0 ? <p class="fn-help">{vi ? "Chưa đủ số thực tế và kế hoạch để đánh giá. Nếu kế hoạch bằng 0, chỉ ngưỡng số tiền được áp dụng." : "Actuals and plan are not yet sufficient for assessment. When the plan is zero, only an amount threshold applies."}</p>
    : material.length === 0 ? <p class="fn-help">{vi ? "Không có chỉ tiêu đủ dữ liệu nào đạt ngưỡng đã cấu hình." : "No measure with sufficient inputs meets the configured thresholds."}</p>
    : <div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Chênh lệch đạt ngưỡng" : "Variances meeting the threshold"}><table class="fn-table"><thead><tr><th>{vi ? "Chỉ tiêu" : "Measure"}</th><th class="num">{vi ? "Kế hoạch" : "Plan"}</th><th class="num">{vi ? "Thực tế" : "Actual"}</th><th class="num">{vi ? "Chênh lệch" : "Difference"}</th><th class="num">%</th><th>{vi ? "Ý nghĩa" : "Direction"}</th></tr></thead><tbody>{material.map(row => <tr><th><a class="fn-link" href={financeLink(data, row.key === "revenue" ? "revenue" : ["direct_costs", "operating_expenses"].includes(row.key) ? "costs" : "pnl")}>{metricLabel(row.key, vi)}</a></th><td class="num">{money(row.planned, precision, vi)}</td><td class="num">{money(row.actual, precision, vi)}</td><td class="num">{money(row.delta.difference, precision, vi)}</td><td class="num">{percent(row.delta.percentage, vi)}</td><td><span class:list={["fn-badge", row.delta.favorable === true ? "good" : row.delta.favorable === false ? "bad" : ""]}>{row.delta.favorable === true ? (vi ? "Thuận lợi" : "Favorable") : row.delta.favorable === false ? (vi ? "Bất lợi" : "Adverse") : (vi ? "Trung tính" : "Neutral")}</span></td></tr>)}</tbody></table></div>}
  {configured && <p class="fn-footnote">{vi ? "Chỉ cần đạt một ngưỡng đang cấu hình. Tỷ lệ dùng trị tuyệt đối của kế hoạch; không xác định khi kế hoạch bằng 0. Chỉ tiêu thiếu số liệu không được coi là không có chênh lệch." : "Meeting either configured threshold is sufficient. Percentage uses the absolute plan and is undefined for a zero plan. Missing measures are not treated as having no variance."}</p>}
</section>
