---
import type { FinancePageData } from "./types";
import CommandFields from "./CommandFields.astro";
import FactFields from "./FactFields.astro";
import SourceFields from "./SourceFields.astro";
import CashObservations from "./CashObservations.astro";
import FinanceChecks from "./FinanceChecks.astro";
import FinanceImports from "./FinanceImports.astro";
import FinanceAnnotation from "./FinanceAnnotation.astro";
import { financeLink, groupLabel, inputValue, lineLabel, money, monthLabel, selectedContext, selectedRevision, stateLabel, timestamp } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", revision = selectedRevision(data), context = selectedContext(data, "actual");
const period = data.state.periods.find(item => item.period === data.period), future = data.period > data.currentPeriod;
const values = data.state.actualValues.filter(item => item.actualRevisionId === revision?.id), revisions = data.state.actualRevisions.filter(item => item.period === data.period);
const precision = data.state.book?.precision ?? 0;
---
<nav class="fn-periods" aria-label={vi ? "Các tháng trong năm tài chính" : "Fiscal-year months"}>{data.months.map(month => {
  const row = data.state.periods.find(item => item.period === month);
  const label = row?.workingRevisionId ? "draft" : row?.authoritativeClosedRevisionId ? "closed" : "missing";
  return <a class="fn-period" href={financeLink(data, "actuals", { period: month, revision: undefined })} aria-current={month === data.period ? "date" : undefined}><span>{monthLabel(month, vi)}</span><span class:list={["fn-badge", label === "closed" ? "good" : ""]}>{month > data.currentPeriod ? (vi ? "Chưa đến kỳ" : "Future") : stateLabel(label, vi)}</span></a>;
})}</nav>
{future && <div class="fn-notice warn"><strong>{vi ? "Chưa thể nhập số thực tế cho tháng tương lai" : "Actuals are not available for a future month"}</strong><p>{vi ? "Dùng Kế hoạch để nhập dự kiến. Bản nháp thực tế được mở từ tháng hiện tại trở về trước." : "Use Plans for future estimates. Actual drafts can be opened for the current month and earlier."}</p></div>}
{!revision ? <section class="fn-empty"><p class="fn-eyebrow">{monthLabel(data.period, vi, true)}</p><h2>{vi ? "Chưa có số thực tế của tháng" : "No actuals for this month yet"}</h2><p>{vi ? "Mở một bản nháp để nhập lãi lỗ, thu chi, công nợ và số dư. Bạn có thể lưu từng bước trước khi chốt tháng." : "Open a draft for profit and loss, cash movements, working capital and balances. Save your progress before closing the complete month."}</p><form method="post"><CommandFields intent="actual.open" fields={{ period: data.period, expected_period_version: period?.version ?? 0 }} /><button class="fn-button" type="submit" disabled={future}>{vi ? "Mở bản nháp tháng" : "Open monthly draft"}</button></form></section>
  : <div class="fn-stack">
    <div class="fn-sheet"><div class="fn-sheet-head"><div><h2>{monthLabel(data.period, vi, true)}</h2><p>{vi ? "Phiên bản" : "Revision"} <span class="fn-mono">{revision.id}</span> · v{revision.version}</p></div><span class:list={["fn-badge", revision.state === "closed" ? "good" : "info"]}>{stateLabel(revision.state, vi)}</span></div>
      {revision.stale && <div class="fn-notice bad"><strong>{vi ? "Nguồn tháng trước đã được thay thế" : "A previous source revision has changed"}</strong><p>{vi ? "Cần mở lại và đối chiếu chuỗi số dư trước khi coi báo cáo này là đã khớp." : "Reopen and reconcile the balance chain before treating this report as current and reconciled."}</p></div>}
      {period?.workingRevisionId && period.authoritativeClosedRevisionId && <p class="fn-help">{vi ? "Tháng này đang điều chỉnh. Phiên bản đã chốt trước đó vẫn được giữ để đối chiếu." : "This month is under restatement. The previous closed revision remains available for comparison."}</p>}
      {revisions.length > 1 && <form method="get" class="fn-toolbar" style="margin-bottom:0"><input type="hidden" name="year" value={data.fiscalYear} /><input type="hidden" name="period" value={data.period} />{data.selectedPlanId && <input type="hidden" name="plan" value={data.selectedPlanId} />}<div class="fn-field fn-grow"><label for="actual-revision">{revisions.length >= 100 ? (vi ? "100 phiên bản gần nhất" : "Latest 100 revisions") : (vi ? "Xem phiên bản" : "View revision")}</label><select class="fn-select" id="actual-revision" name="revision">{revisions.map(item => <option value={item.id} selected={item.id === revision.id}>{stateLabel(item.state, vi)} · {timestamp(item.closedAt ?? item.createdAt, vi, data.state.book?.timezone)}{item.id === period?.authoritativeClosedRevisionId ? ` · ${vi ? "Bản chốt hiện hành" : "Current close"}` : ""}</option>)}</select></div><button class="fn-button secondary" type="submit">{vi ? "Xem phiên bản" : "View revision"}</button></form>}
    </div>
    <div class="fn-layout"><div class="fn-stack">
      {revision.state === "draft" ? <form method="post" class="fn-sheet"><CommandFields intent="actual.save" fields={{ actual_revision_id: revision.id, expected_version: revision.version, expected_period_version: period?.version ?? 0 }} /><div class="fn-sheet-head"><div><h2>{vi ? "Nhập số thực tế" : "Enter monthly actuals"}</h2><p>{vi ? "Các báo cáo cùng sử dụng số liệu tại đây." : "These inputs feed every financial report."}</p></div></div><SourceFields data={data} sources={revision.sources} /><div class="fn-divider"></div><FactFields data={data} values={values} kind="actual" /><div class="fn-divider"></div><CashObservations data={data} /><div class="fn-form-actions"><button class="fn-button" type="submit">{vi ? "Lưu bản nháp tháng" : "Save monthly draft"}</button><p>{vi ? "Bản nháp được phép còn thiếu dữ liệu. Chốt tháng là bước riêng." : "A draft may contain missing inputs. Closing the month is a separate step."}</p></div></form>
      : <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Số liệu đã chốt" : "Closed inputs"}</h2><p>{vi ? "Đã chốt lúc" : "Closed"} {timestamp(revision.closedAt, vi, data.state.book?.timezone)} · {vi ? "Nguồn đến ngày" : "Source as of"} {revision.sources.sourceAsOf || "—"}</p></div></div>{["pnl", "cash", "position", "aging", "control"].map(basis => {
        const rows = values.filter(value => context.lines.find(line => line.code === value.lineCode)?.basis === basis);
        return rows.length > 0 && <details class="fn-disclosure" open={basis === "pnl"}><summary>{groupLabel(basis, vi)}</summary><div class="fn-disclosure-body"><div class="fn-table-scroll" tabindex="0" aria-label={groupLabel(basis, vi)}><table class="fn-table"><thead><tr><th>{vi ? "Khoản mục" : "Line"}</th><th class="num">{data.state.book?.currency}</th><th>{vi ? "Giải trình / nguồn" : "Explanation / evidence"}</th></tr></thead><tbody>{rows.map(value => { const line = context.lines.find(item => item.code === value.lineCode)!; return <tr><td>{lineLabel(line, vi)}<small>{value.segmentCode}</small></td><td class="num">{value.state === "not_applicable" ? (vi ? "Không áp dụng" : "N/A") : money(value.amount, precision, vi)}</td><td>{value.note || "—"}<small>{value.evidenceRef}</small></td></tr>; })}</tbody></table></div></div></details>;
      })}<p class="fn-footnote">{vi ? "Phạm vi nguồn" : "Source scope"}: {revision.sources.scope || "—"}</p></section>}
      <FinanceAnnotation data={data} />
    </div><aside class="fn-stack"><FinanceChecks data={data} />
      {revision.state === "draft" && <section class="fn-sheet"><h2>{vi ? "Chốt tháng" : "Close the month"}</h2><p class="fn-help">{vi ? "Chỉ chốt sau khi tháng kết thúc, dữ liệu đã đầy đủ và mọi đối chiếu khớp. Lưu các ô đang chỉnh trước khi chốt." : "Close after month end, with complete inputs and reconciled checks. Save any inputs you are editing first."}</p><form method="post"><CommandFields intent="actual.close" fields={{ actual_revision_id: revision.id, expected_version: revision.version, expected_period_version: period?.version ?? 0 }} /><button class="fn-button" type="submit" disabled={!data.report?.canClose}>{vi ? "Chốt phiên bản tháng" : "Close this revision"}</button></form></section>}
      {revision.state === "closed" && revision.id === period?.authoritativeClosedRevisionId && !period.workingRevisionId && <section class="fn-sheet"><h2>{vi ? "Điều chỉnh sau khi chốt" : "Restate a closed month"}</h2><p class="fn-help">{vi ? "Mở lại tạo một bản nháp mới, giữ nguyên phiên bản này và các bản xuất cũ." : "Reopening creates a new draft and preserves this revision and its existing exports."}</p><form method="post"><CommandFields intent="actual.reopen" fields={{ period: data.period, expected_period_version: period.version }} /><div class="fn-field"><label for="reopen-reason">{vi ? "Lý do mở lại" : "Reason for reopening"}</label><textarea class="fn-textarea" id="reopen-reason" name="reason" required maxlength="1000">{inputValue(data, "reason")}</textarea></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Tạo bản điều chỉnh" : "Create a restatement"}</button></div></form></section>}
      <section class="fn-sheet"><h3>{vi ? "Tiếp tục đối chiếu" : "Continue the review"}</h3><ul class="fn-list"><li><a class="fn-link" href={financeLink(data, "pnl")}>{vi ? "Báo cáo lãi lỗ" : "Profit and loss"}</a></li><li><a class="fn-link" href={financeLink(data, "cash-flow")}>{vi ? "Dòng tiền và số dư" : "Cash flow and balances"}</a></li><li><a class="fn-link" href={financeLink(data, "position")}>{vi ? "Cân đối tài chính" : "Financial position"}</a></li><li><a class="fn-link" href={financeLink(data, "audit")}>{vi ? "Lịch sử thay đổi" : "Audit history"}</a></li></ul></section>
    </aside></div>
    <FinanceImports data={data} kind="actual" />
  </div>}
