---
import { formatMoneyInput } from "../../lib/finance/calculations";
import type { FinancePageData } from "./types";
import { inputValue, selectedContext, selectedRevision } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", revision = selectedRevision(data);
const context = selectedContext(data, "actual"), precision = data.state.book?.precision ?? 0;
const accounts = context.accounts.filter(account => account.activeFrom <= data.period && (!account.activeTo || account.activeTo >= data.period));
const observations = data.state.observations.filter(observation => observation.actualRevisionId === revision?.id);
const kinds = data.period === data.state.book?.firstPeriod ? ["opening", "closing"] as const : ["closing"] as const;
---
<fieldset class="fn-form-section">
  <legend>{vi ? "Số dư tài khoản tiền" : "Cash account observations"}</legend>
  <p class="fn-help">{vi ? "Nhập số dư từ nguồn đã đối chiếu. Tiền bị hạn chế là một phần của số dư tiền, không phải dòng chi. Số dư vay hoặc thấu chi được phân loại riêng. Nguồn cuối kỳ phải đúng ngày cuối tháng; nguồn đầu kỳ đầu tiên đúng ngày đầu tháng." : "Enter balances from reconciled source records. Restricted cash is part of the balance, not an outflow. Borrowings and overdrafts are classified separately. Closing sources must be dated at month end; initial opening sources at the first day of the month."}</p>
  {revision?.openingSourceRevisionId && <p class="fn-help">{vi ? "Tiền đầu kỳ kế thừa phiên bản đã chốt của tháng trước." : "Opening cash is carried from the previous month’s closed revision."} <span class="fn-mono">{revision.openingSourceRevisionId}</span></p>}
  {accounts.length === 0 && <div class="fn-notice warn">{vi ? "Chưa có tài khoản tiền hoạt động trong tháng này. Thêm tài khoản trong Thiết lập trước khi chốt tháng." : "There is no active cash account in this month. Add an account in Settings before closing the period."}</div>}
  {accounts.map(account => <details class="fn-disclosure" open><summary><span>{account.label}</span><span class="fn-mono">{account.code}</span></summary><div class="fn-disclosure-body fn-stack">{kinds.map(kind => {
    const observation = observations.find(item => item.accountCode === account.code && item.kind === kind), prefix = `balance.${account.code}.${kind}`, id = `balance-${account.code}-${kind}`;
    return <fieldset class="fn-form-section"><legend>{kind === "opening" ? (vi ? "Số dư đầu kỳ đầu tiên" : "Initial opening balance") : (vi ? "Số dư cuối tháng" : "Month-end closing balance")}</legend><div class="fn-form-grid three"><div class="fn-field"><label for={`${id}-amount`}>{vi ? "Số dư" : "Balance"} · {data.state.book?.currency}</label><input class="fn-input fn-money-input" id={`${id}-amount`} name={`${prefix}.amount`} inputmode="decimal" value={inputValue(data, `${prefix}.amount`, observation?.amount == null ? "" : formatMoneyInput(observation.amount, precision))} /></div><div class="fn-field"><label for={`${id}-restricted`}>{vi ? "Trong đó tiền bị hạn chế" : "Restricted portion"}</label><input class="fn-input fn-money-input" id={`${id}-restricted`} name={`${prefix}.restricted`} inputmode="decimal" value={inputValue(data, `${prefix}.restricted`, observation?.restrictedAmount == null ? "" : formatMoneyInput(observation.restrictedAmount, precision))} /></div><div class="fn-field"><label for={`${id}-classification`}>{vi ? "Phân loại" : "Classification"}</label><select class="fn-select" id={`${id}-classification`} name={`${prefix}.classification`}><option value="cash" selected={inputValue(data, `${prefix}.classification`, observation?.classification ?? "cash") === "cash"}>{vi ? "Tiền" : "Cash"}</option><option value="borrowing" selected={inputValue(data, `${prefix}.classification`, observation?.classification ?? "cash") === "borrowing"}>{vi ? "Vay / thấu chi" : "Borrowing / overdraft"}</option></select></div><div class="fn-field"><label for={`${id}-date`}>{vi ? "Ngày của số dư nguồn" : "Balance as of"}</label><input class="fn-input" id={`${id}-date`} type="date" name={`${prefix}.as_of`} value={inputValue(data, `${prefix}.as_of`, observation?.asOfDate ?? "")} /></div><div class="fn-field wide"><label for={`${id}-evidence`}>{vi ? "Nguồn đối chiếu số dư" : "Balance evidence"}</label><input class="fn-input" id={`${id}-evidence`} name={`${prefix}.evidence`} value={inputValue(data, `${prefix}.evidence`, observation?.evidenceRef ?? "")} maxlength="300" /></div></div></fieldset>;
  })}</div></details>)}
</fieldset>
