---
interface Props { intent: string; fields?: Record<string, string | number | boolean | null | undefined> }
const { intent, fields = {} } = Astro.props;
---
<input type="hidden" name="intent" value={intent} />
<input type="hidden" name="request_key" value={crypto.randomUUID()} />
<input type="hidden" name="return_to" value={`${Astro.url.pathname}${Astro.url.search}`} />
{Object.entries(fields).filter(([, value]) => value !== undefined && value !== null).map(([name, value]) => <input type="hidden" name={name} value={String(value)} />)}
