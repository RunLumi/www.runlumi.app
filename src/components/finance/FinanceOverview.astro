---
import { financeReportView } from "../../lib/finance/reports";
import type { FinancePageData } from "./types";
import MetricCards from "./MetricCards.astro";
import FinanceExceptions from "./FinanceExceptions.astro";
import { financeLink, metricLabel, money, monthLabel, selectedPlan, selectedRevision, stateLabel, variance } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", precision = data.state.book?.precision ?? 0;
const report = data.aggregateReport ?? data.report, comparison = data.aggregatePlanReport ?? data.planReport, plan = selectedPlan(data);
const ytdView = financeReportView(data.state, { fiscalYear: data.fiscalYear, period: data.period, planId: data.selectedPlanId }, { lang: data.lang, range: "ytd", segmentCode: data.segmentCode ?? "all", now: data.generatedAt });
const prefix = ytdView.comparisonPeriods, ytd = ytdView.aggregateReport, ytdPlan = ytdView.aggregatePlanReport;
const bookReport = data.segmentCode && data.segmentCode !== "all" ? financeReportView(data.state, { fiscalYear: data.fiscalYear, period: data.period }, { lang: data.lang, segmentCode: "all", now: data.generatedAt }).report : data.report;
const closedCount = data.months.filter(month => data.state.periods.find(item => item.period === month)?.authoritativeClosedRevisionId).length;
const draftCount = data.months.filter(month => data.state.periods.find(item => item.period === month)?.workingRevisionId).length;
const staleCount = data.state.actualRevisions.filter(item => item.stale && data.months.includes(item.period) && data.state.periods.find(period => period.period === item.period)?.authoritativeClosedRevisionId === item.id).length;
const missing = report?.completeness.missing.length ?? 0;
const available = data.report?.metrics.cash_available, floor = (selectedRevision(data)?.reportingSnapshot?.book ?? data.state.book)?.cashFloor;
const alertCash = available != null && floor != null && available < floor;
const paths = [{ key: "pnl", en: "Profit and loss", vi: "Lãi lỗ", copyEn: "Revenue, margins and the final result.", copyVi: "Doanh thu, biên lợi nhuận và kết quả cuối cùng." }, { key: "cash-flow", en: "Cash flow", vi: "Dòng tiền", copyEn: "Movements, cash observations and forecast.", copyVi: "Thu chi, số dư quan sát và dự báo." }, { key: "working-capital", en: "Working capital", vi: "Vốn lưu động", copyEn: "Receivable and payable aging.", copyVi: "Tuổi nợ phải thu và phải trả." }, { key: "position", en: "Financial position", vi: "Tình hình tài chính", copyEn: "Assets, obligations and equity checks.", copyVi: "Tài sản, nghĩa vụ và kiểm tra vốn chủ." }] as const;
---
<div class="fn-sheet-head"><div><h2>{data.comparisonLabel ?? monthLabel(data.period, vi, true)}</h2><p>{plan ? `${plan.label} · ${stateLabel(plan.kind, vi)} · ${stateLabel(plan.state, vi)}` : (vi ? "Chưa có kế hoạch gốc được chọn" : "No baseline selected")}</p></div><span class:list={["fn-badge", report?.completeness.complete && !report.stale ? "good" : "warn"]}>{report?.completeness.complete && !report.stale ? (vi ? "Đủ đầu vào" : "Inputs complete") : (vi ? "Số liệu chưa đầy đủ" : "Inputs incomplete")}</span></div>
<MetricCards data={data} report={report} comparison={comparison} metrics={["revenue", "gross_profit", "operating_profit", "cash_available"]} />
<div class="fn-stack">
  <FinanceExceptions data={data} />
  <div class="fn-layout"><section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Ưu tiên kiểm tra" : "Review priorities"}</h2><p>{vi ? "Bắt đầu từ độ đầy đủ của nguồn và khả năng đối chiếu tiền." : "Start with source completeness and cash reconciliation."}</p></div></div><ul class="fn-list">
    {alertCash && <li><div class="fn-list-title"><span>{vi ? "Tiền không bị hạn chế đang dưới ngưỡng" : "Unrestricted cash is below the floor"}</span><span class="fn-badge bad">{vi ? "Cần xem" : "Review"}</span></div><p>{money(available, precision, vi)} / {money(floor, precision, vi)} {data.state.book?.currency}</p><a class="fn-link" href={financeLink(data, "cash-flow")}>{vi ? "Mở dòng tiền" : "Review cash flow"}</a></li>}
    {staleCount > 0 && <li><div class="fn-list-title"><span>{vi ? "Có nguồn đã được điều chỉnh" : "Restated sources need attention"}</span><span class="fn-badge bad">{staleCount} {vi ? "phiên bản" : "revisions"}</span></div><p>{vi ? "Kiểm tra chuỗi số dư đầu kỳ phụ thuộc trước khi sử dụng báo cáo đã chốt." : "Review dependent opening balances before relying on closed reports."}</p><a class="fn-link" href={financeLink(data, "actuals")}>{vi ? "Đối chiếu lại tháng" : "Review monthly actuals"}</a></li>}
    <li><div class="fn-list-title"><span>{vi ? "Dữ liệu kỳ đang xem" : "Selected-period inputs"}</span><span class:list={["fn-badge", report?.completeness.complete ? "good" : "warn"]}>{report?.completeness.complete ? (vi ? "Đầy đủ" : "Complete") : (vi ? "Còn thiếu" : "Incomplete")}</span></div><p>{report ? `${report.completeness.entered + report.completeness.notApplicable} / ${report.completeness.expected} ${vi ? "ô đã được nhập hoặc xác nhận không áp dụng" : "inputs entered or marked not applicable"}${missing ? ` · ${missing} ${vi ? "ô còn thiếu" : "missing"}` : ""}.` : (vi ? "Chưa có số thực tế đã chốt trong kỳ đang chọn." : "No closed actuals are available in the selected period.")}</p><a class="fn-link" href={financeLink(data, "actuals")}>{vi ? "Tiếp tục nhập số liệu" : "Continue entering actuals"}</a></li>
    <li><div class="fn-list-title"><span>{vi ? "Đối chiếu tiền và số dư" : "Cash and balance reconciliation"}</span><span class:list={["fn-badge", bookReport?.reconciled && !bookReport.stale ? "good" : "warn"]}>{bookReport?.reconciled && !bookReport.stale ? (vi ? "Đã khớp" : "Reconciled") : (vi ? "Cần kiểm tra" : "Needs review")}</span></div><p>{vi ? "Chênh lệch phải được giải thích từ nguồn; không tự bù số liệu thiếu." : "Resolve differences against source records; missing figures are never auto-balanced."}</p></li>
    {!plan && <li><div class="fn-list-title"><span>{vi ? "Thiết lập kế hoạch đối chiếu" : "Choose a comparison plan"}</span><span class="fn-badge">{vi ? "Chưa chọn" : "Not selected"}</span></div><p>{vi ? "Công bố kế hoạch gốc để theo dõi thực tế so với cam kết ban đầu." : "Publish a baseline to compare actual performance with the original plan."}</p><a class="fn-link" href={financeLink(data, "plans")}>{vi ? "Mở kế hoạch tài chính" : "Open financial plans"}</a></li>}
  </ul></section><aside class="fn-stack"><section class="fn-sheet"><h2>{vi ? "Tiến độ năm tài chính" : "Fiscal-year progress"}</h2><dl class="fn-dl"><div><dt>{vi ? "Tháng có bản đã chốt" : "Months with a closed revision"}</dt><dd>{closedCount} / 12</dd></div><div><dt>{vi ? "Tháng đang có bản nháp" : "Months with a working draft"}</dt><dd>{draftCount}</dd></div><div><dt>{vi ? "Tháng đầu tiên của sổ" : "Book reporting start"}</dt><dd>{monthLabel(data.state.book?.firstPeriod ?? "", vi)}</dd></div><div><dt>{vi ? "Ngưỡng tiền mặt" : "Cash floor"}</dt><dd>{floor == null ? (vi ? "Chưa cấu hình" : "Not configured") : `${money(floor, precision, vi)} ${data.state.book?.currency}`}</dd></div></dl><div class="fn-form-actions"><a class="fn-button secondary" href={financeLink(data, "plans")}>{vi ? "Cập nhật kế hoạch" : "Update plans"}</a></div></section><section class="fn-sheet"><h3>{vi ? "Một nguồn số liệu" : "One set of inputs"}</h3><p class="fn-help">{vi ? "Các trang lãi lỗ, doanh thu, chi phí và dòng tiền đọc cùng số liệu tháng. Chỉnh số liệu tại Số thực tế tháng hoặc Kế hoạch, sau đó xem lại báo cáo." : "Profit and loss, revenue, costs and cash flow read the same monthly facts. Edit Monthly actuals or Plans, then review the reports."}</p></section></aside></div>
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{data.state.book && data.state.book.firstPeriod > data.months[0] ? (vi ? "Lũy kế từ kỳ bắt đầu báo cáo" : "Since reporting start") : (vi ? "Lũy kế từ đầu năm tài chính" : "Fiscal year to date")}</h2><p>{ytdView.comparisonLabel}</p></div></div>{prefix.length === 0 && <div class="fn-notice warn">{vi ? "Tháng còn thiếu không được coi là 0 và không làm bắt đầu lại mốc lũy kế. Nếu sổ bắt đầu giữa năm, năm đầu chỉ có số liệu từ kỳ bắt đầu. Chọn kỳ bắt đầu sớm nhất khi thiết lập; mở rộng về trước cần thay đổi dữ liệu được xem xét riêng." : "Missing months are not zero and do not restart the year-to-date interval. A midyear reporting start keeps the first year partial. Choose the earliest reporting month during setup; extending it earlier requires a separately reviewed data migration."}</div>}<div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Lũy kế tài chính" : "Year-to-date results"}><table class="fn-table"><thead><tr><th>{vi ? "Chỉ tiêu" : "Measure"}</th><th class="num">{vi ? "Kế hoạch cùng kỳ" : "Same-period plan"}</th><th class="num">{vi ? "Thực tế đã chốt" : "Closed actuals"}</th><th class="num">{vi ? "Chênh lệch" : "Difference"}</th></tr></thead><tbody>{["revenue", "gross_profit", "operating_profit", "net_profit"].map(key => { const delta = variance(ytd?.metrics[key], ytdPlan?.metrics[key], "higher"); return <tr><th>{metricLabel(key, vi)}</th><td class="num">{money(ytdPlan?.metrics[key], precision, vi)}</td><td class="num">{money(ytd?.metrics[key], precision, vi)}</td><td class:list={["num", delta.favorable === true && "fn-good", delta.favorable === false && "fn-bad"]}>{money(delta.difference, precision, vi)}</td></tr>; })}</tbody></table></div></section>
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Thực tế và kế hoạch theo tháng" : "Monthly actual and plan"}</h2><p>{vi ? "Doanh thu ghi nhận cùng tiền khả dụng cuối tháng; tiền thu khách hàng có báo cáo riêng." : "Recognized revenue alongside month-end available cash; customer collections have their own cash report."}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Theo dõi tài chính theo tháng" : "Monthly financial review"}><table class="fn-table"><thead><tr><th>{vi ? "Tháng" : "Month"}</th><th class="num">{vi ? "Doanh thu kế hoạch" : "Planned revenue"}</th><th class="num">{vi ? "Doanh thu thực tế" : "Actual revenue"}</th><th class="num">{vi ? "Lợi nhuận hoạt động" : "Operating profit"}</th><th class="num">{vi ? "Tiền không bị hạn chế" : "Unrestricted cash"}</th><th>{vi ? "Trạng thái" : "Status"}</th></tr></thead><tbody>{data.months.map(month => { const actual = data.reports?.find(item => item.period === month), planned = data.planReports?.find(item => item.period === month); return <tr><th><a class="fn-link" href={financeLink(data, "actuals", { period: month })}>{monthLabel(month, vi)}</a></th><td class="num">{money(planned?.metrics.revenue, precision, vi)}</td><td class="num">{money(actual?.metrics.revenue, precision, vi)}</td><td class="num">{money(actual?.metrics.operating_profit, precision, vi)}</td><td class="num">{money(actual?.metrics.cash_available, precision, vi)}</td><td><span class:list={["fn-badge", actual?.sourceState === "closed" && !actual.stale ? "good" : ""]}>{actual?.sourceState === "closed" ? stateLabel("closed", vi) : data.state.periods.find(item => item.period === month)?.workingRevisionId ? (vi ? "Bản nháp chưa chốt" : "Unclosed draft") : (vi ? "Chưa có số chốt" : "No closed actuals")}</span></td></tr>; })}</tbody></table></div></section>
  <div class="fn-layout equal">{paths.map(path => <section class="fn-sheet"><h2>{vi ? path.vi : path.en}</h2><p class="fn-help">{vi ? path.copyVi : path.copyEn}</p><a class="fn-link" href={financeLink(data, path.key)}>{vi ? "Mở báo cáo" : "Open report"} →</a></section>)}</div>
</div>
