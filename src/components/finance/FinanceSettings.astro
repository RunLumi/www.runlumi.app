---
import { formatMoneyInput } from "../../lib/finance/calculations";
import type { FinancePageData } from "./types";
import CommandFields from "./CommandFields.astro";
import { costBehaviorLabel, groupLabel, inputValue, lineLabel, stateLabel } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", book = data.state.book;
const definition = data.state.definitions.find(item => item.fiscalYear === data.fiscalYear);
const definitionHasFacts = data.state.planValues.some(value => data.months.includes(value.period)) || data.state.actualValues.some(value => data.state.actualRevisions.some(revision => revision.id === value.actualRevisionId && revision.definitionSetId === definition?.id));
const frozen = definition?.state === "published" || definitionHasFacts;
const lines = definition?.lines ?? data.state.lines, segments = definition?.segments ?? data.state.segments;
const hasData = data.state.plans.length > 0 || data.state.periods.length > 0;
---
<div class="fn-stack">
  {!book && <div class="fn-notice"><strong>{vi ? "Thiết lập một sổ quản trị tài chính" : "Set up one management finance book"}</strong><p>{vi ? "Các giá trị mặc định là gợi ý ban đầu. Xác nhận đúng doanh nghiệp và chính sách trước khi nhập dữ liệu. Không có số liệu tài chính mẫu được thêm tự động." : "Defaults are starting suggestions. Confirm the entity and policies before entering data. No sample financial amounts are added."}</p></div>}
  {book && !book.enabled && <div class="fn-notice warn"><strong>{vi ? "Finance đang tắt" : "Finance is disabled"}</strong><p>{vi ? "Bạn vẫn có thể hoàn tất thiết lập tại đây. Bật Finance khi sổ và chính sách đã sẵn sàng." : "You can finish setup here. Enable Finance when the book and its policies are ready."}</p></div>}
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Sổ và chính sách báo cáo" : "Book and reporting policies"}</h2><p>{vi ? "Một doanh nghiệp, một tiền tệ cơ sở, báo cáo theo tháng." : "One reporting entity, one base currency, monthly reporting."}</p></div></div><form method="post"><CommandFields intent="book.save" fields={{ expected_version: book?.version ?? 0 }} /><div class="fn-form-grid three">
    <div class="fn-field wide"><label for="book-entity">{vi ? "Tên doanh nghiệp / phạm vi báo cáo" : "Reporting entity / scope name"}</label><input class="fn-input" id="book-entity" name="legal_entity" maxlength="200" value={inputValue(data, "legal_entity", book?.entityName ?? "")} required /></div>
    <div class="fn-field"><label for="book-currency">{vi ? "Tiền tệ cơ sở" : "Base currency"}</label><input class="fn-input" id="book-currency" name="currency" minlength="3" maxlength="3" pattern="[A-Z]{3}" value={inputValue(data, "currency", book?.currency ?? "VND")} readonly={hasData} required /><small>{vi ? "Mã ISO viết hoa, ví dụ VND." : "Uppercase ISO code, for example VND."}</small></div>
    <div class="fn-field"><label for="book-precision">{vi ? "Chữ số thập phân" : "Decimal places"}</label><input class="fn-input" id="book-precision" name="precision" type="number" min="0" max="6" value={inputValue(data, "precision", book?.precision ?? 0)} readonly={hasData} required /><small>{vi ? "VND mặc định không có phần thập phân." : "VND defaults to no decimal places."}</small></div>
    <div class="fn-field"><label for="book-fiscal">{vi ? "Tháng bắt đầu năm tài chính" : "Fiscal year starting month"}</label><input class="fn-input" id="book-fiscal" type="number" name="fiscal_start_month" min="1" max="12" value={inputValue(data, "fiscal_start_month", book?.fiscalStartMonth ?? 1)} readonly={hasData} required /></div>
    <div class="fn-field"><label for="book-timezone">{vi ? "Múi giờ báo cáo" : "Reporting time zone"}</label><input class="fn-input" id="book-timezone" name="timezone" maxlength="80" value={inputValue(data, "timezone", book?.timezone ?? "Asia/Ho_Chi_Minh")} readonly={hasData} required /><small>{vi ? "Dùng để xác định khi nào một tháng kết thúc." : "Determines when a reporting month has ended."}</small></div>
    <div class="fn-field"><label for="book-first">{vi ? "Tháng báo cáo đầu tiên" : "First reporting month"}</label><input class="fn-input" id="book-first" type="month" name="first_period" value={inputValue(data, "first_period", book?.firstPeriod ?? data.currentPeriod)} readonly={hasData} required /></div>
    <div class="fn-field"><label for="book-floor">{vi ? "Ngưỡng tiền mặt tối thiểu" : "Minimum cash floor"}</label><input class="fn-input fn-money-input" id="book-floor" name="cash_floor" inputmode="decimal" value={inputValue(data, "cash_floor", book?.cashFloor == null ? "" : formatMoneyInput(book.cashFloor, book.precision))} /><small>{vi ? "Để trống nếu chưa xác định; không tự coi là 0." : "Leave blank if unconfigured; it will not be treated as zero."}</small></div>
    <div class="fn-field"><label for="book-variance-amount">{vi ? "Ngưỡng chênh lệch theo số tiền" : "Variance amount threshold"}</label><input class="fn-input fn-money-input" id="book-variance-amount" name="variance_amount_threshold" inputmode="decimal" value={inputValue(data, "variance_amount_threshold", book?.varianceAmountThreshold == null ? "" : formatMoneyInput(book.varianceAmountThreshold, book.precision))} /><small>{vi ? "Giá trị không âm theo tiền tệ cơ sở; để trống nếu không dùng." : "Nonnegative amount in the base currency; leave blank to disable."}</small></div>
    <div class="fn-field"><label for="book-variance-percent">{vi ? "Ngưỡng chênh lệch theo tỷ lệ (%)" : "Variance percentage threshold (%)"}</label><input class="fn-input fn-money-input" id="book-variance-percent" name="variance_percent_threshold" inputmode="decimal" value={inputValue(data, "variance_percent_threshold", book?.variancePercentThresholdBps == null ? "" : formatMoneyInput(book.variancePercentThresholdBps, 2))} /><small>{vi ? "Ví dụ 10 cho 10%. Chỉ cần đạt ngưỡng số tiền hoặc tỷ lệ để được đánh dấu." : "For example, 10 means 10%. Meeting either the amount or percentage threshold triggers a flag."}</small></div>
    <div class="fn-field wide"><label for="book-policy">{vi ? "Chính sách ghi nhận và phân bổ" : "Recognition and allocation policy"}</label><textarea class="fn-textarea" id="book-policy" name="policy_note" maxlength="4000" rows="5" required placeholder={vi ? "Mô tả cách ghi nhận doanh thu, chi phí trực tiếp, chi phí dùng chung và khoản thu hộ/chi hộ." : "Describe revenue recognition, direct and shared cost allocation, and pass-through treatment."}>{inputValue(data, "policy_note", book?.policyNote ?? "")}</textarea></div>
    <div class="wide"><label class="fn-check"><input type="checkbox" name="enabled" value="true" checked={data.submitted?.intent === "book.save" ? data.submitted.enabled === "true" : book?.enabled === true} /><span>{vi ? "Bật Finance cho System Super Admin" : "Enable Finance for System Super Admin"}<small class="fn-help" style="display:block">{vi ? "Chỉ Super Admin được mở trang, xem số liệu và thao tác." : "Only Super Admin can open pages, read figures and make changes."}</small></span></label></div>
  </div>{hasData && <p class="fn-help">{vi ? "Tiền tệ và lịch báo cáo đã có dữ liệu nên được giữ nguyên. Đổi ngưỡng hoặc ghi chú không sửa lại các ảnh chụp đã chốt." : "Currency and reporting calendar are kept fixed once data exists. Changing the cash floor or policy note does not rewrite frozen snapshots."}</p>}<div class="fn-form-actions"><button class="fn-button" type="submit">{book ? (vi ? "Lưu thiết lập sổ" : "Save book settings") : (vi ? "Tạo sổ tài chính" : "Create finance book")}</button></div></form></section>
  {book && <>
    <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Định nghĩa năm tài chính" : "Fiscal-year definitions"}</h2><p>{vi ? "Tên khoản mục, phân khúc và ô nhập cần có được ghim khi công bố một kế hoạch hoặc chốt tháng." : "Line meanings, segments and applicable coordinates are pinned when a plan is published or a month closes."}</p></div>{definition && <span class:list={["fn-badge", frozen ? "good" : "info"]}>{definitionHasFacts && definition.state === "draft" ? (vi ? "Đã có dữ liệu" : "In use") : stateLabel(definition.state, vi)}</span>}</div>
      <form method="get" class="fn-toolbar"><div class="fn-field"><label for="definition-year">{vi ? "Năm bắt đầu kỳ tài chính" : "Fiscal starting year"}</label><input class="fn-input" id="definition-year" name="year" type="number" min="2000" max="2100" value={data.fiscalYear} required /></div><button class="fn-button secondary" type="submit">{vi ? "Xem định nghĩa" : "View definitions"}</button></form>
      {!definition && <form method="post"><CommandFields intent="definition.save" fields={{ fiscal_year: data.fiscalYear, expected_version: 0 }} /><p class="fn-help">{vi ? "Năm này chưa có định nghĩa. Tạo từ bộ khoản mục ban đầu rồi xem lại phạm vi áp dụng." : "This year has no definition set. Create it from the starter lines, then review its applicability."}</p><button class="fn-button secondary" type="submit">{vi ? "Tạo định nghĩa cho năm" : "Create year definitions"}</button></form>}
      {definition && <><dl class="fn-dl"><div><dt>{vi ? "Khoản mục" : "Lines"}</dt><dd>{lines.length}</dd></div><div><dt>{vi ? "Phân khúc" : "Segments"}</dt><dd>{segments.length}</dd></div><div><dt>{vi ? "Ô nhập đã xác định trong năm" : "Defined yearly input coordinates"}</dt><dd>{definition.expectedInputs.length}</dd></div></dl>
        {frozen && <div class="fn-notice" style="margin-top:20px">{definition.state === "published" ? (vi ? "Định nghĩa này đã được giữ nguyên để bảo toàn ý nghĩa lịch sử. Dùng khoản mục Khác / Chưa phân bổ kèm giải thích cho phát sinh mới trong năm." : "This definition set is frozen to preserve historical meaning. Use the documented Other / Unallocated inputs with an explanation for new activity this year.") : (vi ? "Năm này đã có số liệu nên không thể đổi định nghĩa. Hãy hoàn tất tên, tính chất chi phí và phân khúc trước lần nhập số đầu tiên; dùng khoản mục Khác / Chưa phân bổ kèm giải thích cho phát sinh ngoài dự kiến." : "This year already has financial facts, so its definitions cannot change. Complete labels, cost behavior and segment scope before the first amount is entered; use documented Other / Unallocated inputs for unexpected activity.")}</div>}
        <details class="fn-disclosure" style="margin-top:20px"><summary>{vi ? "Danh mục khoản mục và ý nghĩa" : "Line definitions and meaning"}</summary><div class="fn-disclosure-body"><p class="fn-help">{vi ? "Mọi ô trong phạm vi áp dụng phải có số hoặc trạng thái Không áp dụng được phép để hoàn tất báo cáo. Bỏ trống luôn là thiếu dữ liệu, không phải 0. Dùng phạm vi phân khúc và trạng thái Không áp dụng để thể hiện các khoản không phát sinh." : "Every applicable coordinate needs an amount or an allowed Not applicable state to complete a statement. A blank is always missing, never zero. Use segment applicability and explicit Not applicable states for exclusions."}</p><form method="post"><CommandFields intent="definition.save" fields={{ fiscal_year: data.fiscalYear, expected_version: definition.version }} /><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Danh mục khoản mục" : "Line definitions"}><table class="fn-table"><thead><tr><th>{vi ? "Khoản mục / mã" : "Line / code"}</th><th>{vi ? "Tên tiếng Anh" : "English label"}</th><th>{vi ? "Tên tiếng Việt" : "Vietnamese label"}</th><th>{vi ? "Phạm vi nhập" : "Input requirements"}</th></tr></thead><tbody>{lines.map(line => <tr><td>{lineLabel(line, vi)}<small class="fn-mono">{line.code}</small><small>{groupLabel(line.basis, vi)} · {line.aggregation === "stock" ? (vi ? "Số dư" : "Stock") : (vi ? "Phát sinh" : "Flow")}</small>{line.kind === "derived" && <small>{vi ? "Tự tính, không nhập" : "Derived, read only"}</small>}{line.basis === "pnl" && ["direct_cost", "operating_expense", "finance_cost", "income_tax"].includes(line.group) && (frozen ? <small>{costBehaviorLabel(line.costBehavior, vi)}</small> : <div class="fn-field" style="margin-top:10px"><label for={`behavior-${line.code}`}>{vi ? "Tính chất chi phí" : "Cost behavior"}</label><select class="fn-select" id={`behavior-${line.code}`} name={`line.${line.code}.cost_behavior`}>{["unspecified", "fixed", "variable", "mixed"].map(behavior => <option value={behavior} selected={inputValue(data, `line.${line.code}.cost_behavior`, line.costBehavior ?? "unspecified") === behavior}>{costBehaviorLabel(behavior, vi)}</option>)}</select></div>)}</td><td>{frozen ? line.labelEn : <input class="fn-input" name={`line.${line.code}.label_en`} aria-label={`${line.code}: English label`} value={inputValue(data, `line.${line.code}.label_en`, line.labelEn)} maxlength="120" required />}</td><td>{frozen ? line.labelVi : <input class="fn-input" name={`line.${line.code}.label_vi`} aria-label={`${line.code}: Tên tiếng Việt`} value={inputValue(data, `line.${line.code}.label_vi`, line.labelVi)} maxlength="120" required />}</td><td>{!frozen && line.basis === "pnl" && line.kind === "input" ? <><label class="fn-help" for={`na-${line.code}`}>{vi ? "Cho phép không áp dụng" : "Allow not applicable"}</label><select class="fn-select" id={`na-${line.code}`} name={`line.${line.code}.allow_na`}><option value="true" selected={inputValue(data, `line.${line.code}.allow_na`, String(line.allowNa)) === "true"}>{vi ? "Có" : "Yes"}</option><option value="false" selected={inputValue(data, `line.${line.code}.allow_na`, String(line.allowNa)) === "false"}>{vi ? "Không" : "No"}</option></select></> : <>{line.kind === "derived" ? (vi ? "Tự tính" : "Derived") : (vi ? "Mọi ô áp dụng đều cần số liệu" : "Every applicable input needs a value")}<small>{line.allowNa ? (vi ? "Cho phép không áp dụng" : "N/A allowed") : (vi ? "Không dùng trạng thái không áp dụng" : "N/A unavailable")}</small></>}</td></tr>)}</tbody></table></div>{!frozen && <div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Lưu tên và yêu cầu đầu vào" : "Save labels and input requirements"}</button></div>}</form></div></details>
        <details class="fn-disclosure"><summary>{vi ? "Phân khúc và phạm vi áp dụng" : "Segments and applicability"}</summary><div class="fn-disclosure-body"><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Các phân khúc" : "Segments"}><table class="fn-table"><thead><tr><th>{vi ? "Mã" : "Code"}</th><th>English</th><th>Tiếng Việt</th><th>{vi ? "Hiệu lực" : "Active period"}</th></tr></thead><tbody>{segments.map(segment => <tr><td class="fn-mono">{segment.code}</td><td>{segment.labelEn}</td><td>{segment.labelVi}</td><td>{segment.activeFrom} → {segment.activeTo ?? (vi ? "Tiếp tục" : "Ongoing")}</td></tr>)}</tbody></table></div>
          {!frozen && segments.map(segment => <details class="fn-input-detail"><summary>{vi ? "Chỉnh phân khúc" : "Edit segment"}: {vi ? segment.labelVi : segment.labelEn}</summary><form method="post"><CommandFields intent="definition.save" fields={{ fiscal_year: data.fiscalYear, expected_version: definition.version }} /><div class="fn-form-grid"><div class="fn-field"><label for={`edit-segment-${segment.code}-en`}>{vi ? "Tên tiếng Anh" : "English label"}</label><input class="fn-input" id={`edit-segment-${segment.code}-en`} name={`segment.${segment.code}.label_en`} value={inputValue(data, `segment.${segment.code}.label_en`, segment.labelEn)} maxlength="100" required /></div><div class="fn-field"><label for={`edit-segment-${segment.code}-vi`}>{vi ? "Tên tiếng Việt" : "Vietnamese label"}</label><input class="fn-input" id={`edit-segment-${segment.code}-vi`} name={`segment.${segment.code}.label_vi`} value={inputValue(data, `segment.${segment.code}.label_vi`, segment.labelVi)} maxlength="100" required /></div><div class="fn-field"><label for={`edit-segment-${segment.code}-from`}>{vi ? "Hoạt động từ tháng" : "Active from"}</label><input class="fn-input" id={`edit-segment-${segment.code}-from`} type="month" name={`segment.${segment.code}.active_from`} value={inputValue(data, `segment.${segment.code}.active_from`, segment.activeFrom)} readonly={["all", "unallocated"].includes(segment.code)} required /></div><div class="fn-field"><label for={`edit-segment-${segment.code}-to`}>{vi ? "Tháng cuối hoạt động" : "Last active month"}</label><input class="fn-input" id={`edit-segment-${segment.code}-to`} type="month" name={`segment.${segment.code}.active_to`} value={inputValue(data, `segment.${segment.code}.active_to`, segment.activeTo ?? "")} readonly={["all", "unallocated"].includes(segment.code)} /></div></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Lưu phân khúc" : "Save segment"}</button></div></form></details>)}
          {!frozen && <div class="fn-layout equal" style="margin-top:22px"><form method="post"><CommandFields intent="definition.save" fields={{ fiscal_year: data.fiscalYear, expected_version: definition.version }} /><h3>{vi ? "Thêm phân khúc" : "Add a segment"}</h3><div class="fn-stack"><div class="fn-field"><label for="segment-code">{vi ? "Mã ổn định" : "Stable code"}</label><input class="fn-input" id="segment-code" name="new_segment_code" pattern="[a-z][a-z0-9_-]{0,63}" maxlength="64" value={inputValue(data, "new_segment_code")} required /><small>{vi ? "Chữ thường, số, dấu gạch dưới hoặc gạch ngang." : "Lowercase letters, numbers, underscore or hyphen."}</small></div><div class="fn-field"><label for="segment-en">{vi ? "Tên tiếng Anh" : "English label"}</label><input class="fn-input" id="segment-en" name="new_segment_name_en" maxlength="100" value={inputValue(data, "new_segment_name_en")} required /></div><div class="fn-field"><label for="segment-vi">{vi ? "Tên tiếng Việt" : "Vietnamese label"}</label><input class="fn-input" id="segment-vi" name="new_segment_name_vi" maxlength="100" value={inputValue(data, "new_segment_name_vi")} required /></div><div class="fn-form-grid"><div class="fn-field"><label for="segment-from">{vi ? "Từ tháng" : "From month"}</label><input class="fn-input" id="segment-from" type="month" name="new_segment_active_from" value={inputValue(data, "new_segment_active_from", data.months[0] ?? book.firstPeriod)} required /></div><div class="fn-field"><label for="segment-to">{vi ? "Đến tháng (nếu có)" : "Through month (optional)"}</label><input class="fn-input" id="segment-to" type="month" name="new_segment_active_to" value={inputValue(data, "new_segment_active_to")} /></div></div></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Thêm phân khúc" : "Add segment"}</button></div></form>
          <form method="post"><CommandFields intent="definition.save" fields={{ fiscal_year: data.fiscalYear, expected_version: definition.version }} /><h3>{vi ? "Phân bổ ô nhập P&L" : "Set P&L input segments"}</h3><p class="fn-help">{vi ? "Thay thế danh sách phân khúc của một khoản mục trong khoảng tháng đã chọn. Giữ unallocated trong danh sách nếu còn phần chưa phân bổ." : "Replace one line’s segment scope over the selected months. Include unallocated when an unallocated portion remains."}</p><div class="fn-stack"><div class="fn-field"><label for="coordinate-line">{vi ? "Khoản mục" : "Line"}</label><select class="fn-select" id="coordinate-line" name="coordinate_line">{lines.filter(line => line.basis === "pnl" && line.kind === "input").map(line => <option value={line.code}>{lineLabel(line, vi)}</option>)}</select></div><div class="fn-field"><label for="coordinate-segments">{vi ? "Mã phân khúc, ngăn bằng dấu phẩy" : "Comma-separated segment codes"}</label><input class="fn-input" id="coordinate-segments" name="coordinate_segments" value={inputValue(data, "coordinate_segments", "unallocated")} maxlength="2000" required /><small>{segments.map(segment => segment.code).join(", ")}</small></div><div class="fn-form-grid"><div class="fn-field"><label for="coordinate-from">{vi ? "Từ tháng" : "From month"}</label><input class="fn-input" id="coordinate-from" type="month" name="coordinate_from" value={inputValue(data, "coordinate_from", data.months[0] ?? "")} required /></div><div class="fn-field"><label for="coordinate-to">{vi ? "Đến tháng" : "Through month"}</label><input class="fn-input" id="coordinate-to" type="month" name="coordinate_to" value={inputValue(data, "coordinate_to", data.months.at(-1) ?? "")} required /></div></div></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Lưu phạm vi ô nhập" : "Save input scope"}</button></div></form></div>}
        </div></details>
      </>}
    </section>
    <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Tài khoản tiền" : "Cash accounts"}</h2><p>{vi ? "Theo dõi số dư theo tài khoản và ngày nguồn. Danh sách tài khoản của một bản đã chốt được giữ trong phiên bản đó." : "Observe balances by account and source date. Closed revisions retain their own account roster."}</p></div></div><div class="fn-stack">{data.state.accounts.map(account => <details class="fn-disclosure"><summary><span>{account.label}</span><span class="fn-mono">{account.code}</span></summary><div class="fn-disclosure-body"><form method="post"><CommandFields intent="account.save" fields={{ account_code: account.code, expected_version: account.version }} /><div class="fn-form-grid three"><div class="fn-field"><label for={`account-${account.code}-label`}>{vi ? "Tên tài khoản" : "Account label"}</label><input class="fn-input" id={`account-${account.code}-label`} name="label" value={data.submitted?.account_code === account.code ? inputValue(data, "label", account.label) : account.label} maxlength="100" required /></div><div class="fn-field"><label for={`account-${account.code}-from`}>{vi ? "Hoạt động từ tháng" : "Active from"}</label><input class="fn-input" id={`account-${account.code}-from`} type="month" name="active_from" value={data.submitted?.account_code === account.code ? inputValue(data, "active_from", account.activeFrom) : account.activeFrom} required /></div><div class="fn-field"><label for={`account-${account.code}-to`}>{vi ? "Tháng cuối hoạt động" : "Last active month"}</label><input class="fn-input" id={`account-${account.code}-to`} type="month" name="active_to" value={data.submitted?.account_code === account.code ? inputValue(data, "active_to", account.activeTo ?? "") : account.activeTo ?? ""} /></div></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Lưu tài khoản" : "Save account"}</button></div></form></div></details>)}<details class="fn-disclosure" open={data.state.accounts.length === 0}><summary>{vi ? "Thêm tài khoản tiền" : "Add a cash account"}</summary><div class="fn-disclosure-body"><form method="post"><CommandFields intent="account.save" fields={{ expected_version: 0 }} /><div class="fn-form-grid"><div class="fn-field"><label for="new-account-code">{vi ? "Mã tài khoản" : "Account code"}</label><input class="fn-input" id="new-account-code" name="account_code" pattern="[a-z][a-z0-9_-]{0,63}" value={inputValue(data, "account_code")} maxlength="64" required /></div><div class="fn-field"><label for="new-account-label">{vi ? "Tên tài khoản" : "Account label"}</label><input class="fn-input" id="new-account-label" name="label" value={inputValue(data, "label")} maxlength="100" required /></div><div class="fn-field"><label for="new-account-from">{vi ? "Hoạt động từ tháng" : "Active from month"}</label><input class="fn-input" id="new-account-from" type="month" name="active_from" value={inputValue(data, "active_from", book.firstPeriod)} required /></div><div class="fn-field"><label for="new-account-to">{vi ? "Tháng cuối (nếu có)" : "Last month (optional)"}</label><input class="fn-input" id="new-account-to" type="month" name="active_to" value={inputValue(data, "active_to")} /></div></div><div class="fn-form-actions"><button class="fn-button secondary" type="submit">{vi ? "Thêm tài khoản" : "Add account"}</button></div></form></div></details></div></section>
  </>}
</div>
