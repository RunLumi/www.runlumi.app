---
import { fiscalYearForPeriod } from "../../lib/finance/calculations";
import type { FinancePageData } from "./types";
import FinanceAnnotation from "./FinanceAnnotation.astro";
import { financeLink, monthLabel, timestamp } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi";
const actions: Record<string, readonly [string, string]> = { "book.save": ["Book settings saved", "Lưu thiết lập sổ"], "definition.save": ["Definitions updated", "Cập nhật định nghĩa"], "account.save": ["Cash account saved", "Lưu tài khoản tiền"], "plan.create": ["Plan version created", "Tạo phiên bản kế hoạch"], "plan.save": ["Plan saved", "Lưu kế hoạch"], "plan.publish": ["Plan published", "Công bố kế hoạch"], "actual.open": ["Monthly draft opened", "Mở bản nháp tháng"], "actual.save": ["Monthly actuals saved", "Lưu số thực tế"], "actual.close": ["Month closed", "Chốt tháng"], "actual.reopen": ["Restatement opened", "Mở bản điều chỉnh"], "import.preview": ["CSV staged for review", "Tạo bản xem trước CSV"], "import.commit": ["Import month committed", "Ghi dữ liệu CSV của tháng"], "import.discard": ["Pending import discarded", "Bỏ phần CSV chưa ghi"], "annotation.add": ["Explanation added", "Thêm giải trình"], "report.export": ["Report exported", "Xuất báo cáo"] };
const action = Astro.url.searchParams.get("action") ?? "", actor = Astro.url.searchParams.get("actor") ?? "";
const events = data.state.audit;
const last = events.at(-1);
const inspect = (value: unknown): string => value == null ? "—" : typeof value === "string" ? value : JSON.stringify(value, null, 2);
---
<div class="fn-stack">
  <form method="get" class="fn-toolbar"><input type="hidden" name="year" value={data.fiscalYear} /><input type="hidden" name="period" value={data.period} /><div class="fn-field fn-grow"><label for="audit-action">{vi ? "Loại thao tác" : "Action"}</label><select class="fn-select" id="audit-action" name="action"><option value="">{vi ? "Tất cả thao tác" : "All actions"}</option>{Object.entries(actions).map(([key, label]) => <option value={key} selected={action === key}>{label[vi ? 1 : 0]}</option>)}</select></div><div class="fn-field fn-grow"><label for="audit-actor">{vi ? "Mã người thực hiện (nếu cần)" : "Actor ID (optional)"}</label><input class="fn-input" id="audit-actor" name="actor" value={actor} maxlength="100" /></div><button class="fn-button" type="submit">{vi ? "Lọc lịch sử" : "Filter history"}</button></form>
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Lịch sử thay đổi" : "Change history"}</h2><p>{vi ? "Mỗi thao tác có người thực hiện, thời gian và phiên bản liên quan. Bộ lọc áp dụng cho toàn bộ lịch sử; mỗi trang tối đa 100 sự kiện." : "Each action records its actor, time and related revision. Filters apply to the full audit trail; each page contains up to 100 events."}</p></div><span class="fn-badge">{events.length} {vi ? "sự kiện" : "events"}</span></div>
    {events.length === 0 ? <div class="fn-empty"><h2>{vi ? "Chưa có sự kiện trong bộ lọc này" : "No events match this selection"}</h2><p>{vi ? "Các lần lưu, chốt, mở lại, nhập và xuất sẽ xuất hiện tại đây sau khi thực hiện thành công." : "Successful saves, closes, restatements, imports and exports appear here."}</p></div> : <ol class="fn-timeline">{events.map(event => <li><div class="fn-list-title"><h3>{actions[event.action]?.[vi ? 1 : 0] ?? event.action}</h3>{event.period && <span class="fn-badge">{monthLabel(event.period, vi)}</span>}</div><p>{event.actorName}<span class="fn-help"> · {event.actorId}</span></p><time datetime={event.createdAt}>{timestamp(event.createdAt, vi, data.state.book?.timezone)}</time><details class="fn-input-detail"><summary>{vi ? "Xem chi tiết và tham chiếu" : "Inspect details and references"}</summary><dl class="fn-dl"><div><dt>{vi ? "Bản ghi liên quan" : "Related record"}</dt><dd class="fn-mono">{event.targetId}</dd></div><div><dt>{vi ? "Biên nhận thao tác" : "Operation receipt"}</dt><dd class="fn-mono">{event.operationId}</dd></div></dl>{Object.entries(event.detail).map(([key, value]) => <details class="fn-input-detail" open={typeof value !== "object"}><summary>{({ before: vi ? "Trước thay đổi" : "Before", after: vi ? "Sau thay đổi" : "After", cause: vi ? "Nguyên nhân" : "Cause", next_action: vi ? "Hành động tiếp theo" : "Next action", nextAction: vi ? "Hành động tiếp theo" : "Next action", fiscalYear: vi ? "Năm tài chính" : "Fiscal year", baselineId: vi ? "Kế hoạch gốc tham chiếu" : "Referenced baseline", actualRevisionId: vi ? "Phiên bản thực tế" : "Actual revision", actualRevisionVersion: vi ? "Số phiên bản thực tế" : "Actual revision version", lineCode: vi ? "Khoản mục" : "Line", segmentCode: vi ? "Phân khúc" : "Segment", review: vi ? "Ghi chú xem xét" : "Review", reason: vi ? "Lý do" : "Reason", command: vi ? "Nội dung thao tác" : "Action details", receipt: vi ? "Biên nhận" : "Receipt", manifest: vi ? "Phạm vi và phiên bản" : "Scope and revisions" } as Record<string, string>)[key] ?? key}</summary><pre class="fn-mono" style="white-space:pre-wrap;overflow-wrap:anywhere;max-height:400px;overflow:auto">{inspect(value)}</pre></details>)}{event.action.startsWith("actual.") && event.period && <a class="fn-link" href={financeLink(data, "actuals", { period: event.period, revision: event.targetId, year: fiscalYearForPeriod(event.period, data.state.book?.fiscalStartMonth ?? 1) })}>{vi ? "Mở phiên bản thực tế" : "Inspect actual revision"}</a>}{event.action.startsWith("plan.") && <a class="fn-link" href={financeLink(data, "plans", { plan: event.targetId, year: typeof event.detail.fiscalYear === "number" ? event.detail.fiscalYear : typeof (event.detail.plan as { fiscalYear?: unknown } | undefined)?.fiscalYear === "number" ? (event.detail.plan as { fiscalYear: number }).fiscalYear : data.fiscalYear, period: undefined })}>{vi ? "Mở phiên bản kế hoạch" : "Inspect plan version"}</a>}</details></li>)}</ol>}
    <div class="fn-form-actions">{Astro.url.searchParams.has("before") && <a class="fn-button secondary" href={financeLink(data, "audit", { before: undefined, action, actor })}>{vi ? "Về sự kiện mới nhất" : "Back to latest"}</a>}{events.length === 100 && last && <a class="fn-button secondary" href={financeLink(data, "audit", { before: `${last.createdAt}|${last.id}`, action, actor })}>{vi ? "Xem sự kiện cũ hơn" : "Older events"}</a>}</div>
  </section>
  <FinanceAnnotation data={data} />
</div>
