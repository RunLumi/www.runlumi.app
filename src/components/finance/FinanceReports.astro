---
import { calculateRunway } from "../../lib/finance/calculations";
import type { FinancePageData } from "./types";
import MetricCards from "./MetricCards.astro";
import FinanceAnnotation from "./FinanceAnnotation.astro";
import FinanceExceptions from "./FinanceExceptions.astro";
import FinanceChecks from "./FinanceChecks.astro";
import { costBehaviorLabel, exactTotal, financeLink, groupLabel, lineLabel, metricLabel, money, monthLabel, percent, selectedContext, selectedPlan, selectedRevision, stateLabel, timestamp, variance } from "./ui";
interface Props { data: FinancePageData }
const { data } = Astro.props, vi = data.lang === "vi", page = data.page, precision = data.state.book?.precision ?? 0;
const segmentOnly = ["pnl", "revenue", "costs"].includes(page) && data.segmentCode && data.segmentCode !== "all";
const report = data.aggregateReport ?? data.report, comparison = data.aggregatePlanReport ?? data.planReport;
const plan = selectedPlan(data), revision = selectedRevision(data), context = selectedContext(data, "actual");
const book = revision?.reportingSnapshot?.book ?? data.state.book;
const summaryKeys: Record<string, string[]> = { pnl: ["revenue", "gross_profit", "operating_profit", "net_profit"], revenue: ["revenue", "direct_costs", "gross_profit", "gross_margin"], costs: ["direct_costs", "operating_expenses", "operating_profit", "net_profit"], "cash-flow": ["cash_opening", "cash_closing", "cash_restricted", "cash_available"], "working-capital": ["ar_gross", "ar_allowance", "ar_net", "ap"], position: ["assets", "liabilities", "equity", "position_reconciliation"] };
const metricKeys: Record<string, string[]> = { pnl: ["revenue", "direct_costs", "gross_profit", "gross_margin", "operating_expenses", "operating_profit", "operating_margin", "profit_before_tax", "net_profit", "net_margin"], revenue: ["revenue", "direct_costs", "gross_profit", "gross_margin"], costs: ["direct_costs", "operating_expenses", "operating_profit", "net_profit"], "cash-flow": ["cash_opening", "cash_operating", "cash_investing", "cash_financing", "cash_expected_closing", "cash_closing", "cash_reconciliation", "cash_restricted", "cash_available"], "working-capital": ["ar_gross", "ar_allowance", "ar_net", "ap", "ar_aging_total", "ap_aging_total"], position: ["assets", "liabilities", "equity", "position_reconciliation", "equity_reconciliation"] };
const allLines = context.lines.filter(line => page === "pnl" ? line.basis === "pnl" : page === "revenue" ? line.basis === "pnl" && line.group === "revenue" : page === "costs" ? line.basis === "pnl" && ["direct_cost", "operating_expense", "finance_cost", "income_tax"].includes(line.group) : page === "cash-flow" ? line.basis === "cash" : page === "working-capital" ? line.basis === "aging" || ["aging.ar_control", "aging.ap_control"].includes(line.code) : line.basis === "position" || line.code.startsWith("equity."));
const costFilter = ["fixed", "variable", "mixed", "unspecified"].includes(Astro.url.searchParams.get("cost_behavior") ?? "") ? Astro.url.searchParams.get("cost_behavior")! : "all";
const lines = page === "costs" && costFilter !== "all" ? allLines.filter(line => (line.costBehavior ?? "unspecified") === costFilter) : allLines;
const grouped = [...new Set(lines.map(line => line.group))];
const direction = (key: string): "higher" | "lower" | "neutral" => ["direct_costs", "operating_expenses"].includes(key) ? "lower" : ["revenue", "gross_profit", "operating_profit", "net_profit", "gross_margin", "operating_margin", "net_margin", "cash_available"].includes(key) ? "higher" : "neutral";
const rowDirection = (group: string): "higher" | "lower" | "neutral" => group === "revenue" ? "higher" : ["direct_cost", "operating_expense", "finance_cost", "income_tax"].includes(group) ? "lower" : "neutral";
const forecastPeriods = plan?.actualCutoff ? data.months.filter(month => month > plan.actualCutoff!) : data.months;
const forecastReports = data.planReports?.filter(item => forecastPeriods.includes(item.period)) ?? [];
const forecastFloor = (plan?.reportingSnapshot?.book ?? book)?.cashFloor ?? null;
const runway = calculateRunway(forecastReports, forecastFloor, forecastPeriods);
const observations = data.state.observations.filter(item => item.actualRevisionId === revision?.id && item.kind === "closing");
---
<div class="fn-sheet-head"><div><h2>{data.comparisonLabel ?? monthLabel(data.period, vi, true)}</h2><p>{plan ? `${vi ? "Đối chiếu" : "Compared with"}: ${plan.label} · ${stateLabel(plan.state, vi)}` : (vi ? "Chưa chọn kế hoạch đối chiếu" : "No comparison plan selected")}{!["pnl", "revenue", "costs"].includes(page) ? ` · ${vi ? "Toàn sổ" : "Whole book"}` : ""}</p></div><span class:list={["fn-badge", report?.completeness.complete && (segmentOnly || report.reconciled) && !report.stale ? "good" : "warn"]}>{report?.completeness.complete && (segmentOnly || report.reconciled) && !report.stale ? (segmentOnly ? (vi ? "Đủ đầu vào P&L của phân khúc" : "Segment P&L inputs complete") : (vi ? "Đủ dữ liệu, đã đối chiếu" : "Complete and reconciled")) : (vi ? "Còn thiếu / cần đối chiếu" : "Incomplete / review required")}</span></div>
{report?.sourceState === "draft" && revision?.state === "draft" && <div class="fn-notice warn">{vi ? "Bạn đang xem bản nháp thực tế; số liệu chưa được chốt." : "You are viewing draft actuals; these figures have not been closed."}</div>}
{report?.stale && <div class="fn-notice bad">{vi ? "Báo cáo tham chiếu nguồn đã có phiên bản thay thế. Kiểm tra lại chuỗi điều chỉnh trước khi sử dụng kết quả." : "This report references a superseded source. Review the restatement chain before relying on the result."}</div>}
{!report && <div class="fn-notice"><strong>{vi ? "Chưa có số thực tế phù hợp" : "No matching actuals yet"}</strong><p>{vi ? "Mở mục Số thực tế tháng để nhập và chốt dữ liệu. Các ô còn thiếu được giữ là chưa xác định." : "Open Monthly actuals to enter and close the period. Missing values remain unknown."}</p></div>}
<MetricCards data={data} report={report} comparison={comparison} metrics={summaryKeys[page] ?? summaryKeys.pnl} />
<div class="fn-stack">
  {page === "costs" && <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Tính chất chi phí" : "Cost behavior"}</h2><p>{vi ? "Phân loại cố định, biến đổi và hỗn hợp theo định nghĩa đã cấu hình. Phần chưa phân loại được thể hiện riêng." : "Fixed, variable and mixed classifications follow configured definitions. Unspecified costs remain visible separately."}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Chi phí theo tính chất" : "Costs by behavior"}><table class="fn-table"><thead><tr><th>{vi ? "Tính chất" : "Behavior"}</th><th class="num">{vi ? "Khoản mục" : "Lines"}</th><th class="num">{vi ? "Kế hoạch" : "Plan"}</th><th class="num">{vi ? "Thực tế" : "Actual"}</th></tr></thead><tbody>{["fixed", "variable", "mixed", "unspecified"].map(behavior => { const matching = allLines.filter(line => (line.costBehavior ?? "unspecified") === behavior); return <tr><th>{costBehaviorLabel(behavior, vi)}</th><td class="num">{matching.length}</td><td class="num">{money(exactTotal(matching.map(line => comparison?.lineValues[line.code])), precision, vi)}</td><td class="num">{money(exactTotal(matching.map(line => report?.lineValues[line.code])), precision, vi)}</td></tr>; })}</tbody></table></div><form method="get" class="fn-toolbar fn-no-print" style="margin-top:18px;margin-bottom:0"><input type="hidden" name="year" value={data.fiscalYear} /><input type="hidden" name="period" value={data.period} /><input type="hidden" name="range" value={data.range ?? "month"} /><input type="hidden" name="segment" value={data.segmentCode ?? "all"} />{data.selectedPlanId && <input type="hidden" name="plan" value={data.selectedPlanId} />}<div class="fn-field fn-grow"><label for="cost-behavior-filter">{vi ? "Lọc bảng chi tiết khoản mục" : "Filter the line-detail table"}</label><select class="fn-select" id="cost-behavior-filter" name="cost_behavior"><option value="all">{vi ? "Tất cả tính chất" : "All behaviors"}</option>{["fixed", "variable", "mixed", "unspecified"].map(behavior => <option value={behavior} selected={costFilter === behavior}>{costBehaviorLabel(behavior, vi)}</option>)}</select></div><button class="fn-button secondary" type="submit">{vi ? "Lọc chi tiết" : "Filter detail"}</button></form></section>}
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Đối chiếu kết quả" : "Result comparison"}</h2><p>{vi ? "Thực tế và kế hoạch cùng phạm vi kỳ báo cáo. Tỷ lệ biên so bằng điểm phần trăm." : "Actual and plan cover the same reporting periods. Margin differences use percentage points."}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Đối chiếu chỉ tiêu" : "Metric comparison"}><table class="fn-table"><thead><tr><th>{vi ? "Chỉ tiêu" : "Measure"}</th><th class="num">{vi ? "Kế hoạch" : "Plan"}</th><th class="num">{vi ? "Thực tế" : "Actual"}</th><th class="num">{vi ? "Chênh lệch" : "Difference"}</th><th class="num">{vi ? "% / điểm %" : "% / pp"}</th><th>{vi ? "Ý nghĩa" : "Direction"}</th></tr></thead><tbody>{(metricKeys[page] ?? metricKeys.pnl).map(key => {
    const ratio = key.endsWith("_margin"), actual = report?.metrics[key], planned = comparison?.metrics[key], delta = variance(actual, planned, direction(key), ratio);
    const display = (value: number | null | undefined) => ratio ? percent(value, vi) : money(value, precision, vi);
    return <tr class:list={[["gross_profit", "operating_profit", "net_profit", "cash_closing", "cash_available", "assets", "equity"].includes(key) && "fn-total"]}><th>{metricLabel(key, vi)}</th><td class="num">{display(planned)}</td><td class="num">{display(actual)}</td><td class="num">{ratio ? delta.percentagePoints == null ? "—" : `${new Intl.NumberFormat(vi ? "vi-VN" : "en-GB", { maximumFractionDigits: 1 }).format(delta.percentagePoints)} ${vi ? "điểm %" : "pp"}` : money(delta.difference, precision, vi)}</td><td class="num">{ratio ? "—" : percent(delta.percentage, vi)}</td><td>{delta.state === "unbudgeted" ? <span class="fn-badge warn">{vi ? "Ngoài ngân sách" : "Unbudgeted"}</span> : delta.favorable === true ? <span class="fn-badge good">{vi ? "Thuận lợi" : "Favorable"}</span> : delta.favorable === false ? <span class="fn-badge bad">{vi ? "Bất lợi" : "Adverse"}</span> : <span class="fn-muted">{delta.state === "no_comparison" ? (vi ? "Chưa đủ đối chiếu" : "No comparison") : (vi ? "Trung tính" : "Neutral")}</span>}</td></tr>;
  })}</tbody><caption>{data.state.book?.currency} · {vi ? "Chênh lệch = thực tế − kế hoạch; tỷ lệ chênh lệch dùng trị tuyệt đối của kế hoạch. Kế hoạch bằng 0 không có tỷ lệ chênh lệch." : "Difference = actual − plan; percentage uses the absolute plan as denominator. A zero plan has no percentage variance."}</caption></table></div></section>
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{page === "working-capital" ? (vi ? "Chi tiết tuổi nợ và tổng kiểm soát" : "Aging and source control detail") : (vi ? "Chi tiết khoản mục" : "Line detail")}</h2><p>{page === "revenue" ? (vi ? "Doanh thu ghi nhận tách biệt với tiền thu khách hàng." : "Recognized revenue is distinct from customer cash collections.") : page === "costs" ? (vi ? "Chi phí ghi nhận tách biệt với tiền đã trả; phần dùng chung chưa phân bổ vẫn được thể hiện." : "Recognized costs are distinct from cash paid; shared unallocated costs remain visible.") : page === "working-capital" ? (vi ? "Tuổi nợ dùng số phải thu gộp; dự phòng được theo dõi riêng." : "Receivable aging uses gross balances; allowances are tracked separately.") : page === "position" ? (vi ? "Số dư tại thời điểm cuối khoảng đã chọn; không cộng số dư các tháng." : "Balances at the selected range end; monthly balances are not summed.") : (vi ? "Cùng một nguồn đầu vào với báo cáo tổng hợp." : "The same inputs used by the summary report.")}</p></div><a class="fn-link fn-no-print" href={financeLink(data, "actuals")}>{vi ? "Mở số liệu nguồn" : "Open source inputs"}</a></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Chi tiết khoản mục tài chính" : "Financial line detail"}><table class="fn-table"><thead><tr><th>{vi ? "Khoản mục" : "Line"}</th><th class="num">{vi ? "Kế hoạch" : "Plan"}</th><th class="num">{vi ? "Thực tế" : "Actual"}</th><th class="num">{vi ? "Chênh lệch" : "Difference"}</th></tr></thead><tbody>{grouped.map(group => <><tr class="fn-section"><th colspan="4">{groupLabel(group, vi)}</th></tr>{lines.filter(line => line.group === group).map(line => { const actual = report?.lineValues[line.code], planned = comparison?.lineValues[line.code], delta = variance(actual, planned, rowDirection(group)); return <tr><th>{lineLabel(line, vi)}{page === "costs" && <small>{costBehaviorLabel(line.costBehavior, vi)}</small>}{line.kind === "derived" && <small>{vi ? "Tự tính" : "Derived"}</small>}</th><td class="num">{money(planned, precision, vi)}</td><td class="num">{money(actual, precision, vi)}</td><td class:list={["num", delta.favorable === true && "fn-good", delta.favorable === false && "fn-bad"]}>{money(delta.difference, precision, vi)}</td></tr>; })}</>)}</tbody></table></div></section>
  {page === "cash-flow" && <>
    <div class="fn-layout equal"><section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Số dư tài khoản cuối tháng" : "Month-end account observations"}</h2><p>{monthLabel(data.period, vi)} · {vi ? "Phân loại toàn sổ" : "Whole-book classification"}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Số dư tài khoản" : "Cash account balances"}><table class="fn-table"><thead><tr><th>{vi ? "Tài khoản / nguồn" : "Account / evidence"}</th><th class="num">{vi ? "Số dư" : "Balance"}</th><th class="num">{vi ? "Bị hạn chế" : "Restricted"}</th></tr></thead><tbody>{observations.map(observation => <tr><td>{context.accounts.find(account => account.code === observation.accountCode)?.label ?? observation.accountCode}<small>{observation.classification === "cash" ? (vi ? "Tiền" : "Cash") : (vi ? "Vay / thấu chi" : "Borrowing / overdraft")} · {observation.asOfDate}</small><small>{observation.evidenceRef}</small></td><td class="num">{money(observation.amount, precision, vi)}</td><td class="num">{money(observation.restrictedAmount, precision, vi)}</td></tr>)}{observations.length === 0 && <tr><td colspan="3">{vi ? "Chưa có quan sát số dư cho phiên bản này." : "No account observations for this revision."}</td></tr>}</tbody></table></div></section><section class="fn-sheet"><h2>{vi ? "Ngưỡng tiền và dự báo" : "Cash floor and forecast"}</h2><dl class="fn-dl"><div><dt>{vi ? "Ngưỡng tiền cấu hình" : "Configured cash floor"}</dt><dd>{money(forecastFloor, precision, vi)} {book?.currency}</dd></div><div><dt>{vi ? "Phiên bản dự kiến" : "Projection version"}</dt><dd>{plan?.label ?? "—"}</dd></div><div><dt>{vi ? "Số tháng trong phạm vi" : "Months in scope"}</dt><dd>{forecastPeriods.length}</dd></div></dl><div class:list={["fn-notice", runway.status === "breach" ? "bad" : "warn"]} style="margin-top:18px"><strong>{!plan || plan.kind !== "forecast" ? (vi ? "Chọn dự báo có nguồn thực tế đã chốt" : "Select a forecast anchored to closed actuals") : runway.status === "no_floor" ? (vi ? "Chưa cấu hình ngưỡng tiền" : "Cash floor is not configured") : runway.status === "incomplete" || plan.stale ? (vi ? "Chuỗi dự báo chưa đủ điều kiện" : "Forecast chain is incomplete") : runway.status === "breach" ? `${vi ? "Dưới ngưỡng trong" : "Below floor in"} ${monthLabel(runway.breachPeriod!, vi)}` : (vi ? "Chưa thấy vi phạm trong phạm vi đã nhập" : "No breach in the supplied horizon")}</strong><p>{vi ? "Dự báo tháng không chứng minh đủ tiền ở từng ngày thanh toán. Tháng thiếu dữ liệu giữ trạng thái chưa xác định." : "Monthly forecasts do not establish cash availability on individual payment dates. Missing months remain unknown."}</p></div><a class="fn-link fn-no-print" href={financeLink(data, "plans")}>{vi ? "Cập nhật dự báo" : "Update the forecast"}</a></section></div>
    {plan && <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Dòng tiền các tháng còn lại" : "Remaining-month cash path"}</h2><p>{plan.label} · {stateLabel(plan.state, vi)}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Dự kiến tiền từng tháng" : "Monthly projected cash"}><table class="fn-table"><thead><tr><th>{vi ? "Tháng" : "Month"}</th><th class="num">{vi ? "Đầu kỳ" : "Opening"}</th><th class="num">{vi ? "Cuối kỳ" : "Closing"}</th><th class="num">{vi ? "Không bị hạn chế" : "Unrestricted"}</th><th>{vi ? "Trạng thái" : "Status"}</th></tr></thead><tbody>{forecastPeriods.map(month => { const projected = forecastReports.find(item => item.period === month); return <tr><td>{monthLabel(month, vi)}</td><td class="num">{money(projected?.metrics.cash_opening, precision, vi)}</td><td class="num">{money(projected?.metrics.cash_closing, precision, vi)}</td><td class="num">{money(projected?.metrics.cash_available, precision, vi)}</td><td><span class:list={["fn-badge", projected?.completeness.complete && !projected.stale ? "" : "warn"]}>{projected?.completeness.complete && !projected.stale ? (vi ? "Đã nhập" : "Supplied") : (vi ? "Chưa đầy đủ" : "Incomplete")}</span></td></tr>; })}</tbody></table></div></section>}
  </>}
  {page === "costs" && <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Chi phí lương và tiền đã trả" : "Recognized payroll and cash paid"}</h2><p>{vi ? "Chi phí lương triển khai và lương dùng chung được cộng từ cùng bộ số P&L. Tiền trả lương là dòng tiền riêng của toàn sổ." : "Delivery and shared payroll are totaled from the same P&L facts. Payroll payments are a separate whole-book cash movement."}</p></div></div><dl class="fn-dl"><div><dt>{vi ? "Chi phí lương ghi nhận trong phạm vi P&L" : "Payroll recognized in the P&L scope"}</dt><dd>{money(exactTotal([report?.lineValues["pnl.delivery_payroll"], report?.lineValues["pnl.shared_payroll"]]), precision, vi)} {book?.currency}</dd></div><div><dt>{vi ? "Tiền đã trả lương — toàn sổ" : "Payroll cash paid — whole book"}</dt><dd>{money(report?.lineValues["cash.payroll_payments"], precision, vi)} {book?.currency}</dd></div></dl><p class="fn-help">{vi ? "Hai số có thể khác nhau do kỳ ghi nhận và kỳ thanh toán. Xem số phải trả để đối chiếu thời điểm." : "The figures may differ because recognition and payment happen in different periods. Review payroll payables to reconcile timing."}</p></section>}
  {page === "working-capital" && <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Nợ chưa quá hạn và quá hạn" : "Current and overdue balances"}</h2><p>{vi ? "Tổng quá hạn cộng bốn nhóm tuổi nợ từ 1 ngày trở lên; thiếu nhóm nào thì tổng đó vẫn chưa xác định." : "Overdue balances sum the four aging buckets from one day onward; a missing bucket keeps that total unknown."}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Tổng hợp nợ đến hạn" : "Due and overdue summary"}><table class="fn-table"><thead><tr><th>{vi ? "Khoản công nợ" : "Balance"}</th><th class="num">{vi ? "Chưa quá hạn" : "Not overdue"}</th><th class="num">{vi ? "Quá hạn" : "Overdue"}</th><th class="num">{vi ? "Tổng tuổi nợ" : "Aging total"}</th></tr></thead><tbody>{["ar", "ap"].map(side => <tr><th>{side === "ar" ? (vi ? "Phải thu thương mại gộp" : "Gross trade receivables") : (vi ? "Phải trả thương mại" : "Trade payables")}</th><td class="num">{money(report?.lineValues[`aging.${side}_current`], precision, vi)}</td><td class="num">{money(exactTotal(["1_30", "31_60", "61_90", "over_90"].map(bucket => report?.lineValues[`aging.${side}_${bucket}`])), precision, vi)}</td><td class="num">{money(report?.metrics[`${side}_aging_total`], precision, vi)}</td></tr>)}</tbody></table></div><p class="fn-help">{vi ? "Giả định thu hoặc trả tiền tiếp theo được nhập một lần trong kế hoạch dòng tiền, với nguồn và ghi chú của tháng tương ứng." : "Expected collections and payments are entered once in the cash plan, with source references and notes for the relevant month."} <a class="fn-link" href={financeLink(data, "plans")}>{vi ? "Mở kế hoạch thu chi" : "Open the cash plan"}</a></p></section>}
  {(page === "position" || page === "working-capital") && <div class="fn-layout"><section class="fn-sheet"><h2>{vi ? "Nguồn và điều kiện đối chiếu" : "Source and reconciliation context"}</h2><dl class="fn-dl"><div><dt>{vi ? "Nguồn cập nhật đến" : "Source as of"}</dt><dd>{revision?.sources.sourceAsOf || "—"}</dd></div><div><dt>{vi ? "Tham chiếu nguồn" : "Evidence reference"}</dt><dd>{revision?.sources.blocks[page === "position" ? "position" : "aging"]?.evidenceRef || "—"}</dd></div><div><dt>{vi ? "Phạm vi" : "Scope"}</dt><dd>{revision?.sources.scope || "—"}</dd></div></dl><p class="fn-help">{page === "position" ? (vi ? "Tài sản phải bằng nợ phải trả cộng vốn chủ sở hữu. Biến động vốn được kiểm tra riêng với lợi nhuận và góp/rút vốn." : "Assets must equal liabilities plus equity. Equity movements are checked separately against profit and owner movements.") : (vi ? "Tổng nhóm tuổi nợ phải khớp tổng nguồn và số dư phải thu/phải trả. Tiền thu/trả dự kiến nằm trong kế hoạch dòng tiền, không làm thay đổi số dư thực tế." : "Aging buckets must match source controls and receivable/payable balances. Expected collections and payments belong in the cash plan; they do not change actual balances.")}</p></section><FinanceChecks data={data} report={data.report} /></div>}
  {["pnl", "revenue", "costs"].includes(page) && <FinanceExceptions data={data} />}
  <FinanceAnnotation data={data} />
  <section class="fn-sheet"><div class="fn-sheet-head"><div><h2>{vi ? "Theo dõi theo tháng" : "Month-by-month view"}</h2><p>{vi ? "Giữ nguyên các tháng còn thiếu để thấy rõ độ phủ dữ liệu." : "Missing months stay visible so coverage is explicit."}</p></div></div><div class="fn-table-scroll" tabindex="0" aria-label={vi ? "Số liệu theo tháng" : "Monthly figures"}><table class="fn-table"><thead><tr><th>{vi ? "Tháng" : "Month"}</th>{(summaryKeys[page] ?? summaryKeys.pnl).map(key => <th class="num">{metricLabel(key, vi)}</th>)}<th>{vi ? "Trạng thái" : "Status"}</th></tr></thead><tbody>{data.months.map(month => { const monthly = data.reports?.find(item => item.period === month); return <tr><th><a class="fn-link" href={financeLink(data, data.page, { period: month, range: "month" })}>{monthLabel(month, vi)}</a></th>{(summaryKeys[page] ?? summaryKeys.pnl).map(key => <td class="num">{key.endsWith("_margin") ? percent(monthly?.metrics[key], vi) : money(monthly?.metrics[key], precision, vi)}</td>)}<td><span class:list={["fn-badge", monthly?.sourceState === "closed" && !monthly.stale ? "good" : ""]}>{monthly?.sourceState === "closed" ? stateLabel("closed", vi) : data.state.periods.find(item => item.period === month)?.workingRevisionId ? (vi ? "Bản nháp chưa chốt" : "Unclosed draft") : (vi ? "Chưa có số chốt" : "No closed actuals")}</span></td></tr>; })}</tbody></table></div></section>
  <details class="fn-disclosure"><summary>{vi ? "Dấu vết phiên bản báo cáo" : "Report revision details"}</summary><div class="fn-disclosure-body"><dl class="fn-dl"><div><dt>{vi ? "Kế hoạch" : "Plan"}</dt><dd class="fn-mono">{plan?.id ?? "—"}</dd></div><div><dt>{vi ? "Thực tế tháng đã chọn" : "Selected actual revision"}</dt><dd class="fn-mono">{revision?.id ?? "—"}</dd></div><div><dt>{vi ? "Định nghĩa tính toán" : "Calculation version"}</dt><dd>{revision?.reportingSnapshot?.calculationVersion ?? context.definition?.calculationVersion ?? "—"}</dd></div><div><dt>{vi ? "Bản thiết lập" : "Settings version"}</dt><dd>{book?.version ?? "—"}</dd></div><div><dt>{vi ? "Thời điểm tạo báo cáo" : "Generated at"}</dt><dd>{timestamp(data.generatedAt, vi, book?.timezone)}</dd></div></dl><p class="fn-help">{vi ? "Bản xuất CSV ghi nhận phạm vi và phiên bản đã chọn để đối chiếu về sau." : "CSV exports record the selected scope and revisions for later comparison."}</p></div></details>
</div>
