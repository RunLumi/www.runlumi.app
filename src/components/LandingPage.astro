---
import type { content } from "../data/content";
import { company } from "../data/company";
import BaseLayout from "../layouts/BaseLayout.astro";
import CompanyFooter from "./CompanyFooter.astro";

interface Props { copy: (typeof content)[keyof typeof content]; }
const { copy } = Astro.props;
const vi = copy.lang === "vi";
const contact = `mailto:${company.email}?subject=${encodeURIComponent(copy.mail.subject)}&body=${encodeURIComponent(copy.mail.body)}`;
---
<BaseLayout lang={copy.lang} title={copy.meta.title} description={copy.meta.description} canonicalPath={copy.path}>
  <header class="site-header">
    <div class="shell header-inner glass">
      <a href={copy.path} class="brand" aria-label={vi ? "Trang chủ Lumi" : "Lumi home"}>
        <img class="brand-mark" src="/brand/lumi-fulltext.svg" alt="Lumi" width="196" height="100" />
      </a>
      <nav class="main-nav" aria-label={vi ? "Điều hướng chính" : "Main navigation"}>
        <a href="#products">{copy.nav.products}</a>
        <a href="#how">{copy.nav.how}</a>
        <a href="#trust">{copy.nav.trust}</a>
        <a href={vi ? "/vi/blog" : "/blog"}>{copy.nav.blog}</a>
      </nav>
      <div class="header-actions">
        <a class="language-link" href={copy.switchPath} lang={vi ? "en" : "vi"} aria-label={vi ? "Read in English" : "Đọc bằng tiếng Việt"}>{copy.switchLabel}</a>
        <a class="button button-sm" href={contact}>{copy.nav.contact}</a>
        <details class="mobile-menu">
          <summary aria-label={vi ? "Menu điều hướng" : "Navigation menu"}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
          </summary>
          <nav class="mobile-nav" aria-label={vi ? "Điều hướng trên di động" : "Mobile navigation"}>
            <a href="#products">{copy.nav.products}</a>
            <a href="#how">{copy.nav.how}</a>
            <a href="#trust">{copy.nav.trust}</a>
            <a href={vi ? "/vi/blog" : "/blog"}>{copy.nav.blog}</a>
            <a href={contact}>{copy.nav.contact}</a>
          </nav>
        </details>
      </div>
    </div>
  </header>
  <script>
    document.querySelectorAll<HTMLDetailsElement>(".mobile-menu").forEach((menu) => {
      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => { menu.open = false; });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (event) => {
        if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      window.matchMedia("(max-width: 900px)").addEventListener("change", () => { menu.open = false; });
    });
  </script>

  <main id="main">
    <section class="hero shell">
      <div class="hero-copy">
        <div class="eyebrow">{copy.hero.eyebrow}</div>
        <h1>
          <span>{copy.hero.titleA}</span>
          <span class="hero-accent">{copy.hero.titleB}</span>
        </h1>
        <p class="hero-body">{copy.hero.body}</p>
        <div class="hero-actions">
          <a class="button button-lg" href="#how">{copy.hero.primary}</a>
          <a class="text-link" href={contact}>{copy.hero.secondary} <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-note">{copy.hero.note}</p>
      </div>
      <aside class="hero-system" aria-label={copy.hero.systemLabel}>
        <div class="hero-system-head"><span>{copy.hero.example.label}</span><span aria-hidden="true">L / 01</span></div>
        <div class="request-sheet sheet">
          <div class="request-heading"><img src="/brand/lumi-logo.svg" alt="" width="28" height="28" /><span>RunLumi</span><span class="example-label">{copy.hero.example.tag}</span></div>
          <p class="request-question">{copy.hero.example.query}</p>
          <div class="request-divider"><span>{copy.hero.example.divider}</span></div>
          <ol class="hero-system-list">
            {copy.hero.systemItems.map((item) => (
              <li><span class="system-n">{item.n}</span><div><strong>{item.name}</strong><span class="system-detail">{item.detail}</span></div><span class="system-role">{item.role}</span></li>
            ))}
          </ol>
          <div class="hero-system-foot"><span class="corner-mark" aria-hidden="true"></span><span>{copy.hero.systemFoot}</span></div>
        </div>
        <a class="workflow-dock glass" href="#how"><span class="dock-mark" aria-hidden="true">↳</span><span>{copy.hero.example.dock}</span><span aria-hidden="true">↗</span></a>
        <div class="system-caption">{copy.hero.example.caption}</div>
      </aside>
    </section>

    <section class="thesis section-rule">
      <div class="shell two-col-section">
        <div class="section-label">{copy.thesis.label}</div>
        <div>
          <h2>{copy.thesis.title}</h2>
          <p class="lede">{copy.thesis.body}</p>
        </div>
      </div>
    </section>

    <section class="day-section section-rule" id="how">
      <div class="shell two-col-section">
        <div>
          <div class="section-label">{copy.day.label}</div>
          <h2>{copy.day.title}</h2>
          <p class="section-intro">{copy.day.body}</p>
        </div>
        <ol class="day-timeline">
          {copy.day.moments.map((moment, index) => (
            <li class="day-moment">
              <div class="timeline-time">
                <span>{moment.time}</span>
                <span class="timeline-index">0{index + 1}</span>
              </div>
              <div class="timeline-copy">
                <h3>{moment.title}</h3>
                <p>{moment.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="stack-section" id="stack">
      <div class="shell">
        <div class="section-heading">
          <div class="section-label">{copy.stack.label}</div>
          <h2>{copy.stack.title}</h2>
        </div>

        <p class="scope-note">{copy.stack.scopeNote}</p>
        <div class="stack-map" aria-label={copy.stack.ariaLabel}>
          <article class="stack-assistant sheet">
            <div class="stack-node-meta">{copy.stack.assistantMeta}</div>
            <h3>{copy.stack.assistant.name}</h3>
            <strong>{copy.stack.assistant.role}</strong>
            <p>{copy.stack.assistant.desc}</p>
          </article>

          <div class="stack-connector stack-connector-short" aria-hidden="true"></div>

          <div class="stack-products">
            {copy.stack.products.map((product, index) => (
              <article class="stack-product sheet">
                <div class="stack-node-meta">0{index + 1} / {product.role}</div>
                <h3>{product.name}</h3>
                <p>{product.desc}</p>
              </article>
            ))}
          </div>

          <div class="stack-connector" aria-hidden="true"></div>

          <article class="stack-foundation">
            <span>{copy.stack.foundationMeta}</span>
            <h3>{copy.stack.foundationTitle}</h3>
            <p>{copy.stack.foundation}</p>
          </article>

          <div class="stack-connector stack-connector-compact" aria-hidden="true"></div>

          <article class="stack-gateway">
            <span>{copy.stack.gatewayMeta}</span>
            <h3>{copy.stack.gatewayTitle}</h3>
            <p>{copy.stack.gateway}</p>
          </article>

          <div class="stack-connector stack-connector-compact" aria-hidden="true"></div>

          <article class="stack-systems">
            <span>{copy.stack.systems}</span>
            <p>{copy.stack.systemsList}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="products-section section-rule" id="products">
      <div class="shell">
        <div class="section-heading products-heading">
          <div class="section-label">{copy.productsLabel}</div>
          <h2>{copy.productsTitle}</h2>
        </div>
        <div class="product-list">
          {copy.products.map((product) => (
            <article class="product-chapter">
              <div class="product-number">{product.index}</div>
              <div class="product-heading">
                <div class="eyebrow">{product.kicker}</div>
                <div class="product-name">{product.name}</div>
              </div>
              <div class="product-story">
                <h3>{product.title}</h3>
                <p>{product.body}</p>
              </div>
              <div class="product-artifact sheet" aria-label={product.demo.label}>
                <div class="artifact-head">
                  <span>{product.demo.label}</span>
                  <span class="artifact-source"><i></i> {copy.lang === "vi" ? "MINH HỌA" : "ILLUSTRATIVE"}</span>
                </div>
                <div class="artifact-rows">
                  {product.demo.rows.map((row) => (
                    <div class="artifact-row">
                      <span class="artifact-key">{row.key}</span>
                      <div>
                        <strong>{row.value}</strong>
                        <small>{row.meta}</small>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <ul class="product-examples" aria-label={product.name + (vi ? " — năng lực" : " capabilities")}>
                {product.examples.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="context-section">
      <div class="shell">
        <div class="context-header">
          <div class="section-label">{copy.context.label}</div>
          <h2>{copy.context.title}</h2>
          <p>{copy.context.body}</p>
        </div>

        <div class="context-graph" role="img" aria-label={copy.context.ariaLabel}>
          <div class="context-inputs">
            {copy.context.inputs.map((input) => <span class="context-chip">{input}</span>)}
          </div>
          <div class="context-flow" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="context-center">
            <img class="context-logo" src="/brand/lumi-logo.svg" alt="" width="84" height="84" aria-hidden="true" />
            <strong>{copy.context.center}</strong>
          </div>
          <div class="context-flow context-flow-out" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="context-outputs">
            {copy.context.outputs.map((output) => <span class="context-output">{output}</span>)}
          </div>
        </div>

        <div class="evidence-callout">
          <span class="evidence-star" aria-hidden="true">✦</span>
          <div>
            <strong>{copy.context.proofTitle}</strong>
            <p>{copy.context.proofBody}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-section section-rule" id="trust">
      <div class="shell">
        <div class="section-heading trust-heading">
          <div class="section-label">{copy.trust.label}</div>
          <h2>{copy.trust.title}</h2>
        </div>
        <div class="trust-grid">
          {copy.trust.items.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="teams-section section-rule" id="teams">
      <div class="shell">
        <div class="section-heading">
          <div class="section-label">{copy.teams.label}</div>
          <h2>{copy.teams.title}</h2>
        </div>
        <p class="scope-note">{copy.teams.body}</p>
        <div class="stack-products" aria-label={copy.teams.ariaLabel}>
          {copy.teams.products.map((product, index) => (
            <article class="stack-product sheet">
              <div class="stack-node-meta">0{index + 1} / {product.role}</div>
              <h3>{product.name}</h3>
              <p>{product.desc}</p>
              <a class="stack-product-link" href={product.href}>
                <span>{vi ? `Mở ${product.name}` : `Visit ${product.name}`}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="journal-section section-rule">
      <div class="shell journal-section-inner">
        <div>
          <div class="section-label">{copy.blog.label}</div>
          <h2>{copy.blog.title}</h2>
          <p>{copy.blog.body}</p>
        </div>
        <a class="button button-lg" href={vi ? "/vi/blog" : "/blog"}>{copy.blog.cta} <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="existing-section" id="pilot">
      <div class="shell two-col-section">
        <div>
          <div class="section-label">{copy.existing.label}</div>
          <h2>{copy.existing.title}</h2>
          <p class="section-intro">{copy.existing.body}</p>
        </div>
        <ol class="operating-steps">
          {copy.existing.steps.map((step) => (
            <li>
              <span class="step-n">{step.n}</span>
              <div><h3>{step.t}</h3><p>{step.d}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="cta-section" id="contact">
      <div class="shell cta-sheet">
        <div class="section-label">{copy.cta.label}</div>
        <h2>{copy.cta.title}</h2>
        <p>{copy.cta.body}</p>
        <div class="cta-actions">
          <a class="button button-lg" href={contact}>{copy.cta.primary} <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={contact}>{copy.cta.secondary}</a>
        </div>
        <p class="contact-note">{vi ? "Mở bản nháp email với vài câu hỏi ngắn để bắt đầu." : "Opens an email draft with a few questions to get started."}</p>
      </div>
    </section>
  </main>

  <CompanyFooter lang={copy.lang} contact={contact} version={false} />
</BaseLayout>
