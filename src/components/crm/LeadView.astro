---
import CrmShell from "../../layouts/CrmShell.astro";
import Crumbs from "./Crumbs.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { formatDate, formatDateTime, label, options } from "../../lib/crm/i18n";
import { leadAgeHours, overTarget, reasonLabel, statusLabel } from "../../lib/crm/leads";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { LeadProps } from "../../lib/crm/routes/leads";
import "../../styles/crm-sales.css";

type Props = LeadProps;
const { ctx, state, lead, canEdit, process, owners, names, events, playbooks, matches, convert, contactsFor, convertAccount, companies } = Astro.props;
const { lang, vi, base } = ctx;
const v = (intent: string, name: string, fallback: string | number | null = "") => valueFor(state, intent, name, fallback);
const e = (intent: string, name: string) => errorFor(state, intent, name);
const person = (id: string | null) => id ? (names[id]?.name ?? (id === ctx.actor.id ? ctx.actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chờ phân công" : "Waiting for assignment");
const stateName: Record<string, [string, string]> = { open: ["Open", "Đang mở"], converted: ["Converted", "Đã chuyển đổi"], disqualified: ["Disqualified", "Không tiếp tục"] };
const statuses = process.def.statuses;
const currentIndex = statuses.findIndex((item) => item.id === lead.status_id);
const late = overTarget(process, lead);
const body = (raw: string) => { try { return JSON.parse(raw) as Record<string, unknown>; } catch { return {}; } };
const eventText = (kind: string, raw: string): string => {
  const data = body(raw);
  switch (kind) {
    case "lead_created": return vi ? "Tạo Lead" : "Lead created";
    case "lead_inbound": return vi ? "Yêu cầu gửi tới Lumi từ local.runlumi.app" : "Enquiry sent to Lumi from local.runlumi.app";
    case "lead_referred": return vi ? "Được giới thiệu cho đội Lumi (đã xác nhận khách đồng ý)" : "Referred to the Lumi team (consent confirmed)";
    case "lead_assigned": return vi ? `Giao cho ${person(String(data.to ?? ""))}` : `Assigned to ${person(String(data.to ?? ""))}`;
    case "lead_status": return `${statusLabel(process, String(data.from ?? ""), vi)} → ${statusLabel(process, String(data.to ?? ""), vi)}`;
    case "lead_note": return String(data.text ?? "");
    case "lead_updated": return vi ? "Cập nhật thông tin Lead" : "Lead details updated";
    case "lead_disqualified": return `${vi ? "Không tiếp tục" : "Disqualified"}: ${reasonLabel(process, String(data.reason_id ?? ""), vi)}${data.note ? ` — ${String(data.note)}` : ""}`;
    case "lead_reopened": return `${vi ? "Mở lại" : "Reopened"}: ${String(data.reason ?? "")}`;
    case "lead_converted": return vi ? "Chuyển thành cơ hội" : "Converted to an opportunity";
    default: return kind;
  }
};
const convertErrors = state.intent === "lead_convert" ? state.errors : {};
const accountMode = v("lead_convert", "account_mode", convertAccount ? "existing" : (matches.accounts.length ? "existing" : "new"));
const contactMode = v("lead_convert", "contact_mode", matches.contacts.some((item) => item.account_id === convertAccount) ? "existing" : "new");
const accountChoice = v("lead_convert", "account_id", convertAccount || matches.accounts[0]?.id || "");
const contactChoices = [...matches.contacts.map((item) => ({ value: item.id, label: `${item.name} · ${item.account_name}` })), ...contactsFor.filter((item) => !matches.contacts.some((match) => match.id === item.id)).map((item) => ({ value: item.id, label: `${item.name} · ${label(lang, "role", item.role)}` }))];
const fieldLabels: Record<string, string> = vi
  ? { name: "Họ tên", company: "Công ty", phone: "Điện thoại", email: "Email", account_id: "Công ty có sẵn", account_name: "Tên công ty mới", contact_id: "Liên hệ có sẵn", contact_mode: "Liên hệ", playbook_key: "Playbook", title: "Tên cơ hội", owner_id: "Người phụ trách", reason_id: "Lý do", status_id: "Trạng thái", consent: "Đồng ý liên hệ", estimated_value_vnd: "Giá trị HĐ mong đợi", win_probability: "Tỉ lệ thành công", reopen_reason: "Lý do mở lại" }
  : { name: "Name", company: "Company", phone: "Phone", email: "Email", account_id: "Existing company", account_name: "New company name", contact_id: "Existing contact", contact_mode: "Contact", playbook_key: "Playbook", title: "Opportunity name", owner_id: "Owner", reason_id: "Reason", status_id: "Status", consent: "Contact consent", estimated_value_vnd: "Expected value", win_probability: "Win probability", reopen_reason: "Reason to reopen" };
---
<CrmShell title={`${lead.name} · ${lead.company}`} lang={lang} actor={ctx.actor} current="leads">
  <Crumbs label={vi ? "Đường dẫn" : "Breadcrumb"} items={[{ label: "CRM", href: base }, { label: vi ? "Lead" : "Leads", href: `${base}/leads` }, { label: lead.name }]} />
  <div class="crm-head">
    <div>
      <p class="crm-eyebrow">Lead · {label(lang, "channel", lead.source_channel)}</p>
      <h1 class="crm-h1">{lead.name}</h1>
      <p class="crm-lede">{lead.job_title ? `${lead.job_title} · ` : ""}{lead.company}{lead.region ? ` · ${lead.region}` : ""}</p>
    </div>
    <div class="crm-actions">
      {canEdit && <a class="crm-button" href="?convert=1#convert">{vi ? "Chuyển đổi" : "Convert"}</a>}
      {lead.state === "converted" && lead.converted_opportunity_id && <a class="crm-button" href={`${base}/${lead.converted_opportunity_id}`}>{vi ? "Mở cơ hội" : "Open opportunity"}</a>}
    </div>
  </div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={fieldLabels} />
  {lead.suppressed ? <div class="crm-notice bad" role="status">{vi ? "Số điện thoại này từng yêu cầu không liên hệ. Không gọi hay nhắn cho đến khi admin xác minh." : "This number previously asked not to be contacted. Do not call or message until an admin has checked it."}</div> : null}
  {lead.state === "converted" && <div class="crm-notice good" role="status">{vi ? `Đã chuyển đổi ${formatDate(lead.converted_at, lang)}. Lead chỉ còn để đọc.` : `Converted on ${formatDate(lead.converted_at, lang)}. This lead is now read-only.`}</div>}
  {lead.state === "disqualified" && <div class="crm-notice" role="status"><strong>{vi ? "Không tiếp tục" : "Disqualified"}: {reasonLabel(process, lead.disqualify_reason_id, vi)}</strong>{lead.disqualify_note}</div>}
  {lead.state === "open" && !lead.owner_id && <div class="crm-notice warn" role="status">{vi ? "Lead đang chờ quản lý bán hàng phân công. Chỉ chuyển đổi được khi đã có người phụ trách." : "This lead is waiting for a Sales Manager to assign it. It can be converted once it has an owner."}</div>}

  {lead.state === "open" && <section class="crm-sheet" aria-labelledby="path-h" style="margin-bottom:18px">
    <h2 class="crm-sr" id="path-h">{vi ? "Trạng thái Lead" : "Lead status"}</h2>
    <ol class="crm-path">{statuses.map((item, index) => <li class:list={{ current: item.id === lead.status_id, done: currentIndex >= 0 && index < currentIndex }}><span aria-current={item.id === lead.status_id ? "step" : undefined}>{vi ? item.vi : item.en}</span></li>)}</ol>
    {late && <p class="crm-card-alert" style="display:inline-block">{vi ? `Đã ${leadAgeHours(lead)} giờ, quá thời gian mục tiêu của trạng thái này.` : `${leadAgeHours(lead)} hours old, past this status's target time.`}</p>}
    {canEdit && <form class="crm-form-inline" method="post" style="margin-top:10px">
      <Hidden intent="lead_status" state={state} version={lead.version} />
      <Field name="status_id" type="select" label={vi ? "Đổi trạng thái Lead" : "Change lead status"} lang={lang} value={lead.status_id} error={e("lead_status", "status_id")} options={statuses.map((item) => ({ value: item.id, label: vi ? item.vi : item.en }))} />
      <button class="crm-button secondary" type="submit">{vi ? "Lưu trạng thái" : "Save status"}</button>
    </form>}
  </section>}

  {convert && canEdit && <section class="crm-sheet" id="convert" aria-labelledby="convert-h" style="margin-bottom:18px">
    <h2 class="crm-h2" id="convert-h">{vi ? `Chuyển Lead thành cơ hội: ${lead.name} · ${lead.company}` : `Convert lead: ${lead.name} · ${lead.company}`}</h2>
    {!lead.owner_id ? <p class="crm-empty">{vi ? "Cần phân công người phụ trách trước." : "Assign an owner first."}</p> : <form class="crm-convert" method="post" action="#convert">
      <Hidden intent="lead_convert" state={state} version={lead.version} />
      <fieldset>
        <legend>{vi ? "Công ty" : "Company"}{matches.accounts.length ? (vi ? ` · ${matches.accounts.length} công ty có thể trùng` : ` · ${matches.accounts.length} possible duplicates`) : ""}</legend>
        <div class="crm-choice">
          <label><input type="radio" name="account_mode" value="new" checked={accountMode === "new"} /><span>{vi ? "Tạo công ty mới" : "Create a new company"}</span></label>
          <Field name="account_name" label={fieldLabels.account_name} lang={lang} value={v("lead_convert", "account_name", lead.company)} error={convertErrors.account_name} maxlength={160} />
          <label><input type="radio" name="account_mode" value="existing" checked={accountMode === "existing"} /><span>{vi ? "Dùng công ty có sẵn" : "Use an existing company"}</span></label>
          {matches.accounts.length > 0 && <ul class="crm-list">{matches.accounts.map((item) => <li class="crm-row"><span><strong>{item.name}</strong>{item.region ? ` · ${item.region}` : ""}</span><span class="crm-badge amber">{item.reason === "phone" ? (vi ? "Cùng số điện thoại" : "Same phone") : (vi ? "Cùng tên" : "Same name")}</span></li>)}</ul>}
          <Field name="account_id" type="select" label={fieldLabels.account_id} lang={lang} value={accountChoice} error={convertErrors.account_id} options={[{ value: "", label: vi ? "Chọn công ty" : "Choose a company" }, ...matches.accounts.map((item) => ({ value: item.id, label: `${item.name} · ${vi ? "có thể trùng" : "possible duplicate"}` })), ...companies.filter((item) => !matches.accounts.some((match) => match.id === item.id)).map((item) => ({ value: item.id, label: item.region ? `${item.name} · ${item.region}` : item.name }))]} help={vi ? "Chỉ hiện công ty bạn được làm việc." : "Only companies you may work on are listed."} />
        </div>
      </fieldset>
      <fieldset>
        <legend>{vi ? "Liên hệ" : "Contact"}{matches.contacts.length ? (vi ? ` · ${matches.contacts.length} liên hệ có thể trùng` : ` · ${matches.contacts.length} possible duplicates`) : ""}</legend>
        <div class="crm-choice">
          <label><input type="radio" name="contact_mode" value="new" checked={contactMode === "new"} /><span>{vi ? `Tạo liên hệ mới: ${lead.name}` : `Create a new contact: ${lead.name}`}</span></label>
          <Field name="contact_role" type="select" label={vi ? "Vai trò của liên hệ" : "Contact role"} lang={lang} value={v("lead_convert", "contact_role", "owner")} options={options(lang, "role")} />
          <label><input type="radio" name="contact_mode" value="existing" checked={contactMode === "existing"} /><span>{vi ? "Dùng liên hệ có sẵn ở công ty đã chọn" : "Use an existing contact at the chosen company"}</span></label>
          {contactChoices.length ? <Field name="contact_id" type="select" label={fieldLabels.contact_id} lang={lang} value={v("lead_convert", "contact_id", contactChoices[0]?.value ?? "")} error={convertErrors.contact_id} options={contactChoices} />
            : <p class="crm-help">{vi ? "Chưa có liên hệ phù hợp. Chọn công ty rồi bấm \"Tải liên hệ của công ty\" để xem liên hệ ở đó." : "No matching contacts. Choose a company, then select \"Load the company's contacts\"."}</p>}
          {convertErrors.contact_mode && <p class="crm-error">{vi ? "Liên hệ có sẵn cần đi cùng công ty có sẵn." : "An existing contact needs an existing company."}</p>}
          <button class="crm-button small secondary" type="submit" formmethod="get" formaction="#convert" name="convert" value="1">{vi ? "Tải liên hệ của công ty" : "Load the company's contacts"}</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>{vi ? "Cơ hội" : "Opportunity"}</legend>
        <div class="crm-form-grid">
          <Field name="title" label={fieldLabels.title} lang={lang} value={v("lead_convert", "title", lead.company)} error={convertErrors.title} required maxlength={160} />
          <Field name="playbook_key" type="select" label={vi ? "Playbook · bắt đầu ở giai đoạn đầu" : "Playbook · starts at its first stage"} lang={lang} value={v("lead_convert", "playbook_key", lead.playbook_key || playbooks[0]?.playbook_key || "")} error={convertErrors.playbook_key} options={playbooks.map((item) => ({ value: item.playbook_key, label: `${vi ? item.name_vi : item.name_en} · ${vi ? item.def.stages[0].vi : item.def.stages[0].en}` }))} />
          <Field name="estimated_value_vnd" label={vi ? "Giá trị HĐ mong đợi (VND, để trống nếu chưa biết)" : "Expected value (VND, blank if unknown)"} lang={lang} value={v("lead_convert", "estimated_value_vnd")} error={convertErrors.estimated_value_vnd} inputmode="numeric" />
          <Field name="win_probability" label={vi ? "Tỉ lệ thành công % (để trống nếu chưa biết)" : "Win probability % (blank if unknown)"} lang={lang} value={v("lead_convert", "win_probability")} error={convertErrors.win_probability} inputmode="numeric" />
        </div>
      </fieldset>
      <p class="crm-help">{vi
        ? `Người phụ trách bản ghi mới: ${person(lead.owner_id)} (người phụ trách Lead, cũng là người bán được ghi công). Nguồn Lead${lead.referrer_id ? " và người giới thiệu" : ""} được giữ trên cơ hội. Sau khi chuyển đổi, Lead chỉ còn để đọc.`
        : `Owner of new records: ${person(lead.owner_id)} (the lead's owner, also credited as seller). The lead source${lead.referrer_id ? " and referrer" : ""} stay on the opportunity. After conversion the lead is read-only.`}</p>
      <div class="crm-actions"><a class="crm-button secondary" href={`${base}/leads/${lead.id}`}>{vi ? "Hủy" : "Cancel"}</a><button class="crm-button" type="submit">{vi ? "Chuyển đổi" : "Convert"}</button></div>
    </form>}
  </section>}

  <div class="crm-row-panels">
    <section class="crm-sheet" aria-labelledby="details-h">
      <h2 class="crm-h2" id="details-h">{vi ? "Thông tin Lead" : "Lead details"}</h2>
      {canEdit ? <form class="crm-form" method="post" action="#details-h">
        <Hidden intent="lead_save" state={state} version={lead.version} />
        <div class="crm-form-grid">
          <Field name="name" id="ld-name" label={fieldLabels.name} lang={lang} value={v("lead_save", "name", lead.name)} error={e("lead_save", "name")} required maxlength={160} />
          <Field name="job_title" id="ld-title" label={vi ? "Chức danh" : "Job title"} lang={lang} value={v("lead_save", "job_title", lead.job_title)} maxlength={120} />
          <Field name="company" id="ld-company" label={fieldLabels.company} lang={lang} value={v("lead_save", "company", lead.company)} error={e("lead_save", "company")} required maxlength={160} />
          <Field name="phone" id="ld-phone" type="tel" label={vi ? "Điện thoại / Zalo" : "Phone / Zalo"} lang={lang} value={v("lead_save", "phone", lead.phone)} error={e("lead_save", "phone")} maxlength={40} inputmode="tel" />
          <Field name="email" id="ld-email" type="email" label="Email" lang={lang} value={v("lead_save", "email", lead.email)} error={e("lead_save", "email")} maxlength={254} />
          <Field name="industry" id="ld-industry" label={vi ? "Ngành" : "Industry"} lang={lang} value={v("lead_save", "industry", lead.industry)} maxlength={120} />
          <Field name="region" id="ld-region" label={vi ? "Khu vực" : "Area"} lang={lang} value={v("lead_save", "region", lead.region)} maxlength={120} />
          <Field name="playbook_key" id="ld-pb" type="select" label={vi ? "Nhu cầu thuộc playbook" : "Playbook"} lang={lang} value={v("lead_save", "playbook_key", lead.playbook_key)} error={e("lead_save", "playbook_key")} options={[{ value: "", label: vi ? "Chưa rõ" : "Not known yet" }, ...playbooks.filter((item) => item.kind !== "renewal").map((item) => ({ value: item.playbook_key, label: vi ? item.name_vi : item.name_en }))]} />
          <Field name="next_action" id="ld-next" label={vi ? "Bước tiếp theo" : "Next step"} lang={lang} value={v("lead_save", "next_action", lead.next_action)} maxlength={500} />
          <Field name="next_action_due" id="ld-due" type="date" label={vi ? "Hạn bước tiếp theo" : "Next step due"} lang={lang} value={v("lead_save", "next_action_due", lead.next_action_due)} error={e("lead_save", "next_action_due")} />
        </div>
        <Field name="need" id="ld-need" type="textarea" label={vi ? "Nhu cầu, theo lời họ" : "Need, in their words"} lang={lang} value={v("lead_save", "need", lead.need)} maxlength={1500} />
        <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Lưu" : "Save"}</button></div>
      </form> : <dl class="crm-facts">
        <div><dt>{vi ? "Công ty" : "Company"}</dt><dd>{lead.company}</dd></div>
        <div><dt>{vi ? "Điện thoại" : "Phone"}</dt><dd>{lead.phone || "—"}</dd></div>
        <div><dt>Email</dt><dd>{lead.email || "—"}</dd></div>
        <div><dt>{vi ? "Nhu cầu" : "Need"}</dt><dd>{lead.need || "—"}</dd></div>
      </dl>}
    </section>
    <section class="crm-sheet" aria-labelledby="facts-h">
      <h2 class="crm-h2" id="facts-h">{vi ? "Nguồn và người phụ trách" : "Source and owner"}</h2>
      <dl class="crm-facts">
        <div><dt>{vi ? "Tình trạng" : "State"}</dt><dd>{stateName[lead.state][vi ? 1 : 0]}{lead.state === "open" ? ` · ${statusLabel(process, lead.status_id, vi)}` : ""}</dd></div>
        <div><dt>{vi ? "Nguồn Lead" : "Lead source"}</dt><dd>{label(lang, "channel", lead.source_channel)}</dd></div>
        {lead.source_detail && <div><dt>{vi ? "Chi tiết nguồn" : "Source detail"}</dt><dd>{lead.source_detail}</dd></div>}
        {lead.referrer_id && <div><dt>{vi ? "Người giới thiệu" : "Referrer"}</dt><dd>{person(lead.referrer_id)}</dd></div>}
        <div><dt>{vi ? "Người phụ trách" : "Owner"}</dt><dd>{person(lead.owner_id)}</dd></div>
        <div><dt>{vi ? "Đồng ý liên hệ" : "Contact consent"}</dt><dd>{label(lang, "consent", lead.consent_status)}</dd></div>
        <div><dt>{vi ? "Tạo lúc" : "Created"}</dt><dd>{formatDateTime(lead.created_at, lang)}</dd></div>
        <div><dt>{vi ? "Phiên bản quy trình Lead" : "Lead process version"}</dt><dd>v{process.version}</dd></div>
      </dl>
      {lead.consent_evidence && <p class="crm-help">{lead.consent_evidence}</p>}
      {ctx.actor.manager && lead.state === "open" && <form class="crm-form-inline" method="post" style="margin-top:14px">
        <Hidden intent="lead_assign" state={state} version={lead.version} />
        <Field name="owner_id" id="la-owner" type="select" label={vi ? "Giao cho" : "Assign to"} lang={lang} value={lead.owner_id ?? ""} error={e("lead_assign", "owner_id")} options={[{ value: "", label: vi ? "Chọn người" : "Choose" }, ...owners.filter((owner) => owner.id !== ctx.actor.id || ctx.actor.configure).map((owner) => ({ value: owner.id, label: owner.label }))]} />
        <button class="crm-button secondary" type="submit">{vi ? "Giao" : "Assign"}</button>
      </form>}
    </section>
  </div>

  <div class="crm-row-panels" style="margin-top:18px">
    <section class="crm-sheet" id="activity" aria-labelledby="activity-h">
      <h2 class="crm-h2" id="activity-h">{vi ? "Hoạt động" : "Activity"}<span class="crm-count">{events.length}</span></h2>
      {canEdit && <form class="crm-form" method="post" action="#activity">
        <Hidden intent="lead_note" state={state} />
        <Field name="note" id="ln-note" type="textarea" label={vi ? "Ghi chú (cuộc gọi, tin nhắn, gặp mặt)" : "Note (call, message, meeting)"} lang={lang} value={v("lead_note", "note")} error={e("lead_note", "note")} maxlength={3000} />
        <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Ghi chú" : "Add note"}</button></div>
      </form>}
      {events.length ? <ol class="crm-activity" style="margin-top:14px">{events.map((event) => <li><p class="crm-meta">{event.actor_name} · {formatDateTime(event.created_at, lang)}</p><p>{eventText(event.kind, event.body)}</p></li>)}</ol> : <p class="crm-empty">{vi ? "Chưa có hoạt động." : "No activity yet."}</p>}
    </section>
    {(canEdit || (lead.state === "disqualified" && (ctx.actor.manager || lead.owner_id === ctx.actor.id))) && <section class="crm-sheet" id="disqualify" aria-labelledby="dq-h">
      {canEdit ? <>
        <h2 class="crm-h2" id="dq-h">{vi ? "Không tiếp tục" : "Disqualify"}</h2>
        <p class="crm-help">{vi ? "Lead được giữ lại kèm lý do. Danh sách lý do do admin đặt trong Thiết lập Lead." : "The lead is kept with the reason. Admins set the reasons in Lead settings."}</p>
        <form class="crm-form" method="post" action="#disqualify">
          <Hidden intent="lead_disqualify" state={state} version={lead.version} />
          <Field name="reason_id" type="select" label={fieldLabels.reason_id} lang={lang} value={v("lead_disqualify", "reason_id")} error={e("lead_disqualify", "reason_id")} required options={[{ value: "", label: vi ? "Chọn lý do" : "Choose a reason" }, ...process.def.disqualify_reasons.map((item) => ({ value: item.id, label: vi ? item.vi : item.en }))]} />
          <Field name="disqualify_note" type="textarea" label={vi ? "Ghi chú" : "Note"} lang={lang} value={v("lead_disqualify", "disqualify_note")} maxlength={1000} />
          <div class="crm-actions"><button class="crm-button danger" type="submit">{vi ? "Không tiếp tục" : "Disqualify"}</button></div>
        </form>
      </> : <>
        <h2 class="crm-h2" id="dq-h">{vi ? "Mở lại Lead" : "Reopen lead"}</h2>
        <form class="crm-form" method="post" action="#disqualify">
          <Hidden intent="lead_reopen" state={state} version={lead.version} />
          <Field name="reopen_reason" label={fieldLabels.reopen_reason} lang={lang} value={v("lead_reopen", "reopen_reason")} error={e("lead_reopen", "reopen_reason")} required maxlength={500} />
          <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Mở lại" : "Reopen"}</button></div>
        </form>
      </>}
    </section>}
  </div>
</CrmShell>
