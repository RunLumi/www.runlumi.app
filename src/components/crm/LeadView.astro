---
// LeadRecord and LeadConvert boards. Highlights, the lead-process path with
// key fields and guidance, Activity/Details tabs and a related column. Every
// write opens in a sheet (or the conversion dialog); none needs client script.
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import RecordHeader from "../workspace/ui/RecordHeader.astro";
import ButtonGroup from "../workspace/ui/ButtonGroup.astro";
import RelatedList from "../workspace/ui/RelatedList.astro";
import RecordPath from "../workspace/record/PathPanel.astro";
import RecordTabs from "../workspace/ui/RecordTabs.astro";
import Sheet from "../workspace/ui/Sheet.astro";
import Feed from "../workspace/record/Feed.astro";
import { formatDate, formatDateTime, label, options } from "../../lib/crm/i18n";
import { leadAgeHours, overTarget, reasonLabel, statusLabel } from "../../lib/crm/leads";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { LeadProps } from "../../lib/crm/routes/leads";
import "../../styles/crm-sales.css";
import "../../styles/record.css";

type Props = LeadProps;
const { ctx, state, lead, canEdit, process, owners, names, events, playbooks, matches, convert, contactsFor, convertAccount, companies } = Astro.props;
const { lang, vi, base } = ctx;
const here = `${base}/leads/${lead.id}`;
const tab = Astro.url.searchParams.get("tab") === "details" ? "details" : "activity";
const v = (intent: string, name: string, fallback: string | number | null = "") => valueFor(state, intent, name, fallback);
const e = (intent: string, name: string) => errorFor(state, intent, name);
const person = (id: string | null) => id ? (names[id]?.name ?? (id === ctx.actor.id ? ctx.actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chờ phân công" : "Waiting for assignment");
const stateName: Record<string, [string, string]> = { open: ["Open", "Đang mở"], converted: ["Converted", "Đã chuyển đổi"], disqualified: ["Disqualified", "Không tiếp tục"] };
const statuses = process.def.statuses;
const currentIndex = statuses.findIndex((item) => item.id === lead.status_id);
const current = statuses[currentIndex];
const nextStatus = currentIndex >= 0 ? statuses[currentIndex + 1] : undefined;
const late = overTarget(process, lead);
const canReopen = lead.state === "disqualified" && (ctx.actor.manager || lead.owner_id === ctx.actor.id);
const canAssign = ctx.actor.manager && lead.state === "open";
const unknown = vi ? "Chưa biết" : "Unknown";
const body = (raw: string) => { try { return JSON.parse(raw) as Record<string, unknown>; } catch { return {}; } };
const eventText = (kind: string, raw: string): string => {
  const data = body(raw);
  switch (kind) {
    case "lead_created": return vi ? "Tạo Lead" : "Lead created";
    case "lead_inbound": return vi ? "Yêu cầu gửi tới Lumi từ local.runlumi.app" : "Enquiry sent to Lumi from local.runlumi.app";
    case "lead_referred": return vi ? "Được giới thiệu cho đội Lumi (đã xác nhận khách đồng ý)" : "Referred to the Lumi team (consent confirmed)";
    case "lead_assigned": return vi ? `Giao cho ${person(String(data.to ?? ""))}` : `Assigned to ${person(String(data.to ?? ""))}`;
    case "lead_status": return `${statusLabel(process, String(data.from ?? ""), vi)} → ${statusLabel(process, String(data.to ?? ""), vi)}`;
    case "lead_note": return String(data.text ?? "");
    case "lead_updated": return vi ? "Cập nhật thông tin Lead" : "Lead details updated";
    case "lead_disqualified": return `${vi ? "Không tiếp tục" : "Disqualified"}: ${reasonLabel(process, String(data.reason_id ?? ""), vi)}${data.note ? ` — ${String(data.note)}` : ""}`;
    case "lead_reopened": return `${vi ? "Mở lại" : "Reopened"}: ${String(data.reason ?? "")}`;
    case "lead_converted": return vi ? "Chuyển thành cơ hội" : "Converted to an opportunity";
    default: return kind;
  }
};
const feed = events.map((event) => ({ title: eventText(event.kind, event.body), meta: event.actor_name, when: formatDateTime(event.created_at, lang), kind: (event.kind === "lead_note" ? "note" : event.kind === "lead_disqualified" ? "warn" : "event") as "note" | "warn" | "event" }));
const convertErrors = state.intent === "lead_convert" ? state.errors : {};
const accountMode = v("lead_convert", "account_mode", convertAccount ? "existing" : (matches.accounts.length ? "existing" : "new"));
const contactMode = v("lead_convert", "contact_mode", matches.contacts.some((item) => item.account_id === convertAccount) ? "existing" : "new");
const accountChoice = v("lead_convert", "account_id", convertAccount || matches.accounts[0]?.id || "");
const contactChoices = [...matches.contacts.map((item) => ({ value: item.id, label: `${item.name} · ${item.account_name}` })), ...contactsFor.filter((item) => !matches.contacts.some((match) => match.id === item.id)).map((item) => ({ value: item.id, label: `${item.name} · ${label(lang, "role", item.role)}` }))];
const playbookName = (key: string) => { const item = playbooks.find((pb) => pb.playbook_key === key); return item ? (vi ? item.name_vi : item.name_en) : ""; };
const fieldLabels: Record<string, string> = vi
  ? { name: "Họ tên", company: "Công ty", phone: "Điện thoại", email: "Email", account_id: "Công ty có sẵn", account_name: "Tên công ty mới", contact_id: "Liên hệ có sẵn", contact_mode: "Liên hệ", playbook_key: "Playbook", title: "Tên cơ hội", owner_id: "Người phụ trách", reason_id: "Lý do", status_id: "Trạng thái", consent: "Đồng ý liên hệ", estimated_value_vnd: "Giá trị HĐ mong đợi", win_probability: "Tỉ lệ thành công", reopen_reason: "Lý do mở lại" }
  : { name: "Name", company: "Company", phone: "Phone", email: "Email", account_id: "Existing company", account_name: "New company name", contact_id: "Existing contact", contact_mode: "Contact", playbook_key: "Playbook", title: "Opportunity name", owner_id: "Owner", reason_id: "Reason", status_id: "Status", consent: "Contact consent", estimated_value_vnd: "Expected value", win_probability: "Win probability", reopen_reason: "Reason to reopen" };
const open = (intent: string) => state.intent === intent && (Object.keys(state.errors).length > 0 || state.conflict || state.serverError);
const moreActions = canEdit ? [{ label: vi ? "Ghi chú" : "Add note", href: "#sheet-note" }, ...(lead.state === "open" ? [{ label: vi ? "Chọn trạng thái" : "Choose status", href: "#sheet-status" }] : []), { label: vi ? "Không tiếp tục" : "Disqualify", href: "#sheet-disqualify", danger: true }] : [];
const dupCount = matches.accounts.length + matches.contacts.length;
---
<CrmShell title={`${lead.name} · ${lead.company}`} lang={lang} actor={ctx.actor} current="leads">
  <div class="rec">
    <RecordHeader vi={vi} icon="leads" tone="lead" object="Lead" title={lead.name}
      crumbs={[{ label: "CRM", href: base }, { label: "Lead", href: `${base}/leads` }, { label: lead.name }]}
      highlights={[
        { label: vi ? "Chức danh" : "Job title", value: lead.job_title || "—" },
        { label: vi ? "Công ty" : "Company", value: lead.company },
        { label: vi ? "Điện thoại" : "Phone", value: lead.phone || "—" },
        { label: vi ? "Nguồn Lead" : "Lead source", value: label(lang, "channel", lead.source_channel) },
        { label: vi ? "Người phụ trách" : "Owner", value: person(lead.owner_id), tone: lead.owner_id ? undefined : "warn" },
      ]}>
      <p slot="sub" class="rec-badges"><span class:list={["ws-badge", lead.state === "converted" ? "ok" : lead.state === "disqualified" ? "warn" : "info"]}>{stateName[lead.state][vi ? 1 : 0]}</span></p>
      <ButtonGroup slot="actions" label={vi ? "Thao tác" : "Actions"} more={moreActions}>
        {canEdit && lead.state === "open" && <a class="ws-btn" href="?convert=1#convert">{vi ? "Chuyển đổi" : "Convert"}</a>}
        {canEdit && <a class="ws-btn" href="#sheet-edit">{vi ? "Sửa" : "Edit"}</a>}
        {canAssign && <a class="ws-btn" href="#sheet-assign">{vi ? "Đổi người phụ trách" : "Change owner"}</a>}
        {lead.state === "converted" && lead.converted_opportunity_id && <a class="ws-btn" href={`${base}/${lead.converted_opportunity_id}`}>{vi ? "Mở cơ hội" : "Open opportunity"}</a>}
        {lead.state === "converted" && <a class="ws-btn" href={`${here}/converted`}>{vi ? "Kết quả chuyển đổi" : "Conversion result"}</a>}
        {canReopen && <a class="ws-btn" href="#sheet-reopen">{vi ? "Mở lại" : "Reopen"}</a>}
      </ButtonGroup>
    </RecordHeader>

    <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={fieldLabels} />
    {lead.suppressed ? <div class="crm-notice bad" role="status">{vi ? "Số điện thoại này từng yêu cầu không liên hệ. Không gọi hay nhắn cho đến khi admin xác minh." : "This number previously asked not to be contacted. Do not call or message until an admin has checked it."}</div> : null}
    {lead.state === "converted" && <div class="crm-notice good" role="status">{vi ? `Đã chuyển đổi ${formatDate(lead.converted_at, lang)}. Lead chỉ còn để đọc.` : `Converted on ${formatDate(lead.converted_at, lang)}. This lead is now read-only.`}</div>}
    {lead.state === "disqualified" && <div class="crm-notice" role="status"><strong>{vi ? "Không tiếp tục" : "Disqualified"}: {reasonLabel(process, lead.disqualify_reason_id, vi)}</strong>{lead.disqualify_note}</div>}
    {lead.state === "open" && !lead.owner_id && <div class="crm-notice warn" role="status">{vi ? "Lead đang chờ quản lý bán hàng phân công. Chỉ chuyển đổi được khi đã có người phụ trách." : "This lead is waiting for a Sales Manager to assign it. It can be converted once it has an owner."}</div>}

    {lead.state === "open" && <RecordPath vi={vi} label={vi ? `Trạng thái Lead (quy trình v${process.version})` : `Lead status (process v${process.version})`}
      steps={statuses.map((item, index) => ({ label: vi ? item.vi : item.en, state: item.id === lead.status_id ? "current" : currentIndex >= 0 && index < currentIndex ? "done" : "todo" }))}>
      {canEdit && nextStatus && <form slot="action" method="post">
        <Hidden intent="lead_status" state={state} version={lead.version} />
        <input type="hidden" name="status_id" value={nextStatus.id} />
        <button class="ws-btn primary" type="submit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>{vi ? `Hoàn tất, chuyển sang “${nextStatus.vi}”` : `Complete, move to “${nextStatus.en}”`}</button>
      </form>}
      {canEdit && !nextStatus && <a slot="action" class="ws-btn primary" href="?convert=1#convert">{vi ? "Chuyển đổi" : "Convert"}</a>}
      <div>
        <h2>{vi ? `Trường quan trọng · ${current ? current.vi : ""}` : `Key fields · ${current ? current.en : ""}`}{canEdit && <a class="ws-btn sm" href="#sheet-edit">{vi ? "Sửa" : "Edit"}</a>}</h2>
        <dl class="rec-fields">
          <div><dt>{vi ? "Nhu cầu" : "Need"}</dt><dd>{lead.need || <span class="rec-unknown">{unknown}</span>}</dd></div>
          <div><dt>Playbook</dt><dd>{lead.playbook_key ? playbookName(lead.playbook_key) || lead.playbook_key : <span class="rec-unknown">{vi ? "Chưa rõ" : "Not known yet"}</span>}</dd></div>
          <div><dt>{vi ? "Bước tiếp theo" : "Next step"}</dt><dd>{lead.next_action || <span class="rec-unknown">{vi ? "Chưa đặt" : "Not set"}</span>}</dd></div>
          <div><dt>{vi ? "Hạn" : "Due"}</dt><dd>{lead.next_action_due ? formatDate(lead.next_action_due, lang) : <span class="rec-unknown">{vi ? "Chưa đặt" : "Not set"}</span>}</dd></div>
        </dl>
      </div>
      <div>
        <h2>{vi ? "Hướng dẫn" : "Guidance"}</h2>
        <ul class="rec-guide">
          {current?.target_hours ? <li>{vi ? `Mục tiêu của trạng thái này: ${current.target_hours} giờ. Lead đã ${leadAgeHours(lead)} giờ.` : `Target for this status: ${current.target_hours} hours. This lead is ${leadAgeHours(lead)} hours old.`}{late && <strong>{vi ? " Đã quá mục tiêu." : " Past the target."}</strong>}</li> : null}
          <li>{vi ? "Ghi lại mỗi cuộc gọi, tin nhắn hay buổi gặp bằng Ghi chú. Ghi chú không làm đổi phiên bản Lead." : "Record each call, message or meeting as a note. Notes do not change the lead's version."}</li>
          <li>{vi ? "Khi đã rõ nhu cầu và người quyết định: bấm Chuyển đổi để tạo công ty, liên hệ và cơ hội ở giai đoạn đầu của playbook." : "Once the need and the decision maker are clear, select Convert to create the company, contact and opportunity at the playbook's first stage."}</li>
          <li>{vi ? "Không phù hợp: chọn Không tiếp tục với lý do. Lead được giữ lại." : "Not a fit: disqualify with a reason. The lead is kept."}</li>
        </ul>
      </div>
    </RecordPath>}

    <div class="rec-split">
      <div class="rec-main">
        <section class="ws-sheet-panel" id="activity" aria-label={vi ? "Hoạt động và chi tiết" : "Activity and details"}>
          <RecordTabs label={vi ? "Phần của Lead" : "Lead sections"} current={tab} tabs={[{ key: "activity", label: vi ? "Hoạt động" : "Activity", href: `${here}#activity` }, { key: "details", label: vi ? "Chi tiết" : "Details", href: `${here}?tab=details#activity` }]} />
          {tab === "activity" ? <div class="rec-body">
            {canEdit && <div class="rec-compose"><a class="ws-btn sm" href="#sheet-note">{vi ? "Ghi chú" : "Add note"}</a>{lead.state === "open" && <a class="ws-btn sm" href="#sheet-edit">{vi ? "Đặt bước tiếp theo" : "Set next step"}</a>}</div>}
            <p class="rec-feed-h"><span>{vi ? "Sắp tới & quá hạn" : "Upcoming and overdue"}</span></p>
            {lead.state === "open" && lead.next_action ? <Feed empty="" items={[{ title: lead.next_action, meta: vi ? "Bước tiếp theo" : "Next step", when: lead.next_action_due ? formatDate(lead.next_action_due, lang) : (vi ? "Chưa có hạn" : "No due date"), kind: "task" }]} /> : <p class="rec-path-note">{vi ? "Chưa có bước tiếp theo." : "No next step set."}</p>}
            <p class="rec-feed-h"><span>{vi ? "Lịch sử" : "History"}</span><span>{events.length}</span></p>
            <Feed items={feed} empty={vi ? "Chưa có hoạt động." : "No activity yet."} />
          </div> : <div class="rec-body">
            <h3 class="rec-sec">{vi ? "Thông tin Lead" : "Lead information"}</h3>
            <dl class="rec-fields">
              <div><dt>{fieldLabels.name}</dt><dd>{lead.name}</dd></div>
              <div><dt>{vi ? "Chức danh" : "Job title"}</dt><dd>{lead.job_title || "—"}</dd></div>
              <div><dt>{fieldLabels.company}</dt><dd>{lead.company}</dd></div>
              <div><dt>{vi ? "Điện thoại / Zalo" : "Phone / Zalo"}</dt><dd>{lead.phone || "—"}</dd></div>
              <div><dt>Email</dt><dd>{lead.email || "—"}</dd></div>
              <div><dt>{vi ? "Ngành" : "Industry"}</dt><dd>{lead.industry || "—"}</dd></div>
              <div><dt>{vi ? "Khu vực" : "Area"}</dt><dd>{lead.region || "—"}</dd></div>
              <div><dt>{vi ? "Nhu cầu, theo lời họ" : "Need, in their words"}</dt><dd>{lead.need || "—"}</dd></div>
            </dl>
            <h3 class="rec-sec">{vi ? "Thông tin hệ thống" : "System information"}</h3>
            <dl class="rec-fields">
              <div><dt>{vi ? "Tình trạng" : "State"}</dt><dd>{stateName[lead.state][vi ? 1 : 0]}{lead.state === "open" ? ` · ${statusLabel(process, lead.status_id, vi)}` : ""}</dd></div>
              <div><dt>{vi ? "Phiên bản quy trình Lead" : "Lead process version"}</dt><dd>v{process.version}</dd></div>
              <div><dt>{vi ? "Tạo lúc" : "Created"}</dt><dd>{formatDateTime(lead.created_at, lang)}</dd></div>
              <div><dt>{vi ? "Sửa lần cuối" : "Last modified"}</dt><dd>{formatDateTime(lead.updated_at, lang)}</dd></div>
            </dl>
          </div>}
        </section>
      </div>
      <aside class="rec-side" aria-label={vi ? "Liên quan" : "Related"}>
        <section class="ws-sheet-panel" aria-labelledby="rel-h">
          <div class="rec-head"><h2 id="rel-h">{vi ? "Liên quan" : "Related"}</h2></div>
          <div class="rec-body">
            {dupCount > 0 && <div class="rec-alert"><span class="rec-feed-ic warn" aria-hidden="true">!</span><div>
              <strong>{vi ? `Phát hiện trùng: ${dupCount} bản ghi có thể trùng` : `Possible duplicates: ${dupCount}`}</strong>
              <ul class="rec-cv-dups">
                {matches.accounts.map((item) => <li><span>{vi ? "Công ty" : "Company"} “{item.name}”</span><span class="ws-badge warn">{item.reason === "phone" ? (vi ? "Cùng số điện thoại" : "Same phone") : (vi ? "Cùng tên" : "Same name")}</span></li>)}
                {matches.contacts.map((item) => <li><span>{vi ? "Liên hệ" : "Contact"} “{item.name}” · {item.account_name}</span></li>)}
              </ul>
              <p>{vi ? "Kiểm tra trước khi chuyển đổi; trong hộp chuyển đổi có thể chọn bản ghi có sẵn." : "Check before converting; the conversion dialog lets you use the existing record."}</p>
            </div></div>}
            <RelatedList title={vi ? "Nguồn và đồng ý" : "Source and consent"} vi={vi} icon="referrals" tone="lead">
              <div class="ws-rl-row">
                <div class="rec-rl-f"><span>{vi ? "Nguồn Lead" : "Lead source"}</span><span>{label(lang, "channel", lead.source_channel)}</span></div>
                {lead.source_detail && <div class="rec-rl-f"><span>{vi ? "Chi tiết nguồn" : "Source detail"}</span><span>{lead.source_detail}</span></div>}
                {lead.referrer_id && <div class="rec-rl-f"><span>{vi ? "Người giới thiệu" : "Referrer"}</span><span>{person(lead.referrer_id)}</span></div>}
                <div class="rec-rl-f"><span>{vi ? "Đồng ý liên hệ" : "Contact consent"}</span><span>{label(lang, "consent", lead.consent_status)}</span></div>
                {lead.consent_evidence && <div class="rec-rl-f"><span>{vi ? "Bằng chứng" : "Evidence"}</span><span>{lead.consent_evidence}</span></div>}
              </div>
            </RelatedList>
            {lead.state === "converted" && <RelatedList title={vi ? "Đã chuyển thành" : "Converted to"} vi={vi} icon="pipeline" tone="opportunity">
              {lead.converted_opportunity_id && <div class="ws-rl-row"><a href={`${base}/${lead.converted_opportunity_id}`}>{vi ? "Cơ hội" : "Opportunity"}</a></div>}
              {lead.converted_account_id && <div class="ws-rl-row"><a href={`${base}/accounts/${lead.converted_account_id}`}>{vi ? "Công ty" : "Company"}</a></div>}
              {lead.converted_contact_id && <div class="ws-rl-row"><a href={`${base}/contacts/${lead.converted_contact_id}`}>{vi ? "Liên hệ" : "Contact"}</a></div>}
            </RelatedList>}
          </div>
        </section>
      </aside>
    </div>
  </div>

  {canEdit && <Sheet id="sheet-edit" vi={vi} title={vi ? "Sửa Lead" : "Edit lead"} open={open("lead_save")} closeHref={here} action={`${here}#sheet-edit`}>
    
        <Hidden intent="lead_save" state={state} version={lead.version} />
        <div class="crm-form-grid">
          <Field name="name" id="ld-name" label={fieldLabels.name} lang={lang} value={v("lead_save", "name", lead.name)} error={e("lead_save", "name")} required maxlength={160} />
          <Field name="job_title" id="ld-title" label={vi ? "Chức danh" : "Job title"} lang={lang} value={v("lead_save", "job_title", lead.job_title)} maxlength={120} />
          <Field name="company" id="ld-company" label={fieldLabels.company} lang={lang} value={v("lead_save", "company", lead.company)} error={e("lead_save", "company")} required maxlength={160} />
          <Field name="phone" id="ld-phone" type="tel" label={vi ? "Điện thoại / Zalo" : "Phone / Zalo"} lang={lang} value={v("lead_save", "phone", lead.phone)} error={e("lead_save", "phone")} maxlength={40} inputmode="tel" />
          <Field name="email" id="ld-email" type="email" label="Email" lang={lang} value={v("lead_save", "email", lead.email)} error={e("lead_save", "email")} maxlength={254} />
          <Field name="industry" id="ld-industry" label={vi ? "Ngành" : "Industry"} lang={lang} value={v("lead_save", "industry", lead.industry)} maxlength={120} />
          <Field name="region" id="ld-region" label={vi ? "Khu vực" : "Area"} lang={lang} value={v("lead_save", "region", lead.region)} maxlength={120} />
          <Field name="playbook_key" id="ld-pb" type="select" label={vi ? "Nhu cầu thuộc playbook" : "Playbook"} lang={lang} value={v("lead_save", "playbook_key", lead.playbook_key)} error={e("lead_save", "playbook_key")} options={[{ value: "", label: vi ? "Chưa rõ" : "Not known yet" }, ...playbooks.filter((item) => item.kind !== "renewal").map((item) => ({ value: item.playbook_key, label: vi ? item.name_vi : item.name_en }))]} />
          <Field name="next_action" id="ld-next" label={vi ? "Bước tiếp theo" : "Next step"} lang={lang} value={v("lead_save", "next_action", lead.next_action)} maxlength={500} />
          <Field name="next_action_due" id="ld-due" type="date" label={vi ? "Hạn bước tiếp theo" : "Next step due"} lang={lang} value={v("lead_save", "next_action_due", lead.next_action_due)} error={e("lead_save", "next_action_due")} />
        </div>
        <Field name="need" id="ld-need" type="textarea" label={vi ? "Nhu cầu, theo lời họ" : "Need, in their words"} lang={lang} value={v("lead_save", "need", lead.need)} maxlength={1500} />
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu" : "Save"}</button></Fragment>
  </Sheet>}

  {canEdit && <Sheet id="sheet-note" vi={vi} title={vi ? "Ghi chú" : "Add note"} open={open("lead_note")} closeHref={here} action={`${here}#activity`}>
    
        <Hidden intent="lead_note" state={state} />
        <Field name="note" id="ln-note" type="textarea" label={vi ? "Ghi chú (cuộc gọi, tin nhắn, gặp mặt)" : "Note (call, message, meeting)"} lang={lang} value={v("lead_note", "note")} error={e("lead_note", "note")} maxlength={3000} />
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu ghi chú" : "Save note"}</button></Fragment>
  </Sheet>}

  {canEdit && lead.state === "open" && <Sheet id="sheet-status" vi={vi} title={vi ? "Chọn trạng thái Lead" : "Choose lead status"} open={open("lead_status")} closeHref={here} action={here}>
    
        <Hidden intent="lead_status" state={state} version={lead.version} />
        <Field name="status_id" type="select" label={vi ? "Trạng thái" : "Status"} lang={lang} value={lead.status_id} error={e("lead_status", "status_id")} options={statuses.map((item) => ({ value: item.id, label: vi ? item.vi : item.en }))} />
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu trạng thái" : "Save status"}</button></Fragment>
  </Sheet>}

  {canAssign && <Sheet id="sheet-assign" vi={vi} title={vi ? "Đổi người phụ trách" : "Change owner"} open={open("lead_assign")} closeHref={here} action={here}>
    
        <Hidden intent="lead_assign" state={state} version={lead.version} />
        <Field name="owner_id" id="la-owner" type="select" label={vi ? "Giao cho" : "Assign to"} lang={lang} value={lead.owner_id ?? ""} error={e("lead_assign", "owner_id")} options={[{ value: "", label: vi ? "Chọn người" : "Choose" }, ...owners.filter((owner) => owner.id !== ctx.actor.id || ctx.actor.configure).map((owner) => ({ value: owner.id, label: owner.label }))]} />
        <p class="crm-help">{vi ? "Người phụ trách cũng là người bán được ghi công khi chuyển đổi. Không tự giao Lead chưa có người giới thiệu cho chính mình." : "The owner is also credited as seller on conversion. You cannot assign an unattributed lead to yourself."}</p>
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Giao" : "Assign"}</button></Fragment>
  </Sheet>}

  {canEdit && <Sheet id="sheet-disqualify" vi={vi} title={vi ? "Không tiếp tục" : "Disqualify"} open={open("lead_disqualify")} closeHref={here} action={here}>
    
        <Hidden intent="lead_disqualify" state={state} version={lead.version} />
        <p class="crm-help">{vi ? "Lead được giữ lại kèm lý do. Danh sách lý do do admin đặt trong Trạng thái Lead." : "The lead is kept with the reason. Admins set the reasons in Lead statuses."}</p>
        <Field name="reason_id" type="select" label={fieldLabels.reason_id} lang={lang} value={v("lead_disqualify", "reason_id")} error={e("lead_disqualify", "reason_id")} required options={[{ value: "", label: vi ? "Chọn lý do" : "Choose a reason" }, ...process.def.disqualify_reasons.map((item) => ({ value: item.id, label: vi ? item.vi : item.en }))]} />
        <Field name="disqualify_note" type="textarea" label={vi ? "Ghi chú" : "Note"} lang={lang} value={v("lead_disqualify", "disqualify_note")} maxlength={1000} />
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Không tiếp tục" : "Disqualify"}</button></Fragment>
  </Sheet>}

  {canReopen && <Sheet id="sheet-reopen" vi={vi} title={vi ? "Mở lại Lead" : "Reopen lead"} open={open("lead_reopen")} closeHref={here} action={here}>
    
        <Hidden intent="lead_reopen" state={state} version={lead.version} />
        <Field name="reopen_reason" label={fieldLabels.reopen_reason} lang={lang} value={v("lead_reopen", "reopen_reason")} error={e("lead_reopen", "reopen_reason")} required maxlength={500} />
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Mở lại" : "Reopen"}</button></Fragment>
  </Sheet>}

  {canEdit && lead.state === "open" && (lead.owner_id && convert
    ? <Sheet id="convert" vi={vi} variant="dialog" width="1040px" open closeHref={here} title={vi ? `Chuyển Lead thành cơ hội: ${lead.name} · ${lead.company}` : `Convert lead: ${lead.name} · ${lead.company}`} action="#convert">
        <Hidden intent="lead_convert" state={state} version={lead.version} />
        <fieldset class="rec-cv">
          <legend><span><span class="rec-rl-i" style="background:#5B4CC4" aria-hidden="true">A</span>{vi ? "Công ty" : "Company"}</span>{matches.accounts.length > 0 && <span class="ws-badge warn">{vi ? `${matches.accounts.length} công ty có thể trùng` : `${matches.accounts.length} possible duplicates`}</span>}</legend>
          <div class="rec-cv-cols">
            <div class="rec-cv-opt">
              <label><input type="radio" name="account_mode" value="new" checked={accountMode === "new"} />{vi ? "Tạo mới" : "Create new"}</label>
              <Field name="account_name" label={fieldLabels.account_name} lang={lang} value={v("lead_convert", "account_name", lead.company)} error={convertErrors.account_name} maxlength={160} />
            </div>
            <span class="rec-cv-or">{vi ? "HOẶC" : "OR"}</span>
            <div class="rec-cv-opt">
              <label><input type="radio" name="account_mode" value="existing" checked={accountMode === "existing"} />{vi ? "Chọn công ty có sẵn" : "Use an existing company"}</label>
              {matches.accounts.length > 0 && <ul class="rec-cv-dups">{matches.accounts.map((item) => <li><span>{item.name}{item.region ? ` · ${item.region}` : ""}</span><span class="ws-badge warn">{item.reason === "phone" ? (vi ? "Cùng số điện thoại" : "Same phone") : (vi ? "Cùng tên" : "Same name")}</span></li>)}</ul>}
              <Field name="account_id" type="select" label={fieldLabels.account_id} lang={lang} value={accountChoice} error={convertErrors.account_id} options={[{ value: "", label: vi ? "Chọn công ty" : "Choose a company" }, ...matches.accounts.map((item) => ({ value: item.id, label: `${item.name} · ${vi ? "có thể trùng" : "possible duplicate"}` })), ...companies.filter((item) => !matches.accounts.some((match) => match.id === item.id)).map((item) => ({ value: item.id, label: item.region ? `${item.name} · ${item.region}` : item.name }))]} help={vi ? "Chỉ hiện công ty bạn được làm việc." : "Only companies you may work on are listed."} />
            </div>
          </div>
        </fieldset>
        <fieldset class="rec-cv">
          <legend><span><span class="rec-rl-i" style="background:#0F7B7B" aria-hidden="true">C</span>{vi ? "Liên hệ" : "Contact"}</span>{matches.contacts.length > 0 && <span class="ws-badge warn">{vi ? `${matches.contacts.length} liên hệ có thể trùng` : `${matches.contacts.length} possible duplicates`}</span>}</legend>
          <div class="rec-cv-cols">
            <div class="rec-cv-opt">
              <label><input type="radio" name="contact_mode" value="new" checked={contactMode === "new"} />{vi ? `Tạo mới: ${lead.name}` : `Create new: ${lead.name}`}</label>
              <Field name="contact_role" type="select" label={vi ? "Vai trò của liên hệ" : "Contact role"} lang={lang} value={v("lead_convert", "contact_role", "owner")} options={options(lang, "role")} />
            </div>
            <span class="rec-cv-or">{vi ? "HOẶC" : "OR"}</span>
            <div class="rec-cv-opt">
              <label><input type="radio" name="contact_mode" value="existing" checked={contactMode === "existing"} />{vi ? "Chọn liên hệ có sẵn ở công ty đã chọn" : "Use an existing contact at the chosen company"}</label>
              {contactChoices.length ? <Field name="contact_id" type="select" label={fieldLabels.contact_id} lang={lang} value={v("lead_convert", "contact_id", contactChoices[0]?.value ?? "")} error={convertErrors.contact_id} options={contactChoices} />
                : <p class="crm-help">{vi ? "Chưa có liên hệ phù hợp. Chọn công ty rồi bấm “Tải liên hệ của công ty”." : "No matching contacts. Choose a company, then select “Load the company's contacts”."}</p>}
              {convertErrors.contact_mode && <p class="crm-error">{vi ? "Liên hệ có sẵn cần đi cùng công ty có sẵn." : "An existing contact needs an existing company."}</p>}
              <button class="ws-btn sm" type="submit" formmethod="get" formaction="#convert" name="convert" value="1">{vi ? "Tải liên hệ của công ty" : "Load the company's contacts"}</button>
            </div>
          </div>
        </fieldset>
        <fieldset class="rec-cv">
          <legend><span><span class="rec-rl-i" style="background:#006093" aria-hidden="true">O</span>{vi ? "Cơ hội · tạo mới" : "Opportunity · new"}</span></legend>
          <div class="rec-cv-cols" style="grid-template-columns:minmax(0,1fr)">
            <div class="rec-cv-opt" style="border:2px solid #006093;background:#F7FBFE"><div class="crm-form-grid">
              <Field name="title" label={fieldLabels.title} lang={lang} value={v("lead_convert", "title", lead.company)} error={convertErrors.title} required maxlength={160} />
              <Field name="playbook_key" type="select" label={vi ? "Playbook · giai đoạn đầu" : "Playbook · first stage"} lang={lang} value={v("lead_convert", "playbook_key", lead.playbook_key || playbooks[0]?.playbook_key || "")} error={convertErrors.playbook_key} options={playbooks.map((item) => ({ value: item.playbook_key, label: `${vi ? item.name_vi : item.name_en} · ${vi ? item.def.stages[0].vi : item.def.stages[0].en}` }))} />
              <Field name="estimated_value_vnd" label={vi ? "Giá trị HĐ mong đợi (VND, để trống nếu chưa biết)" : "Expected value (VND, blank if unknown)"} lang={lang} value={v("lead_convert", "estimated_value_vnd")} error={convertErrors.estimated_value_vnd} inputmode="numeric" />
              <Field name="win_probability" label={vi ? "Tỉ lệ thành công % (để trống nếu chưa biết)" : "Win probability % (blank if unknown)"} lang={lang} value={v("lead_convert", "win_probability")} error={convertErrors.win_probability} inputmode="numeric" />
            </div></div>
          </div>
        </fieldset>
        <dl class="rec-fields">
          <div><dt>{vi ? "Người phụ trách bản ghi mới" : "Owner of the new records"}</dt><dd>{person(lead.owner_id)}</dd></div>
          <div><dt>{vi ? "Nguồn giữ trên cơ hội" : "Source kept on the opportunity"}</dt><dd>{label(lang, "channel", lead.source_channel)}{lead.referrer_id ? ` · ${person(lead.referrer_id)}` : ""}</dd></div>
        </dl>
        <p class="crm-help">{vi ? "Người phụ trách Lead cũng là người bán được ghi công. Sau khi chuyển đổi, Lead chỉ còn để đọc." : "The lead's owner is also credited as seller. After conversion the lead is read-only."}</p>
      <Fragment slot="foot"><a class="ws-btn" href={here}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Chuyển đổi" : "Convert"}</button></Fragment>
  </Sheet>
    : <Sheet id="convert" vi={vi} variant="dialog" closeHref={here} title={vi ? `Chuyển Lead thành cơ hội: ${lead.name} · ${lead.company}` : `Convert lead: ${lead.name} · ${lead.company}`}>
        {!lead.owner_id ? <p class="crm-empty">{vi ? "Cần phân công người phụ trách trước." : "Assign an owner first."}</p> : <p class="crm-help"><a href="?convert=1#convert">{vi ? "Mở hộp chuyển đổi" : "Open the conversion dialog"}</a></p>}
      </Sheet>)}
</CrmShell>
