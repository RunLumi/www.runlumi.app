---
// Search, owner filter (team only) and pagination shared by the Companies and
// Contacts lists. Plain GET forms and links; no client script.
import type { OwnerOption } from "../../lib/crm/access";
import type { DirectoryFilters } from "../../lib/crm/directory";

interface Props { vi: boolean; manager: boolean; filters: DirectoryFilters; owners: OwnerOption[]; page: number; pages: number; position: "top" | "bottom"; searchLabel: string }
const { vi, manager, filters, owners, page, pages, position, searchLabel } = Astro.props;
const query = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Object.entries({ ...filters, ...changes }).filter(([, value]) => value));
  return params.toString() ? `?${params}` : "?";
};
---
{position === "top" ? <form class="crm-sheet crm-filter" method="get" aria-label={vi ? "Bộ lọc" : "Filters"}>
  <div class="crm-field"><label for="q">{searchLabel}</label><input class="crm-input" id="q" name="q" value={filters.q} maxlength="120" /></div>
  {manager && <div class="crm-field"><label for="owner">{vi ? "Người quản lý" : "Managed by"}</label><select class="crm-select" id="owner" name="owner"><option value="">{vi ? "Tất cả" : "Anyone"}</option><option value="unassigned" selected={filters.owner === "unassigned"}>{vi ? "Chưa có người quản lý" : "Nobody yet"}</option>{owners.map((owner) => <option value={owner.id} selected={filters.owner === owner.id}>{owner.label}</option>)}</select></div>}
  <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Lọc" : "Apply"}</button><a class="crm-link" href="?">{vi ? "Xóa lọc" : "Clear"}</a></div>
</form> : pages > 1 && <nav class="crm-pagination" aria-label={vi ? "Phân trang" : "Pagination"}>
  <span class="crm-meta">{vi ? `Trang ${page} / ${pages}` : `Page ${page} of ${pages}`}</span>
  <span class="crm-actions">{page > 1 && <a class="crm-button small secondary" href={query({ page: String(page - 1) })}>{vi ? "Trước" : "Previous"}</a>}{page < pages && <a class="crm-button small secondary" href={query({ page: String(page + 1) })}>{vi ? "Tiếp" : "Next"}</a>}</span>
</nav>}
