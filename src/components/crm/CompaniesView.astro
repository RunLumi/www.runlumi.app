---
// Companies list view (board Accounts). Story: docs/governance/USER-STORIES.md
// § CRM list screens (Accounts, Contacts). "Thêm công ty" opens a sheet.
import CrmShell from "../../layouts/CrmShell.astro";
import ListHeader from "../workspace/ui/ListHeader.astro";
import ButtonGroup from "../workspace/ui/ButtonGroup.astro";
import ListToolbar from "../workspace/ui/ListToolbar.astro";
import Sheet from "../workspace/ui/Sheet.astro";
import ListFilters from "./ListFilters.astro";
import Glyph from "./Glyph.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { options } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { CompaniesProps } from "../../lib/crm/routes/directory";
import "../../styles/crm-sales.css";
import "../../styles/crm-lists.css";

type Props = CompaniesProps;
const { ctx, state, filters, rows, total, page, pages, owners, names } = Astro.props;
const { lang, vi, base, actor } = ctx;
const v = (name: string, fallback = "") => valueFor(state, "account_create", name, fallback);
const e = (name: string) => errorFor(state, "account_create", name);
const manager = (id: string | null) => id ? (names[id]?.name ?? (id === actor.id ? actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chưa có người quản lý" : "Nobody yet");
const fieldLabels: Record<string, string> = vi
  ? { name: "Tên công ty", owner_id: "Người quản lý", contact_name: "Người liên hệ", contact_phone: "Điện thoại", contact_email: "Email", contact_consent_evidence: "Bằng chứng đồng ý" }
  : { name: "Company name", owner_id: "Managed by", contact_name: "Contact", contact_phone: "Phone", contact_email: "Email", contact_consent_evidence: "Consent evidence" };
const query = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Object.entries({ ...filters, ...changes }).filter(([, value]) => value));
  return params.toString() ? `${base}/accounts?${params}` : `${base}/accounts`;
};
const lists = actor.manager ? [
  { label: vi ? "Tất cả công ty" : "All companies", href: query({ owner: "", page: "" }), current: !filters.owner },
  { label: vi ? "Công ty tôi quản lý" : "Companies I manage", href: query({ owner: actor.id, page: "" }), current: filters.owner === actor.id },
  { label: vi ? "Chưa có người quản lý" : "Nobody managing yet", href: query({ owner: "unassigned", page: "" }), current: filters.owner === "unassigned" },
] : [];
const title = lists.find((item) => item.current)?.label ?? (actor.manager ? (vi ? `Công ty của ${owners.find((owner) => owner.id === filters.owner)?.label ?? "người khác"}` : `Companies of ${owners.find((owner) => owner.id === filters.owner)?.label ?? "another person"}`) : (vi ? "Công ty của tôi" : "My companies"));
const meta = [vi ? `${total} mục` : `${total} ${total === 1 ? "item" : "items"}`, vi ? "Sắp xếp theo tên công ty" : "Sorted by company name", actor.manager ? "" : (vi ? "Công ty bạn quản lý hoặc đang có cơ hội" : "Companies you manage or have opportunities with"), filters.q ? (vi ? `Tìm “${filters.q}”` : `Search “${filters.q}”`) : ""].filter(Boolean).join(" · ");
const sheetOpen = Astro.url.searchParams.get("new") === "1" || (state.intent === "account_create" && (Object.keys(state.errors).length > 0 || state.serverError || state.conflict));
const closeHref = query({ new: "" });
---
<CrmShell title={vi ? "Công ty" : "Companies"} lang={lang} actor={actor} current="companies">
  <div class="cl-stack">
    <ListHeader vi={vi} icon="companies" tone="company" object={vi ? "Công ty" : "Companies"} title={title} meta={meta} lists={lists}>
      <ButtonGroup slot="actions" label={vi ? "Hành động" : "Actions"}><a class="ws-btn" href={`${query({ new: "1" })}#new-company`}>{vi ? "Tạo" : "New"}</a></ButtonGroup>
      <ListToolbar slot="tools" vi={vi} q={filters.q} keep={{ owner: filters.owner }}>
        <a class="ws-btn icon" href={query({})} aria-label={vi ? "Làm mới" : "Refresh"}><Glyph name="refresh" /></a>
        {actor.manager && <ListFilters vi={vi} active={filters.owner ? 1 : 0} clearHref={query({ owner: "", page: "" })}>
          {filters.q && <input type="hidden" name="q" value={filters.q} />}
          <div class="crm-field"><label for="owner">{vi ? "Người quản lý" : "Managed by"}</label><select class="crm-select" id="owner" name="owner"><option value="">{vi ? "Tất cả" : "Anyone"}</option><option value="unassigned" selected={filters.owner === "unassigned"}>{vi ? "Chưa có người quản lý" : "Nobody yet"}</option>{owners.map((owner) => <option value={owner.id} selected={filters.owner === owner.id}>{owner.label}</option>)}</select></div>
        </ListFilters>}
      </ListToolbar>
      {rows.length ? <div class="cl-tbl-wrap" tabindex="0" role="region" aria-label={vi ? "Bảng công ty, cuộn ngang được" : "Company table, scrolls sideways"}><table class="cl-tbl">
        <thead><tr><th class="fz fzr" scope="col"><span class="crm-sr">#</span></th><th class="fz fzn" scope="col">{vi ? "Tên công ty" : "Company name"}</th><th scope="col">{vi ? "Ngành" : "Industry"}</th><th scope="col">{vi ? "Khu vực" : "Area"}</th><th scope="col">{vi ? "Địa chỉ" : "Address"}</th><th scope="col" class="r">{vi ? "Liên hệ" : "Contacts"}</th><th scope="col" class="r">{vi ? "Cơ hội đang mở" : "Open opportunities"}</th><th scope="col">{vi ? "Người quản lý" : "Managed by"}</th><th scope="col">{vi ? "Hành động" : "Actions"}</th></tr></thead>
        <tbody>{rows.map((row, index) => <tr>
          <td class="fz fzr">{(page - 1) * 50 + index + 1}</td>
          <td class="fz fzn"><a href={`${base}/accounts/${row.id}`}>{row.name}</a>{row.do_not_contact ? <> <span class="cl-badge danger">{vi ? "Không liên hệ" : "Do not contact"}</span></> : null}</td>
          <td>{row.industry || "—"}</td><td>{row.region || "—"}</td><td>{row.address || "—"}</td><td class="r">{row.contacts}</td><td class="r">{row.open_opportunities}</td><td>{manager(row.owner_id)}</td>
          <td>{!row.do_not_contact && row.contacts > 0 ? <a href={`${base}/new?company=${row.id}`}>{vi ? "Tạo cơ hội" : "New opportunity"}</a> : "—"}</td>
        </tr>)}</tbody>
      </table></div> : <p class="cl-empty">{filters.q || filters.owner ? (vi ? "Không có công ty khớp bộ lọc. Xóa lọc hoặc đổi từ khóa." : "No companies match. Clear the filters or change the search.") : (vi ? "Chưa có công ty. Chọn Tạo để thêm công ty đầu tiên, hoặc chuyển đổi một Lead." : "No companies yet. Choose New to add the first one, or convert a lead.")}</p>}
      {rows.length > 0 && <p class="cl-hint"><span>{vi ? "Cột số dòng và Tên công ty cố định khi cuộn ngang." : "The row number and Company name stay in place when scrolling sideways."}</span><span>{vi ? "Bấm tên để mở trang chi tiết" : "Select a name to open the record"}</span></p>}
      {pages > 1 && <nav class="cl-pager" aria-label={vi ? "Phân trang" : "Pagination"}><span>{vi ? `Trang ${page} / ${pages}` : `Page ${page} of ${pages}`}</span><span>{page > 1 && <a class="ws-btn sm" href={query({ page: String(page - 1) })}>{vi ? "Trước" : "Previous"}</a>}{page < pages && <a class="ws-btn sm" href={query({ page: String(page + 1) })}>{vi ? "Tiếp" : "Next"}</a>}</span></nav>}
    </ListHeader>
  </div>

  <Sheet id="new-company" title={vi ? "Thêm công ty" : "Add a company"} vi={vi} open={sheetOpen} closeHref={closeHref} action={`${query({ new: "1" })}#new-company`} width="640px">
    <FormNotices state={state} lang={lang} fieldLabels={fieldLabels} />
    <p class="cl-sheet-tip">{vi ? "Tạo công ty và người liên hệ trước; mở cơ hội và giao cho người bán sau, trên trang công ty." : "Add the company and its contacts first; open an opportunity and assign it later, on the company page."}</p>
          <Hidden intent="account_create" state={state} />
      <p class="cl-sheet-sec">{vi ? "Thông tin công ty" : "Company details"}</p>
      <div class="crm-form-grid">
        <Field name="name" wide label={fieldLabels.name} lang={lang} value={v("name")} error={e("name")} required maxlength={160} autocomplete="organization" />
        <Field name="industry" label={vi ? "Ngành" : "Industry"} lang={lang} value={v("industry")} maxlength={120} />
        <Field name="region" label={vi ? "Khu vực" : "Area"} lang={lang} value={v("region")} maxlength={120} />
        <Field name="address" wide label={vi ? "Địa chỉ" : "Address"} lang={lang} value={v("address")} maxlength={300} />
        {actor.manager && <Field name="owner_id" type="select" label={fieldLabels.owner_id} lang={lang} value={v("owner_id", actor.id)} error={e("owner_id")} options={owners.map((owner) => ({ value: owner.id, label: owner.label }))} />}
      </div>
      <p class="cl-sheet-sec" style="margin-top:18px">{vi ? "Người liên hệ đầu tiên (không bắt buộc)" : "First contact (optional)"}</p>
      <div class="crm-form-grid">
        <Field name="contact_name" label={fieldLabels.contact_name} lang={lang} value={v("contact_name")} error={e("contact_name")} maxlength={160} autocomplete="off" />
        <Field name="contact_role" type="select" label={vi ? "Vai trò" : "Role"} lang={lang} value={v("contact_role", "owner")} error={e("contact_role")} options={options(lang, "role")} />
        <Field name="contact_phone" type="tel" label={fieldLabels.contact_phone} lang={lang} value={v("contact_phone")} error={e("contact_phone")} maxlength={40} inputmode="tel" autocomplete="off" />
        <Field name="contact_email" type="email" label="Email" lang={lang} value={v("contact_email")} error={e("contact_email")} maxlength={254} autocomplete="off" />
      </div>
      <Fragment slot="foot"><a class="ws-btn" href={closeHref}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu" : "Save"}</button></Fragment>
  </Sheet>
</CrmShell>
