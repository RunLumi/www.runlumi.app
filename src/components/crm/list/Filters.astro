---
// Toolbar filter popover: the list's GET filter form behind a filter button.
import Icon from "./Icon.astro";
interface Props { vi: boolean; active?: number; clearHref: string }
const { vi, active = 0, clearHref } = Astro.props;
---
<details class="cl-pop cl-filters">
  <summary class:list={["cl-btn icon", { on: active > 0 }]} aria-label={vi ? `Bộ lọc${active ? ` (${active} đang dùng)` : ""}` : `Filters${active ? ` (${active} in use)` : ""}`}><Icon name="filter" />{active > 0 && <span class="cl-dot-n">{active}</span>}</summary>
  <form class="cl-menu cl-filter-form" method="get" aria-label={vi ? "Bộ lọc" : "Filters"}>
    <p class="cl-menu-h">{vi ? "Lọc danh sách" : "Filter this list"}</p>
    <slot />
    <div class="cl-filter-actions"><a class="cl-btn sm" href={clearHref}>{vi ? "Xóa lọc" : "Clear"}</a><button class="cl-btn sm primary" type="submit">{vi ? "Áp dụng" : "Apply"}</button></div>
  </form>
</details>
