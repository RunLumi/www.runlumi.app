---
// Create sheet (boards NewEvent; "Tạo" on every list): a centred dialog over a
// scrim. It opens without script, either from a link to its #id (:target) or
// because the server re-rendered it with errors (open). Closing is a link.
import Icon from "./Icon.astro";
interface Props { id: string; title: string; vi: boolean; open?: boolean; closeHref: string; wide?: boolean }
const { id, title, vi, open = false, closeHref, wide = false } = Astro.props;
---
<div class:list={["cl-sheet-wrap", { open }]} id={id}>
  <a class="cl-scrim" href={closeHref} tabindex="-1" aria-hidden="true"></a>
  <section class:list={["cl-sheet", { wide }]} role="dialog" aria-modal="true" aria-labelledby={`${id}-h`} tabindex="-1">
    <header class="cl-sheet-h">
      <h2 id={`${id}-h`}>{title}</h2>
      <a class="cl-sheet-x" href={closeHref} aria-label={vi ? "Đóng" : "Close"}><Icon name="close" size={18} /></a>
    </header>
    <div class="cl-sheet-b"><slot /></div>
  </section>
</div>
