---
// CRM stats: up to five filter sets compared side by side. Server-rendered
// HTML/CSS and one SVG line layer, no client script. Each set keeps its
// colour slot (validated categorical palette, docs/crm/STATS.md); colour
// never stands alone: every set is named in a legend and every chart has a
// table view. Rates with nothing to divide by show "—", never 0%.
import CrmShell from "../../layouts/CrmShell.astro";
import PageHeader from "../workspace/ui/PageHeader.astro";
import { label } from "../../lib/crm/i18n";
import { formatVnd } from "../../lib/crm/money";
import { MAX_SETS, type StatsSet, rate, splitWard, statsSearch } from "../../lib/crm/stats";
import { sourceChannels } from "../../lib/crm/records";
import type { StatsProps } from "../../lib/crm/routes/stats";
import "../../styles/crm-stats.css";

const { ctx, query, playbooks, playbook, results, breakdown, options, owners, gaps, filled, error } = Astro.props as StatsProps;
const { vi, lang, base, actor } = ctx;
const t = (en: string, viText: string) => (vi ? viText : en);
const self = `${base}/stats`;
const n = query.sets.length;
const num = (value: number) => new Intl.NumberFormat(vi ? "vi-VN" : "en-US").format(value);
const pct = (value: number | null) => value === null ? "—" : `${new Intl.NumberFormat(vi ? "vi-VN" : "en-US", { maximumFractionDigits: 1 }).format(value)}%`;
const ownerName = (id: string) => id === "unassigned" ? t("Unassigned", "Chưa phân công") : owners.find((item) => item.id === id)?.label ?? id;

/** A set's name: what the person typed, else its filters, else "All". */
function setName(set: StatsSet, index: number): string {
  if (set.label) return set.label;
  const ward = splitWard(set.ward);
  const parts = [ward.ward, set.district || ward.district, set.city || ward.city, set.industry, set.source ? label(lang, "channel", set.source) : "", set.owner ? ownerName(set.owner) : ""].filter(Boolean);
  return parts.length ? parts.join(" · ") : n > 1 ? t(`Set ${index + 1}: everything`, `Bộ lọc ${index + 1}: tất cả`) : t("Everything you can see", "Tất cả số liệu bạn được xem");
}
const names = query.sets.map(setName);
const stageName = (id: string) => id === "won" ? t("Won", "Thắng") : (() => { const stage = playbook?.def.stages.find((item) => item.id === id); return stage ? (vi ? stage.vi : stage.en) : id; })();
const removeHref = (index: number) => `${self}${statsSearch(query, { sets: query.sets.filter((_, at) => at !== index), focus: 0 })}`;
const periodLabel = `${query.from.split("-").reverse().join("/")} – ${query.to.split("-").reverse().join("/")}`;

// Trend (one line per set) drawn into a fixed viewBox; text stays in HTML.
const series = results.map((item) => item.stats.series);
const bucketsList = series[0] ?? [];
const weekly = bucketsList.length > 1 && Date.parse(bucketsList[1].bucket) - Date.parse(bucketsList[0].bucket) > 86_400_000;
const trendValue = (row: { leads: number; opportunities: number; won: number }) => row[query.trend];
const trendMax = Math.max(1, ...series.flatMap((rows) => rows.map(trendValue)));
const W = 600, H = 160;
const x = (index: number) => bucketsList.length <= 1 ? W / 2 : (index / (bucketsList.length - 1)) * W;
const y = (value: number) => H - (value / trendMax) * H;
const dayLabel = (day: string) => { const [, m, d] = day.split("-"); return `${Number(d)}/${Number(m)}`; };
const trendNames = { leads: t("New leads", "Lead mới"), opportunities: t("New opportunities", "Cơ hội mới"), won: t("Won deals", "Cơ hội thắng") };

// Funnel: share of each set's first step; the largest relative drop is marked in text.
const funnelSteps = results[0]?.stats.funnel.map((step) => step.id) ?? [];
const biggestDrop = results.map(({ stats }) => {
  let worst = -1, at = "";
  stats.funnel.forEach((step, index) => {
    if (index === 0) return;
    const before = stats.funnel[index - 1].count;
    const drop = before > 0 ? (before - step.count) / before : -1;
    if (drop > worst) { worst = drop; at = step.id; }
  });
  return worst > 0 ? at : "";
});
const pipelineMax = Math.max(1, ...results.flatMap(({ stats }) => stats.pipeline.map((step) => step.count)));
const levelName = { city: t("City / province", "Tỉnh / thành phố"), district: t("District / area", "Quận / khu vực"), ward: t("Ward", "Phường / xã"), industry: t("Industry", "Ngành") };
const metrics: { key: string; name: string; help?: string; value: (stats: typeof results[number]["stats"]) => string }[] = [
  { key: "leads", name: t("New leads", "Lead mới"), value: (s) => num(s.leads) },
  { key: "converted", name: t("Leads converted", "Lead đã chuyển cơ hội"), value: (s) => `${num(s.converted)} (${pct(rate(s.converted, s.leads))})` },
  { key: "disqualified", name: t("Leads disqualified", "Lead không tiếp tục"), value: (s) => num(s.disqualified) },
  { key: "opportunities", name: t("New opportunities", "Cơ hội mới"), value: (s) => num(s.opportunities) },
  { key: "won", name: t("Won (of those)", "Thắng (trong số đó)"), value: (s) => `${num(s.won)} (${pct(rate(s.won, s.opportunities))})` },
  { key: "lost", name: t("Lost (of those)", "Thua (trong số đó)"), value: (s) => num(s.lost) },
  { key: "value", name: t("Won value", "Giá trị đã thắng"), help: t("Only deals with a value; others are not counted as 0.", "Chỉ tính cơ hội đã có giá trị; cơ hội chưa có giá trị không tính là 0."), value: (s) => s.wonValued ? formatVnd(s.wonValue, vi) + (s.wonValued < s.won ? ` (${s.wonValued}/${s.won})` : "") : "—" },
  { key: "open", name: t("Open pipeline now", "Cơ hội đang mở hiện tại"), value: (s) => num(s.openPipeline) },
];
---
<CrmShell title={t("Stats", "Thống kê")} lang={lang} actor={actor} current="stats">
  <PageHeader title={t("Sales stats", "Thống kê bán hàng")} vi={vi} eyebrow="CRM"
    lede={t(`${periodLabel}. Compare up to ${MAX_SETS} filter sets by area, industry, source and owner.`, `${periodLabel}. So sánh tối đa ${MAX_SETS} bộ lọc theo khu vực, ngành, nguồn và người phụ trách.`)} />

  {error && <p class="crm-notice bad" role="alert">{t("That action could not be completed. Try again.", "Chưa thực hiện được thao tác. Hãy thử lại.")}</p>}

  <form class="crm-sheet st-form" method="get" action={self} aria-labelledby="st-filters-h">
    <h2 class="crm-h2" id="st-filters-h">{t("Period and filters", "Thời gian và bộ lọc")}</h2>
    <div class="st-global">
      <div class="crm-field"><label for="st-from">{t("From", "Từ ngày")}</label><input class="crm-input" type="date" id="st-from" name="from" value={query.from} max={query.to} required /></div>
      <div class="crm-field"><label for="st-to">{t("To", "Đến ngày")}</label><input class="crm-input" type="date" id="st-to" name="to" value={query.to} required /></div>
      <div class="crm-field"><label for="st-playbook">{t("Sales process (for the funnel)", "Quy trình bán (cho phễu)")}</label>
        <select class="crm-select" id="st-playbook" name="playbook">{playbooks.map((item) => <option value={item.playbook_key} selected={item.playbook_key === query.playbook}>{vi ? item.name_vi : item.name_en}</option>)}</select></div>
    </div>
    <div class="st-sets">
      {query.sets.map((set, index) => <fieldset class="st-set">
        <legend><i class={`st-key s${index + 1}`} aria-hidden="true"></i>{n > 1 ? t(`Filter set ${index + 1}`, `Bộ lọc ${index + 1}`) : t("Filters", "Bộ lọc")}</legend>
        <div class="st-set-grid">
          <div class="crm-field"><label for={`s${index}-city`}>{t("City / province", "Tỉnh / thành phố")}</label>
            <select class="crm-select" id={`s${index}-city`} name={`s${index}_city`}><option value="">{t("All", "Tất cả")}</option>{options.cities.map((value) => <option selected={value === set.city}>{value}</option>)}{set.city && !options.cities.includes(set.city) && <option selected>{set.city}</option>}</select></div>
          <div class="crm-field"><label for={`s${index}-district`}>{t("District / area", "Quận / khu vực")}</label>
            <select class="crm-select" id={`s${index}-district`} name={`s${index}_district`}><option value="">{t("All", "Tất cả")}</option>{options.districts.filter((item) => !set.city || !item.city || item.city === set.city).map((item) => <option value={item.value} selected={item.value === set.district}>{item.city && !set.city ? `${item.value} · ${item.city}` : item.value}</option>)}</select></div>
          <div class="crm-field"><label for={`s${index}-ward`}>{t("Ward", "Phường / xã")}</label>
            <select class="crm-select" id={`s${index}-ward`} name={`s${index}_ward`}><option value="">{t("All", "Tất cả")}</option>{options.wards.filter((item) => { const ward = splitWard(item.value); return (!set.city || ward.city === set.city) && (!set.district || ward.district === set.district); }).map((item) => <option value={item.value} selected={item.value === set.ward}>{item.label}</option>)}</select></div>
          <div class="crm-field"><label for={`s${index}-industry`}>{t("Industry", "Ngành / loại tiệm")}</label>
            <select class="crm-select" id={`s${index}-industry`} name={`s${index}_industry`}><option value="">{t("All", "Tất cả")}</option>{options.industries.map((value) => <option selected={value === set.industry}>{value}</option>)}</select></div>
          <div class="crm-field"><label for={`s${index}-source`}>{t("Source", "Nguồn")}</label>
            <select class="crm-select" id={`s${index}-source`} name={`s${index}_source`}><option value="">{t("All", "Tất cả")}</option>{sourceChannels.map((value) => <option value={value} selected={value === set.source}>{label(lang, "channel", value)}</option>)}</select></div>
          {actor.manager && <div class="crm-field"><label for={`s${index}-owner`}>{t("Owner", "Người phụ trách")}</label>
            <select class="crm-select" id={`s${index}-owner`} name={`s${index}_owner`}><option value="">{t("Everyone", "Mọi người")}</option><option value="unassigned" selected={set.owner === "unassigned"}>{t("Unassigned", "Chưa phân công")}</option>{owners.map((item) => <option value={item.id} selected={item.id === set.owner}>{item.label}</option>)}</select></div>}
          <div class="crm-field"><label for={`s${index}-label`}>{t("Name (optional)", "Tên gọi (không bắt buộc)")}</label><input class="crm-input" id={`s${index}-label`} name={`s${index}_label`} value={set.label} maxlength="80" placeholder={t("e.g. District 4 spas", "Ví dụ: Spa Quận 4")} /></div>
        </div>
        {n > 1 && <p class="st-remove"><a class="crm-link" href={removeHref(index)}>{t("Remove this set", "Bỏ bộ lọc này")}</a></p>}
      </fieldset>)}
    </div>
    <input type="hidden" name="trend" value={query.trend} />
    <div class="crm-actions">
      <button class="crm-button" type="submit" name="n" value={n}>{t("Apply", "Áp dụng")}</button>
      {n < MAX_SETS && <button class="crm-button secondary" type="submit" name="n" value={n + 1}>{t(`Add a set to compare (${n}/${MAX_SETS})`, `Thêm bộ lọc để so sánh (${n}/${MAX_SETS})`)}</button>}
      <a class="crm-link" href={self}>{t("Reset", "Đặt lại")}</a>
    </div>
    <p class="crm-help">{t("Ward options carry their district, so a ward is never matched in another district. Sellers see only leads and deals they own.", "Mỗi phường đi kèm quận của nó nên không bị lẫn với phường cùng tên ở quận khác. Nhân viên chỉ thấy Lead và cơ hội của mình.")}</p>
  </form>

  {n > 1 && <div class="st-legend" aria-label={t("Filter sets", "Các bộ lọc")}>{names.map((name, index) => <span><i class={`st-key s${index + 1}`} aria-hidden="true"></i>{name}</span>)}</div>}

  <section class="crm-sheet st-sec" aria-labelledby="st-kpi-h">
    <h2 class="crm-h2" id="st-kpi-h">{t("Overview", "Tổng quan")}</h2>
    {n === 1 ? <dl class="dash-kpis">{metrics.map((metric) => <div class="dash-kpi"><dt>{metric.name}</dt><dd class="dash-value st-kpi-value">{metric.value(results[0].stats)}</dd>{metric.help && <dd class="crm-help">{metric.help}</dd>}</div>)}</dl>
    : <div class="crm-table-wrap"><table class="crm-table st-compare">
        <thead><tr><th scope="col">{t("Measure", "Chỉ số")}</th>{names.map((name, index) => <th scope="col" class="crm-num"><i class={`st-key s${index + 1}`} aria-hidden="true"></i> {name}</th>)}</tr></thead>
        <tbody>{metrics.map((metric) => <tr><th scope="row">{metric.name}</th>{results.map(({ stats }) => <td class="crm-num">{metric.value(stats)}</td>)}</tr>)}</tbody>
      </table></div>}
    <p class="crm-help">{t("Leads and opportunities created in the period. Won, lost and their rates refer to those opportunities. The open pipeline is today's count, whatever the creation date.", "Lead và cơ hội được tạo trong kỳ. Thắng, thua và tỷ lệ tính trên chính các cơ hội đó. Cơ hội đang mở là số hiện tại, không phụ thuộc ngày tạo.")}</p>
    {results.some(({ stats }) => stats.capped) && <p class="crm-help">{t("Over 20,000 opportunities in one set: the funnel uses the first 20,000. Narrow the period.", "Một bộ lọc có hơn 20.000 cơ hội: phễu chỉ tính 20.000 cơ hội đầu. Hãy thu hẹp thời gian.")}</p>}
  </section>

  <div class="st-grid">
    <figure class="dash-chart st-sec" aria-labelledby="st-funnel-h">
      <figcaption id="st-funnel-h"><strong>{t("Funnel: how far this period's opportunities got", "Phễu: cơ hội trong kỳ đi được tới đâu")}</strong><span class="crm-meta">{playbook ? (vi ? playbook.name_vi : playbook.name_en) : ""}</span></figcaption>
      {funnelSteps.length && results.some(({ stats }) => stats.opportunities) ? <ol class="st-funnel">
        {funnelSteps.map((id, step) => <li>
          <span class="st-step">{stageName(id)}</span>
          <ul class="st-bars">{results.map(({ stats }, index) => { const count = stats.funnel[step]?.count ?? 0; const share = rate(count, stats.funnel[0]?.count ?? 0); return <li title={`${names[index]} · ${stageName(id)}: ${num(count)} (${pct(share)})`}>
            <span class="st-track"><span class={`st-fill s${index + 1}`} style={`inline-size:${share === null ? 0 : Math.max(count ? 1.5 : 0, share)}%`}></span></span>
            <span class="st-num">{num(count)} <span class="crm-meta">{pct(share)}</span>{biggestDrop[index] === id && <span class="st-drop">{t(" · biggest drop", " · rơi nhiều nhất")}</span>}</span>
          </li>; })}</ul>
        </li>)}
      </ol> : <p class="crm-empty">{t("No opportunities in this period.", "Không có cơ hội nào trong kỳ.")}</p>}
      <p class="crm-help">{t("Each bar is the share of that set's opportunities that reached the stage, from stage history. Optional stages count only deals that went through them.", "Mỗi thanh là tỷ lệ cơ hội của bộ lọc đó đã tới giai đoạn này, theo lịch sử giai đoạn. Giai đoạn có thể bỏ qua chỉ tính cơ hội thực sự đi qua.")}</p>
    </figure>

    <figure class="dash-chart st-sec" aria-labelledby="st-pipe-h">
      <figcaption id="st-pipe-h"><strong>{t("Open pipeline now, by stage", "Cơ hội đang mở theo giai đoạn")}</strong></figcaption>
      {results.some(({ stats }) => stats.openPipeline) ? <ol class="st-funnel">
        {(results[0]?.stats.pipeline ?? []).map((step, at) => <li>
          <span class="st-step">{stageName(step.id)}</span>
          <ul class="st-bars">{results.map(({ stats }, index) => { const count = stats.pipeline[at]?.count ?? 0; return <li title={`${names[index]} · ${stageName(step.id)}: ${num(count)}`}>
            <span class="st-track"><span class={`st-fill s${index + 1}`} style={`inline-size:${count ? Math.max(1.5, (count / pipelineMax) * 100) : 0}%`}></span></span>
            <span class="st-num">{num(count)}</span>
          </li>; })}</ul>
        </li>)}
      </ol> : <p class="crm-empty">{t("No open opportunities.", "Không có cơ hội đang mở.")}</p>}
    </figure>
  </div>

  <figure class="dash-chart st-sec" aria-labelledby="st-trend-h">
    <figcaption id="st-trend-h"><strong>{trendNames[query.trend]} {weekly ? t("per week", "mỗi tuần") : t("per day", "mỗi ngày")}</strong>
      <nav class="st-switch" aria-label={t("Measure", "Chỉ số")}>{(["leads", "opportunities", "won"] as const).map((key) => <a class="crm-link" href={`${self}${statsSearch(query, { trend: key })}#st-trend-h`} aria-current={key === query.trend ? "true" : undefined}>{trendNames[key]}</a>)}</nav>
    </figcaption>
    <div class="st-trend">
      <span class="st-ymax" aria-hidden="true">{num(trendMax)}</span>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <line x1="0" y1={H} x2={W} y2={H} class="st-axis" />
        <line x1="0" y1="0" x2={W} y2="0" class="st-grid-line" />
        {series.map((rows, index) => <polyline class={`st-line s${index + 1}`} points={rows.map((row, at) => `${x(at).toFixed(1)},${y(trendValue(row)).toFixed(1)}`).join(" ")} />)}
      </svg>
      <ol class="st-hits" aria-hidden="true">{bucketsList.map((row, at) => <li title={`${weekly ? t("Week of ", "Tuần từ ") : ""}${dayLabel(row.bucket)}: ${results.map((_, index) => `${names[index]} ${num(trendValue(series[index][at]))}`).join(" · ")}`}></li>)}</ol>
    </div>
    <div class="st-xaxis" aria-hidden="true">{bucketsList.length > 0 && <><span>{dayLabel(bucketsList[0].bucket)}</span>{bucketsList.length > 2 && <span>{dayLabel(bucketsList[Math.floor(bucketsList.length / 2)].bucket)}</span>}<span>{dayLabel(bucketsList[bucketsList.length - 1].bucket)}</span></>}</div>
    {n > 1 && <p class="st-legend small">{names.map((name, index) => <span><i class={`st-key s${index + 1}`} aria-hidden="true"></i>{name}: {num(series[index].reduce((sum, row) => sum + trendValue(row), 0))}</span>)}</p>}
    <details class="crm-disclosure"><summary>{t("View as table", "Xem dạng bảng")}</summary>
      <div class="crm-table-wrap"><table class="crm-table">
        <thead><tr><th scope="col">{weekly ? t("Week of", "Tuần từ") : t("Day", "Ngày")}</th>{names.map((name) => <th scope="col" class="crm-num">{name}</th>)}</tr></thead>
        <tbody>{bucketsList.map((row, at) => <tr><th scope="row">{dayLabel(row.bucket)}</th>{series.map((rows) => <td class="crm-num">{num(trendValue(rows[at]))}</td>)}</tr>)}</tbody>
      </table></div>
    </details>
  </figure>

  <section class="crm-sheet st-sec" aria-labelledby="st-break-h">
    <div class="st-break-head">
      <h2 class="crm-h2" id="st-break-h">{t("Breakdown", "Phân rã")}{n > 1 && <span class="crm-meta"> · {names[query.focus]}</span>}</h2>
      {n > 1 && <nav class="st-switch" aria-label={t("Which set to break down", "Phân rã bộ lọc nào")}>{names.map((name, index) => <a class="crm-link" href={`${self}${statsSearch(query, { focus: index })}#st-break-h`} aria-current={index === query.focus ? "true" : undefined}><i class={`st-key s${index + 1}`} aria-hidden="true"></i> {t(`Set ${index + 1}`, `Bộ lọc ${index + 1}`)}</a>)}</nav>}
    </div>
    <div class="st-grid">
      {[breakdown.area, breakdown.industry].map((table) => <div class="crm-table-wrap"><table class="crm-table">
        <caption class="st-caption">{t("By ", "Theo ")}{levelName[table.level].toLocaleLowerCase(vi ? "vi" : "en")}</caption>
        <thead><tr><th scope="col">{levelName[table.level]}</th><th scope="col" class="crm-num">Lead</th><th scope="col" class="crm-num">{t("Converted", "Đã chuyển")}</th><th scope="col" class="crm-num">{t("Opportunities", "Cơ hội")}</th><th scope="col" class="crm-num">{t("Won", "Thắng")}</th></tr></thead>
        <tbody>{table.rows.length ? table.rows.map((row) => <tr><th scope="row">{row.key || <span class="crm-meta">{t("Not recorded", "Chưa ghi")}</span>}</th><td class="crm-num">{num(row.leads)}</td><td class="crm-num">{num(row.converted)} <span class="crm-meta">{pct(rate(row.converted, row.leads))}</span></td><td class="crm-num">{num(row.opportunities)}</td><td class="crm-num">{num(row.won)} <span class="crm-meta">{pct(rate(row.won, row.opportunities))}</span></td></tr>)
          : <tr><td colspan="5" class="crm-meta">{t("Nothing in this period.", "Không có dữ liệu trong kỳ.")}</td></tr>}</tbody>
      </table></div>)}
    </div>
    <p class="crm-help">{t("Small groups move a lot with one record; read differences between small groups with care.", "Nhóm nhỏ thay đổi nhiều chỉ vì một hồ sơ; cẩn trọng khi so sánh các nhóm ít dữ liệu.")}</p>
  </section>

  {gaps && <section class="crm-sheet st-sec" id="areas" aria-labelledby="st-areas-h">
    <h2 class="crm-h2" id="st-areas-h">{t("Areas missing on older records", "Hồ sơ cũ chưa có khu vực")}</h2>
    {filled && <p class="crm-notice good" role="status">{t(`Filled ${filled.accounts} companies and ${filled.leads} leads. ${filled.unreadable} could not be read and stay blank.`, `Đã điền ${filled.accounts} công ty và ${filled.leads} Lead. ${filled.unreadable} hồ sơ không đọc được nên để trống.`)}</p>}
    <p>{t(`${gaps.accounts} companies and ${gaps.leads} leads have an address or area but no ward, district or city yet.`, `${gaps.accounts} công ty và ${gaps.leads} Lead có địa chỉ hoặc khu vực nhưng chưa có phường, quận, thành phố.`)}</p>
    {gaps.accounts + gaps.leads > 0 && <form method="post" action={`${self}${statsSearch(query)}`}>
      <input type="hidden" name="intent" value="fill_areas" /><input type="hidden" name="request_key" value={crypto.randomUUID()} />
      <button class="crm-button secondary" type="submit">{t("Fill areas from addresses", "Điền khu vực từ địa chỉ")}</button>
    </form>}
    <p class="crm-help">{t("Only parts marked Phường/P., Quận/Q., Huyện or a known city are read; nothing is guessed, and only blank fields change.", "Chỉ đọc phần có ghi rõ Phường/P., Quận/Q., Huyện hoặc tên thành phố; không đoán, và chỉ điền vào ô đang trống.")}</p>
  </section>}

  <p class="crm-help st-foot">{t("Outreach messages (Zalo/Facebook sends, replies, schedule) are not in the CRM yet and will be added when the outreach machine reports them.", "Số liệu tin nhắn outreach (tin Zalo/Facebook đã gửi, trả lời, lịch gửi) chưa có trong CRM; sẽ bổ sung khi máy outreach gửi số liệu về.")}</p>
</CrmShell>
