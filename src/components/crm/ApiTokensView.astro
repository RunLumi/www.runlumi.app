---
// "Connect an AI agent": a step-by-step guide (token → environment variable →
// Claude Code / Codex / other MCP clients → first prompts → limits and
// troubleshooting) next to the person's own token management.
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { formatDate } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { ApiToken } from "../../lib/crm/api/tokens";
import type { ApiTokensProps } from "../../lib/crm/routes/api";

type Props = ApiTokensProps;
const { ctx, state, tokens, all, names, created, origin, toolList } = Astro.props;
const { lang, vi, actor } = ctx;
const v = (name: string, fallback = "") => valueFor(state, "token_create", name, fallback);
const e = (name: string) => errorFor(state, "token_create", name);
const now = Date.now();
const status = (token: ApiToken) => token.revoked_at ? ["red", vi ? "Đã thu hồi" : "Revoked"] : Date.parse(token.expires_at) <= now ? ["amber", vi ? "Hết hạn" : "Expired"] : ["green", vi ? "Đang dùng được" : "Active"];
const fieldLabels: Record<string, string> = vi ? { name: "Tên token", scope: "Quyền", days: "Thời hạn" } : { name: "Token name", scope: "Scope", days: "Lifetime" };
const mcpUrl = `${origin}/api/crm/mcp`;
const active = tokens.filter((token) => !token.revoked_at && Date.parse(token.expires_at) > now);
const steps = vi
  ? [["token", "Tạo token"], ["env", "Lưu token vào máy"], ["connect", "Kết nối agent"], ["try", "Thử với agent"], ["limits", "Giới hạn và an toàn"], ["trouble", "Khi gặp lỗi"]]
  : [["token", "Create a token"], ["env", "Store the token"], ["connect", "Connect the agent"], ["try", "Try it"], ["limits", "Limits and safety"], ["trouble", "Troubleshooting"]];
const prompts = vi
  ? ["Tìm các garage ở Bình Thạnh trong CRM.", "Mở cơ hội Lumi Local cho Garage Phong Điện Lạnh với Anh Phong, giá trị HĐ mong đợi 1.990.000đ, tỉ lệ thành công 30%.", "Ghi chú cuộc gọi hôm nay vào cơ hội đó: chủ muốn xem bản demo vào thứ Sáu.", "Cơ hội nào của tôi đang thiếu bước tiếp theo? Đặt bước tiếp theo cho từng cái.", "Chuyển cơ hội X sang giai đoạn tiếp theo; nếu thiếu điều kiện thì cho tôi biết thiếu gì."]
  : ["Find the garages in Bình Thạnh in the CRM.", "Open a Lumi Local opportunity for Garage Phong Điện Lạnh with Anh Phong, expected value 1,990,000 VND, 30% probability.", "Add a note from today's call to that opportunity: the owner wants to see the demo on Friday.", "Which of my opportunities have no next step? Set one for each.", "Move opportunity X to the next stage; if requirements are missing, tell me what."];
---
<CrmShell title={vi ? "Kết nối AI agent" : "Connect an AI agent"} lang={lang} actor={actor} current="api">
  <div class="crm-head"><div>
    <p class="crm-eyebrow">{vi ? "Hướng dẫn và công cụ" : "Guides and tools"}</p>
    <h1 class="crm-h1">{vi ? "Dùng Claude Code, Codex hoặc agent khác với CRM." : "Use Claude Code, Codex or another agent with the CRM."}</h1>
    <p class="crm-lede">{vi
      ? "CRM có MCP server và REST API. Agent hành động với đúng quyền của bạn: chỉ thấy và sửa những gì bạn thấy và sửa được. Không có thanh toán, báo giá, hoa hồng, bàn giao, giao người phụ trách hay tuyển dụng."
      : "The CRM has an MCP server and a REST API. An agent acts with exactly your permissions: it sees and changes only what you can. No payments, quotes, commission, fulfillment, assignment or hiring."}</p>
  </div></div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={fieldLabels} />
  {created && (created.secret
    ? <section class="crm-notice good" role="status" aria-labelledby="secret-h">
        <strong id="secret-h">{vi ? "Token mới — sao chép ngay, sẽ không hiện lại." : "New token — copy it now; it will not be shown again."}</strong>
        <p><code class="crm-secret">{created.secret}</code></p>
        <p>{vi ? "Tiếp theo: làm bước 2 bên dưới để lưu token vào máy. Không dán token vào chat, tài liệu hay mã nguồn." : "Next: follow step 2 below to store it on your computer. Never paste it into chats, documents or source code."}</p>
      </section>
    : <div class="crm-notice warn" role="status">{vi ? "Token đã được tạo ở lần gửi trước; không thể hiện lại. Nếu chưa lưu, hãy thu hồi và tạo token mới." : "This token was created by an earlier submission and cannot be shown again. If you did not save it, revoke it and create another."}</div>)}

  <nav class="agent-steps" aria-label={vi ? "Các bước" : "Steps"}>
    <ol>{steps.map(([id, label], index) => <li><a href={`#${id}`}><span class="agent-step-num">{index + 1}</span>{label}</a></li>)}</ol>
  </nav>

  <div class="crm-grid two">
    <div class="agent-guide">
      <section class="crm-sheet" id="token" aria-labelledby="token-h">
        <h2 class="crm-h2" id="token-h"><span class="agent-step-num">1</span>{vi ? "Tạo token" : "Create a token"}</h2>
        <p>{vi ? "Dùng form bên cạnh. Chọn " : "Use the form alongside. Choose "}<strong>{vi ? "Đọc và ghi" : "Read and write"}</strong>{vi ? " nếu muốn agent cập nhật CRM, hoặc " : " if the agent should update the CRM, or "}<strong>{vi ? "Chỉ đọc" : "Read only"}</strong>{vi ? " nếu chỉ để tra cứu. Mỗi máy hoặc mỗi agent nên có một token riêng để thu hồi riêng khi cần." : " for look-ups only. Give each computer or agent its own token so you can revoke it on its own."}</p>
        <p class="crm-help">{active.length ? (vi ? `Bạn đang có ${active.length} token dùng được (danh sách ở cuối trang).` : `You have ${active.length} active token(s) (listed at the end of the page).`) : (vi ? "Bạn chưa có token nào đang dùng được." : "You have no active token yet.")}</p>
      </section>

      <section class="crm-sheet" id="env" aria-labelledby="env-h">
        <h2 class="crm-h2" id="env-h"><span class="agent-step-num">2</span>{vi ? "Lưu token vào máy" : "Store the token on your computer"}</h2>
        <p>{vi ? "Lưu token vào biến môi trường, không lưu trong thư mục dự án. Trên macOS (zsh), thêm dòng này vào " : "Keep the token in an environment variable, never inside a project folder. On macOS (zsh), add this line to "}<code>~/.zshrc</code>{vi ? ", thay phần token bằng token của bạn, rồi mở terminal mới:" : ", replacing the token with yours, then open a new terminal:"}</p>
        <pre class="crm-code"><code>export LUMI_CRM_TOKEN='lumi_crm_…'</code></pre>
        <p class="crm-help">{vi ? "Windows (PowerShell): " : "Windows (PowerShell): "}<code>setx LUMI_CRM_TOKEN "lumi_crm_…"</code>{vi ? " rồi mở cửa sổ mới." : " then open a new window."}</p>
      </section>

      <section class="crm-sheet" id="connect" aria-labelledby="connect-h">
        <h2 class="crm-h2" id="connect-h"><span class="agent-step-num">3</span>{vi ? "Kết nối agent" : "Connect the agent"}</h2>
        <p>{vi ? "Địa chỉ MCP server (Streamable HTTP):" : "MCP server address (Streamable HTTP):"} <code class="crm-url">{mcpUrl}</code></p>

        <h3 class="agent-h3">Claude Code</h3>
        <pre class="crm-code"><code>{`claude mcp add --transport http --scope user lumi-crm ${mcpUrl} \\\n  --header "Authorization: Bearer $LUMI_CRM_TOKEN"`}</code></pre>
        <p class="crm-help">{vi ? "Kiểm tra: chạy " : "Check: run "}<code>claude mcp list</code>{vi ? " (lumi-crm phải ở trạng thái connected), hoặc gõ " : " (lumi-crm should show as connected), or type "}<code>/mcp</code>{vi ? " trong Claude Code. Lệnh trên lưu token trong cấu hình cá nhân ~/.claude.json; đừng đưa server này vào .mcp.json của một repo kèm token thật." : " inside Claude Code. The command stores the token in your personal ~/.claude.json; never add this server with a real token to a repository's .mcp.json."}</p>

        <h3 class="agent-h3">Codex</h3>
        <pre class="crm-code"><code>{`codex mcp add lumi-crm --url ${mcpUrl} --bearer-token-env-var LUMI_CRM_TOKEN`}</code></pre>
        <p class="crm-help">{vi ? "Codex đọc token từ biến môi trường mỗi lần chạy, không lưu token vào cấu hình. Kiểm tra: " : "Codex reads the token from the environment on each run and does not store it in its configuration. Check: "}<code>codex mcp list</code>.</p>

        <h3 class="agent-h3">{vi ? "Ứng dụng MCP khác (Cursor, VS Code…)" : "Other MCP clients (Cursor, VS Code…)"}</h3>
        <p>{vi ? "Ứng dụng cần hỗ trợ MCP qua HTTP và cho phép thêm header. Cấu hình thường có dạng:" : "The client needs MCP over HTTP with custom headers. The configuration usually looks like:"}</p>
        <pre class="crm-code"><code>{JSON.stringify({ mcpServers: { "lumi-crm": { type: "http", url: mcpUrl, headers: { Authorization: "Bearer ${LUMI_CRM_TOKEN}" } } } }, null, 2)}</code></pre>
        <p class="crm-help">{vi ? "Nếu ứng dụng không tự đọc biến môi trường trong cấu hình, xem hướng dẫn của ứng dụng đó; không dán token vào file nằm trong repository." : "If the client does not expand environment variables in its configuration, follow its own documentation; never paste the token into a file inside a repository."}</p>

        <h3 class="agent-h3">{vi ? "Script tự viết (REST API)" : "Your own scripts (REST API)"}</h3>
        <pre class="crm-code"><code>{`curl -A "my-crm-script/1.0" -H "Authorization: Bearer $LUMI_CRM_TOKEN" \\\n  "${origin}/api/crm/v1/companies?q=garage"`}</code></pre>
        <p class="crm-help">{vi ? "Luôn đặt User-Agent riêng: một số User-Agent mặc định (ví dụ urllib của Python) bị tường lửa chặn với lỗi 403." : "Always set your own User-Agent: some defaults (for example Python's urllib) are blocked by the firewall with a 403."}</p>
      </section>

      <section class="crm-sheet" id="try" aria-labelledby="try-h">
        <h2 class="crm-h2" id="try-h"><span class="agent-step-num">4</span>{vi ? "Thử với agent" : "Try it"}</h2>
        <p>{vi ? "Nói với agent bằng câu bình thường, ví dụ:" : "Ask in plain words, for example:"}</p>
        <ul class="agent-prompts">{prompts.map((prompt) => <li>“{prompt}”</li>)}</ul>
        <p class="crm-help">{vi ? "Agent nên gọi list_playbooks trước khi tạo hoặc chuyển giai đoạn cơ hội. Mỗi thay đổi hiện trong lịch sử với tên bạn kèm “(API: tên token)”." : "The agent should call list_playbooks before creating or moving opportunities. Every change shows in history with your name and “(API: token name)”."}</p>
        <details class="crm-disclosure"><summary>{vi ? `Các công cụ agent dùng được (${toolList.length})` : `Tools available to the agent (${toolList.length})`}</summary>
          <ul class="crm-list">{toolList.map((tool) => <li class="crm-row"><span class="crm-num">{tool.name}</span><span class="crm-row-side"><span class="crm-badge">{tool.write ? (vi ? "ghi" : "write") : (vi ? "đọc" : "read")}</span></span><span class="crm-row-meta"><span>{tool.title}</span></span></li>)}</ul>
        </details>
      </section>

      <section class="crm-sheet" id="limits" aria-labelledby="limits-h">
        <h2 class="crm-h2" id="limits-h"><span class="agent-step-num">5</span>{vi ? "Giới hạn và an toàn" : "Limits and safety"}</h2>
        <ul>
          <li>{vi ? "Agent chỉ thấy và sửa dữ liệu bạn được thấy và sửa. Nhân viên chỉ chạm cơ hội, công ty và liên hệ của mình." : "The agent sees and changes only what you may. Sellers only touch their own opportunities, companies and contacts."}</li>
          <li>{vi ? "Chuyển giai đoạn vẫn phải đủ điều kiện như trên web; ô chưa biết để trống, không đoán số liệu." : "Stage moves need the same requirements as on the web; leave unknown values empty, never guess."}</li>
          <li>{vi ? "Ghi nhận “không liên hệ” chỉ admin gỡ được — kiểm tra kỹ trước khi để agent ghi." : "Only an admin can lift do-not-contact — check before letting the agent record it."}</li>
          <li>{vi ? "Agent không tự nhắn tin cho khách. CRM không gửi tin, không thu tiền." : "The agent does not message customers. The CRM never sends messages or takes payments."}</li>
          <li>{vi ? "120 lệnh mỗi phút cho mỗi token; token hết hạn sau 30, 90 hoặc 365 ngày và ngừng ngay khi bạn mất quyền CRM." : "120 requests a minute per token; tokens expire after 30, 90 or 365 days and stop as soon as you lose CRM access."}</li>
          <li>{vi ? "Mất máy hoặc nghi lộ token: thu hồi ngay ở danh sách bên dưới rồi tạo token mới." : "Lost a computer or suspect a leak: revoke the token below right away and create a new one."}</li>
        </ul>
      </section>

      <section class="crm-sheet" id="trouble" aria-labelledby="trouble-h">
        <h2 class="crm-h2" id="trouble-h"><span class="agent-step-num">6</span>{vi ? "Khi gặp lỗi" : "Troubleshooting"}</h2>
        <dl class="agent-faq">
          <dt>401 · unauthorized</dt><dd>{vi ? "Token sai, hết hạn, đã thu hồi, hoặc bạn không còn quyền CRM. Kiểm tra biến LUMI_CRM_TOKEN và danh sách token bên dưới." : "Wrong, expired or revoked token, or you no longer have CRM access. Check LUMI_CRM_TOKEN and your tokens below."}</dd>
          <dt>403 · read_only_token</dt><dd>{vi ? "Token chỉ đọc. Tạo token “Đọc và ghi” nếu muốn agent cập nhật." : "The token is read-only. Create a read-and-write token for updates."}</dd>
          <dt>403 · error code 1010</dt><dd>{vi ? "Tường lửa chặn User-Agent mặc định của script. Đặt User-Agent riêng." : "The firewall blocked a script's default User-Agent. Set your own."}</dd>
          <dt>404 · not_found</dt><dd>{vi ? "Bản ghi không tồn tại hoặc bạn không được xem." : "The record does not exist or is not visible to you."}</dd>
          <dt>409 · conflict</dt><dd>{vi ? "Ai đó vừa sửa bản ghi. Bảo agent đọc lại rồi thử lại." : "Someone changed the record. Ask the agent to read it again and retry."}</dd>
          <dt>422 · validation</dt><dd>{vi ? "Thiếu hoặc sai giá trị; với chuyển giai đoạn, lỗi liệt kê điều kiện còn thiếu." : "Missing or invalid values; for stage moves, the error lists missing requirements."}</dd>
          <dt>429 · rate_limited</dt><dd>{vi ? "Quá 120 lệnh mỗi phút. Chờ rồi thử lại." : "More than 120 requests a minute. Wait and retry."}</dd>
        </dl>
      </section>

      <section class="crm-sheet" id="tokens" aria-labelledby="tokens-h">
        <h2 class="crm-h2" id="tokens-h">{vi ? "Token của bạn" : "Your tokens"}<span class="crm-count">{tokens.length}</span></h2>
        {tokens.length ? <ul class="crm-list">{tokens.map((token) => <li class="crm-row">
          <strong>{token.name}</strong>
          <span class="crm-row-side"><span class:list={["crm-badge", status(token)[0]]}>{status(token)[1]}</span><span class="crm-badge">{token.scope === "write" ? (vi ? "Đọc và ghi" : "Read and write") : (vi ? "Chỉ đọc" : "Read only")}</span></span>
          <span class="crm-row-meta"><span class="crm-num">{token.prefix}…</span><span>{vi ? "Tạo" : "Created"} {formatDate(token.created_at, lang)}</span><span>{vi ? "Hết hạn" : "Expires"} {formatDate(token.expires_at, lang)}</span><span>{vi ? "Dùng lần cuối" : "Last used"} {token.last_used_at ? formatDate(token.last_used_at, lang) : "—"}</span></span>
          {!token.revoked_at && <form class="crm-actions" method="post" action="#tokens"><Hidden intent="token_revoke" state={state} /><input type="hidden" name="token_id" value={token.id} /><button class="crm-button small danger" type="submit">{vi ? "Thu hồi" : "Revoke"}</button></form>}
        </li>)}</ul> : <p class="crm-empty">{vi ? "Bạn chưa có token nào." : "You have no tokens yet."}</p>}
      </section>

      {actor.configure && <section class="crm-sheet" id="all-tokens" aria-labelledby="all-h">
        <h2 class="crm-h2" id="all-h">{vi ? "Token của người khác (admin)" : "Other people's tokens (admin)"}<span class="crm-count">{all.length}</span></h2>
        {all.length ? <ul class="crm-list">{all.map((token) => <li class="crm-row">
          <strong>{names[token.user_id]?.name ?? (vi ? "Tài khoản không hoạt động" : "Inactive account")} · {token.name}</strong>
          <span class="crm-row-side"><span class:list={["crm-badge", status(token)[0]]}>{status(token)[1]}</span><span class="crm-badge">{token.scope}</span></span>
          <span class="crm-row-meta"><span class="crm-num">{token.prefix}…</span><span>{vi ? "Hết hạn" : "Expires"} {formatDate(token.expires_at, lang)}</span><span>{vi ? "Dùng lần cuối" : "Last used"} {token.last_used_at ? formatDate(token.last_used_at, lang) : "—"}</span></span>
          {!token.revoked_at && <form class="crm-actions" method="post" action="#all-tokens"><Hidden intent="token_revoke" state={state} /><input type="hidden" name="token_id" value={token.id} /><button class="crm-button small danger" type="submit">{vi ? "Thu hồi" : "Revoke"}</button></form>}
        </li>)}</ul> : <p class="crm-empty">{vi ? "Chưa ai khác tạo token." : "Nobody else has a token."}</p>}
      </section>}
    </div>

    <aside class="crm-sheet agent-aside" id="new-token" aria-labelledby="new-token-h">
      <h2 class="crm-h2" id="new-token-h">{vi ? "Tạo token" : "Create a token"}</h2>
      <form class="crm-form" method="post" action="#new-token">
        <Hidden intent="token_create" state={state} />
        <Field name="name" label={fieldLabels.name} lang={lang} value={v("name")} error={e("name")} required maxlength={80} help={vi ? "Ví dụ: Claude Code trên MacBook" : "For example: Claude Code on my MacBook"} />
        <Field name="scope" type="select" label={fieldLabels.scope} lang={lang} value={v("scope", "read")} error={e("scope")} options={[{ value: "read", label: vi ? "Chỉ đọc" : "Read only" }, { value: "write", label: vi ? "Đọc và ghi" : "Read and write" }]} />
        <Field name="days" type="select" label={fieldLabels.days} lang={lang} value={v("days", "90")} error={e("days")} options={[30, 90, 365].map((days) => ({ value: String(days), label: vi ? `${days} ngày` : `${days} days` }))} />
        <p class="crm-help">{vi ? "Token chỉ hiện một lần sau khi tạo." : "The token is shown once, right after you create it."}</p>
        <div class="crm-actions"><button class="crm-button" type="submit">{vi ? "Tạo token" : "Create token"}</button></div>
      </form>
    </aside>
  </div>
</CrmShell>
