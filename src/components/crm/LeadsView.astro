---
// Lead list view and Kanban (boards Leads, LeadsKanban, KanbanDrag). Stories:
// docs/governance/USER-STORIES.md § CRM list screens (Leads, LeadsKanban).
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import ListHeader from "../workspace/ui/ListHeader.astro";
import ButtonGroup from "../workspace/ui/ButtonGroup.astro";
import ListToolbar from "../workspace/ui/ListToolbar.astro";
import Sheet from "../workspace/ui/Sheet.astro";
import NavIcon from "../workspace/NavIcon.astro";
import { formatDate, label, options } from "../../lib/crm/i18n";
import { leadAgeHours, overTarget, statusLabel } from "../../lib/crm/leads";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { LeadsProps } from "../../lib/crm/routes/leads";
import { initials } from "../../lib/workspace/summaries";
import "../../styles/crm-sales.css";
import "../../styles/crm-lists.css";

type Props = LeadsProps;
const { ctx, state, view, filters, rows, total, page, pages, process, processes, owners, ownerNames, playbooks } = Astro.props;
const { lang, vi, base } = ctx;
const v = (name: string, fallback = "") => valueFor(state, "lead_create", name, fallback);
const e = (name: string) => errorFor(state, "lead_create", name);
const query = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Object.entries({ ...filters, view, ...changes }).filter(([key, value]) => value && !(key === "state" && value === "open") && !(key === "view" && value === "list")));
  const text = params.toString();
  return text ? `?${text}` : "?";
};
const here = `${base}/leads${query({})}`.replace(/\?$/, "");
const ownerName = (id: string | null) => id ? (ownerNames[id]?.name ?? (id === ctx.actor.id ? ctx.actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chờ phân công" : "Waiting for assignment");
const age = (hours: number) => hours < 24 ? (vi ? `${hours} giờ` : `${hours} h`) : (vi ? `${Math.floor(hours / 24)} ngày` : `${Math.floor(hours / 24)} d`);
const stateTone: Record<string, string> = { open: "info", converted: "ok", disqualified: "" };
const stateLabel: Record<string, [string, string]> = { open: ["Open", "Đang mở"], converted: ["Converted", "Đã chuyển đổi"], disqualified: ["Disqualified", "Không tiếp tục"] };
const manualSources = options(lang, "channel").filter((item) => !["inbound_web", "referral", "existing_customer"].includes(item.value));
const columns = process.def.statuses;
const known = new Set(columns.map((item) => item.id));
const byStatus = (id: string) => rows.filter((row) => row.status_id === id);
const orphans = rows.filter((row) => !known.has(row.status_id));
const fieldLabels: Record<string, string> = vi
  ? { name: "Họ tên", company: "Công ty", phone: "Điện thoại", email: "Email", source_channel: "Nguồn Lead", owner_id: "Người phụ trách", playbook_key: "Nhu cầu thuộc quy trình", next_action_due: "Hạn bước tiếp theo" }
  : { name: "Name", company: "Company", phone: "Phone", email: "Email", source_channel: "Lead source", owner_id: "Owner", playbook_key: "Playbook", next_action_due: "Next step due" };
// List selector: the saved lists that exist for leads (by state).
const listState = view === "board" ? "open" : filters.state || "open";
const lists = (["open", "converted", "disqualified", "all"] as const).map((key) => ({
  label: key === "all" ? (vi ? "Tất cả Lead" : "All leads") : vi ? `Lead ${stateLabel[key][1].toLowerCase()}` : `${stateLabel[key][0]} leads`,
  href: `${base}/leads${query({ view: "list", state: key, status: "", page: "" })}`.replace(/\?$/, ""), current: listState === key,
}));
const title = lists.find((item) => item.current)?.label ?? lists[0].label;
const filterCount = [filters.status, filters.source, filters.owner].filter(Boolean).length;
const statusName = columns.find((item) => item.id === filters.status);
const meta = [
  vi ? `${total} mục` : `${total} ${total === 1 ? "item" : "items"}`,
  view === "board" ? (vi ? "Nhóm theo trạng thái Lead · Tổng theo số Lead" : "Grouped by lead status · Totals by lead count") : (vi ? "Sắp xếp theo ngày tạo, Lead chờ phân công trước" : "Sorted by created date, unassigned first"),
  statusName ? (vi ? `Lọc theo trạng thái ${statusName.vi}` : `Filtered by status ${statusName.en}`) : "",
  filters.q ? (vi ? `Tìm “${filters.q}”` : `Search “${filters.q}”`) : "",
].filter(Boolean).join(" · ");
const sheetOpen = Astro.url.searchParams.get("new") === "1" || (state.intent === "lead_create" && (Object.keys(state.errors).length > 0 || state.serverError || state.conflict));
const newHref = `${base}/leads${query({ new: "1" })}#new-lead`;
---
<CrmShell title={vi ? "Lead" : "Leads"} lang={lang} actor={ctx.actor} current="leads">
  <div class="cl-stack">
    <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} intents={["lead_status"]} />
    <ListHeader vi={vi} icon="leads" tone="lead" object="Lead" title={title} meta={meta} lists={lists}>
      <ButtonGroup slot="actions" label={vi ? "Hành động" : "Actions"} more={ctx.actor.configure ? [{ label: vi ? "Trạng thái Lead" : "Lead statuses", href: `${base}/admin/leads` }] : []}><a class="ws-btn" href={newHref}>{vi ? "Tạo" : "New"}</a>{ctx.actor.manager && <a class="ws-btn" href={`${base}/admin#leads`}>{vi ? "Đổi người phụ trách" : "Change owner"}</a>}</ButtonGroup>
      <ListToolbar slot="tools" vi={vi} filterActive={filterCount} filterClear={view === "board" ? `${base}/leads?view=board` : `${base}/leads`} q={filters.q} keep={{ view: view === "board" ? "board" : "", state: view === "list" && filters.state !== "open" ? filters.state : "", status: filters.status, source: filters.source, owner: filters.owner }} views={[
          { key: "list", label: vi ? "Bảng" : "Table", href: `${base}/leads${query({ view: "list", page: "" })}`.replace(/\?$/, ""), icon: "model", current: view === "list" },
          { key: "board", label: "Kanban", href: `${base}/leads${query({ view: "board", state: "open", page: "" })}`, icon: "pipeline", current: view === "board" },
        ]}>
        <a class="ws-btn icon" href={here} aria-label={vi ? "Làm mới" : "Refresh"}><NavIcon name="refresh" size={16} /></a>
                <Fragment slot="filters">
          {view === "board" && <input type="hidden" name="view" value="board" />}
          {view === "list" && <input type="hidden" name="state" value={filters.state} />}
          {view === "list" && <div class="crm-field"><label for="lstatus">{vi ? "Trạng thái Lead" : "Lead status"}</label><select class="crm-select" id="lstatus" name="status"><option value="">{vi ? "Tất cả" : "Any"}</option>{columns.map((item) => <option value={item.id} selected={filters.status === item.id}>{vi ? item.vi : item.en}</option>)}</select></div>}
          <div class="crm-field"><label for="lsource">{vi ? "Nguồn Lead" : "Lead source"}</label><select class="crm-select" id="lsource" name="source"><option value="">{vi ? "Tất cả" : "Any"}</option>{options(lang, "channel").map((item) => <option value={item.value} selected={filters.source === item.value}>{item.label}</option>)}</select></div>
          {ctx.actor.manager && <div class="crm-field"><label for="lowner">{vi ? "Người phụ trách" : "Owner"}</label><select class="crm-select" id="lowner" name="owner"><option value="">{vi ? "Tất cả" : "Anyone"}</option><option value="unassigned" selected={filters.owner === "unassigned"}>{vi ? "Chờ phân công" : "Waiting for assignment"}</option>{owners.map((owner) => <option value={owner.id} selected={filters.owner === owner.id}>{owner.label}</option>)}</select></div>}
        </Fragment>
      </ListToolbar>

      {view === "list" && <>
        {rows.length ? <div class="cl-tbl-wrap" tabindex="0" role="region" aria-label={vi ? "Bảng Lead, cuộn ngang được" : "Lead table, scrolls sideways"}>
          <table class="cl-tbl">
            <thead><tr>
              <th class="fz fzr" scope="col"><span class="crm-sr">#</span></th><th class="fz fzn" scope="col">{vi ? "Tên" : "Name"}</th>
              <th scope="col">{vi ? "Chức danh" : "Title"}</th><th scope="col">{vi ? "Công ty" : "Company"}</th><th scope="col">{vi ? "Điện thoại" : "Phone"}</th>
              <th scope="col">{vi ? "Nguồn Lead" : "Lead source"}</th><th scope="col">{vi ? "Trạng thái Lead" : "Lead status"}</th><th scope="col">{vi ? "Nhu cầu" : "Need"}</th>
              <th scope="col">{vi ? "Người phụ trách" : "Owner"}</th><th scope="col">{vi ? "Tạo lúc" : "Created"}</th>
            </tr></thead>
            <tbody>{rows.map((row, index) => { const pr = processes.get(row.process_id); const late = overTarget(pr, row); return <tr>
              <td class="fz fzr">{(page - 1) * 50 + index + 1}</td>
              <td class="fz fzn"><a href={`${base}/leads/${row.id}`}>{row.name}</a></td>
              <td>{row.job_title || "—"}</td><td>{row.company}</td><td>{row.phone || "—"}</td>
              <td>{label(lang, "channel", row.source_channel)}</td>
              <td>{row.state === "open" ? <span class:list={["cl-badge", late ? "warn" : "info"]}>{late && <span class="dot" />}{statusLabel(pr, row.status_id, vi)}{late ? (vi ? ` · quá ${age(leadAgeHours(row))}` : ` · ${age(leadAgeHours(row))} old`) : ""}</span> : <span class:list={["cl-badge", stateTone[row.state]]}>{stateLabel[row.state][vi ? 1 : 0]}</span>}</td>
              <td class="wrap">{row.need ? row.need.slice(0, 120) : "—"}</td>
              <td>{ownerName(row.owner_id)}</td><td>{formatDate(row.created_at, lang)}</td>
            </tr>; })}</tbody>
          </table>
        </div> : <p class="cl-empty">{filters.q || filterCount ? (vi ? "Không có Lead khớp bộ lọc. Xóa lọc hoặc đổi từ khóa." : "No leads match. Clear the filters or change the search.") : (vi ? "Chưa có Lead. Chọn Tạo để thêm người bạn tự tìm được; yêu cầu từ website và khách được giới thiệu tự vào đây." : "No leads yet. Choose New to add someone you found; website enquiries and referrals arrive here on their own.")}</p>}
        {rows.length > 0 && <p class="cl-hint"><span>{vi ? "Cột số dòng và Tên cố định khi cuộn ngang." : "The row number and Name stay in place when scrolling sideways."}</span><span>{vi ? "Bấm tên để mở trang chi tiết" : "Select a name to open the record"}</span></p>}
        {pages > 1 && <nav class="cl-pager" aria-label={vi ? "Phân trang" : "Pagination"}>
          <span>{vi ? `Trang ${page} / ${pages}` : `Page ${page} of ${pages}`}</span>
          <span>{page > 1 && <a class="ws-btn sm" href={query({ page: String(page - 1) })}>{vi ? "Trước" : "Previous"}</a>}{page < pages && <a class="ws-btn sm" href={query({ page: String(page + 1) })}>{vi ? "Tiếp" : "Next"}</a>}</span>
        </nav>}
      </>}
    </ListHeader>

    {view === "board" && <section class="crm-board-wrap cl-stack" data-board-wrap aria-label={vi ? "Kanban theo trạng thái Lead" : "Kanban by lead status"}
        data-drag-hint={vi ? "{name} · Thả vào một cột để đổi trạng thái, hoặc vào vùng Chuyển đổi / Không tiếp tục ở cuối màn hình. Esc để hủy." : "{name} · Drop on a column to change status, or on Convert / Disqualify at the bottom. Esc cancels."}
        data-moving-hint={vi ? "Đang lưu trạng thái mới cho {name}…" : "Saving the new status for {name}…"} data-cancel-hint={vi ? "Đã hủy kéo." : "Drag cancelled."}>
      <p class="cl-drag-status" role="status" aria-live="polite"><span class="cl-badge info"><span class="dot" />{vi ? "Đang kéo" : "Dragging"}</span><span data-drag-status>{vi ? "Nút ⌄ trên mỗi thẻ có ô Chuyển sang để đổi trạng thái bằng bàn phím." : "Each card’s ⌄ button holds a Move to control for keyboard use."}</span></p>
      <nav class="cl-strip" aria-label={vi ? "Trạng thái Lead" : "Lead statuses"}>{columns.map((column) => <a href={`#col-${column.id}`}>{vi ? column.vi : column.en} · {byStatus(column.id).length}</a>)}</nav>
      <div class="cl-kb-scroll"><div class="cl-kb">
        {[...columns.map((column) => ({ id: column.id, name: vi ? column.vi : column.en, hint: column.target_hours ? (vi ? `Mục tiêu: xử lý trong ${column.target_hours} giờ` : `Target: within ${column.target_hours} h`) : "", cards: byStatus(column.id) })),
          ...(orphans.length ? [{ id: "", name: vi ? "Trạng thái của phiên bản cũ" : "Statuses from an earlier version", hint: "", cards: orphans }] : [])].map((column) => <section class="cl-col" id={`col-${column.id || "old"}`} data-column={column.id || undefined} aria-labelledby={`colh-${column.id || "old"}`}>
          <h2 class="cl-chev" id={`colh-${column.id || "old"}`}><span>{column.name} ({column.cards.length})</span></h2>
          <div class="cl-sum"><b>{vi ? `${column.cards.length} Lead` : `${column.cards.length} ${column.cards.length === 1 ? "lead" : "leads"}`}</b>{column.hint && <span>{column.hint}</span>}</div>
          <div class="cl-lane">
            {column.cards.map((row) => { const pr = processes.get(row.process_id); const late = overTarget(pr, row); const editable = ctx.actor.manager || row.owner_id === ctx.actor.id; const alert = late ? (vi ? "Quá thời gian mục tiêu" : "Past the target time") : !row.owner_id ? (vi ? "Chưa có người phụ trách" : "No owner yet") : ""; return <article class:list={["cl-kc", { warn: !!alert }]} data-card={editable ? row.id : undefined} data-name={`${row.name} · ${row.company}`} data-current={row.status_id}
                data-zone-convert={editable ? `${base}/leads/${row.id}?convert=1#convert` : undefined} data-zone-disqualify={editable ? `${base}/leads/${row.id}#disqualify` : undefined}>
              <div class="cl-kc-top">
                {editable ? <span class="cl-grip"><NavIcon name="grip" size={16} /></span> : <span class="cl-grip" />}
                <a class="cl-kc-title" href={`${base}/leads/${row.id}`}>{row.name}</a>
                {alert && <span class="cl-kc-alert" title={alert}><NavIcon name="warn" size={16} /><span class="crm-sr">{alert}</span></span>}
                {editable && <details class="ws-drop cl-kc-more">
                  <summary class="cl-menu-btn" aria-label={vi ? `Hành động cho ${row.name}` : `Actions for ${row.name}`}><NavIcon name="chevron" size={14} /></summary>
                  <div class="ws-pop ws-menu-pop cl-kc-pop">
                    <p class="ws-mi-head">{vi ? "Chuyển sang" : "Move to"}</p>
                    <form method="post" data-move>
                      <Hidden intent="lead_status" state={state} version={row.version} /><input type="hidden" name="lead_id" value={row.id} />
                      <label class="crm-sr" for={`mv-${row.id}`}>{vi ? `Chuyển ${row.name} sang trạng thái` : `Move ${row.name} to status`}</label>
                      <select id={`mv-${row.id}`} name="status_id" data-move-to>{(pr ?? process).def.statuses.map((item) => <option value={item.id} selected={item.id === row.status_id}>{vi ? item.vi : item.en}</option>)}</select>
                      <button class="ws-btn sm" type="submit">{vi ? "Chuyển" : "Move"}</button>
                    </form>
                    <ul><li><a href={`${base}/leads/${row.id}?convert=1#convert`}>{vi ? "Chuyển đổi…" : "Convert…"}</a></li><li><a href={`${base}/leads/${row.id}#disqualify`}>{vi ? "Không tiếp tục…" : "Disqualify…"}</a></li><li><a href={`${base}/leads/${row.id}`}>{vi ? "Mở Lead" : "Open lead"}</a></li></ul>
                  </div>
                </details>}
              </div>
              <dl><dt>{vi ? "Công ty" : "Company"}</dt><dd>{row.company}</dd>{row.need && <><dt>{vi ? "Nhu cầu" : "Need"}</dt><dd>{row.need.slice(0, 80)}</dd></>}<dt>{vi ? "Nguồn Lead" : "Lead source"}</dt><dd>{label(lang, "channel", row.source_channel)}</dd></dl>
              <div class="cl-kc-foot"><span class="cl-av" title={ownerName(row.owner_id)} aria-hidden="true">{row.owner_id ? initials(ownerName(row.owner_id)) : "?"}</span><span class="crm-sr">{vi ? "Người phụ trách" : "Owner"}: {ownerName(row.owner_id)}.</span><span>{vi ? `${age(leadAgeHours(row))} từ khi tạo` : `${age(leadAgeHours(row))} old`}</span>{alert && <span class="cl-badge warn"><span class="dot" />{alert}</span>}</div>
            </article>; })}
            {!column.cards.length && <p class="cl-none">{vi ? "Không có Lead." : "No leads."}</p>}
          </div>
        </section>)}
      </div></div>
      <div class="cl-dropbar crm-dropzones" aria-hidden="true">
        <div class="cl-drop won" data-zone="convert">{vi ? "Chuyển Lead thành cơ hội" : "Convert to an opportunity"}</div>
        <div class="cl-drop lost" data-zone="disqualify">{vi ? "Không tiếp tục · cần lý do" : "Disqualify · reason required"}</div>
      </div>
    </section>}
  </div>

  <Sheet id="new-lead" title={vi ? "Tạo Lead" : "New lead"} vi={vi} open={sheetOpen} closeHref={`${base}/leads${query({})}`.replace(/\?$/, "")} action={`${base}/leads${query({ new: "1" })}#new-lead`} width="640px">
    <FormNotices state={state} lang={lang} intents={["lead_create"]} fieldLabels={fieldLabels} />
    <p class="cl-sheet-tip">{vi ? "Cho người bạn tự tìm được (ghé thăm, gọi, sự kiện). Yêu cầu từ website và khách được giới thiệu tự vào hàng chờ. Cần điện thoại hoặc email." : "For people you found yourself (visit, call, event). Website enquiries and referrals arrive in the queue on their own. A phone number or email is required."}</p>
      <Hidden intent="lead_create" state={state} />
      <p class="cl-sheet-sec">{vi ? "Thông tin Lead" : "Lead details"}</p>
      <div class="crm-form-grid">
        <Field name="name" label={fieldLabels.name} lang={lang} value={v("name")} error={e("name")} required maxlength={160} />
        <Field name="job_title" label={vi ? "Chức danh" : "Job title"} lang={lang} value={v("job_title")} maxlength={120} />
        <Field name="company" label={fieldLabels.company} lang={lang} value={v("company")} error={e("company")} required maxlength={160} />
        <Field name="phone" type="tel" label={vi ? "Điện thoại / Zalo" : "Phone / Zalo"} lang={lang} value={v("phone")} error={e("phone")} maxlength={40} inputmode="tel" />
        <Field name="email" type="email" label="Email" lang={lang} value={v("email")} error={e("email")} maxlength={254} />
        <Field name="industry" label={vi ? "Ngành" : "Industry"} lang={lang} value={v("industry")} maxlength={120} />
        <Field name="region" label={vi ? "Khu vực" : "Area"} lang={lang} value={v("region")} maxlength={120} />
        <Field name="source_channel" type="select" label={fieldLabels.source_channel} lang={lang} value={v("source_channel", "field_visit")} error={e("source_channel")} options={manualSources} />
        <Field name="source_detail" label={vi ? "Chi tiết nguồn" : "Source detail"} lang={lang} value={v("source_detail")} maxlength={300} />
        <Field name="playbook_key" type="select" label={fieldLabels.playbook_key} lang={lang} value={v("playbook_key")} error={e("playbook_key")} options={[{ value: "", label: vi ? "Chưa rõ" : "Not known yet" }, ...playbooks.map((item) => ({ value: item.playbook_key, label: vi ? item.name_vi : item.name_en }))]} />
        {ctx.actor.manager && <Field name="owner_id" type="select" label={fieldLabels.owner_id} lang={lang} value={v("owner_id", ctx.actor.id)} error={e("owner_id")} options={[{ value: "unassigned", label: vi ? "Để trong hàng chờ" : "Leave in the queue" }, ...owners.map((owner) => ({ value: owner.id, label: owner.label }))]} />}
        <Field name="next_action" label={vi ? "Bước tiếp theo" : "Next step"} lang={lang} value={v("next_action")} maxlength={500} />
        <Field name="next_action_due" type="date" label={fieldLabels.next_action_due} lang={lang} value={v("next_action_due")} error={e("next_action_due")} />
        <Field name="need" type="textarea" wide label={vi ? "Nhu cầu, theo lời họ" : "Need, in their words"} lang={lang} value={v("need")} maxlength={1500} />
      </div>
      <Fragment slot="foot"><a class="ws-btn" href={`${base}/leads${query({})}`.replace(/\?$/, "")}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu" : "Save"}</button></Fragment>
  </Sheet>
</CrmShell>
<script>import "../../scripts/crm-board";</script>
