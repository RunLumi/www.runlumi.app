---
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { formatDate, label, options } from "../../lib/crm/i18n";
import { leadAgeHours, overTarget, statusLabel } from "../../lib/crm/leads";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { LeadsProps } from "../../lib/crm/routes/leads";
import "../../styles/crm-sales.css";

type Props = LeadsProps;
const { ctx, state, view, filters, rows, total, page, pages, process, processes, owners, ownerNames, playbooks } = Astro.props;
const { lang, vi, base } = ctx;
const v = (name: string, fallback = "") => valueFor(state, "lead_create", name, fallback);
const e = (name: string) => errorFor(state, "lead_create", name);
const query = (changes: Record<string, string>) => {
  const params = new URLSearchParams(Object.entries({ ...filters, view, ...changes }).filter(([key, value]) => value && !(key === "state" && value === "open") && !(key === "view" && value === "list")));
  const text = params.toString();
  return text ? `?${text}` : "?";
};
const ownerName = (id: string | null) => id ? (ownerNames[id]?.name ?? (id === ctx.actor.id ? ctx.actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chờ phân công" : "Waiting for assignment");
const age = (hours: number) => hours < 24 ? (vi ? `${hours} giờ` : `${hours} h`) : (vi ? `${Math.floor(hours / 24)} ngày` : `${Math.floor(hours / 24)} d`);
const stateTone: Record<string, string> = { open: "blue", converted: "green", disqualified: "" };
const stateLabel: Record<string, [string, string]> = { open: ["Open", "Đang mở"], converted: ["Converted", "Đã chuyển đổi"], disqualified: ["Disqualified", "Không tiếp tục"] };
const manualSources = options(lang, "channel").filter((item) => !["inbound_web", "referral", "existing_customer"].includes(item.value));
const columns = process.def.statuses;
const known = new Set(columns.map((item) => item.id));
const byStatus = (id: string) => rows.filter((row) => row.status_id === id);
const orphans = rows.filter((row) => !known.has(row.status_id));
const fieldLabels: Record<string, string> = vi
  ? { name: "Họ tên", company: "Công ty", phone: "Điện thoại", email: "Email", source_channel: "Nguồn Lead", owner_id: "Người phụ trách", playbook_key: "Nhu cầu thuộc quy trình", next_action_due: "Hạn bước tiếp theo" }
  : { name: "Name", company: "Company", phone: "Phone", email: "Email", source_channel: "Lead source", owner_id: "Owner", playbook_key: "Playbook", next_action_due: "Next step due" };
---
<CrmShell title={vi ? "Lead" : "Leads"} lang={lang} actor={ctx.actor} current="leads">
  <div class="crm-head">
    <div>
      <p class="crm-eyebrow">Lead</p>
      <h1 class="crm-h1">{vi ? "Lead cần liên hệ và đánh giá." : "Leads to contact and qualify."}</h1>
      <p class="crm-lede">{vi
        ? "Yêu cầu từ local.runlumi.app, khách được giới thiệu và người bạn tự tìm được vào đây trước. Khi đã đủ điều kiện, chuyển đổi để tạo công ty, liên hệ và cơ hội."
        : "Enquiries from local.runlumi.app, referred businesses and people you find yourself land here first. Once qualified, convert to create the company, contact and opportunity."}</p>
    </div>
    <a class="crm-button" href="#new-lead">{vi ? "Tạo Lead" : "New lead"}</a>
  </div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={fieldLabels} />

  <div class="crm-toolbar">
    <nav class="crm-views" aria-label={vi ? "Cách xem" : "View"}>
      <a href={query({ view: "list" })} aria-current={view === "list" ? "page" : undefined}>{vi ? "Danh sách" : "List"}</a>
      <a href={query({ view: "board", state: "open" })} aria-current={view === "board" ? "page" : undefined}>Kanban</a>
    </nav>
    <p class="crm-meta" role="status">{vi ? `${total} Lead` : `${total} leads`}{view === "board" ? (vi ? " đang mở · nhóm theo trạng thái Lead" : " open · grouped by lead status") : ""}</p>
  </div>

  <form class="crm-sheet crm-filter" method="get" aria-label={vi ? "Bộ lọc" : "Filters"}>
    {view === "board" && <input type="hidden" name="view" value="board" />}
    <div class="crm-field"><label for="lq">{vi ? "Tìm theo tên, công ty" : "Search name or company"}</label><input class="crm-input" id="lq" name="q" value={filters.q} maxlength="120" /></div>
    {view === "list" && <div class="crm-field"><label for="lstate">{vi ? "Tình trạng" : "State"}</label><select class="crm-select" id="lstate" name="state">{Object.entries(stateLabel).map(([value, names]) => <option value={value} selected={filters.state === value}>{names[vi ? 1 : 0]}</option>)}<option value="all" selected={filters.state === "all"}>{vi ? "Tất cả" : "All"}</option></select></div>}
    {view === "list" && <div class="crm-field"><label for="lstatus">{vi ? "Trạng thái Lead" : "Lead status"}</label><select class="crm-select" id="lstatus" name="status"><option value="">{vi ? "Tất cả" : "Any"}</option>{columns.map((item) => <option value={item.id} selected={filters.status === item.id}>{vi ? item.vi : item.en}</option>)}</select></div>}
    <div class="crm-field"><label for="lsource">{vi ? "Nguồn Lead" : "Lead source"}</label><select class="crm-select" id="lsource" name="source"><option value="">{vi ? "Tất cả" : "Any"}</option>{options(lang, "channel").map((item) => <option value={item.value} selected={filters.source === item.value}>{item.label}</option>)}</select></div>
    {ctx.actor.manager && <div class="crm-field"><label for="lowner">{vi ? "Người phụ trách" : "Owner"}</label><select class="crm-select" id="lowner" name="owner"><option value="">{vi ? "Tất cả" : "Anyone"}</option><option value="unassigned" selected={filters.owner === "unassigned"}>{vi ? "Chờ phân công" : "Waiting for assignment"}</option>{owners.map((owner) => <option value={owner.id} selected={filters.owner === owner.id}>{owner.label}</option>)}</select></div>}
    <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Lọc" : "Apply"}</button><a class="crm-link" href={view === "board" ? "?view=board" : "?"}>{vi ? "Xóa lọc" : "Clear"}</a></div>
  </form>

  {view === "list" ? <section aria-label={vi ? "Danh sách Lead" : "Lead list"} style="margin-top:18px">
    {rows.length ? <div class="crm-grid-table-wrap" tabindex="0" role="region" aria-label={vi ? "Bảng Lead, cuộn ngang được" : "Lead table, scrolls sideways"}>
      <table class="crm-grid-table">
        <thead><tr>
          <th class="frozen frozen-1" scope="col">#</th><th class="frozen frozen-2" scope="col">{vi ? "Tên" : "Name"}</th>
          <th scope="col">{vi ? "Chức danh" : "Title"}</th><th scope="col">{vi ? "Công ty" : "Company"}</th><th scope="col">{vi ? "Điện thoại" : "Phone"}</th>
          <th scope="col">{vi ? "Nguồn Lead" : "Lead source"}</th><th scope="col">{vi ? "Trạng thái Lead" : "Lead status"}</th><th scope="col">{vi ? "Nhu cầu" : "Need"}</th>
          <th scope="col">{vi ? "Người phụ trách" : "Owner"}</th><th scope="col">{vi ? "Tạo lúc" : "Created"}</th>
        </tr></thead>
        <tbody>{rows.map((row, index) => { const pr = processes.get(row.process_id); const late = overTarget(pr, row); return <tr>
          <td class="frozen frozen-1 rowno">{(page - 1) * 50 + index + 1}</td>
          <td class="frozen frozen-2"><a href={`${base}/leads/${row.id}`}>{row.name}</a></td>
          <td>{row.job_title || "—"}</td><td class="wrap">{row.company}</td><td>{row.phone || "—"}</td>
          <td>{label(lang, "channel", row.source_channel)}</td>
          <td>{row.state === "open" ? <span class:list={["crm-badge", late ? "amber" : "blue"]}>{statusLabel(pr, row.status_id, vi)}{late ? (vi ? ` · quá ${age(leadAgeHours(row))}` : ` · ${age(leadAgeHours(row))} old`) : ""}</span> : <span class:list={["crm-badge", stateTone[row.state]]}>{stateLabel[row.state][vi ? 1 : 0]}</span>}</td>
          <td class="wrap">{row.need ? row.need.slice(0, 120) : "—"}</td>
          <td>{ownerName(row.owner_id)}</td><td>{formatDate(row.created_at, lang)}</td>
        </tr>; })}</tbody>
      </table>
    </div> : <p class="crm-empty crm-sheet">{vi ? "Không có Lead khớp bộ lọc." : "No leads match these filters."}</p>}
    <p class="crm-table-note">{vi ? "Cột số dòng và Tên cố định khi cuộn ngang. Bấm tên để mở Lead." : "The row number and Name stay in place when scrolling sideways. Select a name to open the lead."}</p>
    {pages > 1 && <nav class="crm-pagination" aria-label={vi ? "Phân trang" : "Pagination"}>
      <span class="crm-meta">{vi ? `Trang ${page} / ${pages}` : `Page ${page} of ${pages}`}</span>
      <span class="crm-actions">{page > 1 && <a class="crm-button small secondary" href={query({ page: String(page - 1) })}>{vi ? "Trước" : "Previous"}</a>}{page < pages && <a class="crm-button small secondary" href={query({ page: String(page + 1) })}>{vi ? "Tiếp" : "Next"}</a>}</span>
    </nav>}
  </section> : <section class="crm-board-wrap" data-board-wrap aria-label={vi ? "Kanban Lead" : "Lead board"} style="margin-top:18px"
      data-drag-hint={vi ? "Đang kéo {name}. Thả vào một cột để đổi trạng thái, hoặc vào vùng Chuyển đổi / Không tiếp tục. Esc để hủy." : "Dragging {name}. Drop on a column to change status, or on Convert / Disqualify. Esc cancels."}
      data-moving-hint={vi ? "Đang lưu trạng thái mới cho {name}…" : "Saving the new status for {name}…"} data-cancel-hint={vi ? "Đã hủy kéo." : "Drag cancelled."}>
    <p class="crm-help crm-drag-status" data-drag-status role="status" aria-live="polite">{vi ? "Mỗi thẻ có ô \"Chuyển sang\" để đổi trạng thái bằng bàn phím." : "Every card has a \"Move to\" control for keyboard use."}</p>
    <div class="crm-board">
      {[...columns.map((column) => ({ id: column.id, name: vi ? column.vi : column.en, hint: column.target_hours ? (vi ? `Mục tiêu: xử lý trong ${column.target_hours} giờ` : `Target: within ${column.target_hours} h`) : "", cards: byStatus(column.id) })),
        ...(orphans.length ? [{ id: "", name: vi ? "Trạng thái của phiên bản cũ" : "Statuses from an earlier version", hint: "", cards: orphans }] : [])].map((column) => <section class="crm-col" data-column={column.id || undefined} aria-labelledby={`col-${column.id || "old"}`}>
        <div class="crm-col-head"><h2 id={`col-${column.id || "old"}`}>{column.name} ({column.cards.length})</h2>{column.hint && <p>{column.hint}</p>}</div>
        {column.cards.map((row) => { const pr = processes.get(row.process_id); const late = overTarget(pr, row); const editable = ctx.actor.manager || row.owner_id === ctx.actor.id; return <article class="crm-card" data-card={editable ? row.id : undefined} data-name={row.name} data-current={row.status_id}
            data-zone-convert={editable ? `${base}/leads/${row.id}?convert=1#convert` : undefined} data-zone-disqualify={editable ? `${base}/leads/${row.id}#disqualify` : undefined}>
          <a class="crm-card-title" href={`${base}/leads/${row.id}`}>{row.name}</a>
          <dl><dt>{vi ? "Công ty" : "Company"}</dt><dd>{row.company}</dd>{row.need && <><dt>{vi ? "Nhu cầu" : "Need"}</dt><dd>{row.need.slice(0, 80)}</dd></>}<dt>{vi ? "Nguồn" : "Source"}</dt><dd>{label(lang, "channel", row.source_channel)}</dd><dt>{vi ? "Phụ trách" : "Owner"}</dt><dd>{ownerName(row.owner_id)}</dd><dt>{vi ? "Tuổi" : "Age"}</dt><dd>{age(leadAgeHours(row))}</dd></dl>
          {late && <p class="crm-card-alert">{vi ? "Quá thời gian mục tiêu của trạng thái" : "Past this status's target time"}</p>}
          {!row.owner_id && <p class="crm-card-alert">{vi ? "Chưa có người phụ trách" : "No owner yet"}</p>}
          {editable && <form class="crm-move" method="post" data-move>
            <Hidden intent="lead_status" state={state} version={row.version} /><input type="hidden" name="lead_id" value={row.id} />
            <label class="crm-sr" for={`mv-${row.id}`}>{vi ? `Chuyển ${row.name} sang trạng thái` : `Move ${row.name} to status`}</label>
            <select class="crm-select" id={`mv-${row.id}`} name="status_id" data-move-to>{(pr ?? process).def.statuses.map((item) => <option value={item.id} selected={item.id === row.status_id}>{vi ? item.vi : item.en}</option>)}</select>
            <button class="crm-button small secondary" type="submit">{vi ? "Chuyển" : "Move"}</button>
            <a class="crm-link" href={`${base}/leads/${row.id}?convert=1#convert`}>{vi ? "Chuyển đổi" : "Convert"}</a>
          </form>}
        </article>; })}
        {!column.cards.length && <p class="crm-empty crm-meta">{vi ? "Không có Lead." : "No leads."}</p>}
      </section>)}
    </div>
    <div class="crm-dropzones" aria-hidden="true">
      <div class="crm-dropzone won" data-zone="convert">{vi ? "Chuyển Lead thành cơ hội" : "Convert to an opportunity"}</div>
      <div class="crm-dropzone lost" data-zone="disqualify">{vi ? "Không tiếp tục · cần lý do" : "Disqualify · reason required"}</div>
    </div>
  </section>}

  <section class="crm-sheet" id="new-lead" aria-labelledby="new-lead-h" style="margin-top:18px">
    <h2 class="crm-h2" id="new-lead-h">{vi ? "Tạo Lead" : "New lead"}</h2>
    <p class="crm-help">{vi ? "Cho người bạn tự tìm được (ghé thăm, gọi, sự kiện). Yêu cầu từ website và khách được giới thiệu tự vào hàng chờ. Cần điện thoại hoặc email." : "For people you found yourself (visit, call, event). Website enquiries and referrals arrive in the queue on their own. A phone number or email is required."}</p>
    <form class="crm-form" method="post" action="#new-lead-h">
      <Hidden intent="lead_create" state={state} />
      <div class="crm-form-grid">
        <Field name="name" label={fieldLabels.name} lang={lang} value={v("name")} error={e("name")} required maxlength={160} />
        <Field name="job_title" label={vi ? "Chức danh" : "Job title"} lang={lang} value={v("job_title")} maxlength={120} />
        <Field name="company" label={fieldLabels.company} lang={lang} value={v("company")} error={e("company")} required maxlength={160} />
        <Field name="phone" type="tel" label={vi ? "Điện thoại / Zalo" : "Phone / Zalo"} lang={lang} value={v("phone")} error={e("phone")} maxlength={40} inputmode="tel" />
        <Field name="email" type="email" label="Email" lang={lang} value={v("email")} error={e("email")} maxlength={254} />
        <Field name="industry" label={vi ? "Ngành" : "Industry"} lang={lang} value={v("industry")} maxlength={120} />
        <Field name="region" label={vi ? "Khu vực" : "Area"} lang={lang} value={v("region")} maxlength={120} />
        <Field name="source_channel" type="select" label={fieldLabels.source_channel} lang={lang} value={v("source_channel", "field_visit")} error={e("source_channel")} options={manualSources} />
        <Field name="source_detail" label={vi ? "Chi tiết nguồn" : "Source detail"} lang={lang} value={v("source_detail")} maxlength={300} />
        <Field name="playbook_key" type="select" label={fieldLabels.playbook_key} lang={lang} value={v("playbook_key")} error={e("playbook_key")} options={[{ value: "", label: vi ? "Chưa rõ" : "Not known yet" }, ...playbooks.map((item) => ({ value: item.playbook_key, label: vi ? item.name_vi : item.name_en }))]} />
        {ctx.actor.manager && <Field name="owner_id" type="select" label={fieldLabels.owner_id} lang={lang} value={v("owner_id", ctx.actor.id)} error={e("owner_id")} options={[{ value: "unassigned", label: vi ? "Để trong hàng chờ" : "Leave in the queue" }, ...owners.map((owner) => ({ value: owner.id, label: owner.label }))]} />}
        <Field name="next_action" label={vi ? "Bước tiếp theo" : "Next step"} lang={lang} value={v("next_action")} maxlength={500} />
        <Field name="next_action_due" type="date" label={fieldLabels.next_action_due} lang={lang} value={v("next_action_due")} error={e("next_action_due")} />
      </div>
      <Field name="need" type="textarea" label={vi ? "Nhu cầu, theo lời họ" : "Need, in their words"} lang={lang} value={v("need")} maxlength={1500} />
      <div class="crm-actions"><button class="crm-button" type="submit">{vi ? "Tạo Lead" : "Create lead"}</button></div>
    </form>
  </section>
</CrmShell>
<script>import "../../scripts/crm-board";</script>
