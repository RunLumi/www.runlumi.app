---
// Calendar month and week (boards Calendar, CalendarWeek, NewEvent,
// MobileCalendar). Stories: docs/governance/USER-STORIES.md § CRM list screens.
// Items are scoped like the pipeline; a new event is a task created through
// the record's checks. The calendar sends nothing to customers.
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import ListHeader from "../workspace/ui/ListHeader.astro";
import ButtonGroup from "../workspace/ui/ButtonGroup.astro";
import Dialog from "../workspace/ui/Dialog.astro";
import Glyph from "./Glyph.astro";
import { label, options } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { CalendarProps } from "../../lib/crm/routes/calendar";
import { type CalendarItem, calendarRange } from "../../lib/crm/calendar";
import "../../styles/crm-sales.css";
import "../../styles/crm-lists.css";

type Props = CalendarProps;
const { ctx, state, view, range, items, activity, today, opportunities, newDate } = Astro.props;
const { lang, vi, base } = ctx;
const locale = vi ? "vi-VN" : "en-GB";
const fmt = (date: string, opts: Intl.DateTimeFormatOptions) => new Date(`${date}T00:00:00+07:00`).toLocaleDateString(locale, { timeZone: "Asia/Ho_Chi_Minh", ...opts });
const byDay = new Map<string, CalendarItem[]>();
for (const item of items) byDay.set(item.date, [...(byDay.get(item.date) ?? []), item]);
const weekdayNames = vi ? ["Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ nhật"] : ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const miniNames = vi ? ["T2", "T3", "T4", "T5", "T6", "T7", "CN"] : ["M", "T", "W", "T", "F", "S", "S"];
const capital = (text: string) => text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
const monthTitle = (month: string) => capital(fmt(`${month}-01`, { month: "long", year: "numeric" }));
const anchorMonth = view === "week" ? (range.days.find((day) => day === today) ?? range.anchor).slice(0, 7) : range.anchor.slice(0, 7);
const weekTitle = `${fmt(range.from, { day: "numeric", month: "short" })} – ${fmt(range.to, { day: "numeric", month: "short", year: "numeric" })}`;
const activityNames: Record<string, [string, string]> = {
  stage: ["Stage changed", "Đổi giai đoạn"], note: ["Note", "Ghi chú"], task_completed: ["Task done", "Hoàn thành việc"], meeting_confirmed: ["Meeting confirmed", "Khách xác nhận lịch hẹn"],
  quote_accepted: ["Quote accepted", "Chấp thuận báo giá"], lead_note: ["Lead note", "Ghi chú Lead"], lead_status: ["Lead status", "Trạng thái Lead"], lead_converted: ["Lead converted", "Lead thành cơ hội"],
};
const kindLabel = (item: CalendarItem) => item.kind === "task" ? label(lang, "task", item.subtype)
  : item.kind === "next_step" ? (vi ? "Bước tiếp theo" : "Next step")
  : item.kind === "lead_step" ? (vi ? "Lead · bước tiếp theo" : "Lead · next step")
  : (activityNames[item.subtype]?.[vi ? 1 : 0] ?? item.subtype);
const appointment = new Set(["meeting", "visit", "demo", "pilot_review"]);
// Colour families (legend): appointments, tasks, opportunity next steps, lead next steps, recorded activity; overdue and done override.
const tone = (item: CalendarItem) => item.status === "done" ? "done" : item.overdue ? "over"
  : item.kind === "activity" ? "activity" : item.kind === "next_step" ? "deal" : item.kind === "lead_step" ? "lead" : appointment.has(item.subtype) ? "event" : "task";
const text = (item: CalendarItem) => `${item.time ? `${item.time} ` : ""}${kindLabel(item)}: ${item.title}${item.record !== item.title ? ` · ${item.record}` : ""}`;
const link = (changes: Record<string, string>) => {
  const params = new URLSearchParams({ view, [view === "week" ? "week" : "month"]: view === "week" ? range.anchor : range.anchor.slice(0, 7), ...(activity ? { activity: "1" } : {}), ...changes });
  for (const [key, value] of [...params]) if (!value) params.delete(key);
  return `${base}/calendar?${params}`;
};
const monthHref = (month: string) => link({ view: "month", week: "", month });
const weekHref = (day: string) => link({ view: "week", month: "", week: day });
const inMonth = (day: string) => day.slice(0, 7) === range.anchor.slice(0, 7);
const v = (name: string, fallback = "") => valueFor(state, "task_create", name, fallback);
const e = (name: string) => errorFor(state, "task_create", name);
const shown = items.filter((item) => view === "week" || inMonth(item.date));
// The rail's mini month always shows the month in view (or the week's month).
const mini = calendarRange("month", anchorMonth, today);
const currentWeek = view === "week" ? range.days : [];
// Week time grid: 07:00–20:00; earlier or later items sit in the first or last row.
const hours = Array.from({ length: 14 }, (_, index) => 7 + index);
const hourOf = (time: string | null) => Math.min(20, Math.max(7, Number(time?.slice(0, 2) ?? 7)));
const nowHour = Number(new Date(Date.now() + 7 * 3_600_000).toISOString().slice(11, 13));
const sheetOpen = Astro.url.searchParams.get("new") === "1" || (state.intent === "task_create" && (Object.keys(state.errors).length > 0 || state.serverError || state.conflict));
const closeHref = link({ new: "", date: "" });
const fieldLabels = vi ? { opportunity_id: "Liên quan đến", kind: "Loại", title: "Chủ đề", due_on: "Ngày", due_time: "Giờ", contact_id: "Liên hệ" } : { opportunity_id: "Related to", kind: "Kind", title: "Subject", due_on: "Date", due_time: "Time", contact_id: "Contact" };
const legend: { tone: string; label: string }[] = [
  { tone: "event", label: vi ? "Lịch hẹn, ghé thăm, demo" : "Meetings, visits, demos" },
  { tone: "task", label: vi ? "Công việc khác" : "Other tasks" },
  { tone: "deal", label: vi ? "Bước tiếp theo của cơ hội" : "Opportunity next steps" },
  { tone: "lead", label: vi ? "Bước tiếp theo của Lead" : "Lead next steps" },
  { tone: "over", label: vi ? "Quá hạn" : "Overdue" },
];
---
<CrmShell title={vi ? "Lịch" : "Calendar"} lang={lang} actor={ctx.actor} current="calendar">
  <div class="cl-stack">
    <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} intents={[]} />
    <ListHeader vi={vi} icon="calendar" tone="event" object={vi ? "Lịch" : "Calendar"} title={view === "week" ? weekTitle : monthTitle(range.anchor.slice(0, 7))} meta={vi ? `${shown.length} mục trong kỳ này · giờ Việt Nam` : `${shown.length} items in this period · Vietnam time`}>
      <div slot="actions" class="cl-cal-actions">
        <nav class="ws-bg" aria-label={vi ? "Chuyển kỳ" : "Change period"}>
          <a class="ws-btn icon" href={view === "week" ? weekHref(range.previous) : monthHref(range.previous)} aria-label={vi ? (view === "week" ? "Tuần trước" : "Tháng trước") : (view === "week" ? "Previous week" : "Previous month")}><Glyph name="left" /></a>
          <a class="ws-btn" href={view === "week" ? weekHref(today) : monthHref(today.slice(0, 7))}>{vi ? "Hôm nay" : "Today"}</a>
          <a class="ws-btn icon" href={view === "week" ? weekHref(range.next) : monthHref(range.next)} aria-label={vi ? (view === "week" ? "Tuần sau" : "Tháng sau") : (view === "week" ? "Next week" : "Next month")}><Glyph name="right" /></a>
        </nav>
        <nav class="ws-bg" aria-label={vi ? "Cách xem" : "View"}>
          <a class:list={["ws-btn", { on: view === "week" }]} href={weekHref(view === "week" ? range.anchor : (inMonth(today) ? today : range.anchor))} aria-current={view === "week" ? "page" : undefined}>{vi ? "Tuần" : "Week"}</a>
          <a class:list={["ws-btn", { on: view === "month" }]} href={monthHref(view === "week" ? anchorMonth : range.anchor.slice(0, 7))} aria-current={view === "month" ? "page" : undefined}>{vi ? "Tháng" : "Month"}</a>
        </nav>
        <a class="ws-btn icon" href={link({})} aria-label={vi ? "Làm mới" : "Refresh"}><Glyph name="refresh" /></a>
        {opportunities.length > 0 && <a class="ws-btn primary" href={`${link({ new: "1" })}#new-event`}>{vi ? "Tạo lịch hẹn" : "New event"}</a>}
      </div>
    </ListHeader>

    <div class="cl-cal">
      <aside class="cl-panel cl-cal-rail" aria-label={vi ? "Lịch nhỏ và chú thích" : "Mini calendar and legend"}>
        <div>
          <div class="cl-mini-h"><strong>{monthTitle(anchorMonth)}</strong><nav aria-label={vi ? "Đổi tháng" : "Change month"}><a href={monthHref(mini.previous)} aria-label={vi ? "Tháng trước" : "Previous month"}><Glyph name="left" /></a><a href={monthHref(mini.next)} aria-label={vi ? "Tháng sau" : "Next month"}><Glyph name="right" /></a></nav></div>
          <div class="cl-mini">
            {miniNames.map((name) => <b aria-hidden="true">{name}</b>)}
            {mini.days.map((day) => <a href={weekHref(day)} class:list={{ o: day.slice(0, 7) !== anchorMonth, t: day === today, wk: currentWeek.includes(day) && day !== today }} aria-label={fmt(day, { weekday: "long", day: "numeric", month: "long" })}>{Number(day.slice(8))}</a>)}
          </div>
        </div>
        <div>
          <p class="cl-legend-h">{vi ? "Lịch của tôi" : "My calendar"}</p>
          <ul class="cl-legend">
            {legend.map((item) => <li><span class:list={["cl-sw", item.tone]} aria-hidden="true" />{item.label}</li>)}
            <li><a class="cl-legend-toggle" href={link({ activity: activity ? "" : "1" })} aria-pressed={activity ? "true" : "false"}><span class="cl-check" aria-hidden="true">{activity ? "✓" : ""}</span><span class="cl-sw activity" aria-hidden="true" />{vi ? "Hoạt động đã ghi" : "Recorded activity"}</a></li>
          </ul>
        </div>
        <p class="cl-note">{ctx.actor.manager
          ? (vi ? "Bạn xem lịch của cả nhóm. Mục gạch ngang đã xong. Lịch không gửi lời mời hay tin nhắn cho khách." : "You see the whole team's calendar. Struck-through items are done. The calendar sends no invitations or messages to customers.")
          : (vi ? "Chỉ hiện cơ hội và Lead bạn phụ trách. Mục gạch ngang đã xong. Lịch không gửi lời mời hay tin nhắn cho khách." : "Only the opportunities and leads you own. Struck-through items are done. The calendar sends no invitations or messages to customers.")}</p>
      </aside>

      <section class="cl-panel cl-cal-main" aria-label={view === "week" ? weekTitle : monthTitle(range.anchor.slice(0, 7))}>
        {view === "month" ? <div class="cl-mg" role="grid" aria-readonly="true">
          <div role="row" class="cl-mg-row">{weekdayNames.map((day) => <div class="cl-mg-h" role="columnheader">{day}</div>)}</div>
          {Array.from({ length: range.days.length / 7 }, (_, week) => <div role="row" class="cl-mg-row">{range.days.slice(week * 7, week * 7 + 7).map((day, index) => { const list = byDay.get(day) ?? []; return <div role="gridcell" class:list={["cl-mc", { out: !inMonth(day), today: day === today, wknd: index > 4 && inMonth(day) }]}>
            <a class="cl-mc-d" href={weekHref(day)} aria-label={fmt(day, { weekday: "long", day: "numeric", month: "long" })}>{Number(day.slice(8))}</a>
            {list.slice(0, 3).map((item) => <a class:list={["cl-ev", tone(item)]} href={item.href} title={text(item)}>{item.time && <span class="t">{item.time}</span>}<span>{item.title}</span><span class="crm-sr"> · {kindLabel(item)}{item.overdue ? (vi ? " · quá hạn" : " · overdue") : ""}</span></a>)}
            {list.length > 3 && <a class="cl-more" href={weekHref(day)}>{vi ? `+${list.length - 3} mục khác` : `+${list.length - 3} more`}</a>}
          </div>; })}</div>)}
        </div> : <div class="cl-wg">
          <div class="cl-wg-h" aria-hidden="true"></div>
          {range.days.map((day, index) => <div class:list={["cl-wg-h", { today: day === today }]}><div class="cl-wg-dn">{weekdayNames[index]}</div><div class="cl-wg-dd">{Number(day.slice(8))}</div></div>)}
          <div class="cl-wg-lab">{vi ? "Cả ngày" : "All day"}</div>
          {range.days.map((day) => <div class="cl-wg-ad">{(byDay.get(day) ?? []).filter((item) => !item.time).map((item) => <a class:list={["cl-ev", tone(item)]} href={item.href} title={text(item)}><span>{item.title}</span><span class="crm-sr"> · {kindLabel(item)}</span></a>)}</div>)}
          {hours.map((hour) => <>
            <div class="cl-wg-time">{`${String(hour).padStart(2, "0")}:00`}</div>
            {range.days.map((day) => <div class:list={["cl-wg-cell", { now: day === today && hour === nowHour }]}>{(byDay.get(day) ?? []).filter((item) => item.time && hourOf(item.time) === hour).map((item) => <a class:list={["cl-ev", tone(item)]} href={item.href} title={text(item)}><span class="t">{item.time}</span><span>{item.title}</span><span class="crm-sr"> · {kindLabel(item)}</span></a>)}</div>)}
          </>)}
        </div>}

        <div class="cl-agenda" aria-label={vi ? "Danh sách theo ngày" : "Agenda"}>
          {range.days.filter((day) => (byDay.get(day) ?? []).length && (view === "week" || inMonth(day))).map((day) => <>
            <h3 class:list={{ today: day === today }}>{capital(fmt(day, { weekday: "long", day: "numeric", month: "numeric" }))}{day === today ? (vi ? " · hôm nay" : " · today") : ""}</h3>
            <ul>{(byDay.get(day) ?? []).map((item) => <li><span class="tm">{item.time ?? (vi ? "Cả ngày" : "All day")}</span><span class:list={["bar", tone(item)]} aria-hidden="true" /><div><a href={item.href}>{item.title}</a><p>{kindLabel(item)}{item.record !== item.title ? ` · ${item.record}` : ""}{item.overdue ? (vi ? " · quá hạn" : " · overdue") : ""}</p></div></li>)}</ul>
          </>)}
          {!shown.length && <p class="cl-empty">{vi ? "Không có mục nào trong kỳ này. Chọn Tạo lịch hẹn để thêm." : "Nothing in this period. Choose New event to add one."}</p>}
        </div>
      </section>
    </div>
  </div>

  <Dialog id="new-event" title={vi ? "Tạo lịch hẹn" : "New event"} vi={vi} open={sheetOpen} closeHref={closeHref} action={opportunities.length ? `${link({ new: "1" })}#new-event` : undefined} width="640px">
    <FormNotices state={state} lang={lang} intents={["task_create"]} fieldLabels={fieldLabels} />
    <p class="cl-sheet-tip">{vi ? "Lịch hẹn là một công việc trên cơ hội của bạn, theo giờ Việt Nam, với cùng kiểm tra như trang cơ hội (kể cả yêu cầu không liên hệ). CRM không gửi lời mời cho khách." : "An event is a task on one of your opportunities, in Vietnam time, with the same checks as the record (do-not-contact included). The CRM sends no invitation to the customer."}</p>
    {opportunities.length ? <>
      <Hidden intent="task_create" state={state} />
      <p class="cl-sheet-sec">{vi ? "Thông tin lịch hẹn" : "Event details"}</p>
      <div class="crm-form-grid">
        <Field name="title" wide label={fieldLabels.title} lang={lang} value={v("title")} error={e("title")} required maxlength={300} />
        <Field name="due_on" type="date" label={fieldLabels.due_on} lang={lang} value={v("due_on", newDate)} error={e("due_on")} help={vi ? "Bắt buộc với ghé thăm, cuộc hẹn và demo." : "Required for visits, meetings and demos."} />
        <Field name="due_time" type="time" label={vi ? "Giờ (giờ Việt Nam)" : "Time (Vietnam)"} lang={lang} value={v("due_time")} error={e("due_time")} />
        <Field name="opportunity_id" type="select" label={fieldLabels.opportunity_id} lang={lang} value={v("opportunity_id")} error={e("opportunity_id")} options={opportunities.map((item) => ({ value: item.id, label: item.title === item.account_name ? item.title : `${item.title} · ${item.account_name}` }))} />
        <Field name="kind" type="select" label={fieldLabels.kind} lang={lang} value={v("kind", "meeting")} error={e("kind")} options={options(lang, "task")} />
        <Field name="note" type="textarea" wide label={vi ? "Ghi chú nội bộ" : "Internal note"} lang={lang} value={v("note")} maxlength={1000} />
      </div>
      {e("contact_id") === "do_not_contact" && <p class="crm-error">{vi ? "Khách đã yêu cầu không liên hệ; không tạo được việc liên hệ." : "The customer asked not to be contacted; outreach cannot be scheduled."}</p>}
    </> : <p class="cl-empty">{vi ? "Bạn chưa có cơ hội đang mở để thêm lịch hẹn." : "You have no open opportunities to schedule against."}</p>}
    {opportunities.length > 0 && <Fragment slot="foot"><a class="ws-btn" href={closeHref}>{vi ? "Hủy" : "Cancel"}</a><button class="ws-btn primary" type="submit">{vi ? "Lưu" : "Save"}</button></Fragment>}
  </Dialog>
</CrmShell>
