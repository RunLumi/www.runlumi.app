---
import CrmShell from "../../layouts/CrmShell.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { label, options } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { CalendarProps } from "../../lib/crm/routes/calendar";
import type { CalendarItem } from "../../lib/crm/calendar";
import "../../styles/crm-sales.css";

type Props = CalendarProps;
const { ctx, state, view, range, items, activity, today, opportunities, newDate } = Astro.props;
const { lang, vi, base } = ctx;
const locale = vi ? "vi-VN" : "en-GB";
const fmt = (date: string, opts: Intl.DateTimeFormatOptions) => new Date(`${date}T00:00:00+07:00`).toLocaleDateString(locale, { timeZone: "Asia/Ho_Chi_Minh", ...opts });
const byDay = new Map<string, CalendarItem[]>();
for (const item of items) byDay.set(item.date, [...(byDay.get(item.date) ?? []), item]);
const weekdays = range.days.slice(0, 7).map((day) => fmt(day, { weekday: "short" }));
const capital = (text: string) => text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
const monthTitle = capital(fmt(range.anchor, { month: "long", year: "numeric" }));
const weekTitle = `${fmt(range.from, { day: "numeric", month: "short" })} – ${fmt(range.to, { day: "numeric", month: "short", year: "numeric" })}`;
const activityNames: Record<string, [string, string]> = {
  stage: ["Stage changed", "Đổi giai đoạn"], note: ["Note", "Ghi chú"], task_completed: ["Task done", "Hoàn thành việc"], meeting_confirmed: ["Meeting confirmed", "Khách xác nhận lịch hẹn"],
  quote_accepted: ["Quote accepted", "Chấp thuận báo giá"], lead_note: ["Lead note", "Ghi chú Lead"], lead_status: ["Lead status", "Trạng thái Lead"], lead_converted: ["Lead converted", "Lead thành cơ hội"],
};
const kindLabel = (item: CalendarItem) => item.kind === "task" ? label(lang, "task", item.subtype)
  : item.kind === "next_step" ? (vi ? "Bước tiếp theo" : "Next step")
  : item.kind === "lead_step" ? (vi ? "Lead · bước tiếp theo" : "Lead · next step")
  : (activityNames[item.subtype]?.[vi ? 1 : 0] ?? item.subtype);
const tone = (item: CalendarItem) => item.kind === "activity" ? "event" : item.status === "done" ? "done" : item.overdue ? "overdue" : "";
const text = (item: CalendarItem) => `${item.time ? `${item.time} ` : ""}${kindLabel(item)}: ${item.title}`;
const q = (changes: Record<string, string>) => {
  const params = new URLSearchParams({ view, [view === "week" ? "week" : "month"]: view === "week" ? range.anchor : range.anchor.slice(0, 7), ...(activity ? { activity: "1" } : {}), ...changes });
  for (const [key, value] of [...params]) if (!value) params.delete(key);
  return `?${params}`;
};
const inMonth = (day: string) => day.slice(0, 7) === range.anchor.slice(0, 7);
const v = (name: string, fallback = "") => valueFor(state, "task_create", name, fallback);
const e = (name: string) => errorFor(state, "task_create", name);
const shown = items.filter((item) => view === "week" || inMonth(item.date));
---
<CrmShell title={vi ? "Lịch" : "Calendar"} lang={lang} actor={ctx.actor} current="calendar">
  <div class="crm-head">
    <div>
      <p class="crm-eyebrow">{vi ? "Lịch" : "Calendar"}</p>
      <h1 class="crm-h1">{view === "week" ? weekTitle : monthTitle}</h1>
      <p class="crm-lede">{vi ? "Công việc, lịch hẹn, ghé thăm và bước tiếp theo của cơ hội và Lead bạn phụ trách, theo giờ Việt Nam. Lịch không gửi lời mời hay tin nhắn cho khách." : "Tasks, meetings, visits and next steps of the opportunities and leads you own, in Vietnam time. The calendar sends no invitations or messages to customers."}</p>
    </div>
    <a class="crm-button" href="#new-event">{vi ? "Tạo lịch hẹn / công việc" : "New event or task"}</a>
  </div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={vi ? { opportunity_id: "Cơ hội", kind: "Loại", title: "Tiêu đề", due_on: "Ngày", due_time: "Giờ", contact_id: "Liên hệ" } : { opportunity_id: "Opportunity", kind: "Kind", title: "Title", due_on: "Date", due_time: "Time", contact_id: "Contact" }} />
  <div class="crm-toolbar">
    <nav class="crm-views" aria-label={vi ? "Cách xem" : "View"}>
      <a href={`?view=month&month=${(view === "week" ? range.anchor : range.anchor).slice(0, 7)}${activity ? "&activity=1" : ""}`} aria-current={view === "month" ? "page" : undefined}>{vi ? "Tháng" : "Month"}</a>
      <a href={`?view=week&week=${view === "week" ? range.anchor : (inMonth(today) ? today : range.anchor)}${activity ? "&activity=1" : ""}`} aria-current={view === "week" ? "page" : undefined}>{vi ? "Tuần" : "Week"}</a>
    </nav>
    <nav class="crm-actions" aria-label={vi ? "Chuyển kỳ" : "Change period"}>
      <a class="crm-button small secondary" href={q(view === "week" ? { week: range.previous } : { month: range.previous })}>{vi ? "Trước" : "Previous"}</a>
      <a class="crm-button small secondary" href={view === "week" ? `?view=week&week=${today}${activity ? "&activity=1" : ""}` : `?view=month&month=${today.slice(0, 7)}${activity ? "&activity=1" : ""}`}>{vi ? "Hôm nay" : "Today"}</a>
      <a class="crm-button small secondary" href={q(view === "week" ? { week: range.next } : { month: range.next })}>{vi ? "Sau" : "Next"}</a>
      <a class="crm-link" href={q({ activity: activity ? "" : "1" })} aria-pressed={activity ? "true" : "false"}>{activity ? (vi ? "Ẩn hoạt động đã ghi" : "Hide recorded activity") : (vi ? "Hiện hoạt động đã ghi" : "Show recorded activity")}</a>
    </nav>
  </div>
  <p class="crm-meta" role="status">{vi ? `${shown.length} mục trong kỳ này` : `${shown.length} items in this period`} · <span>{vi ? "Đỏ: quá hạn · gạch ngang: đã xong · xanh lá: hoạt động đã ghi" : "Red: overdue · struck through: done · green: recorded activity"}</span></p>

  {view === "month" ? <div class="crm-cal-wrap" role="region" aria-label={monthTitle} tabindex="0">
    <table class="crm-cal">
      <caption class="crm-sr">{monthTitle}</caption>
      <thead><tr>{weekdays.map((day) => <th scope="col">{day}</th>)}</tr></thead>
      <tbody>{Array.from({ length: range.days.length / 7 }, (_, week) => <tr>{range.days.slice(week * 7, week * 7 + 7).map((day) => { const list = byDay.get(day) ?? []; return <td class:list={{ out: !inMonth(day), today: day === today }}>
        <a class="day crm-link" href={`?view=week&week=${day}${activity ? "&activity=1" : ""}`} aria-label={fmt(day, { weekday: "long", day: "numeric", month: "long" })}>{Number(day.slice(8))}</a>
        {list.length > 0 && <ul>{list.slice(0, 4).map((item) => <li class={tone(item)}><a href={item.href} title={text(item)}>{text(item)}</a></li>)}</ul>}
        {list.length > 4 && <a class="crm-meta" href={`?view=week&week=${day}${activity ? "&activity=1" : ""}`}>{vi ? `+${list.length - 4} mục` : `+${list.length - 4} more`}</a>}
      </td>; })}</tr>)}</tbody>
    </table>
  </div> : <div class="crm-week">{range.days.map((day) => { const list = byDay.get(day) ?? []; return <section class:list={{ today: day === today }} aria-labelledby={`d-${day}`}>
    <h2 id={`d-${day}`}>{fmt(day, { weekday: "long", day: "numeric", month: "numeric" })}</h2>
    {list.length ? <ul>{list.map((item) => <li class={tone(item)}><span class="crm-meta">{item.time ?? ""} {kindLabel(item)}</span><br /><a href={item.href}>{item.title}</a>{item.record !== item.title && <><br /><span class="crm-meta">{item.record}</span></>}</li>)}</ul> : <p class="crm-empty crm-meta">{vi ? "Trống" : "Nothing"}</p>}
  </section>; })}</div>}

  <section class="crm-agenda crm-sheet" aria-label={vi ? "Danh sách theo ngày" : "Agenda"}>
    {range.days.filter((day) => (byDay.get(day) ?? []).length && (view === "week" || inMonth(day))).map((day) => <>
      <h2 class="crm-h3">{fmt(day, { weekday: "long", day: "numeric", month: "numeric" })}{day === today ? (vi ? " · hôm nay" : " · today") : ""}</h2>
      <ul class="crm-list">{(byDay.get(day) ?? []).map((item) => <li class="crm-row"><a class="crm-row-title" href={item.href}>{item.title}</a><span class="crm-row-side"><span class:list={["crm-badge", item.overdue ? "red" : item.kind === "activity" ? "green" : "blue"]}>{item.time ? `${item.time} · ` : ""}{kindLabel(item)}</span></span>{item.record !== item.title && <span class="crm-row-meta"><span>{item.record}</span></span>}</li>)}</ul>
    </>)}
    {!shown.length && <p class="crm-empty">{vi ? "Không có mục nào trong kỳ này." : "Nothing in this period."}</p>}
  </section>

  <section class="crm-sheet" id="new-event" aria-labelledby="new-event-h" style="margin-top:18px">
    <h2 class="crm-h2" id="new-event-h">{vi ? "Tạo lịch hẹn hoặc công việc" : "New event or task"}</h2>
    {opportunities.length ? <form class="crm-form" method="post" action="#new-event-h">
      <Hidden intent="task_create" state={state} />
      <div class="crm-form-grid">
        <Field name="opportunity_id" type="select" label={vi ? "Cơ hội" : "Opportunity"} lang={lang} value={v("opportunity_id")} error={e("opportunity_id")} options={opportunities.map((item) => ({ value: item.id, label: item.title === item.account_name ? item.title : `${item.title} · ${item.account_name}` }))} />
        <Field name="kind" type="select" label={vi ? "Loại" : "Kind"} lang={lang} value={v("kind", "meeting")} error={e("kind")} options={options(lang, "task")} />
        <Field name="title" label={vi ? "Tiêu đề" : "Title"} lang={lang} value={v("title")} error={e("title")} required maxlength={300} />
        <Field name="due_on" type="date" label={vi ? "Ngày" : "Date"} lang={lang} value={v("due_on", newDate)} error={e("due_on")} help={vi ? "Bắt buộc với ghé thăm, cuộc hẹn và demo." : "Required for visits, meetings and demos."} />
        <Field name="due_time" type="time" label={vi ? "Giờ (giờ Việt Nam)" : "Time (Vietnam)"} lang={lang} value={v("due_time")} error={e("due_time")} />
      </div>
      <Field name="note" type="textarea" label={vi ? "Ghi chú nội bộ" : "Internal note"} lang={lang} value={v("note")} maxlength={1000} />
      {e("contact_id") === "do_not_contact" && <p class="crm-error">{vi ? "Khách đã yêu cầu không liên hệ; không tạo được việc liên hệ." : "The customer asked not to be contacted; outreach cannot be scheduled."}</p>}
      <div class="crm-actions"><button class="crm-button" type="submit">{vi ? "Lưu" : "Save"}</button></div>
    </form> : <p class="crm-empty">{vi ? "Bạn chưa có cơ hội đang mở để thêm lịch." : "You have no open opportunities to schedule against."}</p>}
  </section>
</CrmShell>
