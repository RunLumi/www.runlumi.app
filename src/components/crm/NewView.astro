---
// /crm/new: the create-opportunity form on its own page (the menu entry and
// links from companies and contacts). On Pipeline the same form opens in a sheet.
import CrmShell from "../../layouts/CrmShell.astro";
import ListHead from "./list/ListHead.astro";
import NewOpportunityForm from "./NewOpportunityForm.astro";
import type { NewProps } from "../../lib/crm/routes/pipeline";
import "../../styles/crm-sales.css";
import "../../styles/crm-lists.css";

type Props = NewProps;
const { ctx, state, playbooks, owners, customers } = Astro.props;
const { lang, vi } = ctx;
---
<CrmShell title={vi ? "Tạo cơ hội" : "New opportunity"} lang={lang} actor={ctx.actor} current="new">
  <div class="cl-stack">
    <ListHead vi={vi} icon="opportunity" tone="#006093" eyebrow={vi ? "Cơ hội" : "Opportunity"} title={vi ? "Tạo cơ hội" : "New opportunity"} bare
      meta={vi ? "Chọn khách có sẵn, hoặc nhập khách mới: CRM tạo công ty và người liên hệ." : "Pick an existing customer, or enter a new one: the CRM creates the company and contact."} />
    <section class="cl-panel cl-form-panel" aria-label={vi ? "Thông tin cơ hội" : "Opportunity details"}>
      <NewOpportunityForm ctx={ctx} state={state} playbooks={playbooks} owners={owners} customers={customers} action={Astro.url.pathname + Astro.url.search} cancelHref={`${ctx.base}/pipeline`} />
    </section>
  </div>
</CrmShell>
