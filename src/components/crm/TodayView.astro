---
// CRM Today (board Home). Story: docs/governance/USER-STORIES.md § CRM list
// screens (Home). Main column: today's appointments and tasks side by side
// (equal height, R-04), the person's largest open opportunities and the
// sales dashboard. Right rail: warnings with their next action, then leads,
// renewals and credits. Everything is scoped like the pipeline.
import CrmShell from "../../layouts/CrmShell.astro";
import SalesDashboard from "./SalesDashboard.astro";
import ListHeader from "../workspace/ui/ListHeader.astro";
import ButtonGroup from "../workspace/ui/ButtonGroup.astro";
import NavIcon from "../workspace/NavIcon.astro";
import { formatDate, label } from "../../lib/crm/i18n";
import { formatVnd } from "../../lib/crm/view";
import type { TodayProps } from "../../lib/crm/routes/today";
import type { TodayTask, TodayOpp } from "../../lib/crm/today";
import "../../styles/crm-sales.css";
import "../../styles/crm-lists.css";

type Props = TodayProps;
const { ctx, data, stageNames, leadStatus, dashboard, owners, playbooks, names } = Astro.props;
const { lang, vi, base } = ctx;
const stageOf = (opp: TodayOpp) => stageNames[`${opp.playbook_id.split("@")[0]}:${opp.stage_id}`] ?? opp.stage_id;
const appointmentKinds = new Set(["visit", "meeting", "demo", "pilot_review"]);
const appointments = data.dueToday.filter((task) => appointmentKinds.has(task.kind));
const todayTasks: (TodayTask & { late: boolean })[] = [...data.overdue.map((task) => ({ ...task, late: true })), ...data.dueToday.filter((task) => !appointmentKinds.has(task.kind)).map((task) => ({ ...task, late: false }))];
const warnings = [
  ...data.blocked.map((item) => ({ tone: "danger", title: item.title, detail: `${vi ? "Bàn giao bị chặn" : "Delivery blocked"} · ${item.blocked_reason}`, href: `${base}/${item.opportunity_id}#fulfillment`, action: vi ? "Mở bàn giao" : "Open delivery" })),
  ...data.help.map((task) => ({ tone: "warn", title: task.title, detail: `${vi ? "Cần hỗ trợ" : "Help requested"} · ${task.account_name}${task.help_note ? ` · ${task.help_note}` : ""}`, href: `${base}/${task.opportunity_id}#tasks`, action: vi ? "Mở cơ hội" : "Open" })),
  ...data.missingNext.map((opp) => ({ tone: "warn", title: vi ? "Không có hoạt động sắp tới" : "No upcoming activity", detail: `${opp.title} · ${stageOf(opp)}${opp.owner_id === null ? (vi ? " · chưa phân công" : " · unassigned") : ""}`, href: `${base}/${opp.id}#tasks`, action: vi ? "Tạo lịch hẹn" : "Add a task" })),
];
const total = data.overdue.length + data.dueToday.length;
const today = capital(new Date(`${data.today}T00:00:00+07:00`).toLocaleDateString(vi ? "vi-VN" : "en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "Asia/Ho_Chi_Minh" }));
function capital(text: string) { return text.charAt(0).toLocaleUpperCase(vi ? "vi" : "en") + text.slice(1); }
---
<CrmShell title={vi ? "Hôm nay" : "Today"} lang={lang} actor={ctx.actor} current="today">
  <div class="cl-stack">
    <ListHeader vi={vi} icon="today" tone="home" object="CRM" title={vi ? "Hôm nay" : "Today"} meta={`${today} · ${vi ? `${total} việc đến hạn hoặc quá hạn · CRM không tự gửi tin cho khách` : `${total} tasks due or overdue · the CRM never messages customers`}`}>
      <ButtonGroup slot="actions" label={vi ? "Tạo mới" : "Create"}><a class="ws-btn" href={`${base}/leads?new=1#new-lead`}>{vi ? "Tạo Lead" : "New lead"}</a><a class="ws-btn" href={`${base}/pipeline?new=1#new-opp`}>{vi ? "Tạo cơ hội" : "New opportunity"}</a><a class="ws-btn" href={`${base}/calendar?new=1#new-event`}>{vi ? "Tạo lịch hẹn" : "New event"}</a></ButtonGroup>
    </ListHeader>

    <div class="cl-home">
      <div class="main">
        <div class="cl-row2">
          <section class="cl-panel" aria-labelledby="h-appointments">
            <div class="cl-panel-h"><h2 id="h-appointments">{vi ? "Lịch hẹn hôm nay" : "Today's appointments"}</h2><a href={`${base}/calendar?view=week`}>{vi ? "Mở lịch" : "Open calendar"}</a></div>
            {appointments.length ? <ul class="cl-ul">{appointments.map((task) => <li class="cl-item">
              <span class="ic" aria-hidden="true"><NavIcon name="calendar" size={16} /></span>
              <div><a class="title" href={`${base}/${task.opportunity_id}#tasks`}>{task.title}</a><p>{task.due_time ?? (vi ? "Cả ngày" : "All day")} · {label(lang, "task", task.kind)} · {task.account_name}{task.kind === "meeting" || task.kind === "demo" ? (task.meeting_confirmed ? (vi ? " · đã xác nhận" : " · confirmed") : (vi ? " · chưa xác nhận" : " · not confirmed")) : ""}</p></div>
            </li>)}</ul> : <p class="cl-empty">{vi ? "Không có lịch hẹn hôm nay." : "No appointments today."}</p>}
          </section>
          <section class="cl-panel" aria-labelledby="h-tasks">
            <div class="cl-panel-h"><h2 id="h-tasks">{vi ? "Công việc hôm nay" : "Today's tasks"}<span class="cl-count">{todayTasks.length}</span></h2><a href={`${base}/tasks`}>{vi ? "Xem tất cả" : "View all"}</a></div>
            {todayTasks.length ? <ul class="cl-ul">{todayTasks.map((task) => <li class="cl-item">
              <div><a class="title" href={`${base}/tasks?task=${task.id}`}>{task.title}</a><p>{label(lang, "task", task.kind)} · {task.account_name}{task.needs_help ? (vi ? " · cần hỗ trợ" : " · help requested") : ""}</p></div>
              <span class:list={["cl-badge", task.late ? "warn" : "info"]}>{task.late ? (vi ? `Quá hạn · ${formatDate(task.due_on, lang)}` : `Overdue · ${formatDate(task.due_on, lang)}`) : (vi ? "Hôm nay" : "Today")}</span>
            </li>)}</ul> : <p class="cl-empty">{vi ? "Không có việc đến hạn hôm nay." : "Nothing due today."}</p>}
          </section>
        </div>

        <section class="cl-panel" aria-labelledby="h-largest">
          <div class="cl-panel-h"><h2 id="h-largest">{vi ? "Cơ hội có giá trị lớn nhất của tôi" : "My largest opportunities"}</h2><a href={`${base}/pipeline?view=table`}>{vi ? "Xem tất cả" : "View all"}</a></div>
          {data.largest.length ? <div class="cl-tbl-wrap" style="border-top:0"><table class="cl-tbl" style="min-width:560px">
            <thead><tr><th scope="col">{vi ? "Tên cơ hội" : "Opportunity"}</th><th scope="col">{vi ? "Giai đoạn" : "Stage"}</th><th scope="col" class="r">{vi ? "Giá trị" : "Value"}</th><th scope="col">{vi ? "Hạn bước tiếp theo" : "Next step due"}</th></tr></thead>
            <tbody>{data.largest.map((opp) => <tr><td><a href={`${base}/${opp.id}`}>{opp.title}</a></td><td>{stageOf(opp)}</td><td class="r">{formatVnd(opp.estimated_value_vnd, vi)}</td><td>{formatDate(opp.next_action_due, lang)}</td></tr>)}</tbody>
          </table></div> : <p class="cl-empty">{vi ? "Chưa có cơ hội đang mở nào có giá trị. Ghi giá trị dự kiến trên bảng cơ hội." : "No open opportunity has a value yet. Record the expected value in the opportunity table."}</p>}
        </section>

        <div class="cl-dash">
          <SalesDashboard lang={lang} vi={vi} manager={ctx.actor.manager} dashboard={dashboard} owners={owners} playbooks={playbooks} names={names} selfName={ctx.actor.name} />
        </div>
      </div>

      <aside class="side" aria-label={vi ? "Cảnh báo và việc cần theo dõi" : "Warnings and follow-ups"}>
        <section class="cl-panel" aria-labelledby="h-warn">
          <div class="cl-panel-h"><h2 id="h-warn">{vi ? "Cảnh báo" : "Warnings"}</h2><span class="cl-count">{warnings.length + (ctx.actor.manager ? Number(data.unassignedLeads > 0) + Number(data.unassigned > 0) + Number(data.inactiveOwners.length > 0) : 0) + (ctx.actor.finance && data.pendingPayments > 0 ? 1 : 0)}</span></div>
          <ul class="cl-ul">
            {ctx.actor.manager && data.unassignedLeads > 0 && <li class="cl-item"><span class="ic warn" aria-hidden="true"><NavIcon name="warn" size={16} /></span><div><span class="title">{vi ? `${data.unassignedLeads} Lead đang chờ phân công` : `${data.unassignedLeads} leads waiting for an owner`}</span></div><a class="cl-act" href={`${base}/admin#leads`}>{vi ? "Phân công" : "Assign"}</a></li>}
            {ctx.actor.manager && data.unassigned > 0 && <li class="cl-item"><span class="ic warn" aria-hidden="true"><NavIcon name="warn" size={16} /></span><div><span class="title">{vi ? `${data.unassigned} cơ hội đang chờ phân công` : `${data.unassigned} opportunities waiting for assignment`}</span></div><a class="cl-act" href={`${base}/admin#inbound`}>{vi ? "Phân công" : "Assign"}</a></li>}
            {ctx.actor.manager && data.inactiveOwners.length > 0 && <li class="cl-item"><span class="ic warn" aria-hidden="true"><NavIcon name="warn" size={16} /></span><div><span class="title">{vi ? `${data.inactiveOwners.length} cơ hội có người phụ trách không còn hoạt động` : `${data.inactiveOwners.length} opportunities belong to inactive owners`}</span><p>{vi ? "Cần giao lại." : "Reassign them."}</p></div><a class="cl-act" href={`${base}/pipeline?owner=inactive&playbook=all`}>{vi ? "Xem" : "View"}</a></li>}
            {ctx.actor.finance && data.pendingPayments > 0 && <li class="cl-item"><span class="ic warn" aria-hidden="true"><NavIcon name="warn" size={16} /></span><div><span class="title">{vi ? `${data.pendingPayments} khoản thanh toán chờ xác nhận` : `${data.pendingPayments} payments await confirmation`}</span></div><a class="cl-act" href={`${base}/reports#pending`}>{vi ? "Xác nhận" : "Confirm"}</a></li>}
            {warnings.map((item) => <li class:list={["cl-item", `rail-${item.tone}`]}><span class:list={["ic", item.tone]} aria-hidden="true"><NavIcon name="warn" size={16} /></span><div><span class="title">{item.title}</span><p>{item.detail}</p></div><a class="cl-act" href={item.href}>{item.action}</a></li>)}
          </ul>
          {!warnings.length && !(ctx.actor.manager && (data.unassignedLeads || data.unassigned || data.inactiveOwners.length)) && !(ctx.actor.finance && data.pendingPayments) && <p class="cl-empty">{vi ? "Không có cảnh báo. Mọi cơ hội đều có bước tiếp theo." : "No warnings. Every opportunity has a next step."}</p>}
        </section>

        <section class="cl-panel" aria-labelledby="today-leads">
          <div class="cl-panel-h"><h2 id="today-leads">{vi ? "Lead cần liên hệ" : "Leads to contact"}<span class="cl-count">{data.leads.length}</span></h2><a href={`${base}/leads`}>{vi ? "Xem tất cả" : "View all"}</a></div>
          {data.leads.length ? <ul class="cl-ul">{data.leads.map((lead) => <li class="cl-item"><div><a class="title" href={`${base}/leads/${lead.id}`}>{lead.name}</a><p>{lead.company} · {lead.next_action_due ? `${lead.next_action || (vi ? "Bước tiếp theo" : "Next step")} · ${formatDate(lead.next_action_due, lang)}` : (vi ? "Chưa có bước tiếp theo" : "No next step yet")}</p></div><span class="cl-badge info">{leadStatus[`${lead.process_id}:${lead.status_id}`] ?? lead.status_id}</span></li>)}</ul> : <p class="cl-empty">{vi ? "Không có Lead cần liên hệ." : "No leads to contact."}</p>}
        </section>

        {data.upcoming.length > 0 && <section class="cl-panel" aria-labelledby="h-upcoming">
          <div class="cl-panel-h"><h2 id="h-upcoming">{vi ? "Lịch 7 ngày tới" : "Next 7 days"}<span class="cl-count">{data.upcoming.length}</span></h2><a href={`${base}/calendar?view=week`}>{vi ? "Mở lịch" : "Open calendar"}</a></div>
          <ul class="cl-ul">{data.upcoming.map((task) => <li class="cl-item"><div><a class="title" href={`${base}/tasks?task=${task.id}`}>{task.title}</a><p>{formatDate(task.due_on, lang)}{task.due_time ? ` · ${task.due_time}` : ""} · {label(lang, "task", task.kind)} · {task.account_name}</p></div></li>)}</ul>
        </section>}

        {(data.renewals.length + data.renewalCandidates.length + data.credits.length > 0) && <section class="cl-panel" aria-labelledby="renewals">
          <div class="cl-panel-h"><h2 id="renewals">{vi ? "Gia hạn và credit sắp hết" : "Renewals and expiring credits"}<span class="cl-count">{data.renewals.length + data.renewalCandidates.length + data.credits.length}</span></h2></div>
          <ul class="cl-ul">
            {data.renewals.map((opp) => <li class="cl-item"><div><a class="title" href={`${base}/${opp.id}`}>{opp.title}</a><p>{stageOf(opp)} · {vi ? "Đến hạn" : "Due"} {formatDate(opp.renewal_due_on ?? null, lang)}</p></div></li>)}
            {data.renewalCandidates.map((opp) => <li class="cl-item"><div><a class="title" href={`${base}/${opp.id}#linked`}>{opp.account_name}</a><p>{vi ? "Chưa có cơ hội gia hạn · kỳ dịch vụ kết thúc" : "No renewal yet · service period ends"} {formatDate(opp.service_period_end ?? null, lang)}</p></div></li>)}
            {data.credits.map((credit) => <li class="cl-item"><div><a class="title" href={`${base}/${credit.opportunity_id}#commercial`}>{credit.account_name}</a><p>{vi ? "Credit Trust Kit · thanh toán" : "Trust Kit credit · paid"} {formatDate(credit.paid_on, lang)}</p></div><span class="cl-badge warn">{vi ? "Hết hạn" : "Expires"} {formatDate(credit.expires_on, lang)}</span></li>)}
          </ul>
        </section>}
      </aside>
    </div>
  </div>
</CrmShell>
