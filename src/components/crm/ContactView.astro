---
import CrmShell from "../../layouts/CrmShell.astro";
import Crumbs from "./Crumbs.astro";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { formatDate, label, options } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { ContactProps } from "../../lib/crm/routes/account";
import "../../styles/crm-sales.css";

type Props = ContactProps;
const { ctx, state, contact, canEdit, opportunities, stageNames, names } = Astro.props;
const { lang, vi, base } = ctx;
const v = (name: string, stored: string | null) => valueFor(state, "contact", name, stored);
const e = (name: string) => errorFor(state, "contact", name);
const person = (id: string | null) => id ? (names[id]?.name ?? (id === ctx.actor.id ? ctx.actor.name : (vi ? "Tài khoản không hoạt động" : "Inactive account"))) : (vi ? "Chưa có người quản lý" : "Nobody yet");
const blocked = !!contact.do_not_contact || !!contact.account_dnc;
---
<CrmShell title={contact.name} lang={lang} actor={ctx.actor} current="contacts">
  <Crumbs label={vi ? "Đường dẫn" : "Breadcrumb"} items={[{ label: "CRM", href: base }, { label: vi ? "Liên hệ" : "Contacts", href: `${base}/contacts` }, { label: contact.account_name, href: `${base}/accounts/${contact.account_id}` }, { label: contact.name }]} />
  <div class="crm-head"><div>
    <p class="crm-eyebrow">{vi ? "Liên hệ" : "Contact"} · {label(lang, "role", contact.role)}</p>
    <h1 class="crm-h1">{contact.name}</h1>
    <p class="crm-lede"><a class="crm-link" href={`${base}/accounts/${contact.account_id}`}>{contact.account_name}</a></p>
  </div>{blocked ? <span class="crm-badge red">{vi ? "Không liên hệ" : "Do not contact"}</span> : <span class="crm-badge">{label(lang, "consent", contact.consent_status)}</span>}</div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} fieldLabels={vi ? { name: "Tên", phone: "Điện thoại", email: "Email", consent_evidence: "Bằng chứng đồng ý", dnc_reason: "Lý do" } : { name: "Name", phone: "Phone", email: "Email", consent_evidence: "Consent evidence", dnc_reason: "Reason" }} />
  {blocked && <div class="crm-notice bad" role="status">{vi ? "Yêu cầu không liên hệ áp dụng cho mọi kênh và mọi quy trình bán. Chỉ admin gỡ, kèm bằng chứng." : "Do-not-contact applies across every channel and playbook. Only an admin can lift it, with evidence."}{contact.dnc_reason ? ` ${contact.dnc_reason} · ${formatDate(contact.dnc_recorded_at, lang)}` : ""}</div>}
  <div class="crm-row-panels">
    <section class="crm-sheet" aria-labelledby="c-details-h">
      <h2 class="crm-h2" id="c-details-h">{vi ? "Thông tin liên hệ" : "Contact details"}</h2>
      {canEdit ? <form class="crm-form" method="post">
        <Hidden intent="contact" state={state} version={contact.version} />
        <div class="crm-form-grid">
          <Field name="name" label={vi ? "Tên" : "Name"} lang={lang} value={v("name", contact.name)} error={e("name")} required maxlength={160} />
          <Field name="role" type="select" label={vi ? "Vai trò" : "Role"} lang={lang} value={v("role", contact.role)} options={options(lang, "role")} />
          <Field name="phone" type="tel" label={vi ? "Điện thoại" : "Phone"} lang={lang} value={v("phone", contact.phone)} error={e("phone")} maxlength={40} />
          <Field name="zalo" label="Zalo" lang={lang} value={v("zalo", contact.zalo)} maxlength={80} />
          <Field name="email" type="email" label="Email" lang={lang} value={v("email", contact.email)} error={e("email")} maxlength={254} />
          <Field name="preferred_channel" type="select" label={vi ? "Kênh ưu tiên" : "Preferred channel"} lang={lang} value={v("preferred_channel", contact.preferred_channel)} options={options(lang, "contactChannel")} />
          <Field name="consent_status" type="select" label={vi ? "Đồng ý liên hệ" : "Contact consent"} lang={lang} value={v("consent_status", contact.consent_status)} options={options(lang, "consent")} />
          <Field name="consent_evidence" label={vi ? "Bằng chứng đồng ý" : "Consent evidence"} lang={lang} value={v("consent_evidence", contact.consent_evidence)} error={e("consent_evidence")} maxlength={500} />
        </div>
        <Field name="contact_basis" label={vi ? "Căn cứ liên hệ" : "Basis for contact"} lang={lang} value={v("contact_basis", contact.contact_basis)} maxlength={500} />
        <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Lưu" : "Save"}</button></div>
      </form> : <dl class="crm-facts">
        <div><dt>{vi ? "Điện thoại" : "Phone"}</dt><dd>{contact.phone || "—"}</dd></div>
        <div><dt>Zalo</dt><dd>{contact.zalo || "—"}</dd></div>
        <div><dt>Email</dt><dd>{contact.email || "—"}</dd></div>
        <div><dt>{vi ? "Căn cứ liên hệ" : "Basis for contact"}</dt><dd>{contact.contact_basis || "—"}</dd></div>
      </dl>}
      <p class="crm-meta">{vi ? "Người quản lý" : "Managed by"}: {person(contact.owner_id)}</p>
    </section>
    <section class="crm-sheet" aria-labelledby="c-opps-h">
      <h2 class="crm-h2" id="c-opps-h">{vi ? "Cơ hội với người này" : "Opportunities with this person"}<span class="crm-count">{opportunities.length}</span></h2>
      {opportunities.length ? <ul class="crm-list">{opportunities.map((opp) => <li class="crm-row"><a class="crm-row-title" href={`${base}/${opp.id}`}>{opp.title}</a><span class="crm-row-side"><span class="crm-badge blue">{stageNames[`${opp.playbook_id}:${opp.stage_id}`] ?? opp.stage_id}</span><span class="crm-badge">{label(lang, "outcome", opp.outcome)}</span></span><span class="crm-row-meta"><span>{vi ? "Phụ trách" : "Owner"}: {opp.owner_id ? person(opp.owner_id) : (vi ? "Chưa phân công" : "Unassigned")}</span></span></li>)}</ul>
        : <p class="crm-empty">{vi ? "Chưa có cơ hội nào bạn được xem." : "No opportunities you can view."}</p>}
      {!blocked && <p><a class="crm-button small secondary" href={`${base}/new?contact=${contact.id}`}>{vi ? "Tạo cơ hội" : "New opportunity"}</a></p>}
      {(!contact.do_not_contact || ctx.actor.configure) && <details class="crm-disclosure" open={state.intent === "dnc"}>
        <summary>{contact.do_not_contact ? (vi ? "Gỡ không liên hệ (admin)" : "Lift do-not-contact (admin)") : (vi ? "Đặt không liên hệ" : "Set do-not-contact")}</summary>
        <form class="crm-form" method="post">
          <Hidden intent="dnc" state={state} /><input type="hidden" name="do_not_contact" value={contact.do_not_contact ? "0" : "1"} />
          <Field name="dnc_reason" label={contact.do_not_contact ? (vi ? "Bằng chứng để gỡ" : "Evidence for lifting") : (vi ? "Lý do / nguồn yêu cầu" : "Reason / source of the request")} lang={lang} value="" error={errorFor(state, "dnc", "dnc_reason")} required maxlength={500} />
          <div class="crm-actions"><button class:list={["crm-button small", contact.do_not_contact ? "secondary" : "danger"]} type="submit">{contact.do_not_contact ? (vi ? "Gỡ" : "Lift") : (vi ? "Đặt không liên hệ" : "Set do-not-contact")}</button></div>
        </form>
      </details>}
    </section>
  </div>
</CrmShell>
