---
// The sales process guide for everyone with CRM access. The content is the
// Markdown source in docs/Lumi_Quy_Trinh_Ban_Hang.md, rendered at build time:
// edit that file and deploy to update this page. Nothing here copies its text.
import CrmShell from "../../layouts/CrmShell.astro";
import * as guide from "../../../docs/Lumi_Quy_Trinh_Ban_Hang.md";
import type { CrmActor } from "../../lib/crm/access";
import type { Lang } from "../../lib/crm/i18n";

interface Props { lang: Lang; actor: CrmActor }
const { lang, actor } = Astro.props;
const vi = lang === "vi";
const headings = guide.getHeadings();
const title = headings.find((heading) => heading.depth === 1)?.text ?? (vi ? "Quy trình bán hàng" : "Sales process");
const sections = headings.filter((heading) => heading.depth === 2);
const { Content } = guide;
---
<CrmShell title={vi ? "Quy trình bán hàng" : "Sales process"} lang={lang} actor={actor} current="process">
  {!vi && <p class="crm-notice" lang="en">This guide is written in Vietnamese, the language the sales team works in.</p>}
  <div class="guide">
    <nav class="guide-toc crm-sheet" aria-label={vi ? "Mục lục" : "Contents"}>
      <p class="crm-eyebrow">{vi ? "Mục lục" : "Contents"}</p>
      <ol>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </nav>
    <article class="crm-sheet guide-body" lang="vi" aria-label={title}>
      <Content />
    </article>
  </div>
  {actor.configure && <p class="crm-help">{vi ? "Nguồn: docs/Lumi_Quy_Trinh_Ban_Hang.md trong repository. Sửa file Markdown này rồi deploy để cập nhật trang." : "Source: docs/Lumi_Quy_Trinh_Ban_Hang.md in the repository. Edit that Markdown file and deploy to update this page."}</p>}
</CrmShell>
