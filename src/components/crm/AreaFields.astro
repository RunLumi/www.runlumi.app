---
// Province/city and ward pickers on the official list after the 2025 merger
// (two tiers, no district). The ward list follows the chosen province: it is
// rendered for the current province, and a small script reloads it when the
// province changes (without script, choose the province and apply first).
import { provinceByName, provinces } from "../../lib/crm/area";

interface Props {
  vi: boolean; id: string; city?: string; ward?: string; cityName?: string; wardName?: string;
  /** Filters show "All"; forms show "Not recorded". */
  filter?: boolean; cityError?: string; wardError?: string; help?: boolean;
}
const { vi, id, city = "", ward = "", cityName = "city", wardName = "ward", filter = false, cityError, wardError, help = false } = Astro.props;
const province = provinceByName(city);
const wards = (province?.wards ?? []).map((item) => item.fullName).sort((a, b) => a.localeCompare(b, "vi"));
const none = filter ? (vi ? "Tất cả" : "All") : (vi ? "Chưa ghi" : "Not recorded");
const pickFirst = vi ? "Chọn tỉnh/thành trước" : "Choose the province first";
const sorted = [...provinces].sort((a, b) => a.name.localeCompare(b.name, "vi"));
const errorText = (code?: string) => code === "required" ? (vi ? "Chọn tỉnh/thành trước." : "Choose the province first.") : code ? (vi ? "Không có trong danh mục sau sáp nhập. Chọn từ danh sách." : "Not on the post-merger list. Pick from the list.") : "";
---
<div class="crm-field">
  <label class="crm-label" for={`${id}-city`}>{vi ? "Tỉnh / thành phố" : "Province / city"}</label>
  <select class="crm-select" id={`${id}-city`} name={cityName} data-area-city={`${id}-ward`} aria-invalid={cityError ? "true" : undefined}>
    <option value="">{none}</option>
    {sorted.map((item) => <option value={item.fullName} data-code={item.code} selected={item.fullName === city}>{item.name}</option>)}
  </select>
  {cityError && <p class="crm-error">{errorText(cityError)}</p>}
</div>
<div class="crm-field">
  <label class="crm-label" for={`${id}-ward`}>{vi ? "Phường / xã / đặc khu" : "Ward / commune"}</label>
  <select class="crm-select" id={`${id}-ward`} name={wardName} data-none={none} data-pick-first={pickFirst} aria-invalid={wardError ? "true" : undefined}>
    <option value="">{province ? none : pickFirst}</option>
    {wards.map((name) => <option selected={name === ward}>{name}</option>)}
  </select>
  {wardError && <p class="crm-error">{errorText(wardError)}</p>}
  {help && <p class="crm-help">{vi ? "Theo địa giới sau sáp nhập (1/7/2025). Để trống: tự đọc từ địa chỉ nếu có tên phường và tỉnh mới." : "Post-merger units (1 July 2025). Left blank, they are read from the address when it names a current ward and province."}</p>}
</div>
<script>
  document.addEventListener("change", async (event) => {
    const city = event.target;
    if (!(city instanceof HTMLSelectElement) || !city.dataset.areaCity) return;
    const ward = document.getElementById(city.dataset.areaCity);
    if (!(ward instanceof HTMLSelectElement)) return;
    const code = city.selectedOptions[0]?.dataset.code;
    const reset = (text: string) => { ward.replaceChildren(new Option(text, "")); };
    if (!code) { reset(ward.dataset.pickFirst ?? ""); return; }
    reset("…");
    try {
      const names: string[] = await (await fetch(`/areas/${code}.json`)).json();
      reset(ward.dataset.none ?? "");
      for (const name of names) ward.add(new Option(name, name));
    } catch {
      reset(ward.dataset.none ?? "");
    }
  });
</script>
