---
import CrmShell from "../../layouts/CrmShell.astro";
import Crumbs from "./Crumbs.astro";
import "../../styles/crm-sales.css";
import Field from "./Field.astro";
import FormNotices from "./FormNotices.astro";
import Hidden from "./Hidden.astro";
import { formatDateTime, label } from "../../lib/crm/i18n";
import { errorFor, valueFor } from "../../lib/crm/page";
import type { AdminProps } from "../../lib/crm/routes/admin";
import type { IntakePayload } from "../../lib/crm/intake";
import { costCategories } from "../../lib/crm/tasks";
import { statusLabel } from "../../lib/crm/leads";

type Props = AdminProps;
const { ctx, state, leads, leadProcesses, inbound, referrals, referrerNames, owners, cohorts, playbooks } = Astro.props;
const { lang, vi, base } = ctx;
const v = (intent: string, name: string, fallback = "") => valueFor(state, intent, name, fallback);
const e = (intent: string, name: string) => errorFor(state, intent, name);
const payload = (raw: string) => { try { return JSON.parse(raw) as IntakePayload; } catch { return null; } };
---
<CrmShell title={vi ? "Vận hành CRM" : "CRM operations"} lang={lang} actor={ctx.actor} current="admin">
  <Crumbs label={vi ? "Đường dẫn" : "Breadcrumb"} items={[{ label: "CRM", href: base }, { label: vi ? "Phân công và cohort" : "Assignment and cohorts" }]} />
  <div class="crm-head"><div>
    <p class="crm-eyebrow">{vi ? "Vận hành CRM" : "CRM operations"}</p>
    <h1 class="crm-h1">{vi ? "Phân công khách mới và theo dõi cohort." : "Assign new enquiries and run cohorts."}</h1>
    <p class="crm-lede">{vi ? "Người dùng và vai trò được quản lý tập trung ở Workspace. Quyền CRM không cấp quyền tuyển dụng." : "Users and roles are managed centrally in the Workspace. CRM access grants nothing in hiring."}</p>
  </div><div class="crm-actions">{ctx.actor.configure && <><a class="crm-button secondary" href={`${base}/admin/playbooks`}>{vi ? "Playbook" : "Playbooks"}</a><a class="crm-button secondary" href={`${base}/admin/offers`}>{vi ? "Gói và giá" : "Offers and prices"}</a><a class="crm-button secondary" href={vi ? "/vi/workspace/users" : "/workspace/users"}>{vi ? "Người dùng và vai trò" : "Users and roles"}</a></>}</div></div>
  <FormNotices state={state} lang={lang} saved={Astro.url.searchParams.get("saved")} />

  <section class="crm-sheet" id="leads" aria-labelledby="leads-h">
    <h2 class="crm-h2" id="leads-h">{vi ? "Lead chờ phân công" : "Leads waiting for an owner"}<span class="crm-count">{leads.length}</span></h2>
    <p class="crm-help">{vi ? "Yêu cầu từ local.runlumi.app, khách được giới thiệu và Lead tạo để trong hàng chờ. Người được giao trở thành người bán khi Lead được chuyển đổi; người giới thiệu giữ ghi công giới thiệu." : "Enquiries from local.runlumi.app, referrals and leads left in the queue. The assignee becomes the seller once the lead converts; a referrer keeps referral credit."}</p>
    {leads.length ? <div class="crm-grid-table-wrap"><table class="crm-grid-table">
      <thead><tr><th class="frozen frozen-1" scope="col">#</th><th class="frozen frozen-2" scope="col">{vi ? "Lead" : "Lead"}</th><th scope="col">{vi ? "Công ty" : "Company"}</th><th scope="col">{vi ? "Nguồn" : "Source"}</th><th scope="col">{vi ? "Trạng thái" : "Status"}</th><th scope="col">{vi ? "Giới thiệu bởi" : "Referred by"}</th><th scope="col">{vi ? "Nhận lúc" : "Received"}</th><th scope="col">{vi ? "Giao cho" : "Assign to"}</th></tr></thead>
      <tbody>{leads.map((row, index) => <tr>
        <td class="frozen frozen-1 rowno">{index + 1}</td>
        <td class="frozen frozen-2"><a href={`${base}/leads/${row.id}`}>{row.name}</a>{row.suppressed ? <span class="crm-badge red">{vi ? "Số từng yêu cầu không liên hệ" : "Number previously opted out"}</span> : null}</td>
        <td class="wrap">{row.company}</td><td>{label(lang, "channel", row.source_channel)}</td><td>{statusLabel(leadProcesses.get(row.process_id), row.status_id, vi)}</td>
        <td>{row.referrer_id ? referrerNames[row.referrer_id]?.name ?? "—" : "—"}</td><td>{formatDateTime(row.created_at, lang)}</td>
        <td><form class="crm-cell-form" method="post" action="#leads"><Hidden intent="lead_assign" state={state} version={row.version} /><input type="hidden" name="lead_id" value={row.id} />
          <label class="crm-sr" for={`lq-owner-${row.id}`}>{vi ? `Giao ${row.name} cho` : `Assign ${row.name} to`}</label>
          <select class="crm-select" id={`lq-owner-${row.id}`} name="owner_id"><option value="">{vi ? "Chọn người" : "Choose"}</option>{owners.filter((owner) => owner.id !== ctx.actor.id || ctx.actor.configure).map((owner) => <option value={owner.id}>{owner.label}</option>)}</select>
          <button class="crm-button small" type="submit">{vi ? "Giao" : "Assign"}</button></form>
          {state.intent === "lead_assign" && state.values.lead_id === row.id && state.errors.owner_id && <p class="crm-error">{vi ? "Chọn người bán hợp lệ (không tự giao cho mình)." : "Choose a valid seller (not yourself)."}</p>}</td>
      </tr>)}</tbody>
    </table></div> : <p class="crm-empty">{vi ? "Không có Lead đang chờ." : "No leads waiting."}</p>}
  </section>

  {inbound.length > 0 && <section class="crm-sheet" id="inbound" aria-labelledby="inbound-h">
    <h2 class="crm-h2" id="inbound-h">{vi ? "Yêu cầu cũ từ website chờ phân công" : "Earlier website enquiries waiting for assignment"}<span class="crm-count">{inbound.length}</span></h2>
    <p class="crm-help">{vi ? "Chỉ yêu cầu gửi tới Lumi từ local.runlumi.app. Yêu cầu chưa phải thanh toán, tài khoản hay khách đã đủ điều kiện." : "Only enquiries addressed to Lumi from local.runlumi.app. An enquiry is not a payment, an account or a qualified lead."}</p>
    {inbound.length ? <ul class="crm-list">{inbound.map((row) => { const data = payload(row.payload); return <li class="crm-row">
      <a class="crm-row-title" href={`${base}/${row.opportunity_id}`}>{data?.business ?? row.id}</a>
      <span class="crm-row-side">{row.suppressed ? <span class="crm-badge red">{vi ? "Số này từng yêu cầu không liên hệ" : "This number previously opted out"}</span> : null}<span class="crm-badge">{data?.locale?.toUpperCase()}</span></span>
      <span class="crm-row-meta"><span>{data?.name}</span><span>{data?.context ? `${data.context.source} · ${data.context.cta_intent} · ${data.context.offer_interest}` : (vi ? "Không có ngữ cảnh trang" : "No page context")}</span><span>{formatDateTime(row.received_at, lang)}</span>{data?.note && <span>{data.note}</span>}</span>
      <div class="crm-grid cols">
        <form class="crm-form" method="post" action="#inbound"><Hidden intent="inbound_assign" state={state} /><input type="hidden" name="inbound_id" value={row.id} />
          <Field name="owner_id" id={`ib-owner-${row.id}`} type="select" label={vi ? "Giao cho" : "Assign to"} lang={lang} value="" options={[{ value: "", label: vi ? "Chọn người" : "Choose" }, ...owners.map((owner) => ({ value: owner.id, label: owner.label }))]} error={state.intent === "inbound_assign" && state.values.inbound_id === row.id ? state.errors.owner_id : undefined} />
          <button class="crm-button small" type="submit">{vi ? "Giao" : "Assign"}</button></form>
        <form class="crm-form" method="post" action="#inbound"><Hidden intent="inbound_dismiss" state={state} /><input type="hidden" name="inbound_id" value={row.id} />
          <Field name="dismiss_reason" id={`ib-dis-${row.id}`} label={vi ? "Lý do bỏ qua (spam, nhầm…)" : "Reason to dismiss (spam, misdirected…)"} lang={lang} value="" maxlength={500} error={state.intent === "inbound_dismiss" && state.values.inbound_id === row.id ? state.errors.dismiss_reason : undefined} />
          <button class="crm-button small secondary" type="submit">{vi ? "Bỏ qua" : "Dismiss"}</button></form>
      </div>
    </li>; })}</ul> : null}
  </section>}

  {referrals.length > 0 && <section class="crm-sheet" id="referrals" aria-labelledby="ref-h">
    <h2 class="crm-h2" id="ref-h">{vi ? "Khách được giới thiệu trước khi có Lead, chờ phân công" : "Referrals made before leads, waiting for an owner"}<span class="crm-count">{referrals.length}</span></h2>
    <p class="crm-help">{vi ? "Cộng tác viên hoặc nhân viên giới thiệu; người giới thiệu được ghi công, người được giao là người bán." : "Referred by partners or staff; the referrer keeps referral credit and the assignee becomes the seller."}</p>
    {referrals.length ? <ul class="crm-list">{referrals.map((row) => <li class="crm-row">
      <a class="crm-row-title" href={`${base}/${row.id}`}>{row.title}</a>
      <span class="crm-row-meta"><span>{vi ? "Giới thiệu bởi" : "Referred by"} {row.referrer_id ? referrerNames[row.referrer_id]?.name ?? "—" : "—"}</span><span>{new Date(row.created_at).toLocaleDateString(vi ? "vi-VN" : "en-GB", { timeZone: "Asia/Ho_Chi_Minh" })}</span><span>{row.next_action}</span></span>
      <form class="crm-actions" method="post" action="#referrals"><Hidden intent="referral_assign" state={state} version={row.version} /><input type="hidden" name="opportunity_id" value={row.id} />
        <label class="crm-label" for={`ref-owner-${row.id}`}>{vi ? "Giao cho" : "Assign to"}</label>
        <select class="crm-select" style="width:auto" id={`ref-owner-${row.id}`} name="owner_id"><option value="">{vi ? "Chọn người" : "Choose"}</option>{owners.filter((owner) => owner.id !== ctx.actor.id || ctx.actor.configure).map((owner) => <option value={owner.id}>{owner.label}</option>)}</select>
        <button class="crm-button small" type="submit">{vi ? "Giao" : "Assign"}</button>
      </form>
    </li>)}</ul> : null}
  </section>}

  <section class="crm-sheet" id="cohorts" aria-labelledby="cohorts-h">
    <h2 class="crm-h2" id="cohorts-h">Cohort</h2>
    {cohorts.length > 0 && <ul class="crm-list">{cohorts.map((cohort) => <li class="crm-row">
      <a class="crm-row-title" href={`${base}/reports?cohort_report=${cohort.cohort_key}#cohort`}>{cohort.name}</a>
      <span class="crm-row-side"><span class:list={["crm-badge", cohort.costing_complete ? "green" : "amber"]}>{cohort.costing_complete ? (vi ? "Đã đủ chi phí" : "Costing complete") : (vi ? "Chưa đủ chi phí" : "Costing incomplete")}</span></span>
      <span class="crm-row-meta"><span>{cohort.cohort_key}</span><span>{cohort.starts_on} → {cohort.ends_on ?? "…"}</span><span>{vi ? "mục tiêu" : "target"} {cohort.target_size ?? "—"}</span></span>
      <form class="crm-form" method="post" action="#cohorts"><Hidden intent="costing" state={state} /><input type="hidden" name="cohort_key" value={cohort.cohort_key} /><input type="hidden" name="costing_complete" value={cohort.costing_complete ? "0" : "1"} />
        {!cohort.costing_complete && <Field name="costing_note" id={`cn-${cohort.cohort_key}`} label={vi ? "Giả định chi phí (giá giờ công, cách phân bổ chi phí chung)" : "Costing assumptions (hourly rate, shared-cost allocation)"} lang={lang} value="" maxlength={1000} error={state.intent === "costing" && state.values.cohort_key === cohort.cohort_key ? state.errors.costing_note : undefined} />}
        <div class="crm-actions"><button class="crm-button small secondary" type="submit">{cohort.costing_complete ? (vi ? "Mở lại chi phí" : "Reopen costing") : (vi ? "Đánh dấu đã đủ chi phí" : "Mark costing complete")}</button></div>
      </form>
    </li>)}</ul>}
    <details class="crm-disclosure" open={state.intent === "cohort"}><summary>{vi ? "Tạo cohort" : "Create a cohort"}</summary>
      <form class="crm-form" method="post" action="#cohorts"><Hidden intent="cohort" state={state} />
        <div class="crm-form-grid">
          <Field name="cohort_key" label={vi ? "Mã (vd. garage-bt-q4-1)" : "Key (e.g. garage-bt-q4-1)"} lang={lang} value={v("cohort", "cohort_key")} error={e("cohort", "cohort_key")} required maxlength={60} />
          <Field name="name" id="co-name" label={vi ? "Tên" : "Name"} lang={lang} value={v("cohort", "name")} error={e("cohort", "name")} required maxlength={120} />
          <Field name="playbook_key" id="co-pb" type="select" label="Playbook" lang={lang} value={v("cohort", "playbook_key", "local-preview")} options={playbooks.filter((item) => item.kind !== "legacy").map((item) => ({ value: item.playbook_key, label: vi ? item.name_vi : item.name_en }))} />
          <Field name="starts_on" type="date" label={vi ? "Bắt đầu" : "Starts"} lang={lang} value={v("cohort", "starts_on")} error={e("cohort", "starts_on")} required />
          <Field name="ends_on" type="date" label={vi ? "Kết thúc quan sát" : "Observation ends"} lang={lang} value={v("cohort", "ends_on")} error={e("cohort", "ends_on")} />
          <Field name="target_size" label={vi ? "Cỡ mẫu (theo STRATEGY: 30)" : "Sample size (STRATEGY: 30)"} lang={lang} value={v("cohort", "target_size", "30")} error={e("cohort", "target_size")} inputmode="numeric" />
        </div>
        <div class="crm-actions"><button class="crm-button" type="submit">{vi ? "Tạo" : "Create"}</button></div>
      </form>
    </details>
    {cohorts.length > 0 && <details class="crm-disclosure" open={state.intent === "cohort_cost"}><summary>{vi ? "Ghi chi phí chung của cohort (quảng cáo, công cụ…)" : "Log a cohort-wide cost (ads, tools…)"}</summary>
      <form class="crm-form" method="post" action="#cohorts"><Hidden intent="cohort_cost" state={state} />
        <div class="crm-form-grid">
          <Field name="cohort_key" id="cc-key" type="select" label="Cohort" lang={lang} value={v("cohort_cost", "cohort_key")} options={cohorts.map((cohort) => ({ value: cohort.cohort_key, label: cohort.name }))} />
          <Field name="category" id="cc-cat" type="select" label={vi ? "Loại" : "Category"} lang={lang} value={v("cohort_cost", "category", "ads")} options={costCategories.map((value) => ({ value, label: label(lang, "cost", value) }))} />
          <Field name="amount_vnd" id="cc-amt" label={vi ? "Chi phí (VND)" : "Cost (VND)"} lang={lang} value={v("cohort_cost", "amount_vnd")} error={e("cohort_cost", "amount_vnd")} inputmode="numeric" />
          <Field name="minutes" id="cc-min" label={vi ? "Phút" : "Minutes"} lang={lang} value={v("cohort_cost", "minutes")} error={e("cohort_cost", "minutes")} inputmode="numeric" />
          <Field name="basis" id="cc-basis" type="select" label={vi ? "Cơ sở" : "Basis"} lang={lang} value={v("cohort_cost", "basis", "actual")} options={[{ value: "actual", label: vi ? "Thực tế" : "Actual" }, { value: "estimate", label: vi ? "Dự toán" : "Estimate" }]} />
          <Field name="note" id="cc-note" label={vi ? "Ghi chú" : "Note"} lang={lang} value={v("cohort_cost", "note")} maxlength={500} />
        </div>
        <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Ghi" : "Log"}</button></div>
      </form>
    </details>}
  </section>
</CrmShell>
