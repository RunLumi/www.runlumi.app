---
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import PageHeader from "../workspace/ui/PageHeader.astro";
import "../../styles/modules.css";
import { deskDate, deskPath, statusName, statusTone } from "../../lib/hiring/desk";
import type { jobPage } from "../../lib/hiring/pages";

type Props = NonNullable<Awaited<ReturnType<typeof jobPage>>>;
const { lang, vi, user, job, questions, total, open, errors } = Astro.props;
const kinds: Record<string, [string, string]> = { long: ["Long answer", "Trả lời dài"], short: ["Short answer", "Trả lời ngắn"], file: ["File upload", "Tải tệp"] };
const employment: Record<string, [string, string]> = { "Full-time": ["Full-time", "Toàn thời gian"], "Part-time": ["Part-time", "Bán thời gian"], Contract: ["Contract", "Hợp đồng"], Internship: ["Internship", "Thực tập"] };
const workplace: Record<string, [string, string]> = { Remote: ["Remote", "Từ xa"], Hybrid: ["Hybrid", "Kết hợp"], "On-site": ["On-site", "Tại văn phòng"] };
const transitions = job.status === "published" ? [["closed", vi ? "Đóng vị trí" : "Close role", "secondary"]] : job.status === "closed" ? [["draft", vi ? "Về nháp" : "Return to draft", "secondary"], ["published", vi ? "Mở lại" : "Reopen", ""]] : [["published", vi ? "Đăng tuyển" : "Publish", ""]];
---
<WorkspaceShell title={job.title} lang={lang} user={user} module="hiring" current="jobs">
  <div class="md-scope">
  <PageHeader vi={vi} title={job.title} crumbs={[{ label: vi ? "Tuyển dụng" : "Hiring", href: deskPath(lang, "/admin/jobs") }, { label: vi ? "Vị trí" : "Roles", href: deskPath(lang, "/admin/jobs") }, { label: job.title }]}>
    <p class="crm-lede" slot="lede"><span class:list={["crm-badge", statusTone(job.status)]}>{statusName(job.status, lang)}</span> · {vi ? "Cập nhật" : "Updated"} {deskDate(job.updated_at, lang)} · <a class="crm-link" href={`/jobs/${job.slug}`}>{vi ? "Trang công khai" : "Public page"}</a> · <a class="crm-link" href={deskPath(lang, `/admin/jobs/applications?job=${job.id}`)}>{total} {vi ? "hồ sơ" : "applications"}{open ? ` (${open} ${vi ? "cần xem" : "to review"})` : ""}</a></p>
    <div slot="actions" class="crm-actions">{transitions.map(([status, label, tone]) => <form method="post" action={`/api/admin/jobs/${job.id}/state`}><input type="hidden" name="lang" value={lang} /><input type="hidden" name="status" value={status} /><button class:list={["crm-button", tone]} type="submit">{label}</button></form>)}</div>
  </PageHeader>
  {errors.slug && <div class="crm-notice bad" role="alert">{vi ? "Đường dẫn (slug) đã được dùng. Hãy chọn đường dẫn khác." : "That slug is already in use. Choose another."}</div>}
  <div class="crm-grid two">
    <section class="crm-sheet" aria-labelledby="role-h">
      <h2 class="crm-h2" id="role-h">{vi ? "Nội dung vị trí" : "Role"}</h2>
      <form class="crm-form" method="post" action={`/api/admin/jobs/${job.id}/update`}>
        <input type="hidden" name="lang" value={lang} />
        <div class="crm-form-grid">
          <div class="crm-field"><label for="title">{vi ? "Tên vị trí" : "Title"} *</label><input class="crm-input" id="title" name="title" value={job.title} required maxlength="160" /></div>
          <div class="crm-field"><label for="slug">{vi ? "Đường dẫn (slug)" : "Slug"} *</label><input class="crm-input" id="slug" name="slug" value={job.slug} required maxlength="80" /></div>
          <div class="crm-field"><label for="team">{vi ? "Nhóm" : "Team"}</label><input class="crm-input" id="team" name="team" value={job.team} maxlength="120" /></div>
          <div class="crm-field"><label for="location">{vi ? "Địa điểm" : "Location"}</label><input class="crm-input" id="location" name="location" value={job.location} maxlength="160" /></div>
          <div class="crm-field"><label for="employment_type">{vi ? "Hình thức" : "Employment"}</label><select class="crm-select" id="employment_type" name="employment_type">{Object.entries(employment).map(([value, names]) => <option value={value} selected={job.employment_type === value}>{names[vi ? 1 : 0]}</option>)}</select></div>
          <div class="crm-field"><label for="workplace_type">{vi ? "Nơi làm việc" : "Workplace"}</label><select class="crm-select" id="workplace_type" name="workplace_type">{Object.entries(workplace).map(([value, names]) => <option value={value} selected={job.workplace_type === value}>{names[vi ? 1 : 0]}</option>)}</select></div>
          <div class="crm-field wide"><label for="summary">{vi ? "Tóm tắt" : "Summary"} *</label><textarea class="crm-textarea" id="summary" name="summary" required maxlength="500">{job.summary}</textarea></div>
          <div class="crm-field wide"><label for="description">{vi ? "Công việc" : "The work"}</label><textarea class="crm-textarea" id="description" name="description" maxlength="12000">{job.description}</textarea></div>
          <div class="crm-field wide"><label for="responsibilities">{vi ? "Sẽ phụ trách (mỗi dòng một ý)" : "What they will own (one per line)"}</label><textarea class="crm-textarea" id="responsibilities" name="responsibilities" maxlength="12000">{job.responsibilities}</textarea></div>
          <div class="crm-field wide"><label for="requirements">{vi ? "Điều quan trọng (mỗi dòng một ý)" : "What matters here (one per line)"}</label><textarea class="crm-textarea" id="requirements" name="requirements" maxlength="12000">{job.requirements}</textarea></div>
          <div class="crm-field wide"><label for="application_note">{vi ? "Trước khi ứng tuyển" : "Before you apply"}</label><textarea class="crm-textarea" id="application_note" name="application_note" maxlength="6000">{job.application_note}</textarea></div>
          <div class="crm-field"><label for="closes_at">{vi ? "Hạn nhận hồ sơ" : "Close applications at"}</label><input class="crm-input" id="closes_at" name="closes_at" type="datetime-local" value={job.closes_at ? job.closes_at.slice(0, 16) : ""} /></div>
          <div class="crm-field"><label for="sort_order">{vi ? "Thứ tự hiển thị" : "Sort order"}</label><input class="crm-input" id="sort_order" name="sort_order" type="number" value={job.sort_order} /></div>
        </div>
        <p class="crm-help">{vi ? "Nội dung trang công khai hiện viết bằng một ngôn ngữ; hãy viết theo ngôn ngữ ứng viên mục tiêu." : "The public page is written in one language; write for the candidates you want to reach."}</p>
        <div class="crm-actions"><button class="crm-button" type="submit">{vi ? "Lưu vị trí" : "Save role"}</button></div>
      </form>
    </section>
    <aside class="crm-grid">
      <section class="crm-sheet" aria-labelledby="test-h">
        <h2 class="crm-h2" id="test-h">{vi ? "Bài kiểm tra ứng tuyển" : "Application test"}<span class="crm-count">{questions.length}</span></h2>
        {errors.question && <p class="crm-notice bad" role="alert">{vi ? "Không xóa được câu hỏi vì đã có hồ sơ trả lời." : "That question could not be removed because applications already depend on it."}</p>}
        {questions.length ? <ul class="crm-list">{questions.map((question) => <li class="crm-row">
          <span><strong>{question.prompt}</strong></span>
          <form method="post" action={`/api/admin/questions/${question.id}/delete`}><input type="hidden" name="lang" value={lang} /><input type="hidden" name="job_id" value={job.id} /><button class="crm-button small danger" type="submit">{vi ? "Xóa" : "Remove"}</button></form>
          <span class="crm-row-meta"><span>{kinds[question.kind]?.[vi ? 1 : 0] ?? question.kind}</span><span>{question.required ? (vi ? "bắt buộc" : "required") : (vi ? "không bắt buộc" : "optional")}</span></span>
        </li>)}</ul> : <p class="crm-empty">{vi ? "Chưa có câu hỏi." : "No questions yet."}</p>}
        <details class="crm-disclosure" open={questions.length === 0}><summary>{vi ? "Thêm câu hỏi" : "Add a question"}</summary>
          <form class="crm-form" method="post" action={`/api/admin/jobs/${job.id}/questions`}>
            <input type="hidden" name="lang" value={lang} />
            <div class="crm-field"><label for="kind">{vi ? "Loại" : "Type"}</label><select class="crm-select" id="kind" name="kind">{Object.entries(kinds).map(([value, names]) => <option value={value}>{names[vi ? 1 : 0]}</option>)}</select></div>
            <div class="crm-field"><label for="prompt">{vi ? "Câu hỏi" : "Prompt"} *</label><textarea class="crm-textarea" id="prompt" name="prompt" required maxlength="1000"></textarea></div>
            <div class="crm-field"><label for="help_text">{vi ? "Hướng dẫn" : "Guidance"}</label><textarea class="crm-textarea" id="help_text" name="help_text" maxlength="1500"></textarea></div>
            <label class="crm-check"><input type="checkbox" name="required" value="1" checked /><span>{vi ? "Bắt buộc" : "Required"}</span></label>
            <div class="crm-field"><label for="sort_order_q">{vi ? "Thứ tự" : "Order"}</label><input class="crm-input" id="sort_order_q" name="sort_order" type="number" value={questions.length * 10} /></div>
            <div class="crm-actions"><button class="crm-button secondary" type="submit">{vi ? "Thêm câu hỏi" : "Add question"}</button></div>
          </form>
        </details>
      </section>
      <section class="crm-sheet" aria-labelledby="danger-h">
        <h2 class="crm-h2" id="danger-h">{vi ? "Xóa vị trí" : "Delete role"}</h2>
        {errors.delete === "applications" && <p class="crm-notice bad" role="alert">{vi ? "Vị trí đã có hồ sơ. Hãy đóng vị trí thay vì xóa." : "This role has applications. Close it instead of deleting it."}</p>}
        <p class="crm-help">{vi ? "Chỉ xóa được khi chưa có ai ứng tuyển." : "A role can only be deleted before anyone has applied."}</p>
        <form class="crm-form" method="post" action={`/api/admin/jobs/${job.id}/delete`}>
          <input type="hidden" name="lang" value={lang} />
          <label class="crm-check"><input type="checkbox" name="confirm" value="1" required /><span>{vi ? "Tôi hiểu thao tác này không hoàn tác được." : "I understand this cannot be undone."}</span></label>
          <div class="crm-actions"><button class="crm-button danger" type="submit">{vi ? "Xóa vị trí" : "Delete role"}</button></div>
        </form>
      </section>
    </aside>
  </div>
  </div>
</WorkspaceShell>
