---
import JobsLayout from "../../layouts/JobsLayout.astro";
import type { Job, JobQuestion } from "../../lib/ats";
import { splitLines } from "../../lib/ats";

interface Props { lang: "en" | "vi"; job: Job | null; questions: JobQuestion[] }
const { lang, job, questions } = Astro.props;
const vi = lang === "vi";
const root = vi ? "/vi/jobs" : "/jobs";
const responsibilities = job ? splitLines(job.responsibilities) : [];
const requirements = job ? splitLines(job.requirements) : [];
const applied = Astro.url.searchParams.get("applied");
const applyError = Astro.url.searchParams.get("error");
const startedAt = Date.now();
const t = (en: string, viText: string) => vi ? viText : en;
---
<JobsLayout
  lang={lang}
  alternate={job ? `${vi ? "" : "/vi"}/jobs/${job.slug}` : undefined}
  title={job ? `${job.title} — ${t("Lumi Jobs", "Tuyển dụng Lumi")}` : t("Role not found — Lumi Jobs", "Không tìm thấy vị trí — Tuyển dụng Lumi")}
  description={job?.summary ?? t("This role is not available.", "Vị trí này không còn tuyển.")}
>
  <section class="ats-page">
    <div class="ats-shell">
      {!job ? (
        <div class="ats-card ats-empty">
          <h1>{t("That role is no longer open.", "Vị trí này không còn tuyển.")}</h1>
          <p>{t("It may have been filled or closed. See the roles that are open now.", "Có thể vị trí đã có người hoặc đã đóng. Xem các vị trí đang tuyển.")}</p>
          <p><a class="ats-button" href={root}>{t("View open roles", "Xem vị trí đang tuyển")}</a></p>
        </div>
      ) : (
        <>
          {applied && (
            <div class="ats-notice" style="margin-bottom: 28px">
              <strong>{t("Application received.", "Đã nhận hồ sơ.")}</strong> {t("Thank you. Your reference is", "Cảm ơn bạn. Mã hồ sơ của bạn là")} <code>{applied}</code>.
              {t("We will review the work, not how loudly it was presented.", "Chúng tôi xem xét công việc, không phải cách trình bày ồn ào.")}
            </div>
          )}
          {applyError && (
            <div class="ats-notice danger" style="margin-bottom: 28px">
              {t("We could not submit that application. Please check the required fields and file sizes, then try again.", "Chưa gửi được hồ sơ. Hãy kiểm tra các trường bắt buộc và dung lượng tệp rồi thử lại.")}
            </div>
          )}

          <a class="text-link" href={root}>← {t("All open roles", "Tất cả vị trí")}</a>
          <div class="ats-eyebrow" style="margin-top:32px">{job.team || "LUMI"} / {t("OPEN ROLE", "VỊ TRÍ ĐANG TUYỂN")}</div>
          <h1 class="ats-title">{job.title}</h1>
          <div class="job-meta" style="margin-top:18px">
            {job.location && <span>{job.location}</span>}
            {job.workplace_type && <span>{job.workplace_type}</span>}
            {job.employment_type && <span>{job.employment_type}</span>}
          </div>
          <p class="ats-lede">{job.summary}</p>
          <hr class="ats-rule" />

          <div class="job-detail-grid" style="margin-top:46px">
            <article class="job-copy">
              {job.description && (
                <>
                  <h2>{t("The work", "Công việc")}</h2>
                  <p>{job.description}</p>
                </>
              )}

              {responsibilities.length > 0 && (
                <>
                  <h2>{t("What you will own", "Bạn sẽ phụ trách")}</h2>
                  <ul class="ats-list">
                    {responsibilities.map((item) => <li>{item}</li>)}
                  </ul>
                </>
              )}

              {requirements.length > 0 && (
                <>
                  <h2>{t("What matters here", "Điều quan trọng ở đây")}</h2>
                  <ul class="ats-list">
                    {requirements.map((item) => <li>{item}</li>)}
                  </ul>
                </>
              )}

              {job.application_note && (
                <>
                  <h2>{t("Before you apply", "Trước khi ứng tuyển")}</h2>
                  <p>{job.application_note}</p>
                </>
              )}
            </article>

            <aside class="ats-card apply-aside">
              <h2>{t("Interested?", "Bạn quan tâm?")}</h2>
              <p>{t("Apply on this page. No account, no recruiter maze.", "Ứng tuyển ngay trên trang này. Không cần tài khoản, không qua nhiều vòng trung gian.")}</p>
              <a class="ats-button" href="#apply">{t("Apply for this role", "Ứng tuyển vị trí này")}</a>
            </aside>
          </div>

          <hr class="ats-rule" style="margin-top:70px" />

          <section id="apply" style="padding-top:54px; max-width:760px">
            <div class="ats-eyebrow">{t("APPLICATION", "HỒ SƠ ỨNG TUYỂN")}</div>
            <h2 style="margin:0;color:var(--ats-navy);font-size:clamp(30px,4vw,44px);letter-spacing:-.04em">{t("Tell us what we should know.", "Cho chúng tôi biết điều nên biết.")}</h2>
            <p class="ats-lede" style="font-size:17px;margin-top:14px">
              {t("Clear and specific is better than polished. Your CV and test files stay private.", "Rõ ràng và cụ thể quan trọng hơn trau chuốt. CV và tệp bài làm của bạn được giữ riêng tư.")}
            </p>

            <form class="ats-form" method="post" action={`/api/jobs/${job.slug}/apply`} enctype="multipart/form-data" style="margin-top:34px">
              <input type="hidden" name="started_at" value={String(startedAt)} />
              <input type="hidden" name="lang" value={lang} />
              <div style="position:absolute;left:-9999px" aria-hidden="true">
                <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
              </div>

              <div class="ats-field">
                <label for="full_name">{t("Full name", "Họ và tên")} *</label>
                <input class="ats-input" id="full_name" name="full_name" autocomplete="name" required maxlength="160" />
              </div>

              <div class="ats-field">
                <label for="email">Email *</label>
                <input class="ats-input" id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </div>

              <div class="ats-field">
                <label for="phone">{t("Phone", "Điện thoại")}</label>
                <input class="ats-input" id="phone" name="phone" autocomplete="tel" maxlength="80" />
              </div>

              <div class="ats-field">
                <label for="linkedin_url">LinkedIn</label>
                <input class="ats-input" id="linkedin_url" name="linkedin_url" type="url" placeholder="https://…" maxlength="500" />
              </div>

              <div class="ats-field">
                <label for="portfolio_url">{t("Portfolio / GitHub / work sample", "Portfolio / GitHub / sản phẩm đã làm")}</label>
                <input class="ats-input" id="portfolio_url" name="portfolio_url" type="url" placeholder="https://…" maxlength="500" />
              </div>

              <div class="ats-field">
                <label for="cover_letter">{t("Cover letter", "Thư giới thiệu")} *</label>
                <textarea class="ats-textarea" id="cover_letter" name="cover_letter" required maxlength="10000" placeholder={t("Why this work, why Lumi, and what should we pay attention to in your experience?", "Vì sao công việc này, vì sao Lumi, và chúng tôi nên chú ý điều gì trong kinh nghiệm của bạn?")}></textarea>
                <span class="ats-help">{t("A few thoughtful paragraphs are enough.", "Vài đoạn viết cẩn thận là đủ.")}</span>
              </div>

              <div class="ats-field">
                <label for="resume">CV *</label>
                <input class="ats-input" id="resume" name="resume" type="file" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <span class="ats-help">{t("PDF, DOC or DOCX. Maximum 10 MB.", "PDF, DOC hoặc DOCX. Tối đa 10 MB.")}</span>
              </div>

              {questions.length > 0 && (
                <div class="ats-form-section">
                  <h3>{t("Small work sample", "Bài làm ngắn")}</h3>
                  <p>{t("These questions are part of the application, not a hidden second round.", "Các câu hỏi này là một phần của hồ sơ, không phải vòng hai ẩn.")}</p>

                  {questions.map((q) => (
                    <div class="ats-field" style="margin-top:22px">
                      <label for={`question_${q.id}`}>{q.prompt}{q.required ? " *" : ""}</label>
                      {q.help_text && <span class="ats-help">{q.help_text}</span>}
                      {q.kind === "long" ? (
                        <textarea class="ats-textarea" id={`question_${q.id}`} name={`question_${q.id}`} required={Boolean(q.required)} maxlength="12000"></textarea>
                      ) : q.kind === "file" ? (
                        <>
                          <input class="ats-input" id={`question_${q.id}`} name={`question_${q.id}`} type="file" required={Boolean(q.required)} accept=".pdf,.doc,.docx,.txt,.md,.csv,.xlsx,.pptx,.png,.jpg,.jpeg,.zip" />
                          <span class="ats-help">{t("Maximum 15 MB. Do not upload secrets or client-confidential material.", "Tối đa 15 MB. Không tải lên thông tin bí mật hay tài liệu mật của khách hàng.")}</span>
                        </>
                      ) : (
                        <input class="ats-input" id={`question_${q.id}`} name={`question_${q.id}`} required={Boolean(q.required)} maxlength="3000" />
                      )}
                    </div>
                  ))}
                </div>
              )}

              <label class="ats-check">
                <input type="checkbox" name="consent" value="1" required />
                <span>{t("I agree that Lumi may use the information I submit to assess this application and contact me about this role. If the application does not move forward or I withdraw it, Lumi deletes it with my files 60 days later.", "Tôi đồng ý để Lumi dùng thông tin tôi gửi để đánh giá hồ sơ này và liên hệ với tôi về vị trí này. Nếu hồ sơ không được tiếp tục hoặc tôi rút hồ sơ, Lumi sẽ xóa hồ sơ cùng các tệp sau 60 ngày.")}</span>
              </label>

              <div>
                <button class="ats-button" type="submit">{t("Submit application", "Gửi hồ sơ")}</button>
              </div>
            </form>
          </section>
        </>
      )}
    </div>
  </section>
</JobsLayout>
