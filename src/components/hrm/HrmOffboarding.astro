---
import HrmCloseout from "./HrmCloseout.astro";
import HrmPage from "./HrmPage.astro";
import type { OffboardingDetailPage, OffboardingListPage } from "../../lib/hrm/offboarding-pages";
type Data=OffboardingDetailPage|OffboardingListPage;const d=Astro.props as Data;const vi=d.vi;
const state=(value:string)=>({open:vi?"Đang mở":"Open",completed:vi?"Hoàn tất":"Completed",cancelled:vi?"Đã hủy do tái tuyển":"Cancelled after rehire",pending:vi?"Chờ xử lý":"Pending",blocked:vi?"Đang chặn":"Blocked",not_required:vi?"Không cần áp dụng":"Not required",superseded:vi?"Đã thay thế":"Superseded"}[value]||value);
const taskLabel=(key:string)=>({manager_handover:vi?"Bàn giao công việc":"Manager handover",asset_return:vi?"Thu hồi tài sản":"Return company assets",workspace_access:vi?"Thu hồi quyền Workspace":"Revoke Workspace access",records_review:vi?"Rà soát lưu trữ và legal hold":"Review retention and legal hold",payroll_closeout:vi?"Quyết toán cuối kỳ":"Final payroll closeout"}[key]||key);
const assetState=(value:string)=>({offered:vi?"Chờ xác nhận":"Awaiting receipt",assigned:vi?"Đang giao":"Assigned",return_requested:vi?"Đang chờ trả":"Return requested",returned:vi?"Đã nhận lại":"Returned",cancelled:vi?"Đã hủy":"Cancelled"}[value]||value);
const date=(value:string)=>new Date(`${value}T00:00:00+07:00`).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
const detail="offboarding" in d;const pathPrefix=vi?"/vi":"";
---
<HrmPage data={d} current="offboarding">
 {detail?<>
  <div class="crm-actions"><a class="crm-button secondary" href={`${pathPrefix}/hrm/offboarding`}>{vi?"← Danh sách":"← Offboarding queue"}</a></div>
  {d.saved&&<p class="crm-notice good" role="status">{vi?"Đã cập nhật checklist offboarding.":"Offboarding checklist updated."}</p>}
  <section class="crm-sheet"><p class="crm-eyebrow">{d.offboarding.employee_code} · {state(d.offboarding.state)}</p><h2 class="crm-h2">{d.offboarding.employee_name}</h2><p class="crm-meta">{d.offboarding.department||"—"} · {d.offboarding.job_title||"—"} · {vi?"Ngày kết thúc":"End date"} {date(d.offboarding.ended_on)}</p>
   <p>{vi?"Hồ sơ, tệp và lịch sử HRM được giữ nguyên. Checklist không tự xóa dữ liệu, thanh toán hay thu hồi quyền bên ngoài.":"The HRM record, files and history remain intact. This checklist does not delete data, make payments or revoke external-system access."}</p>
  </section>
  {d.member&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Quyền Workspace":"Workspace access"}</h2><p>{d.member.name} · {d.member.email} · {d.member.enabled?(vi?"Đang bật":"Enabled"):(vi?"Đã tắt":"Disabled")}</p><p class="crm-meta">{vi?"Vai trò đang lưu":"Stored roles"}: {d.member.roles.join(", ")||"—"}</p><p class="crm-help">{vi?"Thu hồi sẽ tắt toàn bộ quyền Workspace và thu hồi API token CRM. Vai trò được giữ trong audit để khôi phục có chủ đích.":"Revocation disables all Workspace access and revokes CRM API tokens. Role grants remain recorded for an audited, deliberate restoration."}</p></section>}
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Checklist":"Offboarding checklist"}</h2><div class="crm-list">{d.tasks.map(task=>{
   const assigned=task.assignee_user_id===d.user.id;const managerTask=task.task_key==="manager_handover";const adminAccess=task.task_key==="workspace_access"&&d.user.can("users.manage");const managerCan=managerTask&&assigned;const hrCan=d.user.can("hrm.offboarding.manage");const canAct=adminAccess||managerCan||hrCan;
   return <article class="crm-row crm-offboarding-task"><div class="crm-onboarding-copy"><strong>{taskLabel(task.task_key)}</strong><span class="crm-meta">{task.assignee_kind} · {state(task.state)} · {task.required?(vi?"Bắt buộc":"Required"):(vi?"Tùy chọn":"Optional")}</span>{task.task_key==="asset_return"&&<div class="crm-help"><strong>{vi?"Tài sản gắn với việc này":"Linked asset assignments"}</strong>{task.asset_items?.length?<ul>{task.asset_items.map(item=><li><strong>{item.asset_tag}</strong> · {item.description} · {assetState(item.assignment_state)}{item.return_condition?` · ${vi?"Tình trạng khi nhận":"Return condition"}: ${item.return_condition}`:""}{item.expected_return_on?` · ${vi?"Dự kiến trả":"Expected return"}: ${date(item.expected_return_on)}`:""} · {vi?`${item.evidence_count} PDF`:`${item.evidence_count} PDFs`}</li>)}</ul>:<p>{vi?"Không còn assignment tài sản đang mở cho đợt làm việc này.":"No open asset assignments are linked to this employment."}</p>}</div>}{task.task_key==="payroll_closeout"&&task.state==="blocked"?<p class="crm-notice bad">{vi?"Cần hồ sơ quyết toán hiện hành được duyệt độc lập.":"A current independently approved financial dossier is required."}</p>:task.blocked_reason&&<p class="crm-notice bad">{task.blocked_reason}</p>}{task.completion_note&&<p class="crm-meta">{task.completion_note}</p>}
    {canAct&&task.state==="pending"&&task.task_key==="workspace_access"&&adminAccess&&<form class="crm-form" method="post" action={`/api/hrm/offboarding/${encodeURIComponent(d.offboarding.id)}`}><input type="hidden" name="intent" value="revoke_access"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="lang" value={d.lang}/><label class="crm-check"><input type="checkbox" name="confirmed" value="1" required/><span>{d.member?.enabled?(vi?"Tôi xác nhận tắt toàn bộ quyền Workspace của tài khoản này.":"I confirm disabling all Workspace access for this account."):(vi?"Tôi xác nhận tài khoản hiện không còn quyền Workspace hoạt động.":"I confirm the account has no active Workspace access.")}</span></label><label class="crm-field"><span>{vi?"Lý do và phạm vi kiểm tra":"Reason and scope checked"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button danger" type="submit">{d.member?.enabled?(vi?"Thu hồi quyền Workspace":"Revoke Workspace access"):(vi?"Xác nhận đã thu hồi":"Confirm revoked")}</button></form>}
    {canAct&&task.state==="pending"&&task.task_key!=="workspace_access"&&task.task_key!=="payroll_closeout"&&<form class="crm-form" method="post" action={`/api/hrm/offboarding/${encodeURIComponent(d.offboarding.id)}`}><input type="hidden" name="intent" value="complete"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="lang" value={d.lang}/><label class="crm-field"><span>{vi?"Bằng chứng hoặc ghi chú":"Evidence or completion note"}</span><textarea class="crm-input" name="reason" maxlength="500" required rows="2"></textarea></label><button class="crm-button small" type="submit">{vi?"Ghi hoàn tất":"Record completion"}</button></form>}
    {hrCan&&task.state==="pending"&&["manager_handover","asset_return"].includes(task.task_key)&&<form class="crm-form" method="post" action={`/api/hrm/offboarding/${encodeURIComponent(d.offboarding.id)}`}><input type="hidden" name="intent" value="not_required"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="lang" value={d.lang}/><label class="crm-field"><span>{vi?"Lý do không áp dụng":"Why this task is not required"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small" type="submit">{vi?"Đánh dấu không cần":"Mark not required"}</button></form>}
   </div></article>
  })}</div></section>
  {d.closeout&&<HrmCloseout data={d}/>}
 </>:<section class="crm-sheet"><h2 class="crm-h2">{vi?"Các đợt nghỉ việc":"Employment endings"}</h2>{d.cases.length===0?<p class="crm-empty">{vi?"Chưa có hồ sơ offboarding trong phạm vi.":"No offboarding cases in your scope."}</p>:<div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>{vi?"Nhân viên":"Employee"}</th><th>{vi?"Bộ phận / vị trí":"Department / role"}</th><th>{vi?"Ngày kết thúc":"End date"}</th><th>{vi?"Checklist":"Tasks"}</th></tr></thead><tbody>{d.cases.map(item=><tr><td><a href={`${pathPrefix}/hrm/offboarding/${encodeURIComponent(item.id)}`}><strong>{item.employee_name}</strong></a><br/><span class="crm-meta">{item.employee_code} · {state(item.state)}</span></td><td>{item.department||"—"}<br/><span class="crm-meta">{item.job_title||"—"}</span></td><td>{date(item.ended_on)}</td><td>{item.open_tasks}/{item.task_count} {vi?"còn mở":"open"}</td></tr>)}</tbody></table></div>}</section>}
</HrmPage>
