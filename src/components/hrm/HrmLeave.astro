---
import HrmPage from "./HrmPage.astro";
import HrmLeaveEvidence from "./HrmLeaveEvidence.astro";
import HrmLeaveAmendment from "./HrmLeaveAmendment.astro";
import HrmApprovalDelegations from "./HrmApprovalDelegations.astro";
import type { LeaveManagePage, MyLeavePage } from "../../lib/hrm/time-pages";
type Data=LeaveManagePage|MyLeavePage;
// An error page receives only base fields: it renders the self view with
// empty collections and the error notice instead of crashing.
const d={requests:[],balances:[],...(Astro.props as Partial<MyLeavePage>)} as Data,vi=d.vi,prefix=vi?"/vi":"";
const manager="policies" in d;
const state=(value:string)=>({pending_approval:vi?"Chờ duyệt":"Pending approval",approved:vi?"Đã duyệt":"Approved",rejected:vi?"Bị từ chối":"Rejected",withdrawn:vi?"Đã rút":"Withdrawn",cancellation_requested:vi?"Chờ duyệt hủy":"Cancellation requested",cancelled:vi?"Đã hủy":"Cancelled",cancellation_rejected:vi?"Không chấp nhận hủy":"Cancellation rejected",draft:vi?"Bản nháp":"Draft",reviewed:vi?"Đã rà soát":"Reviewed",active:vi?"Đang áp dụng":"Active",retired:vi?"Ngừng áp dụng":"Retired"}[value]||value);
const date=(value:string)=>new Date(`${value}T00:00:00+07:00`).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
const hours=(minutes:number)=>`${(minutes/60).toFixed(2)} ${vi?"giờ":"hours"}`;
const path=`${prefix}/hrm/leave`;
---
<HrmPage data={d} current={manager?"leave":"my-leave"}>
 {manager? <>
  <HrmApprovalDelegations kind="leave" returnTo={path} user={d.user} members={d.members} delegations={d.delegations} vi={vi}/>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Phiên bản chính sách nghỉ":"Versioned leave policies"}</h2><p class="crm-help">{vi?"Không có hạn mức, loại phép hay tích lũy mặc định. Mọi quy tắc cần căn cứ cụ thể, người rà soát độc lập và được HRM Admin/System Super Admin kích hoạt.":"No leave type, allowance or accrual is assumed. Every rule needs a reviewed basis, an independent reviewer and HRM Admin/System Super Admin activation."}</p>
   {d.user.can("hrm.leave.configure")&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-grid"><label class="crm-field"><span>{vi?"Mã chính sách":"Policy key"}</span><input class="crm-input" name="policy_key" maxlength="80" required/></label><label class="crm-field"><span>{vi?"Tên tiếng Anh":"English title"}</span><input class="crm-input" name="title_en" maxlength="200" required/></label><label class="crm-field"><span>{vi?"Tên tiếng Việt":"Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="200" required/></label></div><label class="crm-field"><span>{vi?"Danh mục và quy tắc (JSON)":"Leave types and rules (JSON)"}</span><textarea class="crm-input crm-json" name="rules_json" rows="8" required placeholder={'[{"key":"annual","title_en":"Annual leave","title_vi":"Phép năm","paid":true,"annual_grant_minutes":0,"monthly_accrual_minutes":0,"prorate_on_start":false,"carryover_limit_minutes":0,"max_negative_minutes":0,"evidence_required":false,"exclude_holidays":true,"basis":""}]'}></textarea><span class="crm-help">{vi?"Không sao chép ví dụ nếu chưa được phê duyệt. Đơn vị là phút; căn cứ rỗng sẽ bị từ chối.":"Do not use the example before approval. Amounts are minutes; a blank basis is rejected."}</span></label><button class="crm-button secondary">{vi?"Tạo bản nháp":"Create draft"}</button></form>}
   <div class="crm-list">{d.policies.length===0?<p class="crm-empty">{vi?"Chưa có chính sách được cấu hình.":"No leave policy configured."}</p>:d.policies.map(policy=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{policy.title_en} · {policy.title_vi}</strong><span class="crm-meta">{policy.policy_key} · v{policy.version_number} · {state(policy.state)} · {policy.created_by}</span><pre class="crm-meta crm-json">{policy.rules_json}</pre>{policy.review_reason&&<p>{policy.review_reason}</p>}</div><div class="crm-actions">{policy.state==="draft"&&d.user.can("hrm.leave.review")&&policy.created_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="review_policy"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Rà soát đạt":"Review"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}{policy.state==="reviewed"&&d.user.can("hrm.leave.configure")&&<form method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="activate_policy"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small">{vi?"Kích hoạt":"Activate"}</button></form>}</div></article>)}</div>
  </section>

  {d.user.can("hrm.leave.manage")&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Gán chính sách và cập nhật sổ":"Assign policy and maintain ledger"}</h2><div class="crm-grid"><form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="assign_policy"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Nhân viên":"Employee"}</span><select class="crm-input" name="person_id" required>{d.people.map(p=><option value={p.id}>{p.employee_code} · {p.preferred_name||p.legal_name} · {p.status}</option>)}</select></label><label class="crm-field"><span>{vi?"Chính sách đang active":"Active policy"}</span><select class="crm-input" name="policy_id" required>{d.policies.filter(p=>p.state==="active").map(p=><option value={p.id}>{vi?p.title_vi:p.title_en} · v{p.version_number}</option>)}</select></label><label class="crm-field"><span>{vi?"Có hiệu lực từ":"Effective from"}</span><input class="crm-input" type="date" name="effective_from" required/></label><label class="crm-field"><span>{vi?"Có hiệu lực đến (không bắt buộc)":"Effective through (optional)"}</span><input class="crm-input" type="date" name="effective_to"/></label><button class="crm-button secondary">{vi?"Gán chính sách":"Assign policy"}</button></form>
    <form class="crm-form" method="post" action="/api/hrm/leave"><h3>{vi?"Chạy tích lũy tháng đã qua":"Run monthly accrual"}</h3><input type="hidden" name="intent" value="run_accrual"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Tính đến tháng (YYYY-MM)":"Through month (YYYY-MM)"}</span><input class="crm-input" name="through_month" pattern="\d{4}-(0[1-9]|1[0-2])" required/></label><button class="crm-button secondary">{vi?"Tích lũy idempotent":"Run idempotent accrual"}</button><p class="crm-help">{vi?"Chỉ chạy đến tháng hiện tại đã qua; mỗi tháng được ghi sổ một lần.":"Runs only through an elapsed month; each month is ledgered once."}</p></form></div>
    <h3>{vi?"Cân chỉnh có audit":"Audited balance adjustment"}</h3><form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="adjust_balance"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-grid"><label class="crm-field"><span>{vi?"Nhân viên":"Employee"}</span><select class="crm-input" name="person_id" required>{d.people.map(p=><option value={p.id}>{p.employee_code} · {p.preferred_name||p.legal_name}</option>)}</select></label><label class="crm-field"><span>{vi?"Loại phép":"Leave type key"}</span><input class="crm-input" name="leave_type_key" maxlength="40" required/></label><label class="crm-field"><span>{vi?"Phút (+/-)":"Minutes (+/-)"}</span><input class="crm-input" type="number" name="minutes" required/></label><label class="crm-field"><span>{vi?"Năm":"Year"}</span><input class="crm-input" name="period_key" pattern="\d{4}" required/></label></div><label class="crm-field"><span>{vi?"Lý do":"Reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary">{vi?"Ghi sổ điều chỉnh":"Record adjustment"}</button></form>
  </section>}

  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Chính sách đang gán":"Policy assignments"}</h2><div class="crm-list">{d.assignments.length===0?<p class="crm-empty">{vi?"Chưa gán chính sách.":"No policy assignments."}</p>:d.assignments.map(assignment=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{assignment.employee_code||""} · {assignment.preferred_name||assignment.person_id}</strong><span class="crm-meta"><code>{assignment.policy_version_id}</code> · {date(assignment.effective_from)} — {assignment.effective_to?date(assignment.effective_to):(vi?"đang hiệu lực":"current")} · v{assignment.version}</span></div>{d.user.can("hrm.leave.manage")&&!assignment.effective_to&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="end_policy_assignment"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="assignment_id" value={assignment.id}/><input type="hidden" name="version" value={assignment.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Có hiệu lực đến hết ngày":"Effective through"}</span><input class="crm-input" type="date" name="effective_to" required/></label><label class="crm-field"><span>{vi?"Lý do kết thúc":"End reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi?"Kết thúc để đổi phiên bản":"End for version change"}</button></form>}</article>)}</div></section>

  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Đơn nghỉ phép":"Leave requests"}</h2><div class="crm-list">{d.requests.length===0?<p class="crm-empty">{vi?"Chưa có đơn nghỉ.":"No leave requests."}</p>:d.requests.map(request=><article class="crm-row" id={`leave-${request.id}`}><div class="crm-onboarding-copy"><strong>{request.employee_code||""} · {request.preferred_name||request.person_id} · {request.leave_title_vi||request.leave_type_key}</strong><span class="crm-meta">{date(request.starts_on)} — {date(request.ends_on)} · {hours(request.requested_minutes)} · {state(request.state)}</span>{request.private_reason&&<p>{request.private_reason}</p>}{request.handoff_note&&<span class="crm-meta">{vi?"Bàn giao":"Handoff"}: {request.handoff_note}</span>}{request.review_reason&&<span class="crm-meta">{vi?"Quyết định":"Decision"}: {request.review_reason}</span>}</div><HrmLeaveEvidence request={request} user={d.user} vi={vi} returnTo={path} manager={true}/><HrmLeaveAmendment request={request} user={d.user} vi={vi} returnTo={path} manager={true}/><div class="crm-actions">{request.state==="pending_approval"&&d.user.can("hrm.leave.review")&&request.submitted_by!==d.user.id&&(!request.evidence_required||request.evidence_state==="reviewed")&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="review_request"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}{request.state==="cancellation_requested"&&d.user.can("hrm.leave.review")&&request.submitted_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="review_cancellation"/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button danger small" name="decision" value="approve">{vi?"Duyệt hủy":"Approve cancel"}</button><button class="crm-button secondary small" name="decision" value="reject">{vi?"Giữ đơn":"Keep request"}</button></form>}</div></article>)}</div></section>
 </>: <>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Số dư phép theo sổ biến động":"Leave balances from the ledger"}</h2>{d.options&&<p class="crm-meta">{vi?"Múi giờ lịch":"Calendar timezone"}: {d.options.timezone} · {vi?"Phiên bản chính sách":"Policy version"}: <code>{d.options.policyVersionId}</code></p>}<div class="crm-list">{d.balances.length===0?<p class="crm-empty">{vi?"HR chưa gán chính sách phép.":"HR has not assigned a leave policy."}</p>:d.balances.map(balance=><article class="crm-row"><strong>{balance.leave_type_key}</strong><span>{vi?"Số dư":"Ledger balance"}: {hours(balance.balance_minutes)} · {vi?"Đang giữ":"Pending hold"}: {hours(balance.pending_minutes)} · {vi?"Khả dụng":"Available"}: {hours(balance.available_minutes)}</span></article>)}</div></section>
  {d.options&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo và xem trước đơn nghỉ":"Create and preview leave request"}</h2><form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="preview_request"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/leave`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-grid"><label class="crm-field"><span>{vi?"Loại phép":"Leave type"}</span><select class="crm-input" name="leave_type_key" required>{d.options.rules.map(rule=><option value={rule.key} selected={d.previewValues?.leaveTypeKey===rule.key}>{vi?rule.title_vi:rule.title_en} · {rule.paid?(vi?"có lương":"paid"):(vi?"không lương":"unpaid")}</option>)}</select></label><label class="crm-field"><span>{vi?"Bắt đầu":"Starts on"}</span><input class="crm-input" type="date" name="starts_on" value={d.previewValues?.startsOn||""} required/></label><label class="crm-field"><span>{vi?"Kết thúc":"Ends on"}</span><input class="crm-input" type="date" name="ends_on" value={d.previewValues?.endsOn||""} required/></label><label class="crm-field"><span>{vi?"Phần ngày":"Day portion"}</span><select class="crm-input" name="portion"><option value="full" selected={!d.previewValues||d.previewValues.portion==="full"}>{vi?"Cả ngày":"Full day"}</option><option value="half_first" selected={d.previewValues?.portion==="half_first"}>{vi?"Nửa đầu":"First half"}</option><option value="half_second" selected={d.previewValues?.portion==="half_second"}>{vi?"Nửa sau":"Second half"}</option></select></label></div><button class="crm-button secondary" type="submit">{vi?"Tính trước":"Preview calculation"}</button></form>
   {d.preview&&d.previewValues&&<section class="crm-notice good" aria-live="polite"><strong>{vi?"Bản tính xem trước":"Calculation preview"}</strong><p>{vi?"Thời lượng cần giữ":"Requested work time"}: {hours(d.preview.requestedMinutes)} · {vi?"Số dư hiện tại":"Current available balance"}: {hours(d.preview.balanceMinutes)} · {vi?"Pháp nhân":"Policy version"}: <code class="crm-policy-version">{d.preview.assignment.policy_version_id}</code></p><ul>{d.preview.days.map(day=><li>{date(day.date)} · {hours(day.minutes)}{day.holiday?` · ${vi?"ngày nghỉ":"holiday"}`:""} · {day.shiftKeys.join(", ")||"—"}</li>)}</ul><form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="submit_request"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/leave`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="starts_on" value={d.previewValues.startsOn}/><input type="hidden" name="ends_on" value={d.previewValues.endsOn}/><input type="hidden" name="portion" value={d.previewValues.portion}/><input type="hidden" name="leave_type_key" value={d.previewValues.leaveTypeKey}/><label class="crm-field"><span>{vi?"Lý do (chỉ khi cần)":"Private reason (only if needed)"}</span><textarea class="crm-input" name="private_reason" maxlength="1000" rows="2"></textarea></label><label class="crm-field"><span>{vi?"Bàn giao":"Handoff note"}</span><textarea class="crm-input" name="handoff_note" maxlength="500" rows="2"></textarea></label><button class="crm-button" type="submit">{vi?"Gửi xin nghỉ":"Submit leave request"}</button></form></section>}</section>}
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Đơn của tôi":"My requests"}</h2><div class="crm-list">{d.requests.length===0?<p class="crm-empty">{vi?"Chưa có đơn.":"No requests."}</p>:d.requests.map(request=><article class="crm-row" id={`leave-${request.id}`}><div class="crm-onboarding-copy"><strong>{request.leave_title_vi||request.leave_type_key} · {state(request.state)}</strong><span class="crm-meta">{date(request.starts_on)} — {date(request.ends_on)} · {hours(request.requested_minutes)}</span>{request.cancellation_reason&&<p>{vi?"Lý do xin hủy":"Cancellation reason"}: {request.cancellation_reason}</p>}{request.review_reason&&<p>{request.review_reason}</p>}</div><HrmLeaveEvidence request={request} user={d.user} vi={vi} returnTo={`${prefix}/hrm/me/leave`} manager={false}/><HrmLeaveAmendment request={request} user={d.user} vi={vi} returnTo={`${prefix}/hrm/me/leave`} manager={false}/><div class="crm-actions">{request.state==="pending_approval"&&<form method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="withdraw_request"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/leave`}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button secondary small">{vi?"Rút đơn":"Withdraw"}</button></form>}{request.state==="approved"&&<form class="crm-form" method="post" action="/api/hrm/leave"><input type="hidden" name="intent" value="request_cancellation"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/leave`}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do xin hủy":"Cancellation reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button danger small">{vi?"Yêu cầu hủy":"Request cancellation"}</button></form>}</div></article>)}</div></section>
 </>}
</HrmPage>
