---
import HrmPage from "./HrmPage.astro";
import type { HrmReportsPage } from "../../lib/hrm/report-pages";
import { reportStateLabel } from "../../lib/hrm/reports";

const d=Astro.props as HrmReportsPage,vi=d.vi;
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Tổng hợp theo pháp nhân":"Legal-entity summary"}</strong><p>{vi?"Báo cáo chỉ hiển thị số lượng tổng hợp, không hiển thị tên, CCCD, lương, lý do nghỉ hay nội dung hồ sơ HR riêng tư. Lương không nằm trong báo cáo này.":"Reports show aggregate counts only. They omit names, IDs, pay, private leave reasons and HR case text; payroll is excluded."}</p><p class="crm-meta">{d.legalEntity} · {vi?"Tạo lúc":"Generated"} {d.generatedAt}</p></section>
 {d.error&&<p class="crm-notice error" role="alert">{d.error}</p>}
 {d.user.can("hrm.reports.export")&&<form method="post" action={vi?"/api/hrm/reports/export?lang=vi":"/api/hrm/reports/export"} class="crm-actions"><button class="crm-button secondary" type="submit">{vi?"Tải CSV tổng hợp":"Download aggregate CSV"}</button></form>}
 <div class="crm-list">{d.groups.map(group=><section class="crm-sheet"><h2 class="crm-h2">{vi?group.title_vi:group.title_en}</h2>{group.rows.length===0?<p class="crm-empty">{vi?"Chưa có dữ liệu.":"No data yet."}</p>:<dl class="crm-list">{group.rows.map(row=><div class="crm-row"><dt>{reportStateLabel(row.key,vi?"vi":"en")}</dt><dd><strong>{row.count}</strong></dd></div>)}</dl>}</section>)}</div>
</HrmPage>
