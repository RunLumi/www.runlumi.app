---
import HrmPage from "./HrmPage.astro";
import type { HrmReportsPage } from "../../lib/hrm/report-pages";

const d=Astro.props as HrmReportsPage,vi=d.vi;
const labels:Record<string,string>=vi?{active:"Đang làm",probation:"Thử việc",notice:"Báo trước",ended:"Đã kết thúc",not_started:"Chưa bắt đầu",in_progress:"Đang làm",submitted:"Chờ duyệt",verified:"Đã xác minh",completed:"Hoàn tất",blocked:"Đang chặn",waived:"Được miễn",pending_approval:"Chờ duyệt",approved:"Đã duyệt",rejected:"Từ chối",withdrawn:"Đã rút",cancellation_requested:"Chờ hủy",cancelled:"Đã hủy",cancellation_rejected:"Không cho hủy",triaged:"Đã phân loại",answered:"Đã trả lời",resolved:"Đã xử lý",reopened:"Mở lại",available:"Sẵn sàng",offered:"Chờ nhận",assigned:"Đang giao",return_requested:"Chờ trả",inspection:"Chờ kiểm tra",retired:"Đã thanh lý",lost:"Báo mất",declined:"Không duyệt",overdue:"Quá hạn"}:{active:"Active",probation:"Probation",notice:"Notice",ended:"Ended",not_started:"Not started",in_progress:"In progress",submitted:"Submitted",verified:"Verified",completed:"Completed",blocked:"Blocked",waived:"Waived",pending_approval:"Pending approval",approved:"Approved",rejected:"Rejected",withdrawn:"Withdrawn",cancellation_requested:"Cancellation requested",cancelled:"Cancelled",cancellation_rejected:"Cancellation rejected",triaged:"Triaged",answered:"Answered",resolved:"Resolved",reopened:"Reopened",available:"Available",offered:"Awaiting receipt",assigned:"Assigned",return_requested:"Return requested",inspection:"Inspection",retired:"Retired",lost:"Reported lost",declined:"Declined",overdue:"Overdue"};
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Tổng hợp theo pháp nhân":"Legal-entity summary"}</strong><p>{vi?"Báo cáo chỉ hiển thị số lượng tổng hợp, không hiển thị tên, CCCD, lương, lý do nghỉ hay nội dung hồ sơ HR riêng tư. Lương không nằm trong báo cáo này.":"Reports show aggregate counts only. They omit names, IDs, pay, private leave reasons and HR case text; payroll is excluded."}</p><p class="crm-meta">{d.legalEntity} · {vi?"Tạo lúc":"Generated"} {d.generatedAt}</p></section>
 {d.error&&<p class="crm-notice error" role="alert">{d.error}</p>}
 <div class="crm-list">{d.groups.map(group=><section class="crm-sheet"><h2 class="crm-h2">{vi?group.title_vi:group.title_en}</h2>{group.rows.length===0?<p class="crm-empty">{vi?"Chưa có dữ liệu.":"No data yet."}</p>:<dl class="crm-list">{group.rows.map(row=><div class="crm-row"><dt>{labels[row.key]??row.key}</dt><dd><strong>{row.count}</strong></dd></div>)}</dl>}</section>)}</div>
</HrmPage>
