---
import HrmPage from "./HrmPage.astro";
import type { HrmReportsPage } from "../../lib/hrm/report-pages";
import { reportStateLabel } from "../../lib/hrm/reports";

const d=Astro.props as HrmReportsPage,vi=d.vi;
const prefix=vi?"/vi":"";
const exportQuery=new URLSearchParams({period:d.period});if(d.department)exportQuery.set("department",d.department);if(vi)exportQuery.set("lang","vi");
const exportAction=`/api/hrm/reports/export?${exportQuery.toString()}`;
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Báo cáo tổng hợp theo pháp nhân":"Legal-entity aggregate report"}</strong><p>{vi?"Báo cáo chỉ hiển thị số lượng; không có tên, CCCD, lương, lý do nghỉ hay nội dung hồ sơ HR riêng tư. Nhân sự, tài sản, phúc lợi và quá hạn đào tạo là ảnh chụp hiện tại; công, nghỉ phép, yêu cầu HR, onboarding và hạn đào tạo được tính theo kỳ đã chọn. Phòng ban lấy từ trường phòng ban trên hồ sơ đợt làm việc; sổ tài sản vẫn là số toàn pháp nhân.":"Reports show aggregate counts only; they omit names, IDs, pay, private leave reasons and HR case text. Employment, assets, benefits and overdue training are current snapshots. Attendance, leave, HR requests, onboarding and training deadlines use the selected period. Department comes from the department stored on each employment record; asset inventory remains company-wide."}</p><p class="crm-meta">{d.legalEntity} · {vi?"Tạo lúc":"Generated"} {d.generatedAt}</p></section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Bộ lọc báo cáo":"Report filters"}</h2><form class="crm-form" method="get" action={`${prefix}/hrm/reports`}><div class="crm-form-grid"><label class="crm-field"><span>{vi?"Tháng hoạt động":"Activity month"}</span><input class="crm-input" type="month" name="period" value={d.period} required/></label><label class="crm-field"><span>{vi?"Phòng ban hiện tại":"Current department"}</span><select class="crm-input" name="department"><option value="">{vi?"Tất cả phòng ban":"All departments"}</option>{d.departments.map(department=><option value={department} selected={d.department===department}>{department}</option>)}</select></label></div><div class="crm-actions"><button class="crm-button">{vi?"Áp dụng":"Apply filters"}</button><a class="crm-button secondary" href={`${prefix}/hrm/reports`}>{vi?"Xóa bộ lọc":"Clear filters"}</a></div></form></section>
 {d.user.can("hrm.reports.export")&&!d.error&&<form method="post" action={exportAction} class="crm-actions"><button class="crm-button secondary" type="submit">{vi?"Tải CSV tổng hợp":"Download aggregate CSV"}</button></form>}
 <div class="crm-list">{d.groups.map(group=><section class="crm-sheet"><h2 class="crm-h2">{vi?group.title_vi:group.title_en}</h2>{group.rows.length===0?<p class="crm-empty">{vi?"Chưa có dữ liệu.":"No data yet."}</p>:<dl class="crm-list">{group.rows.map(row=><div class="crm-row"><dt>{reportStateLabel(row.key,vi?"vi":"en")}</dt><dd><strong>{row.count}</strong></dd></div>)}</dl>}</section>)}</div>
</HrmPage>
