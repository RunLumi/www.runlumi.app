---
import Command from "./HrmPerformanceFields.astro";
import type { PerformancePage } from "../../lib/hrm/performance-pages";
interface Props {data:PerformancePage}
const {data:d}=Astro.props,r=d.selected,l=d.lineage,vi=d.vi,prefix=vi?"/vi":"",path=`${prefix}/hrm/${d.mode==="self"?"me/":""}performance`,url=(id:string)=>`${path}?review=${encodeURIComponent(id)}`;
const subject=r?.employee_user_id===d.user.id||r?.correction_subject_user_id===d.user.id;
const canCorrect=Boolean(r&&d.mode==="team"&&d.user.can("hrm.performance.manage")&&!subject&&l?.identity_aligned!==false&&!r.superseded&&!r.pending_correction&&["published","responded","closed"].includes(r.state));
const time=(value:string|null)=>value?new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"}):"";
const state=(value:string)=>({open:vi?"Chờ tự đánh giá":"Awaiting self-assessment",self_submitted:vi?"Chờ người đánh giá":"Awaiting reviewer",assessed:vi?"Chờ rà soát độc lập":"Awaiting independent review",published:vi?"Đã phát hành":"Published",responded:vi?"Đã phản hồi":"Responded",closed:vi?"Đã kết thúc":"Closed",cancelled:vi?"Đã hủy":"Cancelled"}[value]??value);
---
{r&&l&&<div class="performance-lineage">
 {!l.identity_aligned&&<p class="crm-notice">{vi?"Liên kết tài khoản của nhân viên đã thay đổi. HR cần xử lý và xác minh liên kết trước khi tiếp tục thao tác.":"The employee account linkage changed. HR must resolve and verify the linkage before further actions."}</p>}
 {l.superseded&&<p class="crm-notice">{vi?"Đây là bản lưu nguyên trạng. Đã có bản điều chỉnh mới được phát hành.":"This publication is archived unchanged. A later correction has been published."} {l.current&&<a href={url(l.current.id)}>{vi?"Mở bản hiện hành":"Open current publication"}</a>}</p>}
 {l.pending&&!l.superseded&&<p class="crm-notice">{vi?"Có bản điều chỉnh đang chờ duyệt. Bản này vẫn có hiệu lực cho đến khi bản điều chỉnh được phát hành.":"A correction is pending review. This publication remains current until the correction is published."}</p>}
 {l.correction&&<><h3>{vi?"Nguồn và lịch sử điều chỉnh":"Correction provenance"}</h3><p class="crm-meta">{vi?"Lần điều chỉnh":"Correction attempt"} {l.correction.attempt_no} · {vi?"Phiên bản nguồn khi mở":"Source revision at opening"}: {l.correction.source_revision_at_creation}</p><p class="performance-text">{l.correction.reason}</p>
 <div class="crm-actions">{l.correction.source&&<a class="crm-button secondary small" href={url(l.correction.source.id)}>{vi?"Xem bản nguồn":"View source"}: {l.correction.source.cycle_code}</a>}{l.correction.root&&l.correction.root.id!==l.correction.source?.id&&<a class="crm-button secondary small" href={url(l.correction.root.id)}>{vi?"Xem kỳ gốc":"View original cycle"}</a>}</div>
 {l.correction.self_mode==="carry_forward"?<div class="crm-notice"><p>{vi?"Nguyên văn tự đánh giá và bằng chứng của nhân viên được kế thừa làm bối cảnh. Đây không phải lần nộp mới, đồng ý mới hoặc xác nhận đã đọc bản điều chỉnh.":"The employee's original self-assessment and evidence are carried verbatim as context. This is not a new submission, agreement or acknowledgement of this correction."}</p><p class="crm-meta">{vi?"Nộp bản gốc lúc":"Originally submitted at"}: {time(l.correction.self_submitted_at)} · {l.correction.self_origin_period_start} – {l.correction.self_origin_period_end}</p>{l.correction.self_origin_objectives&&<><h4>{vi?"Mục tiêu tại lần tự đánh giá gốc":"Objectives of the original self-assessment"}</h4><p class="performance-text">{l.correction.self_origin_objectives}</p>{l.correction.self_origin_evidence_instructions&&<p class="performance-text">{l.correction.self_origin_evidence_instructions}</p>}</>}</div>:<p class="crm-help">{vi?"Bản điều chỉnh yêu cầu nhân viên tự nộp đánh giá mới. Xác nhận cũ không được chuyển sang bản này.":"This correction requires a new employee self-assessment. Prior acknowledgements are not carried forward."}</p>}
 {l.correction.source_context&&<div class="crm-notice"><h3>{vi?"Nguồn hiện hành cần rà soát trước khi duyệt":"Current source for independent review"}</h3><p class="crm-meta">{l.correction.source_context.title} · {vi?"Phiên bản":"Revision"} {l.correction.source_context.revision} · {state(l.correction.source_context.state)}</p><p>{l.correction.source_context.period_start} – {l.correction.source_context.period_end}</p><h4>{vi?"Nhận xét đã phát hành ở bản nguồn":"Published source assessment"}</h4><p class="performance-text">{l.correction.source_context.assessment}</p><h4>{vi?"Bằng chứng và kế hoạch nguồn":"Source evidence and development plan"}</h4><p class="performance-text">{l.correction.source_context.assessment_evidence}</p><p class="performance-text">{l.correction.source_context.development_plan}</p><h4>{vi?"Phản hồi của nhân viên ở bản nguồn":"Employee feedback on the source"}</h4><p class="performance-text">{l.correction.source_context.employee_feedback||(vi?"Chưa có phản hồi.":"No feedback recorded.")}</p>{l.correction.source_context.acknowledged_at&&<p>{vi?"Đã xác nhận đọc lúc":"Receipt acknowledged at"}: {time(l.correction.source_context.acknowledged_at)}</p>}</div>}
 </>}
 {l.related.length>0&&<><h3>{vi?"Các bản điều chỉnh từ bản này":"Corrections from this publication"}</h3><ul>{l.related.map(item=><li><a href={url(item.id)}>{item.cycle_code} · {item.title}</a><p class="crm-meta">{vi?"Lần":"Attempt"} {item.attempt_no} · {state(item.state)}</p><p class="performance-text">{item.reason}</p></li>)}</ul></>}
 {(l.page>1||l.hasMore)&&<div class="crm-actions">{l.page>1&&<a href={`${url(r.id)}&correction_page=${l.page-1}`}>{vi?"Các bản trước":"Previous corrections"}</a>}{l.hasMore&&<a href={`${url(r.id)}&correction_page=${l.page+1}`}>{vi?"Các bản tiếp":"More corrections"}</a>}</div>}
 {canCorrect&&<><h3>{vi?"Mở bản điều chỉnh có liên kết":"Open a linked correction"}</h3><p class="crm-help">{vi?"Bản nguồn và mọi xác nhận cũ được giữ nguyên. Bản sửa chỉ trở thành hiện hành sau khi được người khác duyệt độc lập; không tự đổi quyền đăng nhập hoặc lương.":"The source and its receipts stay unchanged. The correction becomes current only after independent publication; it does not restore login access or change pay."}</p><form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="create_correction" returnTo={url(r.id)}/><input type="hidden" name="source_review_id" value={r.id}/><input type="hidden" name="source_revision" value={r.revision}/>
 <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Mã riêng của bản điều chỉnh":"Correction cycle code"}</span><input class="crm-input" name="cycle_code" maxlength="48" pattern="[A-Za-z0-9][A-Za-z0-9_-]*" required/></label><label class="crm-field"><span>{vi?"Tên bản điều chỉnh":"Correction title"}</span><input class="crm-input" name="title" value={r.title} maxlength="160" required/></label></div>
 <div class="crm-form-grid">{[["period_start",vi?"Từ ngày":"Period starts",r.period_start],["period_end",vi?"Đến ngày":"Period ends",r.period_end],["due_on",vi?"Hạn hoàn tất bản sửa":"Correction completion due",""]].map(([name,label,value])=><label class="crm-field"><span>{label}</span><input class="crm-input" type="date" name={name} value={value} required/></label>)}</div>
 <label class="crm-field"><span>{vi?"Người đánh giá":"Reviewer"}</span><select class="crm-input" name="reviewer_user_id" required><option value="">{vi?"Chọn người đánh giá":"Choose reviewer"}</option>{d.reviewers.filter(person=>person.user_id!==r.employee_user_id&&person.user_id!==r.correction_subject_user_id).map(person=><option value={person.user_id}>{person.name}</option>)}</select></label>
 <label class="crm-field"><span>{vi?"Mục tiêu điều chỉnh":"Corrected objectives"}</span><textarea class="crm-input" name="objectives" maxlength="4000" rows="4" required>{r.objectives}</textarea></label><label class="crm-field"><span>{vi?"Yêu cầu bằng chứng":"Evidence requirements"}</span><textarea class="crm-input" name="evidence_instructions" maxlength="2000" rows="3" required>{r.evidence_instructions}</textarea></label>
 <fieldset><legend>{vi?"Nguồn tự đánh giá của nhân viên":"Employee self-assessment source"}</legend><label class="crm-field"><span><input type="radio" name="self_mode" value="new_submission" required/> {vi?"Yêu cầu nhân viên nộp mới (cần tài khoản và quyền tự phục vụ đang hoạt động).":"Require a new submission (active account and self-service access required)."}</span></label><label class="crm-field"><span><input type="radio" name="self_mode" value="carry_forward" required/> {vi?"Giữ nguyên bản tự đánh giá gốc làm bối cảnh, hiển thị ngày và mục tiêu gốc; không coi là lần nộp hay đồng ý mới.":"Carry the original submission as context, with its original date and objectives; it is not a new submission or agreement."}</span></label></fieldset>
 <label class="crm-field"><span>{vi?"Lý do điều chỉnh, nhân viên và người được giao đều được xem":"Correction reason, visible to the employee and assigned reviewer"}</span><textarea class="crm-input" name="reason" maxlength="1000" rows="3" required/></label><button class="crm-button primary">{vi?"Mở bản điều chỉnh":"Open correction"}</button></form></>}
</div>}
<style>.performance-lineage{margin-block:1.5rem;overflow-wrap:anywhere}.performance-lineage .crm-button{white-space:normal;max-width:100%}.performance-text{white-space:pre-wrap;overflow-wrap:anywhere}fieldset{border:1px solid var(--crm-line);padding:1rem;min-width:0}legend{font-weight:600}li{margin-block:1rem}</style>
