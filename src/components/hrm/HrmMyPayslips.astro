---
import HrmPage from "./HrmPage.astro";
import { formatPayrollMoney } from "../../lib/hrm/payroll";
import type { MyPayslipsPage } from "../../lib/hrm/payroll-pages";
const d = Astro.props as MyPayslipsPage;
const vi = d.vi, prefix = vi ? "/vi" : "";
const stateLabel = (state: string) => ({ published: vi ? "Đã phát hành" : "Published", superseded: vi ? "Đã thay thế" : "Superseded", submitted: vi ? "Đã gửi" : "Submitted", investigating: vi ? "Đang xử lý" : "Investigating", answered: vi ? "Đã trả lời" : "Answered", resolved: vi ? "Đã giải quyết" : "Resolved", reopened: vi ? "Đã mở lại" : "Reopened" }[state] ?? state);
const localDate = (value: string) => new Date(value).toLocaleString(vi ? "vi-VN" : "en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Ho_Chi_Minh" });
const snap = (value: string) => JSON.parse(value) as { policy: { currency: string; minor_unit_scale: number }; period_key: string; employee_code: string; display_name: string; correction_of_payslip_id: string | null; lines: Array<{ component_code: string; title_en: string; title_vi: string; direction: string; amount_minor: number }>; gross_minor: number; deductions_minor: number; net_minor: number };
---
<HrmPage data={d}>
  <section class="crm-notice" role="note"><strong>{vi ? "Phiếu lương là snapshot đã phát hành" : "Payslips are issued snapshots"}</strong><p>{vi ? "Mở hoặc tải phiếu không đồng nghĩa chấp thuận số tiền. Trạng thái phát hành khác với xác nhận thanh toán." : "Opening or downloading a payslip does not mean you accept its amounts. Issue status is separate from payment confirmation."}</p></section>
  <section class="crm-sheet"><h2 class="crm-h2">{vi ? "Phiếu lương của tôi" : "My payslips"}</h2>
    {d.slips.length === 0 ? <p class="crm-empty">{vi ? "Chưa có phiếu lương được phát hành." : "No payslips have been issued."}</p> : <div class="crm-list">{d.slips.map(slip => { const value = snap(slip.snapshot_json); return <article class="crm-row"><div class="crm-onboarding-copy"><strong>{value.period_key} · {stateLabel(slip.state)}</strong><span class="crm-meta">{value.policy.currency} · {vi ? "Phát hành" : "Issued"} {localDate(slip.issued_at)}</span>{value.correction_of_payslip_id && <span class="crm-meta">{vi ? "Điều chỉnh cho phiếu" : "Correction of payslip"} <code>{value.correction_of_payslip_id}</code></span>}<div class="crm-grid cols"><div><span class="crm-meta">{vi ? "Tổng thu nhập" : "Gross"}</span><strong>{formatPayrollMoney(value.gross_minor,value.policy.currency,value.policy.minor_unit_scale)}</strong></div><div><span class="crm-meta">{vi ? "Tổng khấu trừ" : "Deductions"}</span><strong>{formatPayrollMoney(value.deductions_minor,value.policy.currency,value.policy.minor_unit_scale)}</strong></div><div><span class="crm-meta">{vi ? "Thực nhận" : "Net"}</span><strong>{formatPayrollMoney(value.net_minor,value.policy.currency,value.policy.minor_unit_scale)}</strong></div><div><span class="crm-meta">{vi ? "Đã xác nhận trả" : "Payment confirmed"}</span><strong>{formatPayrollMoney(slip.paid_minor,value.policy.currency,value.policy.minor_unit_scale)}</strong></div></div><table class="crm-table"><thead><tr><th>{vi ? "Khoản" : "Component"}</th><th>{vi ? "Loại" : "Type"}</th><th>{vi ? "Số tiền" : "Amount"}</th></tr></thead><tbody>{value.lines.map(line => <tr><td>{vi ? line.title_vi : line.title_en}</td><td>{line.direction === "deduction" ? (vi ? "Khấu trừ" : "Deduction") : (vi ? "Thu nhập" : "Earning")}</td><td>{formatPayrollMoney(line.amount_minor,value.policy.currency,value.policy.minor_unit_scale)}</td></tr>)}</tbody></table><a href={`/api/hrm/payslips/${encodeURIComponent(slip.id)}`}>{vi ? "Tải bản riêng tư" : "Download private copy"}</a></div>
      {slip.state === "published" && <form class="crm-form" method="post" action="/api/hrm/payroll"><h3 class="crm-h3">{vi ? "Gửi thắc mắc về phiếu này" : "Ask about this payslip"}</h3><input type="hidden" name="intent" value="create_dispute"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/payslips`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="payslip_id" value={slip.id}/><label class="crm-field"><span>{vi ? "Khoản liên quan (tùy chọn)" : "Related component (optional)"}</span><select class="crm-input" name="component_code"><option value="">{vi ? "Toàn phiếu" : "Whole payslip"}</option>{value.lines.map(line => <option value={line.component_code}>{vi ? line.title_vi : line.title_en}</option>)}</select></label><label class="crm-field"><span>{vi ? "Nội dung" : "Inquiry"}</span><textarea class="crm-textarea" name="body" maxlength="2000" required></textarea></label><button class="crm-button secondary">{vi ? "Gửi thắc mắc" : "Submit inquiry"}</button></form>}</article>})}</div>}
  </section>
  {d.disputes.length > 0 && <section class="crm-sheet"><h2 class="crm-h2">{vi ? "Thắc mắc đã gửi" : "My inquiries"}</h2><div class="crm-list">{d.disputes.map(dispute => <article class="crm-row"><div><strong>{stateLabel(dispute.state)} · {dispute.component_code ?? (vi ? "Toàn phiếu" : "Whole payslip")}</strong><p class="crm-meta">{localDate(dispute.updated_at)}</p><a href={`${prefix}/hrm/me/payslips?dispute=${encodeURIComponent(dispute.id)}`}>{vi ? "Xem trao đổi" : "View conversation"}</a>{d.selectedDispute && Astro.url.searchParams.get("dispute") === dispute.id && <ol>{d.selectedDispute.map(event => <li><strong>{stateLabel(event.event_type)}</strong> · {event.body} · {localDate(event.created_at)}</li>)}</ol>}</div>{["answered", "resolved"].includes(dispute.state) && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="transition_dispute"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/payslips`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="dispute_id" value={dispute.id}/><input type="hidden" name="version" value={dispute.version}/><input type="hidden" name="next_state" value="reopened"/><label class="crm-field"><span>{vi ? "Lý do mở lại" : "Reason to reopen"}</span><textarea class="crm-textarea" name="body" maxlength="2000" required></textarea></label><button class="crm-button secondary small">{vi ? "Mở lại thắc mắc" : "Reopen inquiry"}</button></form>}</article>)}</div></section>}
</HrmPage>
