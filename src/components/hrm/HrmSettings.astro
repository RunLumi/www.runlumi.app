---
import HrmPage from "./HrmPage.astro";
import type { PageBase } from "../../lib/hrm/pages";
import type { Settings } from "../../lib/hrm/service";
import type { AssetReminderPolicy } from "../../lib/hrm/asset-reminders";
import type { TrainingReminderPolicy } from "../../lib/hrm/training-reminders";
interface Props extends PageBase { settings:Settings; assetReminderPolicies:AssetReminderPolicy[]; trainingReminderPolicies:TrainingReminderPolicy[]; saved:string; deploymentEnabled:boolean }
const d=Astro.props;
const reminderState=(state:string)=>({draft:d.vi?"Bản nháp":"Draft",reviewed:d.vi?"Đã rà soát":"Reviewed",active:d.vi?"Đang áp dụng":"Active",retired:d.vi?"Đã thay thế":"Retired",rejected:d.vi?"Đã từ chối":"Rejected"}[state]??state);
const reminderDays=(policy:AssetReminderPolicy)=>{try{const value:unknown=JSON.parse(policy.days_before_due_json);return Array.isArray(value)&&value.every(item=>typeof item==="number")?value.join(", "):"—"}catch{return "—"}};
const trainingReminderDays=(policy:TrainingReminderPolicy)=>{try{const value:unknown=JSON.parse(policy.days_before_due_json);return Array.isArray(value)&&value.every(item=>typeof item==="number")?value.join(", "):"—"}catch{return "—"}};
const reminderSaved=(value:string)=>({"1":d.vi?"Đã lưu cấu hình HRM.":"HRM settings saved.",asset_reminder_policy_created:d.vi?"Đã tạo lịch nhắc tài sản dạng nháp.":"Asset reminder policy draft created.",asset_reminder_policy_reviewed:d.vi?"Đã rà soát lịch nhắc tài sản.":"Asset reminder policy reviewed.",asset_reminder_policy_rejected:d.vi?"Đã từ chối lịch nhắc tài sản.":"Asset reminder policy rejected.",asset_reminder_policy_activated:d.vi?"Đã kích hoạt lịch nhắc tài sản.":"Asset reminder policy activated.",asset_reminders_dispatched:d.vi?"Đã xếp lịch nhắc trong ứng dụng.":"In-app reminders queued.",asset_reminders_skipped:d.vi?"Chưa có lịch nhắc được duyệt hoặc HRM chưa sẵn sàng.":"No active reminder policy or HRM activation gate is ready.",training_reminder_policy_created:d.vi?"Đã tạo bản nháp lịch nhắc đào tạo.":"Training reminder policy draft created.",training_reminder_policy_reviewed:d.vi?"Đã rà soát lịch nhắc đào tạo.":"Training reminder policy reviewed.",training_reminder_policy_rejected:d.vi?"Đã từ chối lịch nhắc đào tạo.":"Training reminder policy rejected.",training_reminder_policy_activated:d.vi?"Đã kích hoạt lịch nhắc đào tạo.":"Training reminder policy activated.",training_reminders_dispatched:d.vi?"Đã xếp nhắc hạn đào tạo trong ứng dụng.":"In-app training reminders queued.",training_reminders_skipped:d.vi?"Chưa có lịch nhắc được duyệt hoặc HRM chưa sẵn sàng.":"No active training reminder policy or HRM activation gate is ready.",training_reminder_read:d.vi?"Đã đánh dấu nhắc hạn là đã xem.":"Reminder marked as read."}[value]??value);
---
<HrmPage data={d} current="settings">
  {d.saved&&<div class="crm-notice good" role="status">{reminderSaved(d.saved)}</div>}
  <section class="crm-sheet">
    <h2 class="crm-h2">{d.vi?"Điều kiện mở HRM":"HRM activation conditions"}</h2>
    <p>{d.vi?"Policy pháp lý, công–phép và payroll chưa được owner chốt. Production giữ đóng bằng công tắc deployment; lưu cấu hình ở đây chưa cấp quyền hoặc mở dữ liệu.":"Legal, time/leave and payroll rules still need owner approval. Production remains closed by a deployment switch; saving configuration here does not grant access or open HR data."}</p>
    <p class="crm-meta">{d.vi?"Deployment gate":"Deployment gate"}: <strong>{d.live?(d.settings.enabled? (d.vi?"Đã bật":"Enabled"):(d.vi?"Chưa đủ điều kiện":"Not configured")):(d.vi?"ĐANG TẮT":"OFF")}</strong></p>
    {d.settings.reviewed_at&&<p class="crm-meta">{d.vi?"Được rà soát bởi":"Reviewed by"} {d.settings.reviewed_by} · {new Date(d.settings.reviewed_at).toLocaleString(d.vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"})}</p>}
  </section>
  <form method="post" class="crm-sheet crm-form">
    <input type="hidden" name="request_key" value={crypto.randomUUID()} /><input type="hidden" name="version" value={d.settings.version} />
    <h2 class="crm-h2">{d.vi?"Cấu hình chưa kích hoạt":"Configuration, not yet activated"}</h2>
    <p>{d.vi?"Các trường dưới đây phải trỏ tới quyết định/tài liệu thực. Không điền giá trị mặc định thay cho quyết định còn thiếu.":"These fields must refer to real decisions and source documents. Do not fill invented defaults for unresolved policies."}</p>
    <div class="crm-form-grid">
      <div class="crm-field"><label for="entity">{d.vi?"Pháp nhân sử dụng lao động":"Employing legal entity"}</label><input class="crm-input" id="entity" name="legal_entity" required maxlength="200" value={d.settings.legal_entity} /></div>
      <div class="crm-field"><label for="purpose">{d.vi?"Mục đích sử dụng dữ liệu HRM":"HRM data purpose"}</label><textarea class="crm-textarea" id="purpose" name="purpose" required maxlength="1000">{d.settings.purpose}</textarea></div>
      <div class="crm-field"><label for="retention">{d.vi?"Chính sách lưu trữ/hold đã duyệt":"Approved retention/hold policy"}</label><textarea class="crm-textarea" id="retention" name="retention_policy" required maxlength="1000">{d.settings.retention_policy}</textarea></div>
      <div class="crm-field"><label for="reference">{d.vi?"Nguồn/tài liệu chính sách có thẩm quyền":"Authoritative policy source/reference"}</label><input class="crm-input" id="reference" name="policy_reference" required maxlength="500" value={d.settings.policy_reference} /></div>
    </div>
    <label class="crm-check"><input type="checkbox" name="reviewed" value="1" /><span>{d.vi?"Tôi xác nhận các quyết định trên đã được người có thẩm quyền rà soát.":"I confirm the decisions above have been reviewed by the responsible owner."}</span></label>
    <label class="crm-check"><input type="checkbox" name="enabled" value="1" disabled={!d.deploymentEnabled} checked={d.settings.enabled===1} /><span>{d.vi?"Đề xuất bật HRM (chỉ có hiệu lực khi owner đã bật deployment gate).":"Enable HRM (effective only after the owner turns on the deployment gate)."}</span></label>
    <div class="crm-actions"><button class="crm-button" type="submit">{d.vi?"Lưu cấu hình":"Save settings"}</button></div>
  </form>
  {d.user.can("hrm.assets.reminders.manage")&&<section class="crm-sheet">
    <h2 class="crm-h2">{d.vi?"Lịch nhắc trả tài sản":"Asset return reminder policy"}</h2>
    <p>{d.vi?"Không có mốc nhắc mặc định. Nhập các ngày tương đối để owner có thể rà soát: số dương là số ngày trước hạn, 0 là đúng ngày đến hạn, số âm là số ngày sau hạn. Chỉ lịch đã được người khác rà soát và kích hoạt mới tạo thông báo trong ứng dụng; không gửi email hay webhook.":"No reminder offsets are seeded. Enter explicit day offsets for owner review: positive values are days before the due date, 0 is the due date, and negative values are days after. Only a version reviewed by another person and activated creates in-app reminders; no email or webhook is sent."}</p>
    {d.assetReminderPolicies.length===0?<p class="crm-empty">{d.vi?"Chưa có lịch nhắc tài sản.":"No asset reminder policies."}</p>:<div class="crm-list">{d.assetReminderPolicies.map(policy=><article class="crm-row"><div><strong>{d.vi?policy.title_vi:policy.title_en}</strong><p class="crm-meta">{policy.legal_entity} · {d.vi?"Phiên bản":"Version"} {policy.version_number} · {reminderState(policy.state)}</p><p>{d.vi?"Ngày tương đối":"Day offsets"}: {reminderDays(policy)}</p></div>
      {policy.state==="draft"&&policy.created_by!==d.user.id&&d.user.can("hrm.assets.reminders.approve")&&<div class="crm-actions">{(["approve","reject"] as const).map(decision=><form class="crm-form" method="post" action="/api/hrm/assets/reminders"><input type="hidden" name="intent" value="review_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="decision" value={decision}/><label class="crm-field"><span>{d.vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class={decision==="reject"?"crm-button danger small":"crm-button small"}>{decision==="approve"?(d.vi?"Duyệt":"Approve"):(d.vi?"Từ chối":"Reject")}</button></form>)}</div>}
      {policy.state==="reviewed"&&policy.created_by!==d.user.id&&d.user.can("hrm.assets.reminders.approve")&&<form class="crm-form" method="post" action="/api/hrm/assets/reminders"><input type="hidden" name="intent" value="activate_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><button class="crm-button small">{d.vi?"Kích hoạt lịch":"Activate policy"}</button></form>}
    </article>)}</div>}
    <form class="crm-form" method="post" action="/api/hrm/assets/reminders"><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/>
      <h3 class="crm-h2">{d.vi?"Tạo phiên bản lịch nhắc":"Create a reminder version"}</h3><div class="crm-form-grid"><label class="crm-field"><span>{d.vi?"Tên tiếng Anh":"English title"}</span><input class="crm-input" name="title_en" maxlength="120" required/></label><label class="crm-field"><span>{d.vi?"Tên tiếng Việt":"Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="120" required/></label><label class="crm-field"><span>{d.vi?"Ngày tương đối, phân tách bằng dấu phẩy":"Comma-separated day offsets"}</span><input class="crm-input" name="days_before_due" placeholder={d.vi?"7, 1, 0, -1":"7, 1, 0, -1"} required/></label></div><button class="crm-button">{d.vi?"Tạo bản nháp":"Create draft"}</button>
    </form>
    {d.live&&d.assetReminderPolicies.some(policy=>policy.state==="active")&&<form class="crm-form" method="post" action="/api/hrm/assets/reminders"><input type="hidden" name="intent" value="dispatch_due"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button secondary">{d.vi?"Kiểm tra mốc nhắc đến hạn":"Run due reminder sweep"}</button></form>}
  </section>}
  {d.user.can("hrm.training.reminders.manage")&&<section class="crm-sheet">
    <h2 class="crm-h2">{d.vi?"Lịch nhắc hạn đào tạo và chứng chỉ":"Training and certification reminder policy"}</h2>
    <p>{d.vi?"Không có mốc nhắc mặc định. Mốc dương là số ngày trước hạn, 0 là đúng hạn, mốc âm là số ngày sau hạn. Chỉ phiên bản do người khác rà soát mới có thể kích hoạt; HRM và cờ deployment vẫn phải được mở. Nhắc việc chỉ hiện trong ứng dụng, không gửi email/Lark/webhook. Thời hạn lưu dữ liệu nhắc hạn vẫn cần owner phê duyệt trước khi mở production.":"No reminder offsets are seeded. Positive values mean days before the deadline, 0 means the deadline, and negative values mean days after. Only a version reviewed by another user can be activated, and both the HRM and deployment gates must be open. Reminders remain in-app; there is no email, Lark or webhook delivery. An owner-approved retention period is still required before production activation."}</p>
    {d.trainingReminderPolicies.length===0?<p class="crm-empty">{d.vi?"Chưa có lịch nhắc đào tạo.":"No training reminder policies."}</p>:<div class="crm-list">{d.trainingReminderPolicies.map(policy=><article class="crm-row"><div><strong>{d.vi?policy.title_vi:policy.title_en}</strong><p class="crm-meta">{policy.legal_entity} · {d.vi?"Phiên bản":"Version"} {policy.version_number} · {reminderState(policy.state)}</p><p>{d.vi?"Ngày tương đối":"Day offsets"}: {trainingReminderDays(policy)}</p>{policy.review_reason&&<p class="crm-meta">{d.vi?"Lý do rà soát":"Review reason"}: {policy.review_reason}</p>}</div>
      {policy.state==="draft"&&policy.created_by!==d.user.id&&d.user.can("hrm.training.reminders.approve")&&<div class="crm-actions">{(["approve","reject"] as const).map(decision=><form class="crm-form" method="post" action="/api/hrm/training/reminders"><input type="hidden" name="intent" value="review_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_ref" value={policy.policy_ref}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="decision" value={decision}/><label class="crm-field"><span>{d.vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class={decision==="reject"?"crm-button danger small":"crm-button small"}>{decision==="approve"?(d.vi?"Duyệt":"Approve"):(d.vi?"Từ chối":"Reject")}</button></form>)}</div>}
      {policy.state==="reviewed"&&policy.created_by!==d.user.id&&d.user.can("hrm.training.reminders.approve")&&<form class="crm-form" method="post" action="/api/hrm/training/reminders"><input type="hidden" name="intent" value="activate_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_ref" value={policy.policy_ref}/><input type="hidden" name="version" value={policy.version}/><button class="crm-button small">{d.vi?"Kích hoạt":"Activate"}</button></form>}
    </article>)}</div>}
    <form class="crm-form" method="post" action="/api/hrm/training/reminders"><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/>
      <h3 class="crm-h2">{d.vi?"Tạo phiên bản lịch nhắc":"Create a reminder version"}</h3><div class="crm-form-grid"><label class="crm-field"><span>{d.vi?"Tên tiếng Anh":"English title"}</span><input class="crm-input" name="title_en" maxlength="120" required/></label><label class="crm-field"><span>{d.vi?"Tên tiếng Việt":"Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="120" required/></label><label class="crm-field"><span>{d.vi?"Ngày tương đối, phân tách bằng dấu phẩy":"Comma-separated day offsets"}</span><input class="crm-input" name="days_before_due" placeholder="365, 7, 1, 0, -1" required/></label></div><button class="crm-button">{d.vi?"Tạo bản nháp":"Create draft"}</button>
    </form>
    {d.live&&d.trainingReminderPolicies.some(policy=>policy.state==="active")&&<form class="crm-form" method="post" action="/api/hrm/training/reminders"><input type="hidden" name="intent" value="dispatch_due"/><input type="hidden" name="return_to" value={d.vi?"/vi/hrm/settings":"/hrm/settings"}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button secondary">{d.vi?"Chạy kiểm tra nhắc đến hạn":"Run due reminder sweep"}</button></form>}
  </section>}
</HrmPage>
