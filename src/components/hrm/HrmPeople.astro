---
import HrmPage from "./HrmPage.astro";
import DataTable from "../workspace/ui/DataTable.astro";
import ListToolbar from "../workspace/ui/ListToolbar.astro";
import type { PageBase } from "../../lib/hrm/pages";
import type { Person } from "../../lib/hrm/service";
interface Props extends PageBase { people:Person[]; query:string; page:number; hasMore:boolean }
const d=Astro.props;const date=(value:string|null)=>value?new Date(`${value}T00:00:00+07:00`).toLocaleDateString(d.vi?"vi-VN":"en-GB",{timeZone:"Asia/Ho_Chi_Minh"}):"—";
---
<HrmPage data={d} current="people" meta={d.vi?"Chỉ hiển thị trường công việc trong phạm vi được cấp.":"Shows work information within your permission scope."}>
  {d.user.can("hrm.records.manage")&&<a slot="actions" class="ws-btn" href={d.vi?"/vi/hrm/people/new":"/hrm/people/new"}>{d.vi?"Tạo hồ sơ":"Create employee"}</a>}
  <ListToolbar slot="tools" vi={d.vi} q={d.query} placeholder={d.vi?"Tìm theo tên hoặc mã nhân viên":"Search name or employee code"} />
  {d.people.length?<DataTable vi={d.vi} label={d.vi?"Nhân sự":"People"} frozen={1} widths={["16rem"]} frozenNames={d.vi?"Nhân viên":"Employee"} minWidth="44rem">
    <thead><tr><th scope="col">{d.vi?"Nhân viên":"Employee"}</th><th scope="col">{d.vi?"Bộ phận / vị trí":"Department / role"}</th><th scope="col">{d.vi?"Trạng thái":"Status"}</th><th scope="col">{d.vi?"Bắt đầu":"Start"}</th></tr></thead>
    <tbody>{d.people.map(person=><tr><th scope="row"><a href={`${d.vi?"/vi":""}/hrm/people/${encodeURIComponent(person.id)}`}><strong>{person.preferred_name||person.legal_name}</strong></a><br/><span class="crm-meta">{person.employee_code}</span></th><td>{person.department||"—"}<br/><span class="crm-meta">{person.job_title||"—"}</span></td><td>{person.status}</td><td>{date(person.started_on)}</td></tr>)}</tbody>
  </DataTable>:<section class="crm-sheet"><p class="crm-empty">{d.vi?"Không tìm thấy hồ sơ trong phạm vi được phép.":"No people found within your permitted scope."}</p></section>}
  {(d.page>1||d.hasMore)&&<nav class="crm-actions" aria-label={d.vi?"Phân trang":"Pagination"}>{d.page>1&&<a class="ws-btn" href={`?q=${encodeURIComponent(d.query)}&page=${d.page-1}`}>{d.vi?"Trước":"Previous"}</a>}{d.hasMore&&<a class="ws-btn" href={`?q=${encodeURIComponent(d.query)}&page=${d.page+1}`}>{d.vi?"Tiếp":"Next"}</a>}</nav>}
</HrmPage>
