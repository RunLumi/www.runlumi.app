---
import HrmPage from "./HrmPage.astro";
import type { LegalConsole } from "../../lib/hrm/legal-pages";
const d=Astro.props as LegalConsole;const vi=d.vi;
const typeLabel=(value:string)=>({policy:vi?"Chính sách":"Policy",nda:"NDA",employment_contract:vi?"Hợp đồng lao động":"Employment contract",contract_addendum:vi?"Phụ lục hợp đồng":"Contract addendum",code_of_conduct:vi?"Quy tắc ứng xử":"Code of conduct",privacy:vi?"Quyền riêng tư":"Privacy",equipment:vi?"Thiết bị":"Equipment",handover:vi?"Bàn giao":"Handover",other:vi?"Khác":"Other"}[value]||value);
const stateLabel=(value:string)=>({draft:vi?"Bản nháp":"Draft",reviewed:vi?"Đã rà soát":"Reviewed",active:vi?"Đang áp dụng":"Active",retired:vi?"Đã ngừng":"Retired",rejected:vi?"Bị từ chối":"Rejected",issued:vi?"Đã phát hành":"Issued",viewed:vi?"Đã xem":"Viewed",awaiting_action:vi?"Chờ xác nhận":"Awaiting action",completed:vi?"Hoàn tất":"Completed",cancelled:vi?"Đã hủy":"Cancelled",superseded:vi?"Được thay thế":"Superseded"}[value]||value);
const shortHash=(value:string)=>`${value.slice(0,12)}…${value.slice(-8)}`;
---
<HrmPage data={d} current="legal-documents">
 <p class="crm-meta">{vi?"Tài liệu phát hành giữ snapshot phiên bản và checksum. Bản DOCX không được chuyển thành HTML; xác nhận đã đọc không phải chữ ký điện tử.":"Issued documents keep an immutable version/checksum snapshot. DOCX source is never rendered as HTML; read acknowledgement is not an electronic signature."}</p>
 {d.saved&&<div class="crm-notice good" role="status">{({template:vi?"Đã tạo mẫu.":"Template created.",version:vi?"Đã tạo phiên bản nháp.":"Draft version created.",reviewed:vi?"Đã rà soát phiên bản.":"Version reviewed.",rejected:vi?"Đã từ chối phiên bản.":"Version rejected.",activated:vi?"Đã kích hoạt phiên bản.":"Version activated.",issued:vi?"Đã phát hành cho nhân viên.":"Document issued.",retired:vi?"Đã ngừng mẫu.":"Template retired."} as Record<string,string>)[d.saved]||d.saved}</div>}
 {Astro.url.searchParams.has("file")&&<div class="crm-notice good" role="status">{vi?"Đã nhận tệp; tệp đang chờ rà soát.":"File received and awaiting review."}</div>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo mẫu tài liệu":"Create a document template"}</h2><form method="post" class="crm-form"><input type="hidden" name="intent" value="create_template"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid">
  <div class="crm-field"><label for="document_key">{vi?"Mã mẫu":"Template key"}</label><input class="crm-input" id="document_key" name="document_key" pattern="[a-z0-9][a-z0-9_-]{2,79}" required maxlength="80"/></div>
  <div class="crm-field"><label for="document_type">{vi?"Loại tài liệu":"Document type"}</label><select class="crm-select" id="document_type" name="document_type">{["policy","nda","employment_contract","contract_addendum","code_of_conduct","privacy","equipment","handover","other"].map(type=><option value={type}>{typeLabel(type)}</option>)}</select></div>
  <div class="crm-field"><label for="title_en">Title — English</label><input class="crm-input" id="title_en" name="title_en" required maxlength="200"/></div>
  <div class="crm-field"><label for="title_vi">Tiêu đề — Tiếng Việt</label><input class="crm-input" id="title_vi" name="title_vi" required maxlength="200"/></div>
 </div><button class="crm-button" type="submit">{vi?"Tạo mẫu":"Create template"}</button></form></section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Mẫu và phiên bản":"Templates and versions"}</h2>
  {d.templates.length===0&&<p class="crm-meta">{vi?"Chưa có mẫu tài liệu.":"No document templates yet."}</p>}
  {d.templates.map(template=><article class="crm-row"><div><strong>{vi?template.title_vi:template.title_en}</strong><p class="crm-meta">{template.document_key} · {typeLabel(template.document_type)} · {stateLabel(template.state)}{template.latest_version?` · v${template.latest_version}`:""}</p></div><a class="crm-button secondary small" href={`${vi?"/vi":""}/hrm/documents?selected=${encodeURIComponent(template.id)}`}>{vi?"Mở":"Open"}</a></article>)}
 </section>

 {d.selectedTemplate&&<>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Nạp bản nguồn DOCX":"Upload DOCX source"}</h2><p class="crm-help">{vi?"Tối đa 5 MB. DOCX chỉ được lưu riêng tư; nguồn cần được người khác rà soát trước khi tạo phiên bản.":"Up to 5 MB. DOCX stays private; another authorized reviewer must review the source before a version can be created."}</p><form method="post" action="/api/hrm/legal/files/upload" enctype="multipart/form-data" class="crm-form"><input type="hidden" name="kind" value="docx_source"/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${vi?"/vi":""}/hrm/documents?selected=${encodeURIComponent(d.selectedTemplate)}`}/><div class="crm-field"><label for="policy-docx">{vi?"Tệp chính sách/mẫu DOCX":"Policy/template DOCX"}</label><input class="crm-input" id="policy-docx" type="file" name="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required/></div><button class="crm-button secondary" type="submit">{vi?"Tải DOCX lên":"Upload DOCX"}</button></form>
   <h3 class="crm-h2">{vi?"Tệp DOCX đã nạp":"Uploaded DOCX sources"}</h3><div class="crm-list">{d.files.filter(file=>file.template_id===d.selectedTemplate).map(file=><article class="crm-row"><div><strong>{file.original_name}</strong><span class="crm-meta">{stateLabel(file.state)} · {Math.ceil(file.size_bytes/1024)} KB · SHA-256 {shortHash(file.checksum)}</span></div>{file.state==="quarantined"&&d.user.can("hrm.legal.review")&&<form method="post" action={`/api/hrm/legal/files/${encodeURIComponent(file.id)}`} class="crm-actions"><input type="hidden" name="intent" value="review"/><input type="hidden" name="decision" value="reviewed"/><input type="hidden" name="version" value={file.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${vi?"/vi":""}/hrm/documents?selected=${encodeURIComponent(d.selectedTemplate)}`}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" type="submit">{vi?"Đã rà soát":"Reviewed"}</button></form>}</article>)}</div>
  </section>

  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo phiên bản":"Create a version"}</h2><p class="crm-help">{vi?"Chỉ dùng DOCX đã được người khác rà soát. Phiên bản phát hành không bị sửa khi tạo bản mới.":"Select a DOCX reviewed by a different person. Issued snapshots are not rewritten when you create a new version."}</p><form method="post" class="crm-form"><input type="hidden" name="intent" value="create_version"/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid">
   <div class="crm-field"><label for="source_file_id">{vi?"Nguồn DOCX đã rà soát":"Reviewed DOCX source"}</label><select class="crm-select" id="source_file_id" name="source_file_id" required><option value="">{vi?"Chọn tệp":"Choose a file"}</option>{d.files.filter(file=>file.template_id===d.selectedTemplate&&file.state==="reviewed").map(file=><option value={file.id}>{file.original_name} · {shortHash(file.checksum)}</option>)}</select></div>
   <div class="crm-field"><label for="language">{vi?"Ngôn ngữ":"Language"}</label><select class="crm-select" id="language" name="language"><option value="bilingual">{vi?"Song ngữ":"Bilingual"}</option><option value="en">English</option><option value="vi">Tiếng Việt</option></select></div>
   <div class="crm-field"><label for="legal_entity">{vi?"Pháp nhân áp dụng":"Applicable legal entity"}</label><input class="crm-input" id="legal_entity" name="legal_entity" value={d.legalEntity} required maxlength="200"/></div>
   <div class="crm-field"><label for="purpose">{vi?"Mục đích/ghi chú áp dụng":"Purpose/application note"}</label><input class="crm-input" id="purpose" name="purpose" required maxlength="1000"/></div>
   <div class="crm-field"><label for="effective_on">{vi?"Ngày hiệu lực":"Effective date"}</label><input class="crm-input" id="effective_on" name="effective_on" type="date"/></div>
   <div class="crm-field"><label for="due_days">{vi?"Số ngày đến hạn":"Days until due"}</label><input class="crm-input" id="due_days" name="due_days" type="number" min="0" max="3650" value="30" required/></div>
   <div class="crm-field"><label for="signing_mode">{vi?"Phương thức":"Method"}</label><select class="crm-select" id="signing_mode" name="signing_mode"><option value="acknowledgement">{vi?"Xác nhận đã đọc":"Read acknowledgement"}</option><option value="paper_scan">{vi?"Ký giấy và nộp bản scan":"Paper signing and scan"}</option></select></div>
   <div class="crm-field"><label for="company_party_name">{vi?"Bên đại diện công ty khi ký giấy":"Company representative label for paper signing"}</label><input class="crm-input" id="company_party_name" name="company_party_name" maxlength="160" value={vi?"Đại diện công ty":"Company representative"}/></div>
  </div><fieldset class="crm-field"><legend>{vi?"Đối tượng theo trạng thái đợt làm việc":"Audience by employment status"}</legend><div class="crm-form-grid">{["preboarding","probation","active","notice"].map(status=><label class="crm-check"><input type="checkbox" name="audience_status" value={status} checked/> {status}</label>)}</div></fieldset><label class="crm-check"><input type="checkbox" name="requires_ack" value="1" checked/> {vi?"Yêu cầu nhân viên xác nhận đã đọc":"Require employee acknowledgement"}</label><button class="crm-button" type="submit">{vi?"Tạo bản nháp":"Create draft version"}</button></form>
   <div class="crm-list">{d.versions.map(version=><article class="crm-row"><div><strong>v{version.version_number} · {stateLabel(version.state)}</strong><span class="crm-meta">{version.legal_entity} · {version.language} · SHA-256 {shortHash(version.source_checksum)} · {version.source_name} ({stateLabel(version.source_state)})</span><p class="crm-meta">{version.purpose}</p></div><div class="crm-actions">{version.state==="draft"&&d.user.can("hrm.legal.review")&&<form method="post" class="crm-actions"><input type="hidden" name="intent" value="review_version"/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="version_id" value={version.id}/><input type="hidden" name="version" value={version.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" required maxlength="500" aria-label={vi?"Lý do rà soát":"Review reason"}/><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt":"Review"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}{version.state==="reviewed"&&d.user.can("hrm.legal.activate")&&<form method="post"><input type="hidden" name="intent" value="activate_version"/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="version_id" value={version.id}/><input type="hidden" name="version" value={version.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Kích hoạt":"Activate"}</button></form>}</div></article>)}</div>
  </section>

  {d.templates.find(template=>template.id===d.selectedTemplate)?.state==="active"&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Phát hành cho nhân viên":"Issue to an employee"}</h2>{!d.live&&<p class="crm-notice bad">{vi?"HRM đang đóng. Có thể chuẩn bị mẫu, chưa thể phát hành.":"HRM is closed. You may prepare templates, but cannot issue them."}</p>}<form method="post" class="crm-form"><input type="hidden" name="intent" value="issue"/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-field"><label for="person_id">{vi?"Nhân viên":"Employee"}</label><select class="crm-select" id="person_id" name="person_id" required><option value="">{vi?"Chọn nhân viên":"Choose an employee"}</option>{d.people.map(person=><option value={person.id}>{person.employee_code} · {person.legal_name} · {person.status}</option>)}</select></div><button class="crm-button" type="submit" disabled={!d.live}>{vi?"Phát hành phiên bản hiện hành":"Issue current version"}</button></form></section>}
 </>}

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tình trạng tài liệu đã phát hành":"Issued documents"}</h2><div class="crm-list">{d.issues.map(issue=><article class="crm-row"><div><strong>{issue.employee_code} · {vi?issue.legal_name:issue.legal_name}</strong><span class="crm-meta">{vi?typeLabel(issue.document_type):typeLabel(issue.document_type)} · v{issue.version_number} · {stateLabel(issue.state)} · {issue.issued_at}</span></div><a class="crm-button secondary small" href={`${vi?"/vi":""}/hrm/documents/issues/${encodeURIComponent(issue.id)}`}>{vi?"Mở":"Open"}</a></article>)}{d.issues.length===0&&<p class="crm-meta">{vi?"Chưa phát hành tài liệu.":"No documents have been issued."}</p>}</div></section>
</HrmPage>
