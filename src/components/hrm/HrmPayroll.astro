---
import HrmCloseoutPolicies from "./HrmCloseoutPolicies.astro";
import HrmCompensation from "./HrmCompensation.astro";
import HrmPage from "./HrmPage.astro";
import { formatPayrollMoney } from "../../lib/hrm/payroll";
import HrmPayrollLineForm from "./HrmPayrollLineForm.astro";
import HrmPayrollPaymentHistory from "./HrmPayrollPaymentHistory.astro";
import type { PayrollComponent } from "../../lib/hrm/payroll";
import type { PayrollDeskPage } from "../../lib/hrm/payroll-pages";
const d = Astro.props as PayrollDeskPage;
const selectedRun = d.selectedRun as NonNullable<PayrollDeskPage["selectedRun"]>;
const selectedComponents = d.selectedRun ? JSON.parse(d.selectedRun.policy.components_json) as PayrollComponent[] : [];
const vi = d.vi, prefix = vi ? "/vi" : "";
const stateLabel = (state: string) => ({ draft: vi ? "Nháp" : "Draft", reviewed: vi ? "Đã rà soát" : "Reviewed", active: vi ? "Đang áp dụng" : "Active", rejected: vi ? "Từ chối" : "Rejected", retired: vi ? "Ngừng áp dụng" : "Retired", calculated: vi ? "Đã tính" : "Calculated", approved: vi ? "Đã duyệt" : "Approved", published: vi ? "Đã phát hành" : "Published", closed: vi ? "Đã đóng" : "Closed", submitted: vi ? "Đã gửi" : "Submitted", investigating: vi ? "Đang xử lý" : "Investigating", answered: vi ? "Đã trả lời" : "Answered", resolved: vi ? "Đã giải quyết" : "Resolved", reopened: vi ? "Đã mở lại" : "Reopened" }[state] ?? state);
const localDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString(vi ? "vi-VN" : "en-GB", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Ho_Chi_Minh" }) : "—";
const returnTo = (runId?: string) => `${prefix}/hrm/payroll${runId ? `?run=${encodeURIComponent(runId)}` : ""}`;
const slipData = (value: string) => JSON.parse(value) as { policy: { currency: string; minor_unit_scale: number }; period_key: string; employee_code: string; display_name: string; paid_carryover_minor?: number; lines: Array<{ component_code: string; title_en: string; title_vi: string; direction: string; amount_minor: number }>; gross_minor: number; deductions_minor: number; net_minor: number };
---
<HrmPage data={d}>
  {!d.live && <section class="crm-notice warn" role="status"><strong>{vi ? "Cấu hình payroll đang đóng" : "Payroll setup is closed"}</strong><p>{vi ? "Có thể tạo và rà soát bản nháp chính sách. Kỳ lương, phiếu lương, xác nhận thanh toán và dữ liệu nhân viên vẫn bị khóa cho tới khi owner phê duyệt chính sách và mở cổng production." : "Draft policies may be prepared and reviewed. Runs, payslips, payment confirmation and employee data stay locked until the owner approves policy and opens the production gate."}</p></section>}
  <section class="crm-notice" role="note"><strong>{vi ? "Phạm vi tính hiện tại" : "Current calculation boundary"}</strong><p>{vi ? "Hệ thống chỉ cộng các khoản tiền được nhập rõ ràng theo cấu phần đã cấu hình, bằng số nguyên theo đơn vị tiền đã chọn. Khoản employment_record phải khớp đúng phiên bản thu nhập đã duyệt bao trọn kỳ. Không có công thức thuế, bảo hiểm, OT, đổi ngoại tệ hay dữ liệu mặc định. Hoa hồng CRM chỉ được nhập từ bản chuyển đã được Tài chính xác nhận, đúng số tiền và chỉ một lần; thiếu đầu vào sẽ chặn tính. Tham chiếu chứng từ là thông tin do người nhập khai báo, chưa được hệ thống kiểm tra tệp hoặc đối soát ngân hàng. Cần chạy song song và rà soát chuyên môn trước khi dùng thật." : "The system only sums explicitly entered component amounts as exact integers in the configured currency scale. Employment_record lines must match the approved compensation version covering the whole period. It has no tax, insurance, overtime or FX formula and no default pay inputs. CRM commission enters only from a Finance-confirmed handoff, at its exact amount and once. Missing required inputs block calculation. Evidence references are operator-entered; files and bank records are not verified by this workflow. An independently checked parallel run is still required before real use."}</p></section>

  {d.user.can("hrm.payroll.configure") && <section class="crm-sheet">
    <p class="crm-eyebrow">{vi ? "Cấu hình" : "Configuration"}</p><h2 class="crm-h2">{vi ? "Phiên bản chính sách payroll" : "Payroll policy versions"}</h2>
    <p class="crm-help">{vi ? "Mỗi phiên bản là bất biến. Chỉ khai báo cấu phần, loại tiền, độ chính xác và nguồn dữ liệu; không nhập công thức thực thi. Pháp nhân phải khớp HRM → Thiết lập." : "Each version is immutable. Declare components, currency, precision and source only; executable formulas are not accepted. The entity must match HRM Settings."}</p>
    {d.policies.length === 0 ? <p class="crm-empty">{vi ? "Chưa có phiên bản chính sách." : "No payroll policy versions yet."}</p> : <div class="crm-list">{d.policies.map(policy => <article class="crm-row"><div class="crm-onboarding-copy"><strong>{vi ? policy.title_vi : policy.title_en} · v{policy.revision}</strong><span class="crm-meta">{policy.policy_key} · {policy.legal_entity} · {policy.currency} · {vi ? "độ chính xác" : "scale"} {policy.minor_unit_scale} · {stateLabel(policy.state)}</span><span class="crm-meta">{vi ? "Người tạo" : "Created by"} {policy.created_by} · {localDate(policy.created_at)}{policy.reviewed_by ? ` · ${vi ? "Rà soát" : "Reviewed by"} ${policy.reviewed_by}` : ""}</span><p>{JSON.parse(policy.components_json).map((component: { code: string; direction: string; required: boolean }) => `${component.code} · ${component.direction}${component.required ? " · required" : ""}`).join("; ")}</p></div><div class="crm-actions">
      {policy.state === "draft" && d.user.can("hrm.payroll.review") && policy.created_by !== d.user.id && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="review_policy"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><label class="crm-field"><span>{vi ? "Lý do rà soát" : "Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi ? "Rà soát đạt" : "Review"}</button><button class="crm-button danger small" name="decision" value="reject">{vi ? "Từ chối" : "Reject"}</button></form>}
      {policy.state === "reviewed" && d.live && d.user.can("hrm.payroll.approve") && policy.created_by !== d.user.id && <form method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="activate_policy"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><button class="crm-button small">{vi ? "Kích hoạt" : "Activate"}</button></form>}
    </div></article>)}</div>}
    {d.user.can("hrm.payroll.configure") && <details class="crm-disclosure"><summary>{vi ? "Tạo phiên bản chính sách nháp" : "Create a draft policy version"}</summary><form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><label class="crm-field"><span>{vi ? "Mã chính sách" : "Policy key"}</span><input class="crm-input" name="policy_key" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,59}" maxlength="60" required/></label><label class="crm-field"><span>{vi ? "Tên tiếng Anh" : "English title"}</span><input class="crm-input" name="title_en" maxlength="100" required/></label><label class="crm-field"><span>{vi ? "Tên tiếng Việt" : "Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="100" required/></label><label class="crm-field"><span>{vi ? "Pháp nhân HRM" : "HRM legal entity"}</span><input class="crm-input" name="legal_entity" maxlength="200" required/></label><label class="crm-field"><span>{vi ? "Loại tiền" : "Currency"}</span><input class="crm-input" name="currency" pattern="[A-Za-z]{3}" maxlength="3" required/></label><label class="crm-field"><span>{vi ? "Số chữ số sau dấu thập phân" : "Minor-unit scale"}</span><select class="crm-input" name="minor_unit_scale" required><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label><label class="crm-field wide"><span>{vi ? "Cấu phần JSON" : "Component JSON"}</span><textarea class="crm-textarea" name="components_json" maxlength="48000" required rows="6" placeholder='[{"code":"base","title_en":"Base pay","title_vi":"Lương cơ bản","direction":"earning","required":true,"source_kind":"employment_record"}]'></textarea></label></div><p class="crm-help">{vi ? "Nguồn: employment_record, locked_time, approved_adjustment, manual_evidence hoặc crm_commission (chỉ VND, kỳ trong một tháng). Số 0 cần lý do riêng. Mẫu trong placeholder chỉ minh họa cú pháp, không phải cấu hình được lưu." : "Sources: employment_record, locked_time, approved_adjustment, manual_evidence or crm_commission (VND only, single-month runs). Zero requires a separate reason. The placeholder is syntax guidance only; it is not saved configuration."}</p><button class="crm-button secondary">{vi ? "Lưu bản nháp" : "Save draft"}</button></form></details>}
  </section>}

  {d.live && d.user.can("hrm.compensation.read") && <HrmCompensation data={d}/>}
  {d.user.can("hrm.payroll.configure")&&d.user.can("hrm.offboarding.manage")&&<HrmCloseoutPolicies data={d}/>}
  {d.live && d.user.can("hrm.payroll.prepare") && <section class="crm-sheet"><p class="crm-eyebrow">{vi ? "Chuẩn bị" : "Preparation"}</p><h2 class="crm-h2">{vi ? "Tạo kỳ lương từ công đã khóa" : "Create a run from locked attendance"}</h2>{d.periods.length === 0 || !d.policies.some(policy => policy.state === "active") ? <p class="crm-empty">{vi ? "Cần chính sách active và kỳ công đã khóa. Không có giá trị mặc định." : "An active policy and a locked time period are required. No default values are supplied."}</p> : <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="create_run"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><label class="crm-field"><span>{vi ? "Chính sách" : "Policy"}</span><select class="crm-input" name="policy_version_id" required>{d.policies.filter(policy => policy.state === "active").map(policy => <option value={policy.id}>{vi ? policy.title_vi : policy.title_en} · v{policy.revision} · {policy.currency}</option>)}</select></label><label class="crm-field"><span>{vi ? "Kỳ công đã khóa" : "Locked attendance period"}</span><select class="crm-input" name="period_id" required>{d.periods.map(period => <option value={period.id}>{period.period_key} · {period.starts_on}—{period.ends_on}</option>)}</select></label></div><button class="crm-button">{vi ? "Tạo kỳ nháp" : "Create draft run"}</button></form>}
    {d.periods.length > 0 && d.policies.some(policy => policy.state === "active") && <details class="crm-disclosure"><summary>{vi ? "Kỳ lương cuối cho nhân viên đã nghỉ" : "Final pay for an ended employment"}</summary><form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="create_final_run"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><label class="crm-field"><span>{vi ? "Chính sách" : "Policy"}</span><select class="crm-input" name="policy_version_id" required>{d.policies.filter(policy => policy.state === "active").map(policy => <option value={policy.id}>{vi ? policy.title_vi : policy.title_en} · v{policy.revision} · {policy.currency}</option>)}</select></label><label class="crm-field"><span>{vi ? "Kỳ công đã khóa" : "Locked attendance period"}</span><select class="crm-input" name="period_id" required>{d.periods.map(period => <option value={period.id}>{period.period_key} · {period.starts_on}—{period.ends_on}</option>)}</select></label><label class="crm-field"><span>{vi ? "Mã nhân viên" : "Employee code"}</span><input class="crm-input" name="employee_code" maxlength="60" required/></label><label class="crm-field"><span>{vi ? "Mã đợt làm việc (tùy chọn)" : "Employment period ID (optional)"}</span><input class="crm-input" name="employment_id" maxlength="100"/></label><label class="crm-field wide"><span>{vi ? "Lý do" : "Reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label></div><p class="crm-help">{vi ? "Chỉ cho đợt làm việc đã kết thúc và có ngày làm việc trong kỳ, khi chưa có phiếu hay kỳ nháp nào khác cho người đó trong kỳ. Kỳ cuối vẫn cần thu nhập đã duyệt, công đã khóa và duyệt độc lập; không mở lại quyền truy cập của nhân viên." : "Only for an ended employment that worked in the period, when no payslip or other draft run covers that person for the period. A final run still needs approved compensation, locked time and independent approval, and does not restore the employee's access."}</p><button class="crm-button secondary">{vi ? "Tạo kỳ lương cuối" : "Create final pay run"}</button></form></details>}</section>}

  {d.user.can("hrm.payroll.read") && <section class="crm-sheet"><h2 class="crm-h2">{vi ? "Các kỳ payroll" : "Payroll runs"}</h2>{d.runs.length === 0 ? <p class="crm-empty">{vi ? "Chưa có kỳ payroll." : "No payroll runs yet."}</p> : <div class="crm-list">{d.runs.map(run => <article class="crm-row"><div><strong>{run.period_key} · {stateLabel(run.state)}{run.final_employment_id && ` · ${vi ? "Kỳ lương cuối" : "Final pay"}`}</strong><p class="crm-meta">{run.employee_count} {vi ? "nhân viên" : "employees"} · {run.starts_on}—{run.ends_on} · v{run.version}</p></div><a class="crm-button secondary small" href={`${prefix}/hrm/payroll?run=${encodeURIComponent(run.id)}`}>{vi ? "Mở kỳ" : "Open run"}</a></article>)}</div>}</section>}

  {d.selectedRun && <section class="crm-sheet"><p class="crm-eyebrow">{selectedRun.run.period_key} · {stateLabel(selectedRun.run.state)} · v{selectedRun.run.version}</p><h2 class="crm-h2">{vi ? "Chi tiết kỳ lương" : "Run details"}</h2><p class="crm-meta">{selectedRun.policy.legal_entity} · {selectedRun.policy.currency} · {selectedRun.run.snapshot_checksum ? <>SHA-256 <code>{selectedRun.run.snapshot_checksum}</code></> : (vi ? "Chưa có snapshot" : "No snapshot yet")}</p>
    {selectedRun.run.adjustment_of_payslip_id && <p class="crm-notice warn">{vi ? "Đây là bản điều chỉnh liên kết; phiếu đã phát hành trước đó vẫn được giữ nguyên." : "This is a linked correction; the previously issued payslip remains preserved."} <code>{selectedRun.run.adjustment_of_payslip_id}</code></p>}
    {!['published', 'closed'].includes(selectedRun.run.state) && d.user.can("hrm.payroll.prepare") && <><p class="crm-help">{vi ? "Nhập từng khoản từ nguồn được ghi lại. Chưa có công thức thuế, bảo hiểm, OT hay tỷ giá; mọi khoản phải được rà soát độc lập." : "Enter each line from its recorded source. Tax, insurance, overtime and FX formulas are not configured; every value still needs independent review."}</p><div class="crm-list">{selectedRun.people.map(person => <article class="crm-row"><div class="crm-onboarding-copy"><strong>{person.employee_code_snapshot} · {person.display_name_snapshot}</strong>{person.employment_status === "ended" && !selectedRun.run.final_employment_id && !selectedRun.run.adjustment_of_payslip_id && <><span class="crm-notice warn" role="note">{vi ? "Đợt làm việc này đã kết thúc. Kỳ thường không phát hành được cho người đã nghỉ; hãy chuyển người này sang kỳ lương cuối." : "This employment has ended. A regular run cannot publish pay for ended staff; move this person to a final pay run."}</span><form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="remove_run_person"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="person_id" value={person.person_id}/><input type="hidden" name="version" value={selectedRun.run.version}/><label class="crm-field"><span>{vi ? "Lý do" : "Reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi ? "Gỡ khỏi kỳ thường" : "Remove from regular run"}</button></form></>}{person.gross_minor !== null && <span class="crm-meta">{vi ? "Thu nhập" : "Gross"}: {formatPayrollMoney(person.gross_minor,selectedRun.policy.currency,selectedRun.policy.minor_unit_scale,vi?"vi":"en")} · {vi ? "Khấu trừ" : "Deductions"}: {formatPayrollMoney(person.deductions_minor??0,selectedRun.policy.currency,selectedRun.policy.minor_unit_scale,vi?"vi":"en")} · {vi ? "Thực nhận" : "Net"}: {formatPayrollMoney(person.net_minor??0,selectedRun.policy.currency,selectedRun.policy.minor_unit_scale,vi?"vi":"en")}</span>}</div><div class="crm-grid cols">{selectedComponents.map(component => <HrmPayrollLineForm run={selectedRun.run} person={person} component={component} coverage={(d.coverage ?? {})[`${person.id}:${component.code}`]} commission={(d.commission ?? {})[person.id]} returnTo={returnTo(selectedRun.run.id)} vi={vi}/>)}</div></article>)}</div></>}
    {d.live && <div class="crm-actions">{selectedRun.run.state === "draft" && d.user.can("hrm.payroll.prepare") && <form method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="calculate_run"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="version" value={selectedRun.run.version}/><button class="crm-button">{vi ? "Kiểm tra và tính tổng chính xác" : "Validate and calculate exact totals"}</button></form>}
      {selectedRun.run.state === "calculated" && d.user.can("hrm.payroll.review") && selectedRun.run.created_by !== d.user.id && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="review_run"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="version" value={selectedRun.run.version}/><label class="crm-field"><span>{vi ? "Kết quả rà soát" : "Review result"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary">{vi ? "Rà soát" : "Review"}</button></form>}
      {selectedRun.run.state === "reviewed" && d.user.can("hrm.payroll.approve") && selectedRun.run.created_by !== d.user.id && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="approve_run"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="version" value={selectedRun.run.version}/><label class="crm-field"><span>{vi ? "Lý do phê duyệt" : "Approval reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button">{vi ? "Phê duyệt" : "Approve"}</button></form>}
      {selectedRun.run.state === "approved" && d.user.can("hrm.payroll.publish") && <form method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="publish_run"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="version" value={selectedRun.run.version}/><button class="crm-button danger">{vi ? "Phát hành phiếu lương" : "Publish payslips"}</button></form>}
      {selectedRun.run.state === "published" && d.user.can("hrm.payroll.approve") && d.runSettled && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="close_run"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="run_id" value={selectedRun.run.id}/><input type="hidden" name="version" value={selectedRun.run.version}/><label class="crm-field"><span>{vi ? "Lý do đóng kỳ" : "Close reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary">{vi ? "Đóng kỳ đã đối soát" : "Close reconciled run"}</button></form>}</div>}
    {d.slips.length > 0 && <><h3 class="crm-h3">{vi ? "Phiếu đã phát hành" : "Published payslips"}</h3><div class="crm-list">{d.slips.map(slip => { const snap = slipData(slip.snapshot_json), outstanding = snap.net_minor-slip.paid_minor; return <article class="crm-row"><div><strong>{snap.employee_code} · {snap.display_name} · {stateLabel(slip.state)}</strong><p>{vi ? "Thực nhận" : "Net"}: {formatPayrollMoney(snap.net_minor,snap.policy.currency,snap.policy.minor_unit_scale,vi?"vi":"en")} · {vi ? "Đã xác nhận" : "Confirmed"}: {formatPayrollMoney(slip.paid_minor,snap.policy.currency,snap.policy.minor_unit_scale,vi?"vi":"en")} · {vi ? "Còn lại" : "Outstanding"}: {formatPayrollMoney(Math.max(0,outstanding),snap.policy.currency,snap.policy.minor_unit_scale,vi?"vi":"en")}</p><a href={`/api/hrm/payslips/${encodeURIComponent(slip.id)}?lang=${vi?"vi":"en"}`}>{vi ? "Tải bản HTML riêng tư" : "Download private HTML copy"}</a></div><div class="crm-actions">{d.user.can("hrm.payroll.prepare") && d.live && slip.state === "published" && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="create_correction"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="payslip_id" value={slip.id}/><input type="hidden" name="policy_version_id" value={selectedRun.policy.id}/><input type="hidden" name="period_id" value={selectedRun.run.period_id}/><label class="crm-field"><span>{vi ? "Lý do điều chỉnh" : "Correction reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi ? "Tạo bản điều chỉnh" : "Create correction"}</button></form>}{d.live && d.user.can("hrm.payroll.payment.confirm") && slip.state === "published" && outstanding > 0 && <form class="crm-form" method="post" action="/api/hrm/payroll"><h3 class="crm-h3">{vi ? "Ghi nhận thanh toán đã đối soát" : "Record reconciled payment"}</h3><input type="hidden" name="intent" value="confirm_payment"/><input type="hidden" name="return_to" value={returnTo(selectedRun.run.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="payslip_id" value={slip.id}/><label class="crm-field"><span>{vi ? "Số tiền theo đơn vị nhỏ nhất" : "Amount in minor units"}</span><input class="crm-input" type="number" name="amount_minor" min="1" max={outstanding} step="1" required/></label><label class="crm-field"><span>{vi ? "Ngày giao dịch" : "Payment date"}</span><input class="crm-input" type="date" name="paid_on" required/></label><label class="crm-field"><span>{vi ? "Mã tham chiếu thanh toán" : "Payment reference"}</span><input class="crm-input" name="payment_reference" maxlength="200" required/></label><label class="crm-field"><span>{vi ? "Tham chiếu chứng từ đối soát" : "Reconciliation evidence reference"}</span><input class="crm-input" name="evidence_reference" maxlength="200" required/></label><button class="crm-button secondary small">{vi ? "Xác nhận khoản đã trả" : "Confirm payment"}</button></form>}<HrmPayrollPaymentHistory payments={d.payments.filter(payment=>payment.payslip_id===slip.id)} carryoverMinor={snap.paid_carryover_minor??0} currency={snap.policy.currency} scale={snap.policy.minor_unit_scale} vi={vi}/></div></article>})}</div></>}
  </section>}

  {d.live && (d.refundNotices ?? []).length > 0 && <section class="crm-sheet" aria-labelledby="refund-notices-h"><h2 class="crm-h2" id="refund-notices-h">{vi ? "Báo hoàn tiền từ CRM" : "CRM refund notices"}</h2><p class="crm-help">{vi ? "Khách được hoàn tiền sau khi hoa hồng đã chuyển sang payroll. Phiếu đã phát hành không đổi và hệ thống không tự trừ lương; quyết định thu hồi qua bản điều chỉnh có rà soát hoặc thỏa thuận riêng." : "A customer was refunded after commission reached payroll. Issued payslips do not change and nothing is deducted automatically; decide any recovery through a reviewed correction or a separate agreement."}</p><div class="crm-list">{(d.refundNotices ?? []).map(notice => <article class="crm-row"><div class="payroll-inquiry"><strong>{notice.employee_code ?? (vi ? "Chưa rõ nhân viên" : "Employee unavailable")} · {notice.period} · {formatPayrollMoney(notice.amount_vnd,"VND",0,vi?"vi":"en")}</strong><p class="crm-meta">{notice.line_count} {vi ? "dòng" : "lines"} · {localDate(notice.recorded_at)} · {notice.on_current_payslip ? (vi ? "Có trên phiếu hiện hành" : "On a current payslip") : (vi ? "Chưa có trên phiếu hiện hành" : "Not on a current payslip")}</p><p>{notice.reason}</p><code>{notice.handoff_id}</code></div></article>)}</div></section>}
  {d.live && d.user.can("hrm.payroll.dispute.manage") && <section class="crm-sheet"><h2 class="crm-h2">{vi ? "Thắc mắc phiếu lương" : "Payslip inquiries"}</h2>{d.disputes.length === 0 ? <p class="crm-empty">{vi ? "Chưa có thắc mắc." : "No inquiries yet."}</p> : <div class="crm-list">{d.disputes.map(dispute => <article class="crm-row"><div class="payroll-inquiry"><strong>{stateLabel(dispute.state)} · {dispute.component_code ?? (vi ? "Toàn phiếu" : "Whole payslip")}</strong><p class="crm-meta">{dispute.employee_code??"—"} · {dispute.display_name_snapshot??(vi?"Chưa rõ nhân viên":"Employee unavailable")} · {localDate(dispute.updated_at)}</p><a href={`${prefix}/hrm/payroll?dispute=${encodeURIComponent(dispute.id)}`}>{vi ? "Xem trao đổi" : "View conversation"}</a>{d.selectedDispute && Astro.url.searchParams.get("dispute") === dispute.id && <ol>{d.selectedDispute.map(event => <li><strong>{stateLabel(event.event_type)}</strong> · {event.body} · {event.actor_id} · {localDate(event.created_at)}</li>)}</ol>}</div><div class="crm-actions">{["submitted", "reopened"].includes(dispute.state) && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="transition_dispute"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="dispute_id" value={dispute.id}/><input type="hidden" name="version" value={dispute.version}/><input type="hidden" name="next_state" value="investigating"/><label class="crm-field"><span>{vi ? "Ghi chú xử lý" : "Investigation note"}</span><textarea class="crm-textarea" name="body" maxlength="2000" required/></label><button class="crm-button small">{vi ? "Bắt đầu xử lý" : "Investigate"}</button></form>}{dispute.state === "investigating" && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="transition_dispute"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="dispute_id" value={dispute.id}/><input type="hidden" name="version" value={dispute.version}/><label class="crm-field"><span>{vi ? "Trả lời" : "Answer"}</span><textarea class="crm-textarea" name="body" maxlength="2000" required/></label><button class="crm-button secondary small" name="next_state" value="answered">{vi ? "Trả lời" : "Answer"}</button><button class="crm-button small" name="next_state" value="resolved">{vi ? "Giải quyết" : "Resolve"}</button></form>}{dispute.state === "answered" && <form class="crm-form" method="post" action="/api/hrm/payroll"><input type="hidden" name="intent" value="transition_dispute"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="dispute_id" value={dispute.id}/><input type="hidden" name="version" value={dispute.version}/><input type="hidden" name="next_state" value="resolved"/><label class="crm-field"><span>{vi ? "Ghi chú đóng" : "Resolution note"}</span><textarea class="crm-textarea" name="body" maxlength="2000" required/></label><button class="crm-button small">{vi ? "Đóng thắc mắc" : "Resolve"}</button></form>}</div></article>)}</div>}</section>}
</HrmPage>

<style>.payroll-inquiry{min-width:0;overflow-wrap:anywhere}</style>
