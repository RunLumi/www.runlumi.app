---
import HrmPage from "./HrmPage.astro";
import type { LegalIssuePageData } from "../../lib/hrm/legal-pages";
const d=Astro.props as LegalIssuePageData;const vi=d.vi;
const dateTime=(value:string)=>new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"});
const issueState=(value:string)=>({issued:vi?"Đã phát hành":"Issued",viewed:vi?"Đã xem":"Viewed",awaiting_action:vi?"Chờ thao tác":"Awaiting action",completed:vi?"Hoàn tất":"Completed",declined:vi?"Đã từ chối":"Declined",expired:vi?"Đã hết hạn":"Expired",cancelled:vi?"Đã hủy":"Cancelled",superseded:vi?"Được thay thế":"Superseded"}[value]||value);
const fileState=(value:string,deleted=false)=>deleted?(vi?"Đã xóa theo chính sách lưu trữ":"Deleted under retention policy"):({quarantined:vi?"Chờ rà soát":"Awaiting review",reviewed:vi?"Đã rà soát":"Reviewed",rejected:vi?"Bị từ chối":"Rejected"}[value]||value);
const back=vi?(d.legalManager?"/vi/hrm/documents":"/vi/hrm/me/documents"):(d.legalManager?"/hrm/documents":"/hrm/me/documents");
---
<HrmPage data={d} current={d.legalManager?"legal-documents":"my-documents"}>
 <div class="crm-actions"><a class="crm-button secondary" href={back}>{vi?"← Tài liệu":"← Documents"}</a></div>
 {d.saved&&<div class="crm-notice good" role="status">{({acknowledged:vi?"Đã xác nhận đã đọc phiên bản này.":"Acknowledgement recorded for this version.",file_reviewed:vi?"Đã lưu kết quả rà soát tệp.":"File review saved.",paper_checked:vi?"Đã xác nhận bản ký giấy sau khi kiểm tra.":"Paper signature evidence was checked."} as Record<string,string>)[d.saved]||d.saved}</div>}
 <section class="crm-sheet"><p class="crm-eyebrow">{d.document_type} · v{d.version_number} · {issueState(d.state)}</p><h2 class="crm-h2">{vi?d.title_vi:d.title_en}</h2>
  <dl class="crm-facts"><div><dt>{vi?"Pháp nhân":"Legal entity"}</dt><dd>{d.snapshot_json&&JSON.parse(d.snapshot_json).legal_entity}</dd></div><div><dt>{vi?"Ngôn ngữ":"Language"}</dt><dd>{d.language}</dd></div><div><dt>{vi?"Phát hành":"Issued"}</dt><dd>{dateTime(d.issued_at)}</dd></div><div><dt>{vi?"Hạn xử lý":"Due"}</dt><dd>{d.due_at?dateTime(d.due_at):(vi?"Không đặt hạn":"No deadline")}</dd></div></dl>
  <p>{vi?"Checksum phiên bản đã phát hành":"Issued version checksum"}: <code>{d.source_checksum}</code></p>
  <a class="crm-button secondary" href={`/api/hrm/legal/files/${encodeURIComponent(d.source_file_id)}`}>{vi?"Tải DOCX nguồn":"Download DOCX source"}</a>
 </section>
 {d.acknowledged_at&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Lịch sử xác nhận":"Acknowledgement record"}</h2><p class="crm-notice good" role="status">{vi?`Đã xác nhận đã đọc lúc ${dateTime(d.acknowledged_at)}. Đây không phải chữ ký điện tử.`:`Acknowledged at ${dateTime(d.acknowledged_at)}. This is not an electronic signature.`}</p><p>{vi?"Phiên bản và checksum":"Version and checksum"}: v{d.version_number} · <code>{d.source_checksum}</code></p></section>}
 {d.requires_ack===1&&!d.acknowledged_at&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Xác nhận đã đọc":"Acknowledge reading"}</h2><p>{vi?"Chỉ xác nhận sau khi đã mở đúng tệp và kiểm tra phiên bản phía trên. Thao tác lưu thời gian máy chủ và checksum; không thay chữ ký hợp đồng hoặc chữ ký điện tử.":"Confirm only after opening this exact file and checking its version above. The action stores server time and checksum; it does not replace a contract or electronic signature."}</p><form method="post" class="crm-form"><input type="hidden" name="intent" value="acknowledge"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="checksum" value={d.source_checksum}/><label class="crm-check"><input type="checkbox" name="affirmed" value="1" required/> {vi?"Tôi đã đọc và xác nhận đúng phiên bản này.":"I have read and acknowledge this exact version."}</label><button class="crm-button" type="submit">{vi?"Ghi xác nhận":"Record acknowledgement"}</button></form></section>}
 {d.signing_mode==="paper_scan"&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Ký giấy và nộp bản quét":"Paper signing and scan evidence"}</h2><p>{vi?"Tải PDF đã ký lên chỉ tạo bằng chứng chờ rà soát. HR phải kiểm tra các bên bắt buộc; thao tác tải lên không tự hoàn tất tài liệu.":"Uploading a signed PDF creates evidence awaiting review. HR must verify the required parties; upload alone does not complete the document."}</p><div class="crm-list">{d.parties.map(party=><article class="crm-row"><span><strong>{party.display_name}</strong><br/><span class="crm-meta">{party.party_kind} · {party.required? (vi?"Bắt buộc":"Required"):(vi?"Tùy chọn":"Optional")} · {party.state}</span></span>{d.legalReviewer&&party.required&&party.state!=="paper_signed_verified"&&d.files.some(file=>file.kind==="pdf_evidence"&&file.state==="reviewed")&&<form method="post" class="crm-actions"><input type="hidden" name="intent" value="verify_party"/><input type="hidden" name="party_id" value={party.id}/><input type="hidden" name="version" value={party.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Tệp đã rà soát":"Reviewed PDF evidence"}</span><select class="crm-select" name="file_id" required>{d.files.filter(file=>file.kind==="pdf_evidence"&&file.state==="reviewed").map(file=><option value={file.id}>{file.original_name}</option>)}</select></label><label class="crm-field"><span>{vi?"Ngày ký khai báo (nếu có)":"Declared signing date (if known)"}</span><input class="crm-input" name="signed_on" type="date"/></label><label class="crm-field"><span>{vi?"Lý do kiểm tra":"Verification reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" type="submit">{vi?"Xác nhận đã kiểm tra":"Verify paper signature"}</button></form>}</article>)}</div></section>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tệp PDF bằng chứng":"PDF evidence files"}</h2><p>{vi?"Tệp được cách ly và rà soát thủ công; việc rà soát không phải quét virus.":"Files are quarantined for manual review; review is not an antivirus scan."}</p><div class="crm-list">{d.files.map(file=><article class="crm-row"><span><strong>{file.original_name}</strong><br/><span class="crm-meta">{fileState(file.state,!!file.object_deleted_at)} · {Math.ceil(file.size_bytes/1024)} KB · SHA-256 {file.checksum.slice(0,12)}…</span></span><span class="crm-actions">{!file.object_deleted_at&&(file.state==="reviewed"||file.uploaded_by===d.user.id||d.legalManager)&&<a class="crm-button secondary small" href={`/api/hrm/legal/files/${encodeURIComponent(file.id)}`}>{vi?"Tải xuống":"Download"}</a>}{!file.object_deleted_at&&file.state==="quarantined"&&d.legalReviewer&&<form method="post" action={`/api/hrm/legal/files/${encodeURIComponent(file.id)}`} class="crm-actions"><input type="hidden" name="intent" value="review"/><input type="hidden" name="decision" value="reviewed"/><input type="hidden" name="version" value={file.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${Astro.url.pathname}${Astro.url.search}`}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" type="submit">{vi?"Đã rà soát":"Reviewed"}</button></form>}</span></article>)}</div>
  {d.state!=="completed"&&<form method="post" action="/api/hrm/legal/files/upload" enctype="multipart/form-data" class="crm-form crm-upload"><input type="hidden" name="kind" value="pdf_evidence"/><input type="hidden" name="issue_id" value={d.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${Astro.url.pathname}${Astro.url.search}`}/><div class="crm-field"><label for="legal-evidence">{vi?"Tải PDF bằng chứng":"Upload PDF evidence"}</label><input class="crm-input" id="legal-evidence" name="file" type="file" accept="application/pdf,.pdf" required/></div><button class="crm-button secondary" type="submit">{vi?"Tải tệp PDF":"Upload PDF"}</button></form>}
 </section>
</HrmPage>
