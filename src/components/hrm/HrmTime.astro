---
import HrmPage from "./HrmPage.astro";
import type { MyTimePage, TimeManagePage } from "../../lib/hrm/time-pages";
type Data=MyTimePage|TimeManagePage;
const d=Astro.props as Data,vi=d.vi,prefix=vi?"/vi":"";
const date=(value:string)=>new Date(`${value}T00:00:00+07:00`).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
const local=(value:string,timezone?:string)=>new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"short",timeStyle:"short",timeZone:timezone||"Asia/Ho_Chi_Minh"});
const state=(value:string)=>({open:vi?"Đang mở":"Open",reviewing:vi?"Đang rà soát":"Reviewing",locked:vi?"Đã khóa":"Locked",reopened:vi?"Đã mở lại":"Reopened",reopen_requested:vi?"Chờ duyệt mở lại":"Reopen requested",submitted:vi?"Chờ duyệt":"Submitted",approved:vi?"Đã duyệt":"Approved",rejected:vi?"Cần chỉnh sửa":"Needs correction",pending_approval:vi?"Chờ duyệt OT":"OT approval pending",none:vi?"Không có OT":"No overtime",rejected_ot:vi?"OT bị từ chối":"Overtime rejected"}[value]||value);
const manage="calendars" in d,dayNumber=(value:string)=>{const day=new Date(`${value}T00:00:00Z`).getUTCDay();return day===0?7:day};
const workDate=Astro.url.searchParams.get("work_date")||("context" in d?d.context?.workDate:undefined)||new Date().toLocaleDateString("en-CA",{timeZone:"Asia/Ho_Chi_Minh"});
const myContext=!manage?d.context:undefined;
const activeDay=myContext?.weekdays.find(item=>item.weekday===dayNumber(workDate));
const redirectField=`${prefix}/hrm/time`;
---
<HrmPage data={d} current={manage?"time":"my-time"}>
 {manage? <>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Lịch làm việc có phiên bản":"Versioned work calendars"}</h2><p class="crm-help">{vi?"Không có tuần làm việc, ngày nghỉ hoặc ca mặc định. Mỗi phiên bản cần múi giờ, lịch bảy ngày và căn cứ OT; HRM Officer rà soát, HRM Admin/System Super Admin kích hoạt.":"No workweek, holiday or shift is assumed. Each version needs a timezone, seven-day schedule and overtime basis; an HRM Officer reviews and an HRM Admin/System Super Admin activates."}</p>
   {d.user.can("hrm.time.configure")&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="create_calendar"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-grid"><label class="crm-field"><span>{vi?"Mã lịch":"Calendar key"}</span><input class="crm-input" name="calendar_key" maxlength="80" required/></label><label class="crm-field"><span>{vi?"Pháp nhân":"Legal entity"}</span><input class="crm-input" name="legal_entity" maxlength="200" required/></label><label class="crm-field"><span>{vi?"Tên tiếng Anh":"English title"}</span><input class="crm-input" name="title_en" maxlength="200" required/></label><label class="crm-field"><span>{vi?"Tên tiếng Việt":"Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="200" required/></label><label class="crm-field"><span>{vi?"Múi giờ IANA":"IANA timezone"}</span><input class="crm-input" name="timezone" placeholder="Asia/Ho_Chi_Minh" required/></label></div><label class="crm-field"><span>{vi?"Lịch tuần, ngày nghỉ, OT (JSON)":"Weekdays, holidays and overtime (JSON)"}</span><textarea class="crm-input crm-json" name="schedule_json" rows="9" required placeholder={'{"weekdays":[{"weekday":1,"shifts":[{"key":"day","start":"09:00","end":"18:00","break_minutes":60,"remote_allowed":false}]},…],"holidays":[],"overtime":{"enabled":false,"requires_approval":true,"basis":""}'}></textarea><span class="crm-help">{vi?"Cần đủ weekday 1–7; mỗi ca có key, giờ bắt đầu/kết thúc, phút nghỉ và remote_allowed. Không điền quy tắc chưa được phê duyệt.":"Provide weekdays 1–7; each shift has a key, start/end, break minutes and remote_allowed. Do not enter an unapproved rule."}</span></label><button class="crm-button secondary" type="submit">{vi?"Tạo bản nháp lịch":"Create calendar draft"}</button></form>}
   <div class="crm-list">{d.calendars.length===0?<p class="crm-empty">{vi?"Chưa có lịch được cấu hình.":"No calendars configured."}</p>:d.calendars.map(calendar=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{calendar.title_en} · {calendar.title_vi}</strong><span class="crm-meta">{calendar.calendar_key} · v{calendar.version_number} · {calendar.timezone} · {calendar.legal_entity} · {state(calendar.state)}</span><pre class="crm-meta crm-json">{calendar.schedule_json}</pre><span class="crm-meta">{vi?"Người tạo / rà soát / kích hoạt":"Created / reviewed / activated"}: {calendar.created_by} / {calendar.reviewed_by||"—"} / {calendar.activated_by||"—"}</span></div><div class="crm-actions">{calendar.state==="draft"&&d.user.can("hrm.time.review")&&calendar.created_by!==d.user.id&&<form method="post" action="/api/hrm/time" class="crm-form"><input type="hidden" name="intent" value="review_calendar"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="calendar_id" value={calendar.id}/><input type="hidden" name="version" value={calendar.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="500" required aria-label={vi?"Lý do rà soát":"Review reason"}/><button class="crm-button small" name="decision" value="approve">{vi?"Rà soát đạt":"Review"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}{calendar.state==="reviewed"&&d.user.can("hrm.time.configure")&&<form method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="activate_calendar"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="calendar_id" value={calendar.id}/><input type="hidden" name="version" value={calendar.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Kích hoạt":"Activate"}</button></form>}</div></article>)}</div>
  </section>

  {d.user.can("hrm.time.manage")&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Gán lịch và kỳ công":"Assignments and time periods"}</h2><div class="crm-grid">{d.calendars.some(c=>c.state==="active")&&d.people.length>0&&<form class="crm-form" method="post" action="/api/hrm/time"><h3>{vi?"Gán lịch cho nhân viên":"Assign calendar"}</h3><input type="hidden" name="intent" value="assign_calendar"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Nhân viên":"Employee"}</span><select class="crm-input" name="person_id" required>{d.people.map(p=><option value={p.id}>{p.employee_code} · {p.preferred_name||p.legal_name} · {p.status}</option>)}</select></label><label class="crm-field"><span>{vi?"Phiên bản lịch active":"Active calendar version"}</span><select class="crm-input" name="calendar_version_id" required>{d.calendars.filter(c=>c.state==="active").map(c=><option value={c.id}>{c.title_vi} · v{c.version_number}</option>)}</select></label><label class="crm-field"><span>{vi?"Có hiệu lực từ":"Effective from"}</span><input class="crm-input" type="date" name="effective_from" required/></label><button class="crm-button secondary" type="submit">{vi?"Gán lịch":"Assign"}</button></form>}
   <form class="crm-form" method="post" action="/api/hrm/time"><h3>{vi?"Mở kỳ chấm công":"Open time period"}</h3><input type="hidden" name="intent" value="create_period"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Mã kỳ":"Period key"}</span><input class="crm-input" name="period_key" maxlength="30" required/></label><label class="crm-field"><span>{vi?"Từ ngày":"Starts on"}</span><input class="crm-input" type="date" name="starts_on" required/></label><label class="crm-field"><span>{vi?"Đến ngày":"Ends on"}</span><input class="crm-input" type="date" name="ends_on" required/></label><button class="crm-button secondary" type="submit">{vi?"Mở kỳ":"Open period"}</button></form></div>
   <h3>{vi?"Lịch đã gán":"Work calendar assignments"}</h3><div class="crm-list">{d.assignments.length===0?<p class="crm-empty">{vi?"Chưa gán lịch.":"No calendars assigned."}</p>:d.assignments.map(assignment=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{assignment.employee_code||""} · {assignment.preferred_name||assignment.person_id}</strong><span class="crm-meta"><code>{assignment.calendar_version_id}</code> · {date(assignment.effective_from)} — {assignment.effective_to?date(assignment.effective_to):(vi?"đang hiệu lực":"current")} · v{assignment.version}</span></div>{!assignment.effective_to&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="end_calendar_assignment"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="assignment_id" value={assignment.id}/><input type="hidden" name="version" value={assignment.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Có hiệu lực đến hết ngày":"Effective through"}</span><input class="crm-input" type="date" name="effective_to" required/></label><label class="crm-field"><span>{vi?"Lý do kết thúc":"End reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi?"Kết thúc gán lịch":"End assignment"}</button></form>}</article>)}</div>
   <h3>{vi?"Kỳ công":"Time periods"}</h3><div class="crm-list">{d.periods.length===0?<p class="crm-empty">{vi?"Chưa mở kỳ công.":"No time periods yet."}</p>:d.periods.map(period=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{period.period_key} · {state(period.state)}</strong><span class="crm-meta">{date(period.starts_on)} — {date(period.ends_on)} · {period.entry_count??0} {vi?"dòng":"entries"} · v{period.version}</span>{period.snapshot_checksum&&<span class="crm-meta">{vi?"Checksum snapshot":"Snapshot checksum"}: <code>{period.snapshot_checksum}</code></span>}{period.reopen_reason&&<p>{period.reopen_reason}</p>}</div><div class="crm-actions crm-period-actions">{period.state==="open"&&<form method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="review_period"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="period_id" value={period.id}/><input type="hidden" name="version" value={period.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button secondary small">{vi?"Bắt đầu rà soát":"Start review"}</button></form>}{period.state==="reviewing"&&d.user.can("hrm.time.configure")&&<form method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="lock_period"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="period_id" value={period.id}/><input type="hidden" name="version" value={period.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do khóa":"Lock reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button danger small">{vi?"Kiểm tra và khóa snapshot":"Validate and lock snapshot"}</button></form>}{period.state==="locked"&&d.user.can("hrm.time.manage")&&<form method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="reopen_period"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="period_id" value={period.id}/><input type="hidden" name="version" value={period.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do yêu cầu mở lại":"Reopen reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi?"Yêu cầu mở lại":"Request reopen"}</button></form>}{period.state==="reopen_requested"&&d.user.can("hrm.time.configure")&&period.locked_by!==d.user.id&&<form method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="review_reopen"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="period_id" value={period.id}/><input type="hidden" name="version" value={period.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt mở lại":"Approve reopen"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}</div></article>)}</div>
  </section>}

  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Bảng công và giải trình":"Attendance and adjustments"}</h2><div class="crm-list">{d.entries.length===0?<p class="crm-empty">{vi?"Chưa có dòng công.":"No time entries yet."}</p>:d.entries.map(entry=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{entry.employee_code||""} · {entry.preferred_name||entry.person_id} · {date(entry.work_date)} · {entry.shift_key}</strong><span class="crm-meta">{state(entry.state)} · {entry.worked_minutes}/{entry.planned_minutes} {vi?"phút":"minutes"} · {local(entry.check_in_utc,entry.timezone)} — {local(entry.check_out_utc,entry.timezone)}</span>{entry.overtime_minutes>0&&<span class="crm-meta">{vi?"OT":"Overtime"}: {entry.overtime_minutes} min · {state(entry.overtime_state)} {entry.overtime_reason||""}</span>}</div><div class="crm-actions">{entry.overtime_state==="pending_approval"&&d.user.can("hrm.time.review")&&entry.submitted_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="review_overtime"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="entry_id" value={entry.id}/><input type="hidden" name="version" value={entry.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do rà soát OT":"Overtime review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt OT":"Approve OT"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối OT":"Reject OT"}</button></form>}{entry.state==="submitted"&&entry.overtime_state!=="pending_approval"&&entry.overtime_state!=="rejected"&&d.user.can("hrm.time.review")&&entry.submitted_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="review_entry"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="entry_id" value={entry.id}/><input type="hidden" name="version" value={entry.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do rà soát công":"Attendance review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt công":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Trả lại":"Return"}</button></form>}</div></article>)}</div>
   {d.adjustments.length>0&&<><h3>{vi?"Giải trình đang chờ":"Pending adjustments"}</h3><div class="crm-list">{d.adjustments.map(adj=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{vi?"Giải trình":"Adjustment"} · {state(adj.state)}</strong><span>{adj.reason}</span><span class="crm-meta">{local(adj.old_check_in_utc,adj.timezone)} — {local(adj.old_check_out_utc,adj.timezone)} → {local(adj.proposed_check_in_utc,adj.timezone)} — {local(adj.proposed_check_out_utc,adj.timezone)}</span></div>{adj.state==="pending_approval"&&d.user.can("hrm.time.review")&&adj.submitted_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="review_adjustment"/><input type="hidden" name="return_to" value={redirectField}/><input type="hidden" name="adjustment_id" value={adj.id}/><input type="hidden" name="version" value={adj.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}</article>)}</div></>}
  </section>
 </>: <>
  {myContext?<><section class="crm-sheet"><p class="crm-eyebrow">{vi?"Lịch được gán":"Assigned calendar"}</p><h2 class="crm-h2">{myContext.timezone}</h2><p class="crm-help">{vi?"Ca và ngày nghỉ bên dưới lấy từ phiên bản lịch có hiệu lực; giờ nhập được diễn giải theo múi giờ này rồi lưu UTC.":"Shifts and holidays come from the effective calendar version; entered local times are interpreted in this timezone and stored as UTC."}</p><form method="get" class="crm-actions"><label class="crm-field"><span>{vi?"Ngày làm việc":"Work date"}</span><input class="crm-input" type="date" name="work_date" value={workDate} required/></label><button class="crm-button secondary small">{vi?"Xem lịch ngày":"View date"}</button></form>{myContext.holidays.includes(workDate)&&<p class="crm-notice warn">{vi?"Đây là ngày nghỉ trong lịch làm việc.":"This date is a configured calendar holiday."}</p>}</section>
   <section class="crm-sheet"><h2 class="crm-h2">{vi?"Gửi giờ làm":"Submit attendance"}</h2>{myContext.periods.length===0?<p class="crm-empty">{vi?"HR chưa mở kỳ công cho ngày này.":"HR has not opened a time period for this date."}</p>:<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="submit_entry"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/time?work_date=${workDate}`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="person_id" value={myContext.personId}/><input type="hidden" name="work_date" value={workDate}/><label class="crm-field"><span>{vi?"Kỳ công":"Open time period"}</span><select class="crm-input" name="period_id" required>{myContext.periods.map(period=><option value={period.id}>{period.period_key} · {date(period.starts_on)} — {date(period.ends_on)}</option>)}</select></label><label class="crm-field"><span>{vi?"Ca":"Shift"}</span><select class="crm-input" name="shift_key" required>{(activeDay?.shifts||[]).map(shift=><option value={shift.key}>{shift.key} · {shift.start}–{shift.end} · {shift.break_minutes} min break</option>)}</select></label><div class="crm-grid"><label class="crm-field"><span>{vi?"Bắt đầu theo giờ địa phương":"Check in (local time)"}</span><input class="crm-input" type="datetime-local" name="check_in_local" required/></label><label class="crm-field"><span>{vi?"Kết thúc theo giờ địa phương":"Check out (local time)"}</span><input class="crm-input" type="datetime-local" name="check_out_local" required/></label><label class="crm-field"><span>{vi?"Phút nghỉ":"Break minutes"}</span><input class="crm-input" type="number" min="0" max="1439" name="break_minutes" required/></label></div><button class="crm-button" type="submit">{vi?"Gửi chấm công":"Submit attendance"}</button></form>}</section>
   <section class="crm-sheet"><h2 class="crm-h2">{vi?"Lịch sử chấm công":"Attendance history"}</h2><div class="crm-list">{d.entries.length===0?<p class="crm-empty">{vi?"Chưa có bản ghi.":"No attendance recorded."}</p>:d.entries.map(entry=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{date(entry.work_date)} · {entry.shift_key} · {state(entry.state)}</strong><span class="crm-meta">{local(entry.check_in_utc,entry.timezone)} — {local(entry.check_out_utc,entry.timezone)} · {entry.worked_minutes} min</span>{entry.review_reason&&<span>{entry.review_reason}</span>}{entry.overtime_minutes>0&&<span class="crm-meta">OT {entry.overtime_minutes} min · {state(entry.overtime_state)}</span>}</div>{["approved","rejected"].includes(entry.state)&&<form class="crm-form" method="post" action="/api/hrm/time"><input type="hidden" name="intent" value="adjust_entry"/><input type="hidden" name="return_to" value={`${prefix}/hrm/me/time?work_date=${workDate}`}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="entry_id" value={entry.id}/><input type="hidden" name="version" value={entry.version}/><div class="crm-grid"><label class="crm-field"><span>{vi?"Giờ vào mới":"Proposed check in"}</span><input class="crm-input" type="datetime-local" name="check_in_local" required/></label><label class="crm-field"><span>{vi?"Giờ ra mới":"Proposed check out"}</span><input class="crm-input" type="datetime-local" name="check_out_local" required/></label><label class="crm-field"><span>{vi?"Phút nghỉ":"Break minutes"}</span><input class="crm-input" type="number" min="0" max="1439" name="break_minutes" required/></label></div><label class="crm-field"><span>{vi?"Lý do giải trình":"Adjustment reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi?"Gửi giải trình":"Request adjustment"}</button></form>}</article>)}</div></section></>:<section class="crm-sheet"><p>{vi?"Chưa có lịch làm việc được gán cho ngày này.":"No work calendar is assigned for this date."}</p></section>}
 </>}
</HrmPage>
