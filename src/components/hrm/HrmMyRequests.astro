---
import HrmPage from "./HrmPage.astro";
import type { MyRequestsPage } from "../../lib/hrm/employee-service-pages";
const d=Astro.props as MyRequestsPage,vi=d.vi,prefix=vi?"/vi":"";
const state=(value:string)=>({submitted:vi?"Đã gửi":"Submitted",triaged:vi?"Đã tiếp nhận":"Triaged",in_progress:vi?"Đang xử lý":"In progress",answered:vi?"Đã trả lời":"Answered",resolved:vi?"Đã giải quyết":"Resolved",reopened:vi?"Đã mở lại":"Reopened",cancelled:vi?"Đã hủy":"Cancelled"}[value]??value);
const fileState=(value:string)=>({quarantined:vi?"Chờ HR rà soát":"Waiting for HR review",reviewed:vi?"Đã rà soát":"Reviewed",rejected:vi?"Cần nộp lại":"Resubmit required"}[value]??value);
const types=["employment_confirmation","profile_support","policy_question","benefit_question","asset_return","training_question","reimbursement","sensitive_complaint","other"];
const typeLabel=(value:string)=>({employment_confirmation:vi?"Xác nhận công tác":"Employment confirmation",profile_support:vi?"Hỗ trợ hồ sơ":"Profile support",policy_question:vi?"Thắc mắc chính sách":"Policy question",benefit_question:vi?"Phúc lợi":"Benefits",asset_return:vi?"Tài sản":"Company asset",training_question:vi?"Đào tạo":"Training",reimbursement:vi?"Hoàn ứng":"Reimbursement",sensitive_complaint:vi?"Phản ánh nhạy cảm":"Sensitive concern",other:vi?"Khác":"Other"}[value]??value);
const returnTo=(id?:string)=>`${prefix}/hrm/me/requests${id?`?request=${encodeURIComponent(id)}`:""}`;
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Yêu cầu riêng tư":"Private HR requests"}</strong><p>{vi?"Quản lý trực tiếp không thấy yêu cầu hoặc nội dung của bạn. Phản ánh nhạy cảm chỉ vào hàng chờ HRM; không tự chuyển cho quản lý." : "Direct managers cannot see your requests or messages. Sensitive concerns go only to the HRM queue and are never routed to a manager."}</p></section>
 {d.selected&&<section class="crm-sheet"><p class="crm-eyebrow">{typeLabel(d.selected.request.request_type)} · {state(d.selected.request.state)}</p><h2 class="crm-h2">{d.selected.request.subject}</h2><p class="crm-meta">{d.selected.request.created_at}</p><ol class="crm-list">{d.selected.events.map(event=><li class="crm-row"><div><strong>{state(event.event_type)}</strong><p>{event.body}</p><span class="crm-meta">{event.actor_id} · {event.created_at}</span></div></li>)}</ol>
  <section class="crm-sheet"><h3 class="crm-h3">{vi?"PDF đính kèm":"PDF attachments"}</h3>{d.selected.attachments.length===0?<p class="crm-empty">{vi?"Chưa có tệp đính kèm.":"No attachments yet."}</p>:<div class="crm-list">{d.selected.attachments.map(file=><article class="crm-row"><div><strong>{file.original_name}</strong><p class="crm-meta">{fileState(file.state)} · {file.created_at}</p>{file.state==="rejected"&&file.review_reason&&<p>{file.review_reason}</p>}</div>{(file.state==="reviewed"||file.uploaded_by===d.user.id)&&<a class="crm-button secondary small" href={`/api/hrm/services/attachments/${file.id}`}>{vi?"Tải xuống":"Download"}</a>}</article>)}</div>}</section>
  {!(["resolved","cancelled"].includes(d.selected.request.state))&&<form class="crm-form" method="post" enctype="multipart/form-data" action="/api/hrm/services/attachments"><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><label class="crm-field"><span>{vi?"Thêm chứng từ PDF":"Attach a PDF document"}</span><input class="crm-input" type="file" name="file" accept="application/pdf,.pdf" required/></label><p class="crm-help">{vi?"Tệp riêng tư, tối đa 5 MB. HR cần rà soát trước khi người nhận khác có thể tải xuống.":"Private file, up to 5 MB. HR review is required before other recipients can download it."}</p><button class="crm-button secondary">{vi?"Tải PDF":"Upload PDF"}</button></form>}
  {!["resolved","cancelled"].includes(d.selected.request.state)&&<form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="message"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Thêm thông tin":"Add a message"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required></textarea></label><button class="crm-button secondary">{vi?"Gửi cập nhật":"Send update"}</button></form>}
  {["answered","resolved"].includes(d.selected.request.state)&&<form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="reopen"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Lý do mở lại":"Reason to reopen"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required></textarea></label><button class="crm-button secondary">{vi?"Mở lại yêu cầu":"Reopen request"}</button></form>}
  {d.selected.request.state==="submitted"&&<form method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="cancel"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><input type="hidden" name="body" value={vi?"Nhân viên đã hủy yêu cầu":"Employee cancelled the request"}/><button class="crm-button danger small">{vi?"Hủy yêu cầu":"Cancel request"}</button></form>}
 </section>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Yêu cầu của tôi":"My requests"}</h2>{d.requests.length===0?<p class="crm-empty">{vi?"Chưa có yêu cầu nào.":"No requests yet."}</p>:<div class="crm-list">{d.requests.map(request=><article class="crm-row"><div><strong>{request.subject}</strong><p class="crm-meta">{typeLabel(request.request_type)} · {state(request.state)} · {request.updated_at}</p></div><a class="crm-button secondary small" href={returnTo(request.id)}>{vi?"Mở":"Open"}</a></article>)}</div>}</section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo yêu cầu HR":"Create an HR request"}</h2><form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="create_request"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><label class="crm-field"><span>{vi?"Loại yêu cầu":"Request type"}</span><select class="crm-input" name="request_type" required>{types.map(value=><option value={value}>{typeLabel(value)}</option>)}</select></label><label class="crm-field"><span>{vi?"Tiêu đề":"Subject"}</span><input class="crm-input" name="subject" maxlength="120" required/></label></div><label class="crm-field"><span>{vi?"Nội dung":"Details"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required></textarea></label><p class="crm-help">{vi?"Không gửi mật khẩu, dữ liệu thẻ hoặc đầy đủ số CCCD. Sau khi gửi yêu cầu, hãy mở yêu cầu để đính kèm PDF nếu cần.":"Do not include passwords, card data or full identity numbers. After submitting, open the request to attach a PDF if needed."}</p><button class="crm-button">{vi?"Gửi yêu cầu":"Submit request"}</button></form></section>
</HrmPage>
