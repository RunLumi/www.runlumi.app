---
import HrmPage from "./HrmPage.astro";
import type { AtsTransferPage } from "../../lib/hrm/lifecycle-pages";
const d=Astro.props as AtsTransferPage;const vi=d.vi;const candidate=d.candidate;const transfer=d.transfer;
const date=(value:string)=>new Date(`${value}T00:00:00+07:00`).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
---
<HrmPage data={d} current="people">
 {d.saved&&<p class="crm-notice good" role="status">{vi?"Đã tạo hồ sơ HRM và lưu dấu vết chuyển dữ liệu ATS.":"HRM profile created and ATS transfer provenance recorded."}</p>}
 {transfer?<section class="crm-sheet"><p class="crm-eyebrow">{vi?"Hồ sơ nguồn đã được chuyển":"Source application transferred"} · {transfer.source_status}</p><h2 class="crm-h2">{transfer.employee_code} · {transfer.legal_name}</h2><p class="crm-meta">{vi?"Đợt làm việc":"Employment period"}: {transfer.status} · {transfer.started_on?date(transfer.started_on):"—"}</p><p class="crm-meta">{vi?"Mã hồ sơ ATS":"ATS source reference"}: {transfer.source_public_id} · {new Date(transfer.transferred_at).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"})}</p><p>{vi?"Chỉ trường đã liệt kê được chuyển. CV, bài làm, ghi chú và scorecard vẫn thuộc vòng đời ATS; xóa nguồn ATS không xóa hồ sơ HRM.":"Only the listed fields were transferred. Resume, work samples, notes and scorecards remain in ATS; deleting the ATS source does not delete this HRM record."}</p><a class="crm-button" href={`${vi?"/vi":""}/hrm/people/${encodeURIComponent(transfer.person_id)}/work`}>{vi?"Mở hồ sơ HRM":"Open HRM profile"}</a></section>
 : candidate&&<>
  <p class="crm-meta">{vi?"Trang này yêu cầu quyền quản lý tuyển dụng và hồ sơ HRM. Liên kết tài khoản EmDash được chọn thủ công; email ứng viên không tự ghép tài khoản.":"This page requires both Hiring and HRM record permissions. Select the EmDash account manually; candidate email is never used for automatic account matching."}</p>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Dữ liệu xem trước":"Transfer preview"}</h2><dl class="crm-facts"><div><dt>{vi?"Ứng viên":"Candidate"}</dt><dd>{candidate.full_name}</dd></div><div><dt>Email</dt><dd>{candidate.email}</dd></div><div><dt>{vi?"Điện thoại":"Phone"}</dt><dd>{candidate.phone||"—"}</dd></div><div><dt>{vi?"Vị trí":"Role"}</dt><dd>{candidate.job_title}</dd></div><div><dt>{vi?"Bộ phận":"Department"}</dt><dd>{candidate.department||"—"}</dd></div><div><dt>{vi?"Địa điểm":"Location"}</dt><dd>{candidate.location||"—"}</dd></div><div><dt>{vi?"Pháp nhân HRM":"HRM legal entity"}</dt><dd>{d.legalEntity||"—"}</dd></div><div><dt>{vi?"Trạng thái ATS":"ATS status"}</dt><dd>{candidate.status}</dd></div></dl>
   <p class="crm-help">{vi?"Chỉ chuyển họ tên, email, điện thoại, vị trí, bộ phận, địa điểm và ngày bắt đầu. Không chuyển CV/tệp, câu trả lời, thư giới thiệu, ghi chú, phỏng vấn hay scorecard. Xác nhận tuyển dụng và đồng ý tuyển dụng không tự xác lập căn cứ xử lý dữ liệu nhân viên.":"Only name, email, phone, role, department, location and start date are copied. Resume/files, answers, cover letter, notes, interviews and scorecards are excluded. A hiring decision or recruitment consent does not itself establish the HRM processing basis."}</p>
  </section>
  {candidate.status!=="hired"?<div class="crm-notice bad">{vi?"Chỉ ứng viên có trạng thái ATS ‘đã tuyển’ mới đủ điều kiện chuyển.":"Only an application in the ATS ‘hired’ state can be transferred."}</div>:<section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo đợt làm việc HRM":"Create HRM employment period"}</h2><form method="post" action={`/api/hrm/transfers/${encodeURIComponent(candidate.id)}`} class="crm-form"><input type="hidden" name="request_key" value={d.requestKey}/><input type="hidden" name="source_updated_at" value={candidate.updated_at}/><input type="hidden" name="job_updated_at" value={candidate.job_updated_at}/><input type="hidden" name="settings_version" value={d.settingsVersion}/>
    <label class="crm-field"><span>{vi?"Mã nhân viên":"Employee code"}</span><input class="crm-input" name="employee_code" pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,49}" maxlength="50" required/></label>
    <label class="crm-field"><span>{vi?"Tài khoản EmDash đang có quyền Employee":"Existing EmDash account with Employee access"}</span><select class="crm-select" name="employee_account_email" required><option value="">{vi?"Chọn thủ công — không ghép theo email":"Choose manually — no email matching"}</option>{d.employees.map(member=><option value={member.email}>{member.name} · {member.email}</option>)}</select></label>
    <label class="crm-field"><span>{vi?"Người quản lý trực tiếp (nếu có)":"Direct manager (optional)"}</span><select class="crm-select" name="manager_email"><option value="">{vi?"Chưa phân công":"Unassigned"}</option>{d.managers.map(member=><option value={member.email}>{member.name} · {member.email}</option>)}</select></label>
    <label class="crm-field"><span>{vi?"Ngày bắt đầu":"Employment start date"}</span><input class="crm-input" name="started_on" type="date" required/></label>
    <label class="crm-check"><input type="checkbox" name="confirm_transfer" value="1" required/><span>{vi?"Tôi đã kiểm tra tài khoản được chọn và các trường sẽ chuyển; hồ sơ HRM mới tuân theo chính sách HRM đã cấu hình.":"I verified the selected account and transferred fields; the new HRM record will follow the configured HRM policy."}</span></label>
    <button class="crm-button" type="submit" disabled={!d.live||!d.legalEntity||d.employees.length===0}>{vi?"Tạo hồ sơ HRM":"Create HRM record"}</button>
   </form></section>}
 </>}
</HrmPage>
