---
import HrmPage from "./HrmPage.astro";
import type { ReportGovernancePage } from "../../lib/hrm/report-governance-pages";
const d=Astro.props as ReportGovernancePage,vi=d.vi;
const state=(value:string)=>({draft:["Draft","Nháp"],reviewed:["Reviewed","Đã duyệt"],active:["Active","Có hiệu lực"],retired:["Retired","Đã kết thúc"],rejected:["Rejected","Từ chối"],released:["Released","Đã gỡ"]}[value]?.[vi?1:0]??value);
---
<HrmPage data={d}>
 <section class="crm-notice"><p>{vi?"Chuẩn bị chính sách không mở HRM production. Không có thời hạn hay quy tắc pháp lý mặc định. Bản nguồn DOCX cần được rà soát, đúng pháp nhân và còn trong kho; người duyệt phải khác người tạo. Thay phiên bản sẽ tạm dừng lịch cũ, không tự đổi căn cứ lưu trữ.":"Preparing a policy does not activate production HRM. No retention period or legal rule is supplied by default. The source DOCX must be reviewed, match the entity and remain in storage. Review must be independent. A replacement pauses old schedules without rebinding their retention terms."}</p><p>{vi?"Hold chỉ bảo toàn nội dung snapshot chưa bị xóa, không gia hạn quyền đọc thông thường và không khôi phục nội dung đã xóa. Hold hồ sơ nhân viên không tự áp dụng lên báo cáo dẫn xuất.":"A hold preserves snapshot content that has not been purged. It does not extend ordinary access or recover deleted content. Employee-record holds do not automatically cover derived reports."}</p></section>
 {d.saved&&<p class="crm-notice good" role="status">{vi?"Đã lưu thay đổi.":"Changes saved."}</p>}
 {d.error&&<p class="crm-notice bad" role="alert">{vi?"Không thể lưu. Hãy kiểm tra nguồn đã duyệt, quyền hiện tại và phiên bản mới nhất.":"Unable to save. Check the reviewed source, current permissions and latest revision."}</p>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo phiên bản chính sách":"Create policy version"}</h2>
 <form method="post" class="crm-form"><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/>
 <div class="crm-form-grid">
  <label class="crm-field"><span>{vi?"Mã nhóm hồ sơ (chữ hoa, số, _ hoặc -)":"Record class code (uppercase, digits, _ or -)"}</span><input class="crm-input" name="class_code" maxlength="48" pattern="[A-Z0-9][A-Z0-9_-]*" required/></label>
  <label class="crm-field"><span>{vi?"Loại chụp":"Capture kind"}</span><select class="crm-input" name="capture_kind" required><option value="">{vi?"Chọn loại":"Choose kind"}</option><option value="manual">{vi?"Thủ công":"Manual"}</option><option value="daily">{vi?"Hằng ngày":"Daily"}</option><option value="weekly">{vi?"Hằng tuần":"Weekly"}</option><option value="monthly">{vi?"Hằng tháng":"Monthly"}</option></select></label>
  <label class="crm-field"><span>{vi?"Tên tiếng Anh":"English title"}</span><input class="crm-input" name="title_en" maxlength="120" required/></label><label class="crm-field"><span>{vi?"Tên tiếng Việt":"Vietnamese title"}</span><input class="crm-input" name="title_vi" maxlength="120" required/></label>
  <label class="crm-field"><span>{vi?"Phòng ban (trống: cho phép mọi bộ lọc)":"Department (blank: permits all filters)"}</span><input class="crm-input" name="department" maxlength="120"/></label>
  <label class="crm-field"><span>{vi?"Người chịu trách nhiệm":"Accountable owner"}</span><select class="crm-input" name="owner_user_id" required><option value="">{vi?"Chọn người":"Choose owner"}</option>{d.owners.map(o=><option value={o.id}>{o.name}</option>)}</select></label>
  <label class="crm-field"><span>{vi?"Thời hạn lưu (ngày)":"Retention days"}</span><input class="crm-input" type="number" name="retention_days" min="1" max="36500" required/></label>
  <label class="crm-field"><span>{vi?"Phạm vi pháp luật áp dụng":"Jurisdiction"}</span><input class="crm-input" name="jurisdiction" maxlength="300" required/></label>
  <label class="crm-field"><span>{vi?"Có hiệu lực từ":"Effective from"}</span><input class="crm-input" type="date" name="effective_from" required/></label><label class="crm-field"><span>{vi?"Phải duyệt lại trước ngày":"Approval valid through"}</span><input class="crm-input" type="date" name="effective_until" required/></label>
 </div>
 <label class="crm-field"><span>{vi?"Mục đích":"Purpose"}</span><textarea class="crm-input" name="purpose" maxlength="1000" required rows="3"></textarea></label>
 <label class="crm-field"><span>{vi?"Phiên bản nguồn DOCX (có thể để trống ở bản nháp)":"DOCX source version (optional for a draft)"}</span><select class="crm-input" name="source_version_id"><option value="">{vi?"Chưa có nguồn; chỉ lưu nháp":"No source; draft only"}</option>{d.sources.map(s=><option value={s.id}>{vi?s.title_vi:s.title_en} · v{s.version_number}</option>)}</select></label>
 <p class="crm-help">{vi?"Các trường được đóng băng khi lưu. Nếu thay nội dung hoặc bổ sung nguồn, tạo phiên bản mới. Nhóm hồ sơ thể hiện mục đích lưu trữ, không phải tần suất chạy.":"Fields are frozen on creation. Create another version to change terms or attach a source. The record class describes a retention purpose, independently of run frequency."}</p>
 <button class="crm-button">{vi?"Lưu bản nháp":"Save draft"}</button></form></section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Phiên bản đã lưu":"Saved policy versions"}</h2>
 {d.policies.length===0?<p class="crm-empty">{vi?"Chưa có chính sách.":"No policies exist."}</p>:d.policies.map(p=><article class="crm-sheet"><h3 class="crm-h3">{vi?p.title_vi:p.title_en} · v{p.version_number} · {state(p.state)}</h3><p class="crm-meta break">{p.policy_ref} · {p.class_code} · {p.capture_kind} · {p.retention_days} {vi?"ngày":"days"} · {p.effective_from}–{p.effective_until}</p><p>{p.purpose}</p><p class="crm-meta break">{p.jurisdiction} · {vi?"Chủ sở hữu":"Owner"}: {p.owner_user_id} · {vi?"Nguồn":"Source"}: {p.source_version_id??"—"} · {p.source_checksum??"—"}</p><p class="crm-meta break">{vi?"Người duyệt / thời điểm":"Reviewer / time"}: {p.reviewed_by??"—"} / {p.reviewed_at??"—"} · {vi?"Kích hoạt":"Activation"}: {p.activated_by??"—"} / {p.activated_at??"—"}</p>
 {d.user.can("hrm.reports.policy.approve")&&p.created_by!==d.user.id&&["draft","reviewed","active"].includes(p.state)&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="policy_action"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="policy_ref" value={p.policy_ref}/><input type="hidden" name="version" value={p.version}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><div class="crm-actions">{p.state==="draft"?<><button class="crm-button" name="action" value="approve">{vi?"Duyệt độc lập":"Approve independently"}</button><button class="crm-button secondary" name="action" value="reject">{vi?"Từ chối":"Reject"}</button></>:<button class="crm-button" name="action" value={p.state==="reviewed"?"activate":"retire"}>{p.state==="reviewed"?(vi?"Áp dụng phiên bản":"Activate version"):(vi?"Kết thúc chính sách":"Retire policy")}</button>}</div></form>}
 </article>)}
 </section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Đặt hold báo cáo":"Place report hold"}</h2><form method="post" class="crm-form"><input type="hidden" name="intent" value="place_hold"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid">
 <label class="crm-field"><span>{vi?"Phạm vi":"Scope"}</span><select class="crm-input" name="scope_kind" required><option value="entity">{vi?"Toàn pháp nhân":"Legal entity"}</option><option value="class">{vi?"Nhóm hồ sơ":"Record class"}</option><option value="snapshot">Snapshot</option><option value="schedule">{vi?"Lịch":"Schedule"}</option></select></label><label class="crm-field"><span>{vi?"Mã nhóm / tham chiếu snapshot hoặc lịch (trống cho toàn pháp nhân)":"Class / snapshot or schedule reference (blank for entity)"}</span><input class="crm-input" name="target_ref" maxlength="120"/></label>
 <label class="crm-field"><span>{vi?"Tháng (trống: mọi kỳ)":"Month (blank: any period)"}</span><input class="crm-input" type="month" name="period"/></label><label class="crm-field"><span>{vi?"Khớp phòng ban":"Department matching"}</span><select class="crm-input" name="department_mode"><option value="all">{vi?"Mọi bộ lọc":"All filters"}</option><option value="exact">{vi?"Chính xác; trống là bản toàn pháp nhân":"Exact; blank means entity aggregate"}</option></select></label><label class="crm-field"><span>{vi?"Phòng ban chính xác":"Exact department"}</span><input class="crm-input" name="department" maxlength="120"/></label></div><label class="crm-field"><span>{vi?"Lý do riêng tư":"Private reason"}</span><textarea class="crm-input" name="reason" required maxlength="1000" rows="3"></textarea></label><button class="crm-button">{vi?"Đặt hold":"Place hold"}</button></form></section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Hold đã lưu":"Saved holds"}</h2>{d.holds.map(h=><article class="crm-sheet"><h3 class="crm-h3">{h.scope_kind} · {state(h.state)}</h3><p class="crm-meta break">{h.hold_ref} · {h.class_code??h.snapshot_id??h.schedule_id??h.legal_entity} · {h.period??"*"} · {h.department_mode} / {h.department??"—"}</p><p>{h.reason}</p><p class="crm-meta break">{h.placed_by} / {h.placed_at} · {h.released_by??"—"} / {h.released_at??"—"}</p>{h.release_reason&&<p>{h.release_reason}</p>}{h.state==="active"&&h.placed_by!==d.user.id&&d.user.can("hrm.reports.holds.release")&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="release_hold"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="hold_ref" value={h.hold_ref}/><input type="hidden" name="version" value={h.version}/><label class="crm-field"><span>{vi?"Căn cứ gỡ hold":"Release basis"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary">{vi?"Gỡ hold độc lập":"Release independently"}</button></form>}</article>)}</section>
</HrmPage>
<style>.break{overflow-wrap:anywhere}</style>
