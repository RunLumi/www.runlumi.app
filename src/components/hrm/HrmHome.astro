---
import HrmPage from "./HrmPage.astro";
import type { PageBase } from "../../lib/hrm/pages";
import type { Person } from "../../lib/hrm/service";
interface Props extends PageBase { person:Person|null; people:number; settings?:unknown }
const d=Astro.props;
---
<HrmPage data={d} current="home">
  {d.live ? <>
    <div class="crm-grid">
      <section class="crm-sheet"><p class="crm-eyebrow">{d.vi?"Hồ sơ":"Profile"}</p><h2 class="crm-h2">{d.person?.preferred_name||d.person?.legal_name|| (d.vi?"Chưa liên kết hồ sơ":"No linked profile yet")}</h2>{d.person?<><p class="crm-meta">{d.person.job_title}{d.person.department?` · ${d.person.department}`:""}</p><a class="crm-button secondary" href={d.vi?"/vi/hrm/me":"/hrm/me"}>{d.vi?"Xem hồ sơ":"View my profile"}</a></>:<p class="crm-lede">{d.vi?"HR cần xác minh và liên kết hồ sơ với tài khoản EmDash của bạn.":"HR must verify and link your record to your EmDash account."}</p>}</section>
      {(d.user.can("hrm.records.manage")||d.user.can("hrm.team.read"))&&<section class="crm-sheet"><p class="crm-eyebrow">{d.vi?"Phạm vi được cấp":"Permitted scope"}</p><h2 class="crm-h2">{d.people}</h2><p>{d.vi?"Hồ sơ trong phạm vi quyền HRM của bạn.":"People in your granted HRM scope."}</p><a class="crm-button secondary" href={d.vi?"/vi/hrm/people":"/hrm/people"}>{d.vi?"Mở danh sách":"Open people"}</a></section>}
    </div>
    <section class="crm-sheet"><h2 class="crm-h2">{d.vi?"Việc cần làm":"To do"}</h2><p class="crm-empty">{d.vi?"Hồ sơ chưa có chính sách hoặc việc cần xác nhận được phát hành.":"No policy or acknowledgement tasks have been issued yet."}</p></section>
  </> : <div class="crm-notice warn"><strong>{d.vi?"HRM đã dựng cấu hình nhưng chưa mở.":"HRM setup is available; employee access remains closed."}</strong><p>{d.vi?"Công tắc production HRM_LIVE_ENABLED chưa bật. Các giấy tờ/phép/lương chưa được cấu hình.":"The HRM_LIVE_ENABLED production gate is off. Legal, leave and payroll policies are not yet configured."}</p><a href={d.vi?"/vi/hrm/settings":"/hrm/settings"}>{d.vi?"Thiết lập chính sách":"Configure policy"}</a></div>}
  {d.user.can("hrm.records.manage") && (d.live || d.user.can("hrm.configure")) && <section class="crm-sheet">
    <p class="crm-eyebrow">{d.vi ? "Tổ chức và trách nhiệm" : "Organization and responsibilities"}</p>
    <h2 class="crm-h2">{d.vi ? "Mô tả công việc" : "Job descriptions"}</h2>
    <p>{d.vi ? "Rà soát mục tiêu, trách nhiệm, quyền hạn và kế hoạch 90 ngày của từng vị trí." : "Review each role's purpose, responsibilities, authority and first 90 days."}</p>
    <a class="crm-button secondary" href={d.vi ? "/vi/hrm/job-descriptions" : "/hrm/job-descriptions"}>{d.vi ? "Mở danh mục JD" : "Open job descriptions"}</a>
  </section>}
</HrmPage>
