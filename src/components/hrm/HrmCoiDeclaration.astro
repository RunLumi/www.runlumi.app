---
import HrmPage from "./HrmPage.astro";
import type { CoiDetailPage } from "../../lib/hrm/coi-pages";
const d=Astro.props as CoiDetailPage;const vi=d.vi;const declaration=d.declaration;
const answers=JSON.parse(declaration.answers_json) as {has_conflict:"yes"|"no";related_organization:string;relationship:string;description:string;impact:string;proposed_mitigation:string};
const state=(value:string)=>({draft:vi?"Bản nháp":"Draft",submitted:vi?"Đã gửi":"Submitted",under_review:vi?"Đang rà soát":"Under review",clarification_needed:vi?"Cần bổ sung":"Clarification needed",cleared:vi?"Đã rà soát":"Cleared",mitigation_required:vi?"Cần biện pháp giảm thiểu":"Mitigation required",escalated:vi?"Đã chuyển cấp":"Escalated",closed:vi?"Đã đóng":"Closed",superseded:vi?"Được thay thế":"Superseded"}[value]||value);
const when=(value:string)=>new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"});
const labels={related_organization:vi?"Tổ chức/hoạt động liên quan":"Related organization or activity",relationship:vi?"Mối quan hệ/lợi ích":"Relationship or interest",description:vi?"Mô tả tình huống":"Situation",impact:vi?"Phạm vi ảnh hưởng":"Potential impact",proposed_mitigation:vi?"Biện pháp đề xuất":"Proposed mitigation"};
const back=vi?(d.ownerView?"/vi/hrm/me/coi":"/vi/hrm/coi"):(d.ownerView?"/hrm/me/coi":"/hrm/coi");
const canUpload=d.ownerView?!["closed","superseded"].includes(declaration.state):d.canReview&&!["closed","superseded"].includes(declaration.state);
const canAmend=d.ownerView&&!["draft","superseded"].includes(declaration.state);
const canStartReview=d.canReview&&["submitted","clarification_needed","mitigation_required","escalated"].includes(declaration.state);
const canDecide=d.canReview&&declaration.state==="under_review";
const canClose=d.canReview&&["cleared","mitigation_required","escalated"].includes(declaration.state);
const returnTo=`${Astro.url.pathname}${Astro.url.search}`;
---
<HrmPage data={d} current={d.ownerView?"my-coi":"coi-review"}>
 <div class="crm-actions"><a class="crm-button secondary" href={back}>{vi?"← Quay lại":"← Back"}</a></div>
 {d.saved&&<div class="crm-notice good" role="status">{({draft_saved:vi?"Đã lưu bản nháp.":"Draft saved.",submitted:vi?"Đã gửi khai báo.":"Declaration submitted.",assigned:vi?"Đã cập nhật người rà soát.":"Reviewer assignment updated.",review_started:vi?"Đã bắt đầu rà soát.":"Review started.",review_saved:vi?"Đã lưu quyết định rà soát.":"Review decision saved."} as Record<string,string>)[d.saved]||d.saved}</div>}
 <section class="crm-sheet">
  {d.ownerView?<p class="crm-eyebrow">{vi?`Khai báo #${declaration.declaration_no}`:`Declaration #${declaration.declaration_no}`} · {state(declaration.state)}</p>:<p class="crm-eyebrow">{declaration.person.employee_code} · {declaration.person.legal_name} · {vi?`Khai báo #${declaration.declaration_no}`:`Declaration #${declaration.declaration_no}`} · {state(declaration.state)}</p>}
  <h2 class="crm-h2">{vi?"Thông tin đã khai báo":"Declaration details"}</h2>
  <dl class="crm-facts"><div><dt>{vi?"Kết luận của người khai":"Declarant response"}</dt><dd>{answers.has_conflict==="yes"?(vi?"Có lợi ích cần rà soát":"Potential conflict disclosed"):(vi?"Không khai báo xung đột":"No conflict declared")}</dd></div><div><dt>{vi?"Tạo lúc":"Created"}</dt><dd>{when(declaration.created_at)}</dd></div>{declaration.submitted_at&&<div><dt>{vi?"Gửi lúc":"Submitted"}</dt><dd>{when(declaration.submitted_at)}</dd></div>}{declaration.reviewed_at&&<div><dt>{vi?"Rà soát lúc":"Reviewed"}</dt><dd>{when(declaration.reviewed_at)}</dd></div>}{declaration.followup_due&&<div><dt>{vi?"Hạn theo dõi":"Follow-up due"}</dt><dd>{declaration.followup_due}</dd></div>}</dl>
  {answers.has_conflict==="yes"&&<dl class="crm-facts">{(["related_organization","relationship","description","impact","proposed_mitigation"] as const).map(key=><div><dt>{labels[key]}</dt><dd>{answers[key]||"—"}</dd></div>)}</dl>}
 </section>

 {declaration.review_reason&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Phản hồi rà soát":"Review feedback"}</h2><p>{declaration.review_reason}</p>{declaration.mitigation&&<p><strong>{vi?"Biện pháp":"Mitigation"}:</strong> {declaration.mitigation}</p>}</section>}

 {d.ownerView&&declaration.state==="draft"&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Chỉnh sửa bản nháp":"Edit draft"}</h2><form method="post" class="crm-form"><input type="hidden" name="intent" value="save_draft"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/>
   <div class="crm-field"><label for="has_conflict">{vi?"Có xung đột lợi ích?":"Is there a potential conflict of interest?"}</label><select class="crm-select" id="has_conflict" name="has_conflict"><option value="no" selected={answers.has_conflict==="no"}>{vi?"Không":"No conflict"}</option><option value="yes" selected={answers.has_conflict==="yes"}>{vi?"Có":"Conflict exists"}</option></select></div>
   <div class="crm-form-grid"><div class="crm-field"><label for="related_organization">{labels.related_organization}</label><input class="crm-input" id="related_organization" name="related_organization" value={answers.related_organization} maxlength="300"/></div><div class="crm-field"><label for="relationship">{labels.relationship}</label><input class="crm-input" id="relationship" name="relationship" value={answers.relationship} maxlength="300"/></div><div class="crm-field"><label for="description">{labels.description}</label><textarea class="crm-input" id="description" name="description" rows="4" maxlength="2000">{answers.description}</textarea></div><div class="crm-field"><label for="impact">{labels.impact}</label><textarea class="crm-input" id="impact" name="impact" rows="4" maxlength="2000">{answers.impact}</textarea></div><div class="crm-field"><label for="proposed_mitigation">{labels.proposed_mitigation}</label><textarea class="crm-input" id="proposed_mitigation" name="proposed_mitigation" rows="4" maxlength="2000">{answers.proposed_mitigation}</textarea></div></div>
   <button class="crm-button secondary" type="submit">{vi?"Lưu bản nháp":"Save draft"}</button>
  </form><form method="post" class="crm-actions"><input type="hidden" name="intent" value="submit"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/><button class="crm-button" type="submit">{vi?"Gửi khai báo":"Submit declaration"}</button></form></section>}

 {canAmend&&<section class="crm-sheet"><h2 class="crm-h2">{declaration.state==="clarification_needed"?(vi?"Gửi nội dung bổ sung":"Submit an amended declaration"):(vi?"Khai báo thay đổi/cập nhật":"Declare a change or update")}</h2><p class="crm-help">{vi?"Khai báo trước được giữ nguyên. Khi bản mới được gửi, bản trước được đánh dấu đã thay thế và vẫn lưu trong lịch sử.":"The prior declaration is preserved. Once the new declaration is submitted, the earlier one is marked superseded and stays in the history."}</p><form method="post" class="crm-form"><input type="hidden" name="intent" value="amend"/><input type="hidden" name="supersedes_id" value={declaration.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-field"><label for="has_conflict_new">{vi?"Có xung đột lợi ích?":"Is there a potential conflict of interest?"}</label><select class="crm-select" id="has_conflict_new" name="has_conflict"><option value="no" selected={answers.has_conflict==="no"}>{vi?"Không":"No conflict"}</option><option value="yes" selected={answers.has_conflict==="yes"}>{vi?"Có":"Conflict exists"}</option></select></div><div class="crm-form-grid"><div class="crm-field"><label for="related_organization_new">{labels.related_organization}</label><input class="crm-input" id="related_organization_new" name="related_organization" value={answers.related_organization} maxlength="300"/></div><div class="crm-field"><label for="relationship_new">{labels.relationship}</label><input class="crm-input" id="relationship_new" name="relationship" value={answers.relationship} maxlength="300"/></div><div class="crm-field"><label for="description_new">{labels.description}</label><textarea class="crm-input" id="description_new" name="description" rows="4" maxlength="2000">{answers.description}</textarea></div><div class="crm-field"><label for="impact_new">{labels.impact}</label><textarea class="crm-input" id="impact_new" name="impact" rows="4" maxlength="2000">{answers.impact}</textarea></div><div class="crm-field"><label for="proposed_mitigation_new">{labels.proposed_mitigation}</label><textarea class="crm-input" id="proposed_mitigation_new" name="proposed_mitigation" rows="4" maxlength="2000">{answers.proposed_mitigation}</textarea></div></div><button class="crm-button" type="submit">{vi?"Tạo khai báo cập nhật":"Create updated declaration"}</button></form></section>}

 {!d.ownerView&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Quy trình rà soát":"Review workflow"}</h2>
  {d.canAssign&&declaration.state!=="closed"&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="assign"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/><div class="crm-field"><label for="reviewer_id">{vi?"Người rà soát được giao":"Assigned reviewer"}</label><select class="crm-select" id="reviewer_id" name="reviewer_id"><option value="">{vi?"Để hàng chờ HRM Admin":"Leave in administrator queue"}</option>{d.reviewers.filter(reviewer=>reviewer.user_id!==declaration.submitted_by).map(reviewer=><option value={reviewer.user_id} selected={reviewer.user_id===declaration.assigned_reviewer_id}>{reviewer.name} · {reviewer.roles.filter(role=>role==="hrm_officer"||role==="hrm_admin").join(", ")}</option>)}</select></div><button class="crm-button secondary" type="submit">{vi?"Lưu phân công":"Save assignment"}</button></form>}
  {canStartReview&&<form method="post" class="crm-actions"><input type="hidden" name="intent" value="start_review"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/><button class="crm-button" type="submit">{vi?"Bắt đầu rà soát":"Start review"}</button></form>}
  {canDecide&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="review"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/><div class="crm-field"><label for="decision">{vi?"Kết quả":"Decision"}</label><select class="crm-select" id="decision" name="decision"><option value="clarification_needed">{vi?"Yêu cầu bổ sung":"Clarification needed"}</option><option value="cleared">{vi?"Đã rà soát":"Cleared"}</option><option value="mitigation_required">{vi?"Cần biện pháp giảm thiểu":"Mitigation required"}</option><option value="escalated">{vi?"Chuyển cấp xử lý":"Escalate"}</option></select></div><div class="crm-field"><label for="reason">{vi?"Lý do":"Reason"}</label><textarea class="crm-input" id="reason" name="reason" rows="3" required maxlength="1000"></textarea></div><div class="crm-field"><label for="mitigation">{vi?"Biện pháp giảm thiểu":"Mitigation plan"}</label><textarea class="crm-input" id="mitigation" name="mitigation" rows="3" maxlength="2000"></textarea></div><div class="crm-field"><label for="followup_due">{vi?"Hạn theo dõi":"Follow-up due"}</label><input class="crm-input" id="followup_due" name="followup_due" type="date"/></div><button class="crm-button" type="submit">{vi?"Lưu kết quả":"Save decision"}</button></form>}
  {canClose&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="review"/><input type="hidden" name="decision" value="closed"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={declaration.version}/><div class="crm-field"><label for="close_reason">{vi?"Lý do đóng hồ sơ":"Closure reason"}</label><input class="crm-input" id="close_reason" name="reason" required maxlength="1000"/></div><button class="crm-button secondary" type="submit">{vi?"Đóng hồ sơ":"Close declaration"}</button></form>}
  {!d.canAssign&&!canStartReview&&!canDecide&&!canClose&&<p class="crm-meta">{vi?"Khai báo đang chờ người có quyền được phân công.":"The declaration is waiting for an authorized reviewer assignment."}</p>}
 </section>}

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tệp PDF bằng chứng":"PDF evidence"}</h2><p class="crm-help">{vi?"Tệp được cách ly. Người khác phải rà soát trước khi trạng thái chuyển thành đã kiểm tra; rà soát thủ công không phải quét antivirus.":"Files are quarantined. Another authorized person must review a file before it is marked reviewed; manual review is not antivirus scanning."}</p>
  {d.files.length===0?<p class="crm-meta">{vi?"Chưa có tệp bằng chứng.":"No evidence files yet."}</p>:<div class="crm-list">{d.files.map(file=><article class="crm-row"><div><strong>{file.original_name}</strong><span class="crm-meta">{file.state} · {Math.ceil(file.size_bytes/1024)} KB · SHA-256 {file.checksum.slice(0,12)}…</span></div><span class="crm-actions">{(file.state==="reviewed"||file.uploaded_by===d.user.id||(!d.ownerView&&d.canReview))&&<a class="crm-button secondary small" href={`/api/hrm/legal/files/${encodeURIComponent(file.id)}`}>{vi?"Tải xuống":"Download"}</a>}{!d.ownerView&&d.canReview&&file.state==="quarantined"&&file.uploaded_by!==d.user.id&&<form method="post" action={`/api/hrm/legal/files/${encodeURIComponent(file.id)}`} class="crm-actions"><input type="hidden" name="intent" value="review"/><input type="hidden" name="version" value={file.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={returnTo}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" name="decision" value="reviewed">{vi?"Đã rà soát":"Reviewed"}</button><button class="crm-button danger small" name="decision" value="rejected">{vi?"Từ chối":"Reject"}</button></form>}</span></article>)}</div>}
  {canUpload&&<form method="post" action="/api/hrm/legal/files/upload" enctype="multipart/form-data" class="crm-form crm-upload"><input type="hidden" name="kind" value="pdf_evidence"/><input type="hidden" name="coi_declaration_id" value={declaration.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={returnTo}/><div class="crm-field"><label for="coi-evidence">{vi?"Tải PDF bằng chứng":"Upload PDF evidence"}</label><input class="crm-input" id="coi-evidence" name="file" type="file" accept="application/pdf,.pdf" required/></div><button class="crm-button secondary" type="submit">{vi?"Tải PDF lên":"Upload PDF"}</button></form>}
 </section>
</HrmPage>
