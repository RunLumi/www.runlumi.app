---
import HrmPage from "./HrmPage.astro";
import type { TrainingManagementPage } from "../../lib/hrm/training-pages";

const d=Astro.props as TrainingManagementPage,vi=d.vi,prefix=vi?"/vi":"",returnTo=`${prefix}/hrm/training`;
const categoryLabel=(value:string)=>({compliance:vi?"Tuân thủ":"Compliance",role:vi?"Theo vị trí":"Role-specific",professional:vi?"Chuyên môn":"Professional",development:vi?"Phát triển":"Development",certification:vi?"Chứng chỉ":"Certification",other:vi?"Khác":"Other"}[value]??value);
const stateLabel=(value:string)=>({draft:vi?"Bản nháp":"Draft",active:vi?"Đang áp dụng":"Active",retired:vi?"Đã thay thế":"Retired",assigned:vi?"Đã giao":"Assigned",submitted:vi?"Chờ duyệt":"Pending review",approved:vi?"Đã xác nhận":"Verified",declined:vi?"Cần bổ sung/không đạt":"Needs follow-up",cancelled:vi?"Đã hủy":"Cancelled",quarantined:vi?"Chờ kiểm tra":"Quarantined",reviewed:vi?"Đã kiểm tra":"Reviewed",rejected:vi?"Bị từ chối":"Rejected"}[value]??value);
const evidenceReady=(assignmentId:string,required:number)=>!required||(d.evidence[assignmentId]??[]).some(item=>item.state==="reviewed"&&!item.object_deleted_at);
const offsetLabel=(days:number)=>days===0?(vi?"đúng ngày hạn":"on the due date"):days>0?(vi?`${days} ngày trước hạn`:`${days} days before deadline`):(vi?`${Math.abs(days)} ngày sau hạn`:`${Math.abs(days)} days after deadline`);
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Đào tạo và chứng chỉ theo từng phiên bản":"Versioned training and certifications"}</strong><p>{vi?"Không có khóa học, hạn hoàn thành hoặc chu kỳ gia hạn mặc định. Chứng chỉ PDF được cách ly, dùng lưu trữ riêng và phải do HRM Admin/System Super Admin khác người tải lên kiểm tra. Hoàn tất đào tạo không tự cấp quyền hay thay đổi lương.":"No course, due date or renewal period is assumed. Certificate PDFs are quarantined under a separate retention category and must be reviewed by a different HRM Admin/System Super Admin. Completion never provisions access or changes payroll."}</p></section>
 {d.error&&<p class="crm-notice error" role="alert">{vi?"Không thể lưu thay đổi: ":"Could not save: "}{d.error}</p>}
 {d.saved&&<p class="crm-notice success" role="status">{vi?"Đã lưu thay đổi.":"Changes saved."}</p>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Nhắc hạn đào tạo":"Training reminders"}</h2>
  <p>{vi?"Nhắc hạn chỉ hiện trong HRM cho nhân viên được giao và người phụ trách giao khóa học. Thời điểm được cấu hình tại Thiết lập HRM; thông báo không được gửi ra ngoài.":"Reminders stay inside HRM and are visible only to the assigned employee and the HR member who assigned the course. Configure offsets in HRM settings; no external message is sent."}</p>
  {d.reminders.length===0?<p class="crm-empty">{vi?"Hiện không có nhắc hạn chưa đọc.":"There are no unread training reminders."}</p>:<div class="crm-list">{d.reminders.map(reminder=><article class="crm-row"><div><strong>{reminder.employee_code} · {reminder.employee_name} · {reminder.course_code}</strong><p class="crm-meta">{reminder.course_title} · {reminder.deadline_kind==="completion"?(vi?"Hạn hoàn thành":"Completion due"):(vi?"Hạn gia hạn":"Renewal due")}: {reminder.due_on} · {offsetLabel(reminder.days_before_due)}</p></div><form method="post" action="/api/hrm/training/reminders"><input type="hidden" name="intent" value="read_reminder"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="reminder_ref" value={reminder.reminder_ref}/><input type="hidden" name="version" value={reminder.version}/><button class="crm-button secondary small">{vi?"Đã xem":"Mark read"}</button></form></article>)}</div>}
  {d.hasMoreReminders&&<a class="crm-button secondary small" href={`${returnTo}?reminder_page=${d.reminderPage+1}`}>{vi?"Xem nhắc tiếp theo":"Next reminders"}</a>}
 </section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo phiên bản khóa học":"Create a course version"}</h2>
  {d.legalEntity?<form class="crm-form" method="post" action="/api/hrm/training"><input type="hidden" name="intent" value="create_course"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="legal_entity" value={d.legalEntity}/>
   <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Mã khóa học":"Course code"}</span><input class="crm-input" name="course_code" maxlength="48" required/></label><label class="crm-field"><span>{vi?"Nhóm":"Category"}</span><select class="crm-input" name="category"><option value="compliance">{categoryLabel("compliance")}</option><option value="role">{categoryLabel("role")}</option><option value="professional">{categoryLabel("professional")}</option><option value="development">{categoryLabel("development")}</option><option value="certification">{categoryLabel("certification")}</option><option value="other">{categoryLabel("other")}</option></select></label></div>
   <label class="crm-field"><span>{vi?"Tên khóa học/chứng chỉ":"Course or certificate name"}</span><input class="crm-input" name="title" maxlength="160" required/></label>
   <label class="crm-field"><span>{vi?"Mô tả":"Description"}</span><textarea class="crm-input" name="description" maxlength="2000" rows="3" required></textarea></label>
   <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Có cần nộp PDF chứng cứ?":"Require PDF evidence?"}</span><select class="crm-input" name="evidence_required" required><option value="1">{vi?"Có — bắt buộc":"Yes — required"}</option><option value="0">{vi?"Không":"No"}</option></select></label><label class="crm-field"><span>{vi?"Chu kỳ gia hạn ngày (để trống nếu không cấu hình)":"Renewal interval in days (blank if not configured)"}</span><input class="crm-input" type="number" min="1" max="36500" name="renewal_days"/></label></div>
   <button class="crm-button">{vi?"Tạo bản nháp":"Create draft"}</button>
  </form>:<p class="crm-empty">{vi?"Cấu hình pháp nhân HRM trước khi tạo khóa học.":"Configure the HRM legal entity before creating a course."}</p>}
 </section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Phiên bản khóa học":"Course versions"}</h2>{d.courses.length===0?<p class="crm-empty">{vi?"Chưa có khóa học; không có yêu cầu mặc định.":"No courses exist; no training requirement is assumed."}</p>:<div class="crm-list">{d.courses.map(course=><article class="crm-row"><div><strong>{course.course_code} · v{course.version_no} · {course.title}</strong><p class="crm-meta">{categoryLabel(course.category)} · {stateLabel(course.state)} · {course.legal_entity}</p><p>{course.description}</p><p class="crm-meta">{course.evidence_required? (vi?"Cần PDF chứng cứ":"PDF evidence required"):(vi?"Không yêu cầu PDF":"No PDF required")} · {course.renewal_days?`${vi?"Gia hạn sau":"Renew every"} ${course.renewal_days} ${vi?"ngày":"days"}`:(vi?"Không cấu hình gia hạn":"No renewal configured")}</p></div>
   {course.state==="draft"&&d.user.can("hrm.training.approve")&&course.created_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/training"><input type="hidden" name="intent" value="activate_course"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="course_id" value={course.id}/><input type="hidden" name="course_revision" value={course.revision}/><label class="crm-field"><span>{vi?"Lý do xác nhận phiên bản":"Independent review reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button">{vi?"Kích hoạt":"Activate"}</button></form>}
   {course.state==="active"&&<form class="crm-form" method="post" action="/api/hrm/training"><h3 class="crm-h3">{vi?"Giao khóa học":"Assign course"}</h3><input type="hidden" name="intent" value="assign_course"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="course_id" value={course.id}/><label class="crm-field"><span>{vi?"Nhân viên":"Employee"}</span><select class="crm-input" name="person_id" required>{(d.people??[]).filter(person=>person.legal_entity===course.legal_entity).map(person=><option value={person.id}>{person.employee_code} · {person.display_name} · {person.department}</option>)}</select></label><label class="crm-field"><span>{vi?"Hạn hoàn thành (tùy chọn)":"Completion due date (optional)"}</span><input class="crm-input" type="date" name="due_on"/></label><button class="crm-button secondary">{vi?"Giao khóa học":"Assign course"}</button></form>}
  </article>)}</div>}</section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tiến độ nhân viên":"Employee progress"}</h2>{d.assignments.length===0?<p class="crm-empty">{vi?"Chưa giao khóa học nào.":"No courses have been assigned."}</p>:<div class="crm-list">{d.assignments.map(item=>{
   const evidence=d.evidence[item.id]??[],ready=evidenceReady(item.id,item.evidence_required);
   return <article class="crm-row"><div><strong>{item.employee_code} · {item.display_name} · {item.course_code} v{item.course_version_no}</strong><p class="crm-meta">{item.course_title} · {categoryLabel(item.category)} · {stateLabel(item.state)}{item.due_on?` · ${vi?"Hạn":"Due"} ${item.due_on}`:""}{item.renew_by?` · ${vi?"Gia hạn":"Renew by"} ${item.renew_by}`:""}</p>{item.employee_note&&<p>{vi?"Ghi chú nhân viên: ":"Employee note: "}{item.employee_note}</p>}{item.review_reason&&<p>{vi?"Lý do: ":"Decision reason: "}{item.review_reason}</p>}{item.evidence_required&&!ready&&<p class="crm-meta">{vi?"Chứng cứ PDF cần được duyệt trước khi xác nhận hoàn tất.":"Required PDF evidence must be approved before completion can be verified."}</p>}</div>
    <div class="crm-actions">{evidence.map(file=><div class="crm-row"><div><a href={`/api/hrm/training/evidence/${encodeURIComponent(file.id)}`}>{file.original_name}</a><p class="crm-meta">{stateLabel(file.state)} · {file.created_at}</p>{file.review_reason&&<p>{file.review_reason}</p>}</div>{file.state==="quarantined"&&d.user.can("hrm.training.approve")&&file.uploaded_by!==d.user.id&&item.created_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/training/evidence"><input type="hidden" name="intent" value="review_evidence"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="evidence_id" value={file.id}/><input type="hidden" name="file_version" value={file.version}/><label class="crm-field"><span>{vi?"Lý do kiểm tra":"Review reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><div class="crm-actions"><button class="crm-button" name="decision" value="approve">{vi?"Duyệt PDF":"Approve PDF"}</button><button class="crm-button danger" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></div></form>}</div>)}
    {item.state==="assigned"&&<form class="crm-form" method="post" action="/api/hrm/training"><input type="hidden" name="intent" value="cancel_assignment"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={item.id}/><input type="hidden" name="assignment_revision" value={item.revision}/><label class="crm-field"><span>{vi?"Lý do hủy giao":"Cancellation reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button danger small">{vi?"Hủy giao":"Cancel assignment"}</button></form>}
    {item.state==="submitted"&&d.user.can("hrm.training.approve")&&item.created_by!==d.user.id&&item.actor_id!==d.user.id&&ready&&<form class="crm-form" method="post" action="/api/hrm/training"><input type="hidden" name="intent" value="decide_completion"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={item.id}/><input type="hidden" name="assignment_revision" value={item.revision}/><label class="crm-field"><span>{vi?"Lý do quyết định":"Decision reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><div class="crm-actions"><button class="crm-button" name="decision" value="approve">{vi?"Xác nhận hoàn tất":"Verify completion"}</button><button class="crm-button danger" name="decision" value="decline">{vi?"Yêu cầu bổ sung":"Needs follow-up"}</button></div></form>}</div>
   </article>;
  })}</div>}</section>
</HrmPage>
