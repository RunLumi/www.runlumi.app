---
import HrmPage from "./HrmPage.astro";
import { sections, recordKinds } from "../../lib/hrm/fields";
import type { ProfileResult } from "../../lib/hrm/pages";
import type { PrivateFile } from "../../lib/hrm/service";
interface Props extends ProfileResult { files?:PrivateFile[]; fileKind?:string }
const d=Astro.props;const vi=d.vi;const kind=d.kind;const schema=sections[kind];const isOwn=d.person.user_id===d.user.id;const path=isOwn?(vi?"/vi/hrm/me":"/hrm/me"):`${vi?"/vi":""}/hrm/people/${encodeURIComponent(d.person.id)}/profile`;const canReview=(submittedBy:string)=>d.user.can("hrm.records.manage")&&submittedBy!==d.user.id&&!isOwn;
const data=(row:string)=>{try{return JSON.parse(row) as Record<string,string>}catch{return {}}};
const newest=d.records[0];const values=newest?data(newest.data):{};
const messages:Record<string,[string,string]>={submitted:["Your change was sent for HR review.","Đề nghị đã được gửi HR xét duyệt."],approved:["Change approved.","Đã duyệt thay đổi."],rejected:["Change declined.","Đã từ chối thay đổi."],withdrawn:["Request withdrawn.","Đã rút yêu cầu."],conflict:["The record changed; reload before retrying.","Hồ sơ đã đổi; hãy tải lại trước khi thử lại."],self_approval:["A person cannot approve their own request.","Không thể tự duyệt yêu cầu của mình."],reason_required:["Give a short reason for the decision.","Hãy ghi lý do ngắn cho quyết định."]};
const dateTime=(value:string)=>new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"});
const stateLabel=(state:string)=>({unverified:vi?"Chưa xác minh":"Unverified",verified:vi?"Đã kiểm tra":"Reviewed",ended:vi?"Đã kết thúc":"Ended",submitted:vi?"Chờ duyệt":"Awaiting review",rejected:vi?"Từ chối":"Declined"}[state]||state);
const fileMessages:Record<string,[string,string]>={quarantined:["Awaiting review","Chờ rà soát"],reviewed:["Reviewed by HR","HR đã rà soát"],rejected:["Rejected","Đã từ chối"]};
---
<HrmPage data={d} current="profile">
 <div class="crm-sheet crm-employee-heading"><div><p class="crm-eyebrow">{d.person.employee_code} · {stateLabel(d.person.status)}</p><h2 class="crm-h2">{d.person.preferred_name||d.person.legal_name}</h2><p class="crm-meta">{d.person.job_title||"—"}{d.person.department?` · ${d.person.department}`:""} · {d.person.work_email||"—"}</p></div>{d.user.can("hrm.records.manage")&&<a class="crm-button secondary" href={`${vi?"/vi":""}/hrm/people/${encodeURIComponent(d.person.id)}`}>{vi?"Thông tin công việc":"Work details"}</a>}</div>
 {d.saved&&<div class="crm-notice good" role="status">{messages[new URL(Astro.url).searchParams.get("saved")||""]?.[vi?1:0]??(vi?"Đã lưu.":"Saved.")}</div>}
 {d.error&&<div class="crm-notice bad" role="alert">{messages[d.error]?.[vi?1:0]??(vi?"Không thể hoàn tất yêu cầu.":"The request could not be completed.")}</div>}
 {Astro.url.searchParams.has("file")&&<div class="crm-notice good" role="status">{vi?"Đã nhận tệp; HR cần rà soát trước khi người khác tải.":"File uploaded; HR must review it before others can download it."}</div>}
 <nav class="crm-tabs" aria-label={vi?"Nhóm hồ sơ":"Profile sections"}>{recordKinds.filter(k=>(isOwn&&d.user.can("hrm.profile.self"))||(d.user.can("hrm.records.manage")&&(!sections[k].permission||d.user.can(sections[k].permission!)))).map(k=><a aria-current={kind===k?"page":undefined} href={`${path}?section=${k}`}>{vi?sections[k].vi:sections[k].en}</a>)}</nav>
 <section class="crm-sheet">
  <h2 class="crm-h2">{vi?schema.vi:schema.en}</h2>
  {newest&&<p class="crm-meta">{vi?"Phiên bản":"Revision"} {newest.version} · {stateLabel(newest.state)}{newest.verified_at?` · ${vi?"Rà soát":"Reviewed"} ${dateTime(newest.verified_at)}`:""}</p>}
  <form method="post" class="crm-form"><input type="hidden" name="intent" value="submit"/><input type="hidden" name="section" value={kind}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="record_id" value={newest?.id||""}/><input type="hidden" name="expected_version" value={newest?.version||0}/>
   <div class="crm-form-grid">{schema.fields.map(field=><div class="crm-field"><label for={`f-${field.key}`}>{vi?field.vi:field.en}</label><input class="crm-input" id={`f-${field.key}`} name={field.key} type={field.type||"text"} maxlength={field.max||200} required={field.required||undefined} value={values[field.key]||""}/></div>)}</div>
   {(kind==="identity"||kind==="dependent"||kind==="bank"||kind==="tax")&&<div class="crm-form-grid"><div class="crm-field"><label for="effective_from">{vi?"Có hiệu lực từ (nếu có)":"Effective from (if applicable)"}</label><input class="crm-input" id="effective_from" name="effective_from" type="date" value={newest?.effective_from||""}/></div><div class="crm-field"><label for="effective_to">{vi?"Có hiệu lực đến (nếu có)":"Effective to (if applicable)"}</label><input class="crm-input" id="effective_to" name="effective_to" type="date" value={newest?.effective_to||""}/></div></div>}
   <div class="crm-actions"><button class="crm-button" type="submit">{kind==="contact"&&d.person.user_id===d.user.id?(vi?"Lưu thông tin liên hệ":"Save contact information"):(vi?"Gửi HR xác minh":"Submit for HR review")}</button>{kind==="dependent"&&<button class="crm-button secondary" type="submit" name="new_record" value="1">{vi?"Thêm người phụ thuộc":"Add another dependent"}</button>}</div>
  </form>
  {kind==="dependent"&&d.records.length>0&&<ul class="crm-list">{d.records.map(record=><li class="crm-row"><strong>{data(record.data).name||"—"}</strong><span>{data(record.data).relationship||"—"}</span><span class="crm-meta">{stateLabel(record.state)}</span></li>)}</ul>}
 </section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tệp đính kèm":"Attachments"}</h2><p>{vi?"PDF, PNG, JPEG tối đa 5 MB. Tệp tải lên được cách ly; trạng thái HR rà soát không đồng nghĩa đã quét virus.":"PDF, PNG or JPEG up to 5 MB. New files are quarantined; HR review does not mean an antivirus scan has passed."}</p>
  {d.files?.map(file=><article class="crm-row"><span><strong>{file.original_name}</strong><br/><span class="crm-meta">{Math.ceil(file.size_bytes/1024)} KB · {file.object_deleted_at?(vi?"Object đã xóa theo retention":"Object deleted under retention policy"):(fileMessages[file.state]?.[vi?1:0]??file.state)}{file.reviewed_by?` · ${file.reviewed_by}`:""}</span></span><span class="crm-actions">{!file.object_deleted_at&&<a class="crm-button secondary small" href={`/api/hrm/files/${encodeURIComponent(file.id)}`}>{vi?"Tải xuống":"Download"}</a>}{!file.object_deleted_at&&file.state==="quarantined"&&d.user.can("hrm.files.review")&&<form method="post" action={`/api/hrm/files/${encodeURIComponent(file.id)}`} class="crm-actions"><input type="hidden" name="person_id" value={d.person.id}/><input type="hidden" name="version" value={file.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={path}/><input type="hidden" name="section" value={kind}/><input class="crm-input crm-review-reason" name="reason" aria-label={vi?"Lý do rà soát":"Review reason"} required maxlength="500" placeholder={vi?"Ghi rõ nội dung đã kiểm tra":"Describe what was reviewed"}/><button class="crm-button small" name="intent" value="reviewed">{vi?"Đã rà soát":"Reviewed"}</button><button class="crm-button small danger" name="intent" value="rejected">{vi?"Từ chối":"Reject"}</button></form>}</span></article>)}
  <form method="post" action="/api/hrm/files/upload" enctype="multipart/form-data" class="crm-form crm-upload"><input type="hidden" name="person_id" value={d.person.id}/><input type="hidden" name="kind" value={kind==="contact"?"personal":kind}/><input type="hidden" name="record_id" value={kind==="contact"?"":newest?.id||""}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={path+`?section=${kind}`}/><div class="crm-field"><label for="file">{vi?"Tải PDF, PNG hoặc JPEG":"Upload PDF, PNG or JPEG"}</label><input id="file" class="crm-input" type="file" name="file" accept="application/pdf,image/png,image/jpeg" required/></div><button class="crm-button secondary" type="submit">{vi?"Tải tệp lên":"Upload file"}</button></form>
 </section>
 {d.changes.length>0&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Yêu cầu và lịch sử":"Requests and history"}</h2><div class="crm-list">{d.changes.map(change=><article class="crm-row"><div><strong>{stateLabel(change.state)} · {dateTime(change.created_at)}</strong><pre class="crm-json">{JSON.stringify(data(change.data),null,2)}</pre>{change.review_reason&&<p>{change.review_reason}</p>}</div>{change.state==="submitted"&&(canReview(change.submitted_by)||change.submitted_by===d.user.id)&&<form method="post" class="crm-form"><input type="hidden" name="intent" value="review"/><input type="hidden" name="section" value={kind}/><input type="hidden" name="change_id" value={change.id}/><input type="hidden" name="version" value={change.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do / ghi chú":"Reason / note"}</span><input class="crm-input" name="reason" required maxlength="500"/></label>{canReview(change.submitted_by)&&<><button class="crm-button small" name="decision" value="approved">{vi?"Duyệt":"Approve"}</button><button class="crm-button small danger" name="decision" value="rejected">{vi?"Từ chối":"Reject"}</button></>}{change.submitted_by===d.user.id&&<button class="crm-button secondary small" name="decision" value="withdrawn">{vi?"Rút yêu cầu":"Withdraw"}</button>}</form>}</article>)}</div></section>}
</HrmPage>
