---
import type { LeaveRequest } from "../../lib/hrm/time-leave";
import type { WorkspaceUser } from "../../lib/workspace/roles";
const {request,user,vi,returnTo,manager}=Astro.props as {request:LeaveRequest;user:WorkspaceUser;vi:boolean;returnTo:string;manager:boolean};
const pending=request.state==="pending_approval",fileDeleted=!!request.evidence_deleted_at,fileState=fileDeleted?"deleted":request.evidence_state||"",canUpload=(manager?user.can("hrm.leave.manage"):user.can("hrm.leave.self"))&&pending&&(fileDeleted||fileState!=="quarantined"&&fileState!=="reviewed");
const canReview=manager&&user.can("hrm.leave.review")&&pending&&fileState==="quarantined"&&request.evidence_uploaded_by!==user.id&&request.submitted_by!==user.id;
const evidenceLabel=fileState==="reviewed"?(vi?"Chứng từ đã được rà soát":"Evidence reviewed"):fileState==="quarantined"?(vi?"PDF đang chờ HR rà soát":"PDF awaiting HR review"):fileState==="rejected"?(vi?"PDF cần được nộp lại":"PDF needs replacement"):fileState==="deleted"?(vi?"PDF cũ đã được xử lý theo chính sách lưu trữ; cần nộp lại":"Prior PDF was disposed under retention; replacement required"):request.evidence_superseded===1?(vi?"Đơn đã được sửa; PDF cũ thuộc revision trước và cần nộp lại":"Request amended; prior PDF belongs to an older revision and must be replaced"):(vi?"Chưa nộp PDF bắt buộc":"Required PDF not submitted");
const download=request.evidence_file_id?`/api/hrm/leave/evidence/${encodeURIComponent(request.evidence_file_id)}`:"";
---
{request.evidence_required===1&&<section class="crm-notice warn" aria-label={vi?"Chứng từ nghỉ phép":"Leave evidence"}>
 <strong>{vi?"Chứng từ nghỉ phép":"Leave evidence"}: {evidenceLabel}</strong>
 {fileState==="reviewed"&&request.evidence_reviewed_at&&<p>{vi?"Rà soát lúc":"Reviewed at"} {new Date(request.evidence_reviewed_at).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"})}</p>}
 {request.evidence_file_id&&!fileDeleted&&(fileState==="quarantined"||fileState==="reviewed"||fileState==="rejected")&&<p><a class="crm-button secondary small" href={download}>{vi?"Tải PDF riêng tư":"Download private PDF"}</a></p>}
 {canUpload&&<form class="crm-form" method="post" action="/api/hrm/leave/evidence/upload" enctype="multipart/form-data"><input type="hidden" name="intent" value="upload"/><input type="hidden" name="return_to" value={`${returnTo}#leave-${request.id}`}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="request_version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Tải PDF chứng từ (tối đa 5 MB)":"Upload PDF evidence (up to 5 MB)"}</span><input class="crm-input" type="file" name="file" accept=".pdf,application/pdf" required/></label><button class="crm-button secondary small" type="submit">{vi?"Gửi PDF để HR rà soát":"Submit PDF for HR review"}</button></form>}
 {fileState==="quarantined"&&canReview&&<form class="crm-form" method="post" action={download}><input type="hidden" name="intent" value="review"/><input type="hidden" name="return_to" value={`${returnTo}#leave-${request.id}`}/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="request_version" value={request.version}/><input type="hidden" name="file_version" value={request.evidence_version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do rà soát chứng từ":"Evidence review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Rà soát đạt":"Mark reviewed"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Yêu cầu nộp lại":"Reject and request replacement"}</button></form>}
 {fileState==="quarantined"&&!canReview&&<p class="crm-meta">{vi?"Chỉ người rà soát được phân công mới có thể mở và duyệt PDF.":"Only an assigned reviewer may open and review this PDF."}</p>}
</section>}
