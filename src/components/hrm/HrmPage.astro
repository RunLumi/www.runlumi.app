---
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import type { Failure, PageBase } from "../../lib/hrm/pages";
interface Props { data: PageBase|Failure; module?:"hrm"; current?:string }
const {data}=Astro.props;const vi=data.vi;
const messages:Record<string,[string,string]>={
 hrm_closed:["HRM is not activated. The owner’s configuration and deployment gate are still closed.","HRM chưa được kích hoạt. Cấu hình của owner và cổng production hiện vẫn đóng."],
 policy_required:["Complete and review the policy source, purpose and retention configuration first.","Hãy điền và rà soát nguồn chính sách, mục đích xử lý và thời hạn lưu trước."],
 activation_closed:["The deployment kill switch is off. Ask the owner to enable HRM only after the policy gate passes.","Công tắc triển khai HRM đang tắt. Hãy nhờ owner bật sau khi chính sách đã qua cổng rà soát."],
 invalid_origin:["The request origin was rejected.","Nguồn gửi yêu cầu không hợp lệ."],
 invalid_form:["The form could not be read.","Không đọc được biểu mẫu."],
 conflict:["The record changed since it was opened. Reload and review the latest revision.","Hồ sơ đã thay đổi. Hãy tải lại và kiểm tra phiên bản mới nhất."],
 request_key_conflict:["This request key was already used for different data.","Mã yêu cầu này đã được dùng cho dữ liệu khác."],
 self_approval:["A person cannot review their own request or file.","Không thể tự duyệt yêu cầu hoặc tệp của chính mình."],
 evidence_required:["Add a reference to the external evidence before setting this status.","Hãy thêm tham chiếu bằng chứng bên ngoài trước khi đặt trạng thái."],
 invalid_email:["Enter a valid email address.","Hãy nhập địa chỉ email hợp lệ."],
 invalid_date:["Check the dates. The end date must not come before the start date.","Hãy kiểm tra ngày. Ngày kết thúc không được trước ngày bắt đầu."],
 file_type:["That file’s contents do not match an allowed PDF, JPEG or PNG upload.","Nội dung tệp không khớp PDF, JPEG hoặc PNG được phép."],
 file_size:["Files must be no larger than 5 MB.","Tệp không được lớn hơn 5 MB."],
 invalid_account:["Choose an existing, active EmDash account.","Hãy chọn tài khoản EmDash đang hoạt động."],
};
let title=data.title||"HRM";let error="error" in data?data.error:undefined;
---
<WorkspaceShell title={title} lang={data.lang} user={data.user} module={Astro.props.module??"hrm"} current={Astro.props.current}>
  <div class="crm-head"><div>
    <p class="crm-eyebrow">HRM</p>
    <h1 class="crm-h1">{title}</h1>
  </div></div>
  {error && <div class="crm-notice bad" role="alert"><strong>{vi?"Chưa hoàn tất":"Could not complete"}</strong><p>{messages[error]?.[vi?1:0]??(vi?"Yêu cầu không hợp lệ hoặc hồ sơ không còn khả dụng.":"The request is invalid or the record is no longer available.")}</p></div>}
  {error==="hrm_closed" && data.user.can("hrm.configure") && <div class="crm-sheet"><p>{vi?"Cấu hình chính sách, mục đích sử dụng và retention trước khi mở cổng. Cài đặt ở HRM → Thiết lập.":"Configure the legal entity, purpose and retention policy before opening the module. Use HRM → Settings."}</p><a class="crm-button secondary" href={vi?"/vi/hrm/settings":"/hrm/settings"}>{vi?"Mở thiết lập":"Open settings"}</a></div>}
  <slot />
</WorkspaceShell>
