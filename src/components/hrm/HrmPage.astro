 asset_reminder_decision_invalid:["Choose a valid reminder-policy decision.","Chọn quyết định hợp lệ cho lịch nhắc."],
 offboarding_system_admin_protected:["A System Super Admin account cannot be disabled through employee offboarding.","Không thể tắt tài khoản System Super Admin qua quy trình offboarding nhân viên."],
 offboarding_access_pending:["Workspace access could not be verified as revoked. Keep this task open and retry after review.","Chưa xác minh được quyền Workspace đã bị thu hồi. Hãy giữ việc mở và thử lại sau khi rà soát."],
 offboarding_not_assigned:["This task is not assigned to your account.","Việc này không được phân công cho tài khoản của bạn."],
 offboarding_not_waivable:["This offboarding task cannot be marked not required.","Không thể đánh dấu việc offboarding này là không cần áp dụng."],
 offboarding_end_date_required:["Set the employment end date before ending the period.","Hãy đặt ngày kết thúc trước khi kết thúc đợt làm việc."],
 offboarding_self_revoke:["You cannot revoke your own Workspace membership through offboarding.","Bạn không thể tự thu hồi quyền Workspace của mình qua quy trình offboarding."],
 forbidden:["Your role cannot perform this offboarding action.","Vai trò của bạn không được phép thực hiện thao tác offboarding này."],
 retention_policy_invalid:["Every category needs one explicit retention value (or null for no scheduled deletion) and a reviewed basis.","Mỗi danh mục cần một thời hạn tường minh (hoặc null để không lên lịch xóa) và căn cứ đã rà soát."],
 retention_policy_missing:["No active, reviewed retention policy exists. No deletion is permitted.","Chưa có chính sách lưu trữ active đã rà soát. Không được xóa tệp."],
 retention_deletion_in_progress:["Finish or recover deletion jobs under the active policy before activating a replacement version.","Hãy hoàn tất hoặc khôi phục các tác vụ xóa theo chính sách hiện hành trước khi kích hoạt phiên bản thay thế."],
 retention_policy_review_required:["A different authorized reviewer must review this retention version before activation.","Một người rà soát được cấp quyền và khác người tạo phải rà soát phiên bản retention trước khi kích hoạt."],
 retention_category_manual_review:["This category has no scheduled retention date; a reviewed category rule is required before deletion.","Danh mục này chưa có ngày hết hạn; cần quy tắc đã rà soát trước khi xóa."],
 retention_category_unconfigured:["The active policy does not define this file category.","Chính sách active chưa định nghĩa danh mục tệp này."],
 retention_not_due:["The approved retention date has not arrived.","Chưa đến ngày hết hạn lưu được phê duyệt."],
 legal_hold_active:["An active legal hold blocks deletion of this file.","Legal hold đang hiệu lực nên chặn xóa tệp này."],
 legal_hold_scope_invalid:["Choose one valid employee/category scope or one file.","Chọn đúng một phạm vi hồ sơ/danh mục hoặc một tệp."],
 retention_file_unreviewed:["A quarantined file cannot enter the deletion queue before review.","Không thể đưa tệp đang cách ly vào hàng chờ xóa trước khi rà soát."],
 retention_file_date_invalid:["The file timestamp is invalid; no retention date can be calculated.","Thời điểm tệp không hợp lệ; không thể tính ngày hết hạn lưu."],
 retention_policy_changed:["The active retention policy changed after this request. Create a new reviewed request.","Chính sách retention active đã đổi sau yêu cầu này. Hãy tạo yêu cầu mới đã rà soát."],
 retention_file_changed:["The file changed after the request was created. Review its current revision.","Tệp đã đổi sau khi tạo yêu cầu. Hãy rà soát phiên bản hiện tại."],
 retention_execution_system_admin_only:["Only System Super Admin can execute physical object deletion.","Chỉ System Super Admin mới được thực hiện xóa object vật lý."],
 retention_executor_must_differ:["The System Super Admin executing deletion must differ from both the requester and reviewer.","System Super Admin thực hiện xóa phải khác cả người tạo yêu cầu và người rà soát."],
 retention_delete_failed:["Object deletion or metadata finalization failed. The request remains retryable; review before retrying.","Xóa object hoặc chốt metadata thất bại. Yêu cầu còn trạng thái có thể thử lại; hãy rà soát trước khi thử."],
 retention_request_system_admin_not_needed:["Create the retention request through an HRM operator account; System Super Admin is reserved for final execution.","Hãy tạo yêu cầu bằng tài khoản HRM; System Super Admin dành cho bước thực hiện cuối."],
 retention_hold_deletion_in_progress:["A physical deletion is already in progress or needs recovery. Resolve it before placing a new hold.","Đang xóa vật lý hoặc đang cần khôi phục. Hãy xử lý trước khi đặt hold mới."],
 legal_hold_record_disposed:["This category contains a completed structured-record disposition. A new hold cannot restore data already redacted.","Danh mục này đã có hồ sơ cấu trúc được xử lý. Legal hold mới không thể khôi phục dữ liệu đã xóa."],
 structured_retention_policy_invalid:["Enter exactly one explicit anchor, duration and reviewed basis for every structured-record category; use null to leave a category unscheduled.","Nhập đủ từng danh mục với mốc tính, thời hạn và căn cứ đã rà soát; dùng null để không lên lịch tự động."],
 structured_retention_policy_missing:["No active structured-record retention policy exists. No structured record can be disposed.","Chưa có chính sách lưu trữ hồ sơ cấu trúc đang hoạt động; không thể xử lý hồ sơ."],
 structured_retention_policy_changed:["The structured-record retention policy changed after this request. Create a new reviewed request.","Chính sách lưu trữ hồ sơ cấu trúc đã thay đổi sau yêu cầu; hãy tạo yêu cầu mới để rà soát."],
 structured_retention_category_unconfigured:["The active policy does not define this structured-record category.","Chính sách đang hoạt động chưa định nghĩa danh mục hồ sơ cấu trúc này."],
 structured_retention_manual_review:["This category has no scheduled retention duration; owner-approved manual review is required.","Danh mục này không có thời hạn tự động; cần owner phê duyệt quy trình rà soát thủ công."],
 structured_retention_anchor_unavailable:["The configured retention anchor is not available for this record.","Hồ sơ chưa có mốc tính thời hạn lưu đã cấu hình."],
 structured_record_files_pending:["Dispose linked private files through the separate reviewed file-retention queue first.","Hãy xử lý tệp riêng tư đã liên kết qua hàng chờ retention riêng trước."],
 structured_record_change_pending:["Resolve pending profile changes before requesting structured-record disposition.","Hãy xử lý các yêu cầu đổi hồ sơ đang chờ trước khi yêu cầu xử lý dữ liệu cấu trúc."],
 structured_record_changed:["The profile record changed after the disposition request. Review the current revision.","Hồ sơ đã thay đổi sau yêu cầu xử lý; hãy rà soát phiên bản hiện tại."],
 structured_record_already_disposed:["This profile record has already been redacted.","Hồ sơ này đã được ẩn dữ liệu."],
 structured_disposition_in_progress:["This record has a disposition request in progress or already completed.","Hồ sơ này đang có yêu cầu xử lý hoặc đã hoàn tất."],
 calendar_invalid:["Check the timezone, all seven weekday entries, shift intervals, holidays and reviewed overtime basis.","Hãy kiểm tra múi giờ, đủ bảy ngày, ca làm, ngày nghỉ và căn cứ OT đã rà soát."],
 calendar_review_required:["A different authorized reviewer must review this calendar before activation.","Một người rà soát được cấp quyền và khác người tạo phải rà soát lịch trước khi kích hoạt."],
 calendar_not_active:["Assign an active, reviewed calendar version.","Hãy gán một phiên bản lịch đã rà soát và đang hoạt động."],
 calendar_assignment_missing:["No calendar assignment is effective for this employee and date.","Không có lịch được gán có hiệu lực cho nhân viên vào ngày này."],
 calendar_shift_missing:["The selected shift does not exist on this weekday or configured holiday.","Ca đã chọn không áp dụng vào ngày làm việc hoặc ngày nghỉ này."],
 time_entry_shift_date_mismatch:["The check-in/out dates do not match the assigned shift and timezone.","Ngày vào/ra không khớp ca và múi giờ được gán."],
 time_interval_invalid:["Check the timestamp order, duration and break minutes.","Hãy kiểm tra thứ tự thời điểm, thời lượng và số phút nghỉ."],
 overtime_not_allowed:["The assigned calendar does not allow overtime.","Lịch được gán không cho phép làm thêm giờ."],
 overtime_requires_approval:["This overtime must be reviewed before the attendance can be approved.","Thời gian làm thêm phải được rà soát trước khi duyệt chấm công."],
 time_overtime_review_required:["Resolve the separate overtime decision before reviewing attendance.","Hãy xử lý quyết định OT riêng trước khi rà soát chấm công."],
 time_period_not_open:["This date is outside an open attendance period.","Ngày này không nằm trong kỳ chấm công đang mở."],
 time_period_locked:["The attendance period is locked. Request a reviewed reopening before changes.","Kỳ chấm công đã khóa. Hãy yêu cầu mở lại có rà soát trước khi chỉnh sửa."],
 time_period_locked_calendar_change:["Reopen the affected attendance period before changing this calendar assignment.","Hãy mở lại kỳ chấm công bị ảnh hưởng trước khi đổi ngày hiệu lực của lịch."],
 time_period_entries_unreviewed:["Every attendance entry must be independently reviewed before locking.","Mọi dòng chấm công phải được rà soát độc lập trước khi khóa."],
 time_period_incomplete:["Attendance is missing for one or more scheduled shifts.","Còn thiếu chấm công cho một hoặc nhiều ca đã lên lịch."],
 time_entry_off_schedule:["An entry does not match an effective calendar assignment.","Một dòng chấm công không khớp lịch được gán có hiệu lực."],
 time_period_adjustment_pending:["Resolve pending time adjustments before locking the period.","Hãy xử lý giải trình chấm công đang chờ trước khi khóa kỳ."],
 time_period_leave_pending:["Resolve leave requests and cancellation requests before locking the period.","Hãy xử lý đơn nghỉ và yêu cầu hủy đang chờ trước khi khóa kỳ."],
 leave_policy_invalid:["Check each leave type, minute limit, and reviewed policy basis.","Hãy kiểm tra từng loại phép, hạn mức phút và căn cứ chính sách đã rà soát."],
 leave_policy_review_required:["A different authorized reviewer must review this leave policy before activation.","Một người rà soát được cấp quyền và khác người tạo phải rà soát chính sách phép trước khi kích hoạt."],
 leave_policy_not_active:["Assign an active, reviewed leave policy version.","Hãy gán phiên bản chính sách phép đã rà soát và đang hoạt động."],
 leave_policy_assignment_missing:["No leave policy and work calendar are effective for these dates.","Không có chính sách phép và lịch làm việc có hiệu lực trong các ngày này."],
 leave_range_crosses_policy:["Split this request at a policy or calendar effective-date boundary.","Hãy tách đơn tại mốc đổi ngày hiệu lực của chính sách hoặc lịch."],
 leave_type_unavailable:["That leave type is not available in the assigned policy version.","Loại nghỉ này không có trong phiên bản chính sách được gán."],
 leave_no_work_time:["The selected date range contains no scheduled work time under this calendar.","Khoảng ngày đã chọn không có giờ làm theo lịch được gán."],
 half_day_single_workday:["A half-day request must cover exactly one scheduled workday.","Đơn nửa ngày phải đúng một ngày làm việc theo lịch."],
 leave_evidence_required:["Upload the required PDF evidence. HR must review it before this leave request can be approved.","Hãy tải PDF chứng từ bắt buộc. HR cần rà soát trước khi duyệt đơn nghỉ."],
 leave_evidence_pending:["The required PDF has not passed review yet.","PDF chứng từ bắt buộc chưa được rà soát đạt."],
 leave_evidence_not_required:["This leave type does not accept evidence uploads.","Loại nghỉ này không nhận tải chứng từ."],
 leave_evidence_already_attached:["An evidence PDF is already awaiting review or has been reviewed for this request.","Đơn đã có PDF đang chờ rà soát hoặc đã được rà soát."],
 leave_request_stale:["The leave request changed. Reload it before uploading evidence.","Đơn nghỉ đã thay đổi. Hãy tải lại trước khi nộp chứng từ."],
 leave_balance_insufficient:["The available leave balance or configured negative limit does not cover this request.","Số dư phép hoặc giới hạn âm được cấu hình không đủ cho đơn này."],
 approval_delegation_invalid:["Choose a valid date range that starts today or later, and provide a reason.","Hãy chọn khoảng ngày hợp lệ bắt đầu từ hôm nay trở đi và nêu lý do."],
 approval_delegation_target_invalid:["Choose an active Workspace People Manager account other than your own.","Hãy chọn tài khoản Quản lý trực tiếp đang hoạt động trong Workspace và không phải tài khoản của bạn."],
 approval_delegation_no_reports:["You can delegate approvals only while you manage at least one active employee.","Bạn chỉ có thể ủy quyền khi đang quản lý ít nhất một nhân viên còn làm việc."],
 approval_delegation_inactive:["This delegation is no longer active. Reload the page.","Ủy quyền này không còn hiệu lực. Hãy tải lại trang."],
 leave_cancel_requires_adjustment:["The affected time period is locked. Record a reviewed correction instead of changing this period.","Kỳ chấm công liên quan đã khóa. Hãy lập điều chỉnh có rà soát, không sửa kỳ này."],
 invalid_time:["The local time is invalid, ambiguous or falls inside a daylight-saving gap.","Giờ địa phương không hợp lệ, bị trùng do đổi giờ mùa hè hoặc rơi vào khoảng giờ bị bỏ qua."],
 payroll_closed:["Payroll is closed. Draft policy configuration may be prepared, but runs, payslips and payment records remain unavailable.","Payroll đang đóng. Có thể chuẩn bị cấu hình nháp, nhưng chưa thể tạo kỳ lương, phiếu lương hoặc xác nhận thanh toán."],
 payroll_components_invalid:["Use a valid component list with no executable formulas or unknown fields.","Hãy dùng danh sách cấu phần hợp lệ, không chứa công thức thực thi hoặc trường lạ."],
 payroll_required_earning_missing:["Include at least one required earning component.","Cần ít nhất một cấu phần thu nhập bắt buộc."],
 payroll_policy_invalid:["Check the policy key, currency scale and configured component definitions.","Hãy kiểm tra mã chính sách, số chữ số tiền tệ và các cấu phần đã cấu hình."],
 hrm_entity_unconfigured:["Set the same legal entity in HRM settings before configuring payroll.","Hãy cấu hình cùng pháp nhân trong thiết lập HRM trước khi khai báo payroll."],
 payroll_policy_review_required:["A different authorized person must review this policy before activation.","Một người có quyền và khác người tạo phải rà soát chính sách trước khi kích hoạt."],
 payroll_policy_not_active:["Select an active, reviewed payroll policy version.","Hãy chọn phiên bản chính sách payroll đã rà soát và kích hoạt."],
 payroll_time_period_not_locked:["Lock the matching attendance period before preparing payroll.","Hãy khóa kỳ công tương ứng trước khi chuẩn bị payroll."],
 payroll_correction_source_invalid:["A correction must reference the current published payslip for the same locked period and policy.","Điều chỉnh phải tham chiếu phiếu lương đang có hiệu lực của cùng kỳ công đã khóa và chính sách."],
 payroll_component_invalid:["Choose a component and source type defined in this reviewed policy.","Hãy chọn cấu phần và loại nguồn đã khai báo trong chính sách được rà soát."],
 payroll_amount_invalid:["Enter an exact non-negative integer amount in the configured minor unit.","Hãy nhập số nguyên không âm theo đơn vị nhỏ nhất đã cấu hình."],
 payroll_zero_reason_required:["A zero amount needs an explicit reason; missing inputs cannot be treated as zero.","Khoản bằng không cần lý do tường minh; dữ liệu thiếu không được xem là số không."],
 payroll_source_reference_invalid:["The source reference does not match the locked period, employment or approved adjustment.","Tham chiếu nguồn không khớp kỳ đã khóa, đợt làm việc hoặc điều chỉnh đã duyệt."],
 payroll_inputs_incomplete:["Required payroll inputs are missing for at least one employee.","Còn thiếu đầu vào payroll bắt buộc của ít nhất một nhân viên."],
 payroll_inputs_invalid:["One or more payroll inputs do not match the approved component definition.","Một hoặc nhiều đầu vào payroll không khớp cấu phần đã duyệt."],
 payroll_totals_invalid:["The exact totals exceed the safe range or deductions exceed earnings. Review the source inputs.","Tổng chính xác vượt giới hạn an toàn hoặc khấu trừ lớn hơn thu nhập. Hãy rà soát nguồn đầu vào."],
 payroll_roster_empty:["No active employment overlaps this locked period and legal entity.","Không có đợt làm việc phù hợp với kỳ đã khóa và pháp nhân này."],
 payroll_run_immutable:["Published or closed runs cannot be edited. Create a linked correction instead.","Không thể sửa kỳ lương đã phát hành hoặc đóng. Hãy tạo bản điều chỉnh có liên kết."],
 payroll_publish_blocked:["An independently reviewed and approved run is required before issue.","Cần kỳ lương đã được rà soát độc lập và phê duyệt trước khi phát hành."],
 payroll_snapshot_invalid:["The payroll snapshot does not match its current employee roster.","Snapshot payroll không khớp danh sách nhân viên hiện tại."],
 payroll_payment_exceeds_balance:["The confirmation exceeds the unpaid net amount. Check previous partial payments.","Số xác nhận vượt số thực nhận còn lại. Hãy kiểm tra các lần thanh toán một phần trước."],
 payroll_payment_date_future:["A payment can be confirmed only after its transaction date.","Chỉ xác nhận thanh toán khi ngày giao dịch đã xảy ra."],
 payroll_correction_paid_exceeds_net:["Previously confirmed payments exceed the corrected net amount. A separately reviewed recovery adjustment is required.","Các khoản đã xác nhận trả lớn hơn thực nhận sau điều chỉnh. Cần quy trình thu hồi/điều chỉnh riêng được rà soát."],
 payroll_payment_unreconciled:["Issued payslips and recorded payments must reconcile exactly, including correction carryover. Review missing amounts, underpayments or overpayments before closing.","Phiếu lương đã phát hành và các khoản thanh toán phải khớp chính xác, kể cả số đã trả chuyển sang phiếu điều chỉnh. Hãy kiểm tra số liệu thiếu, khoản trả thiếu hoặc trả thừa trước khi đóng kỳ."],
 payroll_dispute_transition_invalid:["This inquiry has changed state or the requested transition is not allowed.","Thắc mắc đã đổi trạng thái hoặc bước chuyển trạng thái này không được phép."],
 payroll_dispute_self_review:["The person who opened an inquiry cannot answer or resolve it.","Người tạo thắc mắc không được tự trả lời hoặc giải quyết thắc mắc đó."],
 service_request_type_invalid:["Choose a supported HR request category.","Hãy chọn đúng loại yêu cầu HR được hỗ trợ."],
 service_request_transition_invalid:["This request has changed state or the requested action is not allowed.","Yêu cầu đã đổi trạng thái hoặc thao tác này không được phép."],
 service_request_inactive:["This request is closed. Reopen it to add another message.","Yêu cầu đã đóng. Hãy mở lại trước khi gửi thêm nội dung."],
 service_request_assignee_invalid:["Assign the request to an active HRM Officer or HRM Admin.","Hãy phân công cho HRM Officer hoặc HRM Admin đang hoạt động."],
 service_request_self_review:["A request owner cannot handle their own sensitive concern.","Người gửi không được tự xử lý phản ánh nhạy cảm của mình."],
};
let title=data.title||"HRM";let error="error" in data?data.error:undefined;
const savedMessages:Record<string,[string,string]>={asset_reminder_read:["Reminder marked as read.","Đã đánh dấu nhắc việc là đã xem."]};
const saved=Astro.url.searchParams.get("saved")??"";
---
<WorkspaceShell title={title} lang={data.lang} user={data.user} module={Astro.props.module??"hrm"} current={Astro.props.current}>
  <div class="crm-head"><div>
    <p class="crm-eyebrow">HRM</p>
    <h1 class="crm-h1">{title}</h1>
  </div></div>
  {error && <div class="crm-notice bad" role="alert"><strong>{vi?"Chưa hoàn tất":"Could not complete"}</strong><p>{messages[error]?.[vi?1:0]??(vi?"Yêu cầu không hợp lệ hoặc hồ sơ không còn khả dụng.":"The request is invalid or the record is no longer available.")}</p></div>}
  {savedMessages[saved]&&<div class="crm-notice good" role="status">{savedMessages[saved][vi?1:0]}</div>}
  {import.meta.env.DEV&&error?.startsWith("internal_error:")&&<pre class="crm-meta">{error.slice(15)}</pre>}
  {error==="hrm_closed" && data.user.can("hrm.configure") && <div class="crm-sheet"><p>{vi?"Cấu hình chính sách, mục đích sử dụng và retention trước khi mở cổng. Cài đặt ở HRM → Thiết lập.":"Configure the legal entity, purpose and retention policy before opening the module. Use HRM → Settings."}</p><a class="crm-button secondary" href={vi?"/vi/hrm/settings":"/hrm/settings"}>{vi?"Mở thiết lập":"Open settings"}</a></div>}
  <slot />
