---
import WorkspaceShell from "../../layouts/WorkspaceShell.astro";
import type { Failure, PageBase } from "../../lib/hrm/pages";
interface Props { data: PageBase|Failure; module?:"hrm"; current?:string }
const {data}=Astro.props;const vi=data.vi;
const messages:Record<string,[string,string]>={
 hrm_closed:["HRM is not activated. The owner’s configuration and deployment gate are still closed.","HRM chưa được kích hoạt. Cấu hình của owner và cổng production hiện vẫn đóng."],
 policy_required:["Complete and review the policy source, purpose and retention configuration first.","Hãy điền và rà soát nguồn chính sách, mục đích xử lý và thời hạn lưu trước."],
 activation_closed:["The deployment kill switch is off. Ask the owner to enable HRM only after the policy gate passes.","Công tắc triển khai HRM đang tắt. Hãy nhờ owner bật sau khi chính sách đã qua cổng rà soát."],
 invalid_origin:["The request origin was rejected.","Nguồn gửi yêu cầu không hợp lệ."],
 invalid_form:["The form could not be read.","Không đọc được biểu mẫu."],
 conflict:["The record changed since it was opened. Reload and review the latest revision.","Hồ sơ đã thay đổi. Hãy tải lại và kiểm tra phiên bản mới nhất."],
 request_key_conflict:["This request key was already used for different data.","Mã yêu cầu này đã được dùng cho dữ liệu khác."],
 self_approval:["A person cannot review their own request or file.","Không thể tự duyệt yêu cầu hoặc tệp của chính mình."],
 evidence_required:["Add a reference to the external evidence before setting this status.","Hãy thêm tham chiếu bằng chứng bên ngoài trước khi đặt trạng thái."],
 invalid_email:["Enter a valid email address.","Hãy nhập địa chỉ email hợp lệ."],
 invalid_date:["Check the dates. The end date must not come before the start date.","Hãy kiểm tra ngày. Ngày kết thúc không được trước ngày bắt đầu."],
 file_type:["That file’s contents do not match an allowed PDF, JPEG or PNG upload.","Nội dung tệp không khớp PDF, JPEG hoặc PNG được phép."],
 file_size:["Files must be no larger than 5 MB.","Tệp không được lớn hơn 5 MB."],
 invalid_account:["Choose an existing, active EmDash account.","Hãy chọn tài khoản EmDash đang hoạt động."],
 rehire_conflict:["This employment period is no longer current. Reload before starting another period.","Đợt làm việc này không còn là đợt hiện tại. Hãy tải lại trước khi tạo đợt mới."],
 invalid_document_config:["Check the document version, audience, signature method and dates.","Hãy kiểm tra phiên bản tài liệu, đối tượng, phương thức ký và ngày hiệu lực."],
 legal_file_type:["Upload a valid DOCX Open XML source file or a PDF evidence file.","Hãy tải lên DOCX Open XML hợp lệ làm bản nguồn hoặc PDF làm bằng chứng."],
 source_review_required:["A different authorized reviewer must review the source before it can be issued.","Một người rà soát được cấp quyền và khác người tải lên phải kiểm tra bản nguồn trước khi phát hành."],
 required_parties_missing:["Add the required employee and company signing parties before issuing a paper agreement.","Hãy khai báo đủ bên nhân viên và đại diện công ty trước khi phát hành văn bản ký giấy."],
 document_not_active:["This version is not active for issue.","Phiên bản này chưa được kích hoạt để phát hành."],
 document_not_effective:["This version is not yet effective.","Phiên bản này chưa đến ngày hiệu lực."],
 document_version_conflict:["The issued version changed or the acknowledgement does not match its checksum. Reload the document.","Phiên bản phát hành đã thay đổi hoặc xác nhận không khớp checksum. Hãy tải lại tài liệu."],
 document_not_actionable:["This document is no longer awaiting an employee action.","Tài liệu này không còn chờ nhân viên thao tác."],
 acknowledgement_required:["Confirm that you have read the exact issued version before submitting.","Hãy xác nhận đã đọc đúng phiên bản phát hành trước khi gửi."],
 invalid_supersedes:["An amendment must refer to one of your prior submitted declarations.","Bản bổ sung phải liên kết với một khai báo đã gửi trước đây của bạn."],
 invalid_transition:["This record has changed state. Reload it before taking another action.","Hồ sơ đã đổi trạng thái. Hãy tải lại trước khi thao tác tiếp."],
 invalid_reviewer:["Choose an active HRM Officer or HRM Admin as reviewer.","Hãy chọn HRM Officer hoặc HRM Admin đang hoạt động làm người rà soát."],
 mitigation_required:["A mitigation decision needs a plan and a follow-up date.","Quyết định cần giảm thiểu phải có biện pháp và ngày theo dõi."],
 reason_required:["Enter a reason so the decision has an audit trail.","Hãy ghi lý do để quyết định có dấu vết kiểm tra."],
 request_too_large:["The upload request exceeds the safe size limit.","Yêu cầu tải tệp vượt quá giới hạn kích thước cho phép."],
 invalid_file_target:["Choose exactly one COI declaration or issued document for the PDF evidence.","Hãy chọn đúng một khai báo COI hoặc tài liệu đã phát hành để đính kèm PDF."],
 evidence_pending:["Review or reject every pending COI evidence file before closing the declaration.","Hãy rà soát hoặc từ chối mọi tệp bằng chứng COI đang chờ trước khi đóng khai báo."],
 invalid_onboarding_config:["Check the task JSON, owners, evidence type, applicability filters and dependencies.","Hãy kiểm tra JSON todo, người phụ trách, loại bằng chứng, đối tượng áp dụng và phụ thuộc."],
 onboarding_dependency_cycle:["The task dependency graph contains a cycle.","Chuỗi phụ thuộc của todo có vòng lặp."],
 onboarding_pdf_needs_reviewer:["A PDF evidence task must have an assigned reviewer.","Todo yêu cầu PDF phải có người rà soát được phân công."],
 onboarding_restricted_needs_reviewer:["Identity, legal and COI tasks must have an assigned reviewer.","Todo định danh, pháp lý và COI phải có người rà soát được phân công."],
 onboarding_not_applicable:["This template does not apply to the employee's legal entity, job, location or status.","Mẫu này không áp dụng cho pháp nhân, vị trí, địa điểm hoặc trạng thái đợt làm việc của nhân viên."],
 onboarding_template_inactive:["Choose an active, reviewed onboarding template version.","Hãy chọn phiên bản mẫu onboarding đã rà soát và kích hoạt."],
 onboarding_employee_unavailable:["The employment period must be active/preboarding and linked to an EmDash account.","Đợt làm việc phải đang chuẩn bị/hoạt động và liên kết với tài khoản EmDash."],
 onboarding_owner_required:["Assign every owner required by the selected template before creating the plan.","Hãy phân công đủ người phụ trách mà mẫu yêu cầu trước khi tạo kế hoạch."],
 onboarding_self_verifier:["The task assignee and verifier must be different people.","Người làm và người kiểm tra todo phải là hai người khác nhau."],
 onboarding_owner_unavailable:["An assigned owner no longer has the required active Workspace permission.","Người được phân công không còn quyền Workspace phù hợp hoặc tài khoản đã ngừng hoạt động."],
 onboarding_plan_inactive:["This plan is not active for task updates.","Kế hoạch này không còn hoạt động để cập nhật todo."],
 onboarding_dependency_blocked:["Complete or verify all prerequisite tasks before starting or submitting this task.","Hãy hoàn tất hoặc xác minh các todo phụ thuộc trước khi bắt đầu hoặc nộp công việc này."],
 onboarding_pdf_upload_required:["Upload the required PDF evidence from this task before submitting it.","Hãy tải PDF bằng chứng bắt buộc tại todo này trước khi nộp."],
 onboarding_evidence_required:["Submit the required evidence before requesting verification.","Hãy nộp bằng chứng bắt buộc trước khi yêu cầu xác minh."],
 waiver_not_allowed:["This task cannot be waived by your role or the template policy.","Vai trò của bạn hoặc chính sách mẫu không cho phép miễn todo này."],
 onboarding_not_assigned:["This task is not assigned to you.","Todo này không được phân công cho bạn."],
 confirmation_required:["Review the preview and confirm before applying the date change.","Hãy kiểm tra bản xem trước và xác nhận trước khi đổi ngày."],
 onboarding_version_must_be_reviewed:["A different authorized reviewer must review this version before activation.","Một người rà soát được cấp quyền và khác người tạo phải kiểm tra phiên bản trước khi kích hoạt."],
 candidate_not_hired:["This ATS application is not in the hired state.","Hồ sơ ATS chưa ở trạng thái đã tuyển."],
 candidate_already_transferred:["This ATS application already has an HRM transfer record.","Hồ sơ ATS này đã có dấu vết chuyển sang HRM."],
 transfer_preview_stale:["The candidate, job or HRM policy changed after this preview. Reload and review the current values.","Ứng viên, vị trí hoặc chính sách HRM đã đổi sau bản xem trước. Hãy tải lại và kiểm tra dữ liệu hiện tại."],
 invalid_employee_code:["Enter a unique employee code using letters, numbers, hyphens or underscores.","Nhập mã nhân viên chưa dùng, gồm chữ, số, dấu gạch ngang hoặc gạch dưới."],
 transfer_employee_account_invalid:["Select an active existing EmDash account that already has the Employee role.","Chọn tài khoản EmDash đang hoạt động và đã có vai trò Employee."],
 candidate_data_invalid:["The source candidate fields need correction before they can be transferred.","Cần sửa các trường ứng viên nguồn trước khi chuyển."],
 invalid_manager:["Choose an active People Manager or HRM Admin as manager.","Hãy chọn People Manager hoặc HRM Admin đang hoạt động làm quản lý."],
 invalid_revision:["Reload the current preview and try again.","Hãy tải lại bản xem trước hiện tại rồi thử lại."],
 invalid_field:["Check the submitted fields and try again.","Hãy kiểm tra các trường vừa gửi rồi thử lại."],
 internal_error:["The request could not be completed. No transfer was confirmed.","Không thể hoàn tất yêu cầu. Chưa xác nhận chuyển dữ liệu."],
 offboarding_case_inactive:["This offboarding case was superseded or already closed.","Hồ sơ offboarding đã được thay thế hoặc đóng."],
 offboarding_payroll_blocked:["Payroll is not enabled; do not mark the final settlement complete.","Phân hệ payroll chưa được bật; không thể đánh dấu đã quyết toán cuối cùng."],
 offboarding_system_admin_protected:["A System Super Admin account cannot be disabled through employee offboarding.","Không thể tắt tài khoản System Super Admin qua quy trình offboarding nhân viên."],
 offboarding_access_pending:["Workspace access could not be verified as revoked. Keep this task open and retry after review.","Chưa xác minh được quyền Workspace đã bị thu hồi. Hãy giữ việc mở và thử lại sau khi rà soát."],
 offboarding_not_assigned:["This task is not assigned to your account.","Việc này không được phân công cho tài khoản của bạn."],
 offboarding_not_waivable:["This offboarding task cannot be marked not required.","Không thể đánh dấu việc offboarding này là không cần áp dụng."],
 offboarding_end_date_required:["Set the employment end date before ending the period.","Hãy đặt ngày kết thúc trước khi kết thúc đợt làm việc."],
 offboarding_self_revoke:["You cannot revoke your own Workspace membership through offboarding.","Bạn không thể tự thu hồi quyền Workspace của mình qua quy trình offboarding."],
 forbidden:["Your role cannot perform this offboarding action.","Vai trò của bạn không được phép thực hiện thao tác offboarding này."],
};
let title=data.title||"HRM";let error="error" in data?data.error:undefined;
---
<WorkspaceShell title={title} lang={data.lang} user={data.user} module={Astro.props.module??"hrm"} current={Astro.props.current}>
  <div class="crm-head"><div>
    <p class="crm-eyebrow">HRM</p>
    <h1 class="crm-h1">{title}</h1>
  </div></div>
  {error && <div class="crm-notice bad" role="alert"><strong>{vi?"Chưa hoàn tất":"Could not complete"}</strong><p>{messages[error]?.[vi?1:0]??(vi?"Yêu cầu không hợp lệ hoặc hồ sơ không còn khả dụng.":"The request is invalid or the record is no longer available.")}</p></div>}
  {import.meta.env.DEV&&error?.startsWith("internal_error:")&&<pre class="crm-meta">{error.slice(15)}</pre>}
  {error==="hrm_closed" && data.user.can("hrm.configure") && <div class="crm-sheet"><p>{vi?"Cấu hình chính sách, mục đích sử dụng và retention trước khi mở cổng. Cài đặt ở HRM → Thiết lập.":"Configure the legal entity, purpose and retention policy before opening the module. Use HRM → Settings."}</p><a class="crm-button secondary" href={vi?"/vi/hrm/settings":"/hrm/settings"}>{vi?"Mở thiết lập":"Open settings"}</a></div>}
  <slot />
</WorkspaceShell>
