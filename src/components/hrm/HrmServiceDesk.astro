---
import HrmPage from "./HrmPage.astro";
import type { ServiceDeskPage } from "../../lib/hrm/employee-service-pages";
const d=Astro.props as ServiceDeskPage,vi=d.vi,prefix=vi?"/vi":"",selected=d.selected!;
const state=(value:string)=>({submitted:vi?"Mới gửi":"Submitted",triaged:vi?"Đã tiếp nhận":"Triaged",in_progress:vi?"Đang xử lý":"In progress",answered:vi?"Đã trả lời":"Answered",resolved:vi?"Đã giải quyết":"Resolved",reopened:vi?"Đã mở lại":"Reopened",cancelled:vi?"Đã hủy":"Cancelled"}[value]??value);
const fileState=(value:string)=>({quarantined:vi?"Chờ rà soát":"Waiting for review",reviewed:vi?"Đã rà soát":"Reviewed",rejected:vi?"Bị từ chối":"Rejected"}[value]??value);
const typeLabel=(value:string)=>({employment_confirmation:vi?"Xác nhận công tác":"Employment confirmation",profile_support:vi?"Hỗ trợ hồ sơ":"Profile support",policy_question:vi?"Thắc mắc chính sách":"Policy question",benefit_question:vi?"Phúc lợi":"Benefits",asset_return:vi?"Tài sản":"Company asset",training_question:vi?"Đào tạo":"Training",reimbursement:vi?"Hoàn ứng":"Reimbursement",sensitive_complaint:vi?"Phản ánh nhạy cảm":"Sensitive concern",other:vi?"Khác":"Other"}[value]??value);
const returnTo=(id?:string)=>`${prefix}/hrm/requests${id?`?request=${encodeURIComponent(id)}`:""}`;
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Bàn dịch vụ nội bộ":"Internal service desk"}</strong><p>{vi?"Quản lý trực tiếp không có quyền đọc hàng chờ yêu cầu. Phản ánh nhạy cảm chỉ hiển thị cho HRM Officer/Admin và người gửi. Thông báo ở đây chỉ là trong ứng dụng; không gửi qua Lark CRM hoặc email.":"Direct managers cannot read this queue. Sensitive concerns are limited to HRM Officers/Admins and the requester. Notifications are in-app only; nothing is sent to CRM Lark or email."}</p></section>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Hàng chờ HR":"HR request queue"}</h2>{d.requests.length===0?<p class="crm-empty">{vi?"Không có yêu cầu đang chờ.":"No requests in the queue."}</p>:<div class="crm-list">{d.requests.map(request=><article class="crm-row"><div><strong>{request.employee_code} · {request.display_name} · {request.subject}</strong><p class="crm-meta">{typeLabel(request.request_type)} · {state(request.state)} · {request.sensitivity==="restricted"?(vi?"Riêng tư HR":"HR restricted"):(vi?"Thông thường":"Standard")} · {request.updated_at}</p></div><a class="crm-button secondary small" href={returnTo(request.id)}>{vi?"Mở yêu cầu":"Open request"}</a></article>)}</div>}</section>
 {d.selected&&<section class="crm-sheet"><p class="crm-eyebrow">{typeLabel(d.selected.request.request_type)} · {state(d.selected.request.state)} · v{d.selected.request.version}</p><h2 class="crm-h2">{d.selected.request.subject}</h2><p class="crm-meta">{d.selected.request.employee_code} · {d.selected.request.display_name}</p><div class="crm-list">{d.selected.events.map(event=><article class="crm-row"><div><strong>{state(event.event_type)} · {event.visibility==="hr_only"?(vi?"Ghi chú HR":"HR-only note"):(vi?"Hiển thị nhân viên":"Employee-visible")}</strong><p>{event.body}</p><span class="crm-meta">{event.actor_id} · {event.created_at}</span></div></article>)}</div>
  <section class="crm-sheet"><h3 class="crm-h3">{vi?"PDF đính kèm":"PDF attachments"}</h3>{selected.attachments.length===0?<p class="crm-empty">{vi?"Chưa có tệp đính kèm.":"No attachments yet."}</p>:<div class="crm-list">{selected.attachments.map(file=><article class="crm-row"><div><strong>{file.original_name}</strong><p class="crm-meta">{fileState(file.state)} · {file.created_at}</p>{file.review_reason&&<p>{file.review_reason}</p>}</div><div class="crm-actions"><a class="crm-button secondary small" href={`/api/hrm/services/attachments/${file.id}`}>{vi?"Tải xuống":"Download"}</a>{file.state==="quarantined"&&file.uploaded_by!==d.user.id&&selected.request.created_by!==d.user.id&&<div class="crm-grid cols"><form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="review_attachment"/><input type="hidden" name="attachment_id" value={file.id}/><input type="hidden" name="file_version" value={file.version}/><input type="hidden" name="decision" value="approve"/><input type="hidden" name="return_to" value={returnTo(selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do chấp nhận":"Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small">{vi?"Chấp nhận PDF":"Approve PDF"}</button></form><form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="review_attachment"/><input type="hidden" name="attachment_id" value={file.id}/><input type="hidden" name="file_version" value={file.version}/><input type="hidden" name="decision" value="reject"/><input type="hidden" name="return_to" value={returnTo(selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do từ chối":"Rejection reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button danger small">{vi?"Yêu cầu nộp lại":"Request replacement"}</button></form></div>}</div></article>)}</div>}
   {!(["resolved","cancelled"].includes(d.selected.request.state))&&<form class="crm-form" method="post" enctype="multipart/form-data" action="/api/hrm/services/attachments"><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><label class="crm-field"><span>{vi?"Đính kèm chứng từ PDF":"Attach a PDF document"}</span><input class="crm-input" type="file" name="file" accept="application/pdf,.pdf" required/></label><p class="crm-help">{vi?"PDF riêng tư, tối đa 5 MB; người tải lên không thể tự rà soát.":"Private PDF, up to 5 MB. The uploader cannot review their own file."}</p><button class="crm-button secondary">{vi?"Tải PDF":"Upload PDF"}</button></form>}
  </section>
  {d.selected.request.state!="resolved"&&d.selected.request.state!="cancelled"&&d.selected.request.created_by!==d.user.id&&<div class="crm-grid cols">
   <form class="crm-form" method="post" action="/api/hrm/services"><h3 class="crm-h3">{vi?"Phân công người xử lý":"Assign handler"}</h3><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="assign"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"HRM Officer/Admin":"HRM Officer/Admin"}</span><select class="crm-input" name="assign_to" required>{d.members.map(member=><option value={member.user_id}>{member.name} · {member.roles.filter(role=>role==="hrm_officer"||role==="hrm_admin").join(", ")}</option>)}</select></label><label class="crm-field"><span>{vi?"Ghi chú":"Note"}</span><input class="crm-input" name="body" maxlength="3000" required/></label><button class="crm-button secondary small">{vi?"Phân công":"Assign"}</button></form>
   {d.selected.request.state==="submitted"&&<form class="crm-form" method="post" action="/api/hrm/services"><h3 class="crm-h3">{vi?"Tiếp nhận":"Triage"}</h3><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="triage"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Ghi chú trả lời nhân viên":"Employee-visible note"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required/></label><button class="crm-button">{vi?"Tiếp nhận":"Triage"}</button></form>}
   {(d.selected.request.state==="triaged"||d.selected.request.state==="reopened")&&<form class="crm-form" method="post" action="/api/hrm/services"><h3 class="crm-h3">{vi?"Bắt đầu xử lý":"Start handling"}</h3><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="in_progress"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Ghi chú":"Note"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required/></label><button class="crm-button">{vi?"Đang xử lý":"Start"}</button></form>}
   {d.selected.request.state==="in_progress"&&<form class="crm-form" method="post" action="/api/hrm/services"><h3 class="crm-h3">{vi?"Trả lời nhân viên":"Reply to employee"}</h3><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="answer"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Trả lời":"Reply"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required/></label><button class="crm-button secondary">{vi?"Trả lời":"Answer"}</button></form><form class="crm-form" method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="resolve"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Trả lời và giải quyết":"Answer and resolve"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required/></label><button class="crm-button">{vi?"Giải quyết":"Resolve"}</button></form>}
   <form class="crm-form" method="post" action="/api/hrm/services"><h3 class="crm-h3">{vi?"Ghi chú nội bộ":"Internal note"}</h3><input type="hidden" name="intent" value="transition"/><input type="hidden" name="action" value="internal_note"/><input type="hidden" name="return_to" value={returnTo(d.selected.request.id)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="request_id" value={d.selected.request.id}/><input type="hidden" name="version" value={d.selected.request.version}/><label class="crm-field"><span>{vi?"Chỉ HR mới thấy":"Visible to HR only"}</span><textarea class="crm-textarea" name="body" maxlength="3000" required/></label><button class="crm-button secondary small">{vi?"Lưu ghi chú":"Save note"}</button></form>
  </div>}
 </section>}
 {d.failures.length>0&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Thông báo chưa gửi":"Failed in-app notifications"}</h2><div class="crm-list">{d.failures.map(item=><article class="crm-row"><div><strong>{item.event_type} · {item.last_error_code}</strong><p class="crm-meta">{item.request_id} · {item.recipient_user_id} · {item.attempts}</p></div><form method="post" action="/api/hrm/services"><input type="hidden" name="intent" value="retry_outbox"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="outbox_id" value={item.id}/><button class="crm-button secondary small">{vi?"Thử lại":"Retry"}</button></form></article>)}</div></section>}
</HrmPage>
