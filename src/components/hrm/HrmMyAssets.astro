---
import HrmPage from "./HrmPage.astro";
import type { MyAssetsPage } from "../../lib/hrm/asset-pages";
const d=Astro.props as MyAssetsPage,vi=d.vi,prefix=vi?"/vi":"";
const assetState=(value:string)=>({available:vi?"Sẵn sàng":"Available",offered:vi?"Chờ tôi xác nhận":"Awaiting my acknowledgement",assigned:vi?"Tôi đang giữ":"Assigned to me",return_requested:vi?"Đang chờ trả":"Return requested",inspection:vi?"Chờ kiểm tra":"Inspection",retired:vi?"Đã thanh lý":"Retired",lost:vi?"Báo mất":"Reported missing"}[value]??value);
const assignmentState=(value:string)=>({offered:vi?"Cần xác nhận nhận tài sản":"Please acknowledge receipt",assigned:vi?"Đang sử dụng":"In your custody",return_requested:vi?"Cần bàn giao lại":"Return requested",returned:vi?"Đã trả":"Returned",cancelled:vi?"Đã hủy":"Cancelled"}[value]??value);
const typeLabel=(value:string)=>({computer:vi?"Máy tính":"Computer",phone:vi?"Điện thoại":"Phone",monitor:vi?"Màn hình":"Monitor",accessory:vi?"Phụ kiện":"Accessory",key:vi?"Chìa khóa/thẻ":"Key or badge",other:vi?"Khác":"Other"}[value]??value);
const evidenceState=(value:string)=>({quarantined:vi?"Chờ HRM Admin hoặc System Super Admin rà soát":"Awaiting HRM Admin or System Super Admin review",reviewed:vi?"Đã rà soát":"Reviewed",rejected:vi?"Từ chối":"Rejected"}[value]??value);
const reminderText=(days:number)=>days>0?(vi?`Đến hạn trong ${days} ngày`:`Due in ${days} days`):days===0?(vi?"Đến hạn hôm nay":"Due today"):(vi?`Quá hạn ${Math.abs(days)} ngày`:`Overdue by ${Math.abs(days)} days`);
const returnTo=(reminderPage=d.reminderPage,assetPage=d.assetPage)=>{
 const query=[reminderPage>1?`reminder_page=${reminderPage}`:"",assetPage>1?`asset_page=${assetPage}`:""].filter(Boolean).join("&");
 return `${prefix}/hrm/me/assets${query?`?${query}`:""}`;
};
---
<HrmPage data={d}>
 <section class="crm-notice" role="note"><strong>{vi?"Bàn giao có xác nhận":"Asset custody is acknowledged"}</strong><p>{vi?"Chỉ xác nhận nhận tài sản khi bạn đã thực sự nhận. Khi trả, hãy gửi yêu cầu hoặc xác nhận đã bàn giao cho HR; HR sẽ kiểm tra tình trạng. Tài sản mất/hỏng không tự khấu trừ lương.":"Only acknowledge an asset after you physically receive it. To return it, request a return or confirm you handed it to HR; HR records the physical inspection. Lost or damaged assets never trigger automatic payroll deductions."}</p></section>
 {d.reminders.length>0&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Nhắc trả tài sản":"Asset return reminders"}</h2><div class="crm-list">{d.reminders.map(reminder=><article class="crm-row"><div><strong>{reminder.asset_tag} · {reminderText(reminder.days_before_due)}</strong><p class="crm-meta">{reminder.description} · {vi?"Hạn trả":"Due"} {reminder.due_on}</p></div><form method="post" action="/api/hrm/assets/reminders"><input type="hidden" name="intent" value="read_reminder"/><input type="hidden" name="return_to" value={returnTo(d.reminderPage)}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="reminder_id" value={reminder.id}/><input type="hidden" name="version" value={reminder.version}/><button class="crm-button secondary small">{vi?"Đã xem":"Mark read"}</button></form></article>)}</div>
 {(d.reminderPage>1||d.hasMoreReminders)&&<nav class="crm-actions" aria-label={vi?"Trang thông báo tài sản":"Asset reminder pages"}>{d.reminderPage>1&&<a class="crm-button secondary small" href={returnTo(d.reminderPage-1,d.assetPage)}>{vi?"Thông báo trước":"Previous reminders"}</a>}{d.hasMoreReminders&&<a class="crm-button secondary small" href={returnTo(d.reminderPage+1,d.assetPage)}>{vi?"Thông báo tiếp":"Next reminders"}</a>}</nav>}
 </section>}
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tài sản được giao cho tôi":"Assets assigned to me"}</h2>{d.assets.length===0?<p class="crm-empty">{vi?"Chưa có tài sản được giao.":"No assets assigned."}</p>:<div class="crm-list">{d.assets.map(asset=>{const evidence=d.evidence.filter(row=>row.assignment_id===asset.assignment_id);return <article class="crm-row"><div><strong>{asset.asset_tag} · {asset.description}</strong><p class="crm-meta">{typeLabel(asset.asset_type)} · {assetState(asset.asset_state)} · {assignmentState(asset.assignment_state)} · {asset.legal_entity}{asset.location?` · ${asset.location}`:""}</p><p>{vi?"Tình trạng khi giao":"Issued condition"}: {asset.issued_condition}{asset.expected_return_on?` · ${vi?"Ngày dự kiến trả":"Expected return"}: ${asset.expected_return_on}`:""}</p>{asset.return_requested_at&&<p class="crm-meta">{vi?"Yêu cầu trả":"Return requested"}: {asset.return_requested_at}</p>}{asset.employee_handover_at&&<p class="crm-meta">{vi?"Bạn đã báo bàn giao":"Handover reported"}: {asset.employee_handover_at}</p>}{asset.returned_at&&<p class="crm-meta">{vi?"Đã nhận lại":"Received back"}: {asset.returned_at}</p>}{asset.return_condition&&<p>{vi?"Tình trạng khi nhận lại":"Condition at return"}: {asset.return_condition}</p>}{asset.return_note&&<p class="crm-help">{asset.return_note}</p>}{evidence.length>0&&<div class="crm-list"><strong>{vi?"Biên bản đính kèm":"Handover records"}</strong>{evidence.map(file=><p class="crm-meta">{file.evidence_type==="handover"?(vi?"Bàn giao":"Handover"):(vi?"Nhận lại":"Return receipt")} · {file.original_name} · {evidenceState(file.state)}{(file.state==="reviewed"||file.uploaded_by===d.user.id)&&<> · <a href={`/api/hrm/assets/attachments/${encodeURIComponent(file.id)}`}>{vi?"Tải PDF":"Download PDF"}</a></>}</p>)}</div>}</div><div class="crm-actions">
  {asset.assignment_state==="offered"&&<form class="crm-form" method="post" action="/api/hrm/assets"><input type="hidden" name="intent" value="transition_asset"/><input type="hidden" name="action" value="accept"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={asset.assignment_id}/><input type="hidden" name="version" value={asset.version}/><label class="crm-field"><span>{vi?"Xác nhận đã nhận":"Confirm physical receipt"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button">{vi?"Xác nhận nhận tài sản":"Acknowledge receipt"}</button></form>}
  {asset.assignment_state==="assigned"&&<form class="crm-form" method="post" action="/api/hrm/assets"><input type="hidden" name="intent" value="transition_asset"/><input type="hidden" name="action" value="request_return"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={asset.assignment_id}/><input type="hidden" name="version" value={asset.version}/><label class="crm-field"><span>{vi?"Lý do trả":"Return reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary">{vi?"Yêu cầu trả tài sản":"Request return"}</button></form>}
  {asset.assignment_state==="return_requested"&&!asset.employee_handover_at&&<form class="crm-form" method="post" action="/api/hrm/assets"><input type="hidden" name="intent" value="transition_asset"/><input type="hidden" name="action" value="report_handover"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={asset.assignment_id}/><input type="hidden" name="version" value={asset.version}/><label class="crm-field"><span>{vi?"Ghi nhận bàn giao thực tế":"Confirm you handed it to HR"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button">{vi?"Đã bàn giao cho HR":"Report physical handover"}</button></form>}
  {asset.assignment_state==="return_requested"&&asset.employee_handover_at&&<form class="crm-form" method="post" action="/api/hrm/assets/attachments" enctype="multipart/form-data"><input type="hidden" name="intent" value="upload_evidence"/><input type="hidden" name="evidence_type" value="handover"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={asset.assignment_id}/><input type="hidden" name="version" value={asset.version}/><label class="crm-field"><span>{vi?"PDF chứng minh đã bàn giao cho HR":"PDF confirming physical handover to HR"}</span><input class="crm-input" type="file" name="file" accept="application/pdf,.pdf" required/></label><button class="crm-button secondary small">{vi?"Tải biên bản":"Upload handover PDF"}</button></form>}
  {asset.assignment_state==="return_requested"&&asset.return_requested_by===d.user.id&&<form method="post" action="/api/hrm/assets"><input type="hidden" name="intent" value="transition_asset"/><input type="hidden" name="action" value="cancel_return"/><input type="hidden" name="return_to" value={returnTo()}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="assignment_id" value={asset.assignment_id}/><input type="hidden" name="version" value={asset.version}/><label class="crm-field"><span>{vi?"Lý do hủy yêu cầu":"Reason to cancel your return request"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button secondary small">{vi?"Hủy yêu cầu trả":"Cancel return request"}</button></form>}
 </div></article>})}</div>}
 {(d.assetPage>1||d.hasMoreAssets)&&<nav class="crm-actions" aria-label={vi?"Trang tài sản được giao":"Assigned asset pages"}>{d.assetPage>1&&<a class="crm-button secondary small" href={returnTo(d.reminderPage,d.assetPage-1)}>{vi?"Tài sản trước":"Previous assets"}</a>}{d.hasMoreAssets&&<a class="crm-button secondary small" href={returnTo(d.reminderPage,d.assetPage+1)}>{vi?"Tài sản tiếp":"Next assets"}</a>}</nav>}</section>
</HrmPage>
