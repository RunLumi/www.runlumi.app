---
import HrmPage from "./HrmPage.astro";
import type { OnboardingSelfPage } from "../../lib/hrm/onboarding-pages";
const d=Astro.props as OnboardingSelfPage;const vi=d.vi;
const state=(value:string)=>({draft:vi?"Bản nháp":"Draft",not_started:vi?"Chưa bắt đầu":"Not started",in_progress:vi?"Đang làm":"In progress",submitted:vi?"Đã nộp":"Submitted",verified:vi?"Đã kiểm tra":"Verified",completed:vi?"Hoàn tất":"Completed",blocked:vi?"Đang vướng":"Blocked",waived:vi?"Được miễn":"Waived",cancelled:vi?"Đã hủy":"Cancelled"}[value]||value);
const when=(value:string)=>new Date(value).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
const done=(task:{state:string})=>["verified","completed","waived"].includes(task.state);
const canManage=d.user.can("hrm.onboarding.manage");
const now=Date.now();
---
<HrmPage data={d} current="my-onboarding">
 <p class="crm-meta">{vi?"Việc cần làm chỉ hiển thị việc của bạn hoặc việc được giao trực tiếp cho bạn. Liên kết đến giấy tờ vẫn áp dụng quyền riêng của hồ sơ nguồn.":"You see your own tasks and tasks assigned directly to you. Links to legal or identity records still enforce the source record’s access rules."}</p>
 {d.saved&&<div class="crm-notice good" role="status">{vi?"Đã cập nhật công việc hội nhập.":"Onboarding task updated."}</div>}
 {d.tasks.length===0?<section class="crm-sheet"><p>{vi?"Chưa có công việc hội nhập nào trong phạm vi của bạn.":"There are no onboarding tasks in your scope."}</p></section>:<section class="crm-sheet"><h2 class="crm-h2">{vi?"Công việc của tôi":"My tasks"}</h2><div class="crm-list">{d.tasks.map(task=>{
  const isAssignee=task.assignee_user_id===d.user.id;const isOwner=task.person_user_id===d.user.id;const due=new Date(task.due_at);const overdue=due.getTime()<now&&!done(task)&&task.plan_state==="active";
  return <article class="crm-row crm-onboarding-task"><div class="crm-onboarding-copy"><strong>{vi?task.title_vi:task.title_en}</strong><span class="crm-meta">{task.milestone} · {state(task.state)} · {task.required?(vi?"Bắt buộc":"Required"):(vi?"Tùy chọn":"Optional")} · {vi?"Hạn":"Due"} {when(task.due_at)}{overdue?` · ${vi?"Quá hạn":"Overdue"}`:""}</span>{isAssignee&&task.instructions_en&&<p>{vi?task.instructions_vi:task.instructions_en}</p>}{!isOwner&&<span class="crm-meta">{task.employee_code} · {task.legal_name}</span>}{task.plan_state==="cancelled"&&<span class="crm-meta">{vi?"Kế hoạch đã hủy":"Plan cancelled"}</span>}{task.blocked_reason&&<p class="crm-notice bad">{task.blocked_reason}</p>}{task.review_reason&&<p class="crm-notice">{task.review_reason}</p>}{task.state==="submitted"&&<span class="crm-meta">{vi?"Đang chờ người kiểm tra":"Waiting for reviewer"}</span>}{task.evidence_name&&<span class="crm-meta">{vi?`Bằng chứng PDF: ${task.evidence_name} · ${task.evidence_state}`:`PDF evidence: ${task.evidence_name} · ${task.evidence_state}`}</span>}{isAssignee&&task.evidence_file_id&&<a class="crm-button secondary small" href={`/api/hrm/legal/files/${encodeURIComponent(task.evidence_file_id)}`}>{vi?"Tải PDF":"Download PDF"}</a>}</div>
   <div class="crm-actions crm-onboarding-actions">
    {isAssignee&&task.plan_state==="active"&&task.state==="not_started"&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="start"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit" disabled={task.dependencies_ready!==1}>{task.dependencies_ready!==1?(vi?"Đang chờ việc trước":"Waiting on prerequisites"):(vi?"Bắt đầu":"Start")}</button></form>}
    {isAssignee&&task.plan_state==="active"&&task.state==="in_progress"&&task.evidence_type==="none"&&task.verifier_kind==="none"&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="complete"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Hoàn tất":"Complete"}</button></form>}
    {isAssignee&&task.plan_state==="active"&&task.state==="in_progress"&&task.evidence_type==="text"&&<form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="submit"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Bằng chứng hoặc ghi chú hoàn tất":"Evidence or completion note"}</span><textarea class="crm-input" name="submission_text" rows="2" maxlength="4000" required></textarea></label><button class="crm-button small" type="submit">{task.verifier_kind==="none"?(vi?"Ghi hoàn tất":"Record completion"):(vi?"Nộp kiểm tra":"Submit for review")}</button></form>}
    {isAssignee&&task.plan_state==="active"&&task.state==="in_progress"&&task.evidence_type==="pdf"&&<form method="post" action="/api/hrm/legal/files/upload" enctype="multipart/form-data" class="crm-form crm-upload"><input type="hidden" name="kind" value="pdf_evidence"/><input type="hidden" name="onboarding_task_id" value={task.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${vi?"/vi":""}/hrm/me/onboarding`}/><label class="crm-field"><span>{vi?"Tải PDF bằng chứng":"Upload PDF evidence"}</span><input class="crm-input" name="file" type="file" accept="application/pdf,.pdf" required/></label><button class="crm-button secondary small" type="submit">{vi?"Tải lên và nộp":"Upload and submit"}</button></form>}
    {isAssignee&&task.plan_state==="active"&&task.state==="in_progress"&&<form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="block"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do đang vướng":"Why this is blocked"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button secondary small" type="submit">{vi?"Báo đang vướng":"Report blocked"}</button></form>}
    {isAssignee&&task.plan_state==="active"&&task.state==="blocked"&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="unblock"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button secondary small" type="submit">{vi?"Tiếp tục":"Resume"}</button></form>}
    {(d.user.id===task.verifier_user_id||canManage)&&task.state==="submitted"&&task.evidence_file_id&&task.evidence_state==="quarantined"&&task.evidence_uploaded_by!==d.user.id&&<form method="post" action={`/api/hrm/legal/files/${encodeURIComponent(task.evidence_file_id)}`} class="crm-actions"><input type="hidden" name="intent" value="review"/><input type="hidden" name="version" value={task.evidence_file_version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={`${vi?"/vi":""}/hrm/me/onboarding`}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" name="decision" value="reviewed">{vi?"Đã rà soát":"Reviewed"}</button><button class="crm-button danger small" name="decision" value="rejected">{vi?"Từ chối":"Reject"}</button></form>}
   </div>
  </article>
 })}</div></section>}
</HrmPage>
