---
import HrmPage from "./HrmPage.astro";import type { PageBase } from "../../lib/hrm/pages";import type { Person } from "../../lib/hrm/service";import type { MemberRow } from "../../lib/workspace/members";
interface Props extends PageBase {person:Person;accountEmail:string;managers:MemberRow[];saved:boolean;canRehire:boolean;rehired:boolean;error?:string}
const d=Astro.props;const vi=d.vi;
---
<HrmPage data={d} current="people">
 <div class="crm-actions"><a class="crm-button secondary" href={`${vi?"/vi":""}/hrm/people`}>{vi?"← Danh sách nhân sự":"← People"}</a>{d.user.can("hrm.records.manage")&&<a class="crm-button secondary" href={`${vi?"/vi":""}/hrm/people/${encodeURIComponent(d.person.id)}/profile?section=contact`}>{vi?"Hồ sơ riêng tư":"Private profile"}</a>}</div>
 {d.saved&&<div class="crm-notice good" role="status">{vi?"Đã lưu thông tin công việc.":"Work details saved."}</div>}
 {d.rehired&&<div class="crm-notice good" role="status">{vi?"Đã tạo đợt làm việc mới; lịch sử đợt cũ được giữ nguyên.":"A new employment period was created; the previous period remains in history."}</div>}
 <section class="crm-sheet"><p class="crm-eyebrow">{d.person.employee_code}</p><h2 class="crm-h2">{d.person.preferred_name||d.person.legal_name}</h2>
 {d.user.can("hrm.records.manage")?<form method="post" class="crm-form"><input type="hidden" name="intent" value="save"/><input type="hidden" name="version" value={d.person.version}/><input type="hidden" name="profile_version" value={d.person.profile_version}/><input type="hidden" name="employment_id" value={d.person.employment_id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/>
 <div class="crm-form-grid">
  <div class="crm-field"><label for="employee_code">{vi?"Mã nhân viên":"Employee code"}</label><input class="crm-input" id="employee_code" name="employee_code" value={d.person.employee_code} required maxlength="50" readonly/></div>
  <div class="crm-field"><label for="legal_name">{vi?"Họ tên pháp lý":"Legal name"}</label><input class="crm-input" id="legal_name" name="legal_name" value={d.person.legal_name} required maxlength="200"/></div>
  <div class="crm-field"><label for="preferred_name">{vi?"Tên thường dùng":"Preferred name"}</label><input class="crm-input" id="preferred_name" name="preferred_name" value={d.person.preferred_name} maxlength="200"/></div>
  <div class="crm-field"><label for="account_email">{vi?"Tài khoản EmDash liên kết":"Linked EmDash account"}</label><input class="crm-input" id="account_email" name="account_email" type="email" value={d.accountEmail} maxlength="254"/></div>
  <div class="crm-field"><label for="work_email">{vi?"Email công việc":"Work email"}</label><input class="crm-input" id="work_email" name="work_email" type="email" value={d.person.work_email} maxlength="254"/></div>
  <div class="crm-field"><label for="work_phone">{vi?"Điện thoại công việc":"Work phone"}</label><input class="crm-input" id="work_phone" name="work_phone" type="tel" value={d.person.work_phone} maxlength="40"/></div>
  <div class="crm-field"><label for="department">{vi?"Bộ phận":"Department"}</label><input class="crm-input" id="department" name="department" value={d.person.department} maxlength="200"/></div>
  <div class="crm-field"><label for="job_title">{vi?"Chức danh":"Job title"}</label><input class="crm-input" id="job_title" name="job_title" value={d.person.job_title} maxlength="200"/></div>
  <div class="crm-field"><label for="legal_entity">{vi?"Pháp nhân":"Legal entity"}</label><input class="crm-input" id="legal_entity" name="legal_entity" value={d.person.legal_entity} required maxlength="200"/></div>
  <div class="crm-field"><label for="location">{vi?"Địa điểm":"Location"}</label><input class="crm-input" id="location" name="location" value={d.person.location} maxlength="200"/></div>
  <div class="crm-field"><label for="manager_user_id">{vi?"Quản lý trực tiếp":"Direct manager"}</label><select class="crm-select" id="manager_user_id" name="manager_user_id"><option value="">{vi?"Chưa phân công":"Unassigned"}</option>{d.managers.map(member=><option value={member.user_id} selected={d.person.manager_user_id===member.user_id}>{member.name||member.email}</option>)}</select></div>
  <div class="crm-field"><label for="relationship_type">{vi?"Loại quan hệ":"Relationship"}</label><select class="crm-select" id="relationship_type" name="relationship_type">{(["employee","contractor"] as const).map(type=><option value={type} selected={d.person.relationship_type===type}>{type==="employee"?(vi?"Nhân viên":"Employee"):(vi?"Cộng tác viên (không vào payroll)":"Contractor (never in payroll)")}</option>)}</select></div>
  <div class="crm-field"><label for="status">{vi?"Trạng thái":"Status"}</label><select class="crm-select" id="status" name="status">{["preboarding","probation","active","notice","ended"].map(state=><option value={state} selected={d.person.status===state}>{state}</option>)}</select></div>
  <div class="crm-field"><label for="started_on">{vi?"Ngày bắt đầu":"Start date"}</label><input class="crm-input" id="started_on" name="started_on" type="date" value={d.person.started_on||""}/></div>
  <div class="crm-field"><label for="ended_on">{vi?"Ngày kết thúc":"End date"}</label><input class="crm-input" id="ended_on" name="ended_on" type="date" value={d.person.ended_on||""}/></div>
 </div><p class="crm-help">{vi?"Liên kết tài khoản EmDash được kiểm tra rõ ràng. Không cấp vai trò Workspace tại đây.":"EmDash identity is linked explicitly. This page does not grant Workspace roles."}</p><button class="crm-button" type="submit">{vi?"Lưu thay đổi":"Save changes"}</button></form>:<dl class="crm-facts"><div><dt>{vi?"Bộ phận":"Department"}</dt><dd>{d.person.department||"—"}</dd></div><div><dt>{vi?"Chức danh":"Title"}</dt><dd>{d.person.job_title||"—"}</dd></div><div><dt>{vi?"Email công việc":"Work email"}</dt><dd>{d.person.work_email||"—"}</dd></div><div><dt>{vi?"Địa điểm":"Location"}</dt><dd>{d.person.location||"—"}</dd></div><div><dt>{vi?"Trạng thái":"Status"}</dt><dd>{d.person.status}</dd></div></dl>}
 </section>
 {d.canRehire&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Tái tuyển — đợt làm việc mới":"Rehire — new employment period"}</h2><p class="crm-help">{vi?`Đợt cũ kết thúc ngày ${d.person.ended_on}. Đợt mới phải bắt đầu sau ngày đó. Hồ sơ con người và lịch sử cũ không bị ghi đè.`:`The previous period ended ${d.person.ended_on}. The new start date must be later. The person record and prior history stay unchanged.`}</p><form method="post" class="crm-form"><input type="hidden" name="intent" value="rehire"/><input type="hidden" name="previous_employment_id" value={d.person.employment_id}/><input type="hidden" name="previous_version" value={d.person.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid">
  <div class="crm-field"><label for="rehire_started_on">{vi?"Ngày bắt đầu mới":"New start date"}</label><input class="crm-input" id="rehire_started_on" name="started_on" type="date" required/></div>
  <div class="crm-field"><label for="rehire_status">{vi?"Trạng thái ban đầu":"Starting status"}</label><select class="crm-select" id="rehire_status" name="status"><option value="preboarding">preboarding</option><option value="probation">probation</option><option value="active">active</option></select></div>
  <div class="crm-field"><label for="rehire_relationship_type">{vi?"Loại quan hệ":"Relationship"}</label><select class="crm-select" id="rehire_relationship_type" name="relationship_type">{(["employee","contractor"] as const).map(type=><option value={type} selected={d.person.relationship_type===type}>{type==="employee"?(vi?"Nhân viên":"Employee"):(vi?"Cộng tác viên (không vào payroll)":"Contractor (never in payroll)")}</option>)}</select></div>
  <div class="crm-field"><label for="rehire_work_email">{vi?"Email công việc":"Work email"}</label><input class="crm-input" id="rehire_work_email" name="work_email" type="email" value={d.person.work_email} maxlength="254"/></div>
  <div class="crm-field"><label for="rehire_work_phone">{vi?"Điện thoại công việc":"Work phone"}</label><input class="crm-input" id="rehire_work_phone" name="work_phone" type="tel" value={d.person.work_phone} maxlength="40"/></div>
  <div class="crm-field"><label for="rehire_department">{vi?"Bộ phận":"Department"}</label><input class="crm-input" id="rehire_department" name="department" value={d.person.department} maxlength="200"/></div>
  <div class="crm-field"><label for="rehire_job_title">{vi?"Chức danh":"Job title"}</label><input class="crm-input" id="rehire_job_title" name="job_title" value={d.person.job_title} maxlength="200"/></div>
  <div class="crm-field"><label for="rehire_legal_entity">{vi?"Pháp nhân":"Legal entity"}</label><input class="crm-input" id="rehire_legal_entity" name="legal_entity" value={d.person.legal_entity} required maxlength="200"/></div>
  <div class="crm-field"><label for="rehire_location">{vi?"Địa điểm":"Location"}</label><input class="crm-input" id="rehire_location" name="location" value={d.person.location} maxlength="200"/></div>
  <div class="crm-field"><label for="rehire_manager_user_id">{vi?"Quản lý trực tiếp":"Direct manager"}</label><select class="crm-select" id="rehire_manager_user_id" name="manager_user_id"><option value="">{vi?"Chưa phân công":"Unassigned"}</option>{d.managers.map(member=><option value={member.user_id}>{member.name||member.email}</option>)}</select></div>
 </div><button class="crm-button" type="submit">{vi?"Tạo đợt làm việc mới":"Start new employment period"}</button></form></section>}
</HrmPage>
