---
import HrmPage from "./HrmPage.astro";
import type { RetentionPageData } from "../../lib/hrm/retention-pages";
const d=Astro.props as RetentionPageData;const vi=d.vi;
const policyState=(value:string)=>({draft:vi?"Bản nháp":"Draft",reviewed:vi?"Đã rà soát":"Reviewed",active:vi?"Đang áp dụng":"Active",retired:vi?"Đã ngừng":"Retired",rejected:vi?"Bị từ chối":"Rejected"}[value]||value);
const requestState=(value:string)=>({pending_review:vi?"Chờ duyệt":"Awaiting review",approved:vi?"Đã duyệt":"Approved",executing:vi?"Đang xử lý":"Executing",deleting:vi?"Đang xóa object":"Deleting object",retryable:vi?"Có thể thử lại":"Retryable",completed:vi?"Đã xử lý":"Completed",rejected:vi?"Bị từ chối":"Rejected",blocked:vi?"Bị chặn":"Blocked"}[value]||value);
const categoryLabel=(value:string)=>({profile_photo:vi?"Ảnh hồ sơ":"Profile photo",identity:vi?"Định danh/CCCD":"Identity/ID",dependent:vi?"Người phụ thuộc":"Dependent",banking:vi?"Ngân hàng":"Banking",tax:vi?"Thuế/bảo hiểm":"Tax/insurance",personal:vi?"Cá nhân/liên hệ":"Personal/contact",legal_source:vi?"Nguồn chính sách DOCX":"Policy DOCX source",legal_evidence:vi?"Bằng chứng pháp lý PDF":"Legal PDF evidence",coi_evidence:vi?"Bằng chứng COI":"COI evidence",onboarding_evidence:vi?"Bằng chứng onboarding":"Onboarding evidence",leave_evidence:vi?"Chứng từ nghỉ phép":"Leave evidence"}[value]||value);
const recordKindLabel=(value:string)=>({contact:vi?"Liên hệ":"Contact",personal:vi?"Thông tin cá nhân":"Personal",identity:vi?"Định danh/CCCD":"Identity/ID",dependent:vi?"Người phụ thuộc":"Dependent",bank:vi?"Ngân hàng":"Banking",tax:vi?"Thuế/bảo hiểm":"Tax/insurance"}[value]||value);
const anchorLabel=(value:string|null)=>value==="record_created"?(vi?"Từ ngày tạo hồ sơ":"From record creation"):value==="effective_to"?(vi?"Từ ngày hiệu lực kết thúc":"From effective end date"):(vi?"Không lên lịch":"No schedule");
const structuredRulesForDisplay=(value:string)=>{try{return (JSON.parse(value) as {kind:string;retention_days:number|null;retention_anchor:string|null;basis:string}[]).map(rule=>`${recordKindLabel(rule.kind)} · ${rule.retention_days===null?(vi?"không tự động":"manual review"):`${rule.retention_days} ${vi?"ngày":"days"}`} · ${anchorLabel(rule.retention_anchor)} · ${rule.basis}`).join("\n")}catch{return vi?"Không đọc được JSON chính sách.":"Could not read policy JSON."}};
const holdLabel=(hold:{scope_kind:string;category:string|null;source_table:string|null})=>hold.scope_kind==="file"?`${hold.source_table}`:`${hold.category==="*"?(vi?"Mọi danh mục":"All categories"):categoryLabel(hold.category??"")}`;
const dateTime=(value:string)=>new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"});
const today=new Date(Date.now()+7*3600_000).toISOString().slice(0,10);
const canManage=d.user.can("hrm.retention.manage"),canReview=d.user.can("hrm.retention.review"),canPlaceHold=d.user.can("hrm.legalhold.manage");
const canRequestStructured=(record:typeof d.structuredRecords[number])=>d.live&&canManage&&record.policy_configured&&!!record.retention_due_on&&record.retention_due_on<=today&&!record.held&&!record.live_files&&!record.pending_changes&&!record.redacted&&!(["pending_review","approved","executing","completed"].includes(record.disposition_state??""));
const parseRulesForDisplay=(value:string,localeVi:boolean,label:(key:string)=>string)=>{
 try{return (JSON.parse(value) as {category:string;retention_days:number|null;basis:string}[]).map(rule=>{
  const duration=rule.retention_days===null?(localeVi?"không lên lịch tự động":"no automatic schedule"):`${rule.retention_days} ${localeVi?"ngày":"days"}`;
  return `${label(rule.category)} · ${duration} · ${rule.basis}`;
 }).join("\n")}catch{return localeVi?"Không đọc được JSON chính sách.":"Could not read policy JSON."}
};
---
<HrmPage data={d} current="retention">
 <p class="crm-help">{vi?"Mỗi danh mục cần thời hạn và căn cứ được người phụ trách rà soát. Chưa có thời hạn mặc định. Hold còn hiệu lực sẽ chặn yêu cầu xóa; gỡ hold cần người khác với người đặt hold. Dữ liệu hết hạn không bị xóa tự động. Redact hồ sơ cấu trúc cần đến hạn, không còn hold, file sống hay thay đổi chờ duyệt, sau đó phải qua người rà soát độc lập và System Super Admin.":"Each category needs a reviewed retention period and basis. No durations are assumed. An active hold blocks deletion; another person must release a hold. Expired data is not deleted automatically. Structured-record redaction requires a due record with no hold, live file or pending change, followed by independent review and System Super Admin execution."}</p>
 {!d.live&&<div class="crm-notice bad">{vi?"HRM production vẫn đóng. Việc cấu hình/rà soát retention không mở công tắc production.":"HRM production remains closed. Configuring or reviewing retention does not enable the production switch."}</div>}
 {d.saved&&<p class="crm-notice good" role="status">{vi?"Đã ghi nhận thay đổi lưu trữ; kiểm tra trạng thái bên dưới.":"Retention action recorded; check the resulting state below."}</p>}

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Chính sách lưu trữ có phiên bản":"Versioned retention policy"}</h2>
  {canManage&&<form class="crm-form" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="create_policy"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Quy tắc cho đủ danh mục (JSON)":"Rules for every category (JSON)"}</span><textarea class="crm-input crm-json" name="rules_json" rows="13" required>{d.policyTemplate}</textarea><span class="crm-help">{vi?"`retention_days: null` nghĩa là không lên lịch xóa tự động. Ghi rõ căn cứ đã được rà soát; không dùng số ngày mặc định.":"`retention_days: null` means no scheduled eligibility. Enter the reviewed basis; do not use an assumed duration."}</span></label><button class="crm-button secondary" type="submit">{vi?"Tạo phiên bản nháp":"Create draft version"}</button></form>}
  {d.policies.length===0?<p class="crm-empty">{vi?"Chưa có chính sách retention nào được nhập.":"No retention policy has been entered."}</p>:<div class="crm-list">{d.policies.map(policy=><article class="crm-row"><div class="crm-onboarding-copy"><strong>v{policy.version_number} · {policyState(policy.state)}</strong><span class="crm-meta">{vi?"Tạo bởi":"Created by"} {policy.created_by} · {dateTime(policy.created_at)}{policy.reviewed_at?` · ${vi?"Rà soát":"Reviewed"} ${dateTime(policy.reviewed_at)}`:""}</span><pre class="crm-meta crm-json">{parseRulesForDisplay(policy.rules_json,vi,categoryLabel)}</pre></div><div class="crm-actions">
   {policy.state==="draft"&&canReview&&policy.created_by!==d.user.id&&<form class="crm-form crm-actions" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="review_policy"/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="500" required aria-label={vi?"Lý do rà soát":"Review reason"}/><button class="crm-button small" name="decision" value="approve">{vi?"Rà soát đạt":"Approve review"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}
   {policy.state==="reviewed"&&d.user.can("hrm.retention.activate")&&policy.created_by!==d.user.id&&<form method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="activate_policy"/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Kích hoạt phiên bản":"Activate version"}</button></form>}
  </div></article>)}</div>}
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Chính sách lưu trữ dữ liệu hồ sơ":"Structured-record retention policy"}</h2><p class="crm-help">{vi?"Đây là dữ liệu cấu trúc contact, personal, identity/CCCD, dependent, bank và tax trong hồ sơ nhân viên; file đính kèm có chính sách retention riêng. Không có thời hạn hay mốc tính mặc định. Chọn rõ ngày tạo hoặc ngày hiệu lực kết thúc cho từng danh mục, nhập căn cứ đã được owner rà soát; null nghĩa là không lên lịch tự động. Xóa chỉ được thực hiện sau hold, file liên kết và lịch sử thay đổi đã qua kiểm tra.":"This policy covers structured contact, personal, identity, dependent, bank and tax fields. Attached files follow their separate file-retention policy. No duration or retention anchor is seeded. Choose record creation or effective end for each category, provide an owner-reviewed basis, and use null to keep a category unscheduled. Disposition also checks holds, linked files and change history."}</p>
  {canManage&&<form class="crm-form" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="create_structured_policy"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Quy tắc cho đủ sáu loại dữ liệu hồ sơ (JSON)":"Rules for all six structured record kinds (JSON)"}</span><textarea class="crm-input crm-json" name="structured_rules_json" rows="15" required>{d.structuredPolicyTemplate}</textarea></label><button class="crm-button secondary" type="submit">{vi?"Tạo bản nháp chính sách hồ sơ":"Create structured policy draft"}</button></form>}
  {d.structuredPolicies.length===0?<p class="crm-empty">{vi?"Chưa có chính sách retention cho dữ liệu hồ sơ. Không có thời hạn mặc định.":"No structured-record retention policy exists. No default durations are assumed."}</p>:<div class="crm-list">{d.structuredPolicies.map(policy=><article class="crm-row"><div class="crm-onboarding-copy"><strong>v{policy.version_number} · {policyState(policy.state)}</strong><span class="crm-meta">{policy.legal_entity} · {vi?"Tạo bởi":"Created by"} {policy.created_by} · {dateTime(policy.created_at)}{policy.reviewed_at?` · ${vi?"Rà soát":"Reviewed"} ${dateTime(policy.reviewed_at)}`:""}</span><pre class="crm-meta crm-json">{structuredRulesForDisplay(policy.rules_json)}</pre></div><div class="crm-actions">
    {policy.state==="draft"&&canReview&&policy.created_by!==d.user.id&&<form class="crm-form crm-actions" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="review_structured_policy"/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="500" required aria-label={vi?"Lý do rà soát":"Review reason"}/><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}
    {policy.state==="reviewed"&&d.user.can("hrm.retention.activate")&&policy.created_by!==d.user.id&&<form method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="activate_structured_policy"/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="version" value={policy.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Kích hoạt chính sách hồ sơ":"Activate structured policy"}</button></form>}
   </div></article>)}</div>}
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Legal hold":"Legal holds"}</h2>
  {canPlaceHold&&<form class="crm-form" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="place_hold"/><input type="hidden" name="scope_kind" value="person"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Hồ sơ nhân viên":"Employee record"}</span><select class="crm-select" name="person_id" required><option value="">{vi?"Chọn hồ sơ":"Choose a person"}</option>{d.people.map(person=><option value={person.id}>{person.employee_code} · {person.legal_name} · {person.status}</option>)}</select></label><label class="crm-field"><span>{vi?"Phạm vi danh mục":"Category scope"}</span><select class="crm-select" name="category" required><option value="*">{vi?"Mọi danh mục":"All categories"}</option>{d.categories.map(category=><option value={category}>{categoryLabel(category)}</option>)}</select></label><label class="crm-field"><span>{vi?"Lý do / tham chiếu hồ sơ":"Reason / matter reference"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button secondary" type="submit">{vi?"Đặt legal hold":"Place legal hold"}</button></form>}
  <div class="crm-list">{d.holds.length===0?<p class="crm-empty">{vi?"Chưa có legal hold.":"No legal holds."}</p>:d.holds.map(hold=><article class="crm-row"><div><strong>{hold.scope_kind==="person"?(d.people.find(person=>person.id===hold.person_id)?.employee_code||"Employee"):`${hold.source_table} · ${hold.target_file_id}`}</strong><span class="crm-meta">{holdLabel(hold)} · {hold.state} · {hold.placed_by} · {dateTime(hold.placed_at)}</span><p>{hold.reason}{hold.release_reason?` · ${hold.release_reason}`:""}</p></div>{hold.state==="active"&&canReview&&hold.placed_by!==d.user.id&&<form method="post" action="/api/hrm/retention" class="crm-actions"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="release_hold"/><input type="hidden" name="hold_id" value={hold.id}/><input type="hidden" name="version" value={hold.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do gỡ hold":"Release reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button danger small" type="submit">{vi?"Gỡ hold (duyệt độc lập)":"Release hold (independent approval)"}</button></form>}</article>)}</div>
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tệp và kỳ lưu trữ":"Files and retention clock"}</h2><p class="crm-help">{vi?"Thời điểm đến hạn được tính từ lúc tải lên theo phiên bản active. Tệp đã xóa chỉ còn metadata/checksum/audit; không còn tải được.":"Due dates are calculated from upload time using the active version. Deleted objects retain metadata/checksum/audit only and can no longer be downloaded."}</p>
  <div class="crm-list">{d.files.map(file=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{file.employee_code?`${file.employee_code} · `:""}{file.original_name}</strong><span class="crm-meta">{categoryLabel(file.category)} · {file.source_table} · {file.state}{file.object_deleted_at?(vi?" · Object đã xóa":" · Object deleted"):""}</span><span class="crm-meta">{vi?"Tải lên":"Uploaded"} {dateTime(file.created_at)} · {vi?"Đến hạn":"Due"} {file.retention_due_on||"—"} · {Math.ceil(file.size_bytes/1024)} KB · SHA-256 {file.checksum.slice(0,12)}…</span>{file.held&&<span class="crm-badge terminal">LEGAL HOLD</span>}{!file.policy_configured&&<span class="crm-meta">{vi?"Danh mục chưa có quy tắc active":"No active rule for category"}</span>}{file.deletion_state&&<span class="crm-meta">{vi?"Yêu cầu xóa":"Deletion request"}: {requestState(file.deletion_state)}</span>}</div>
   <div class="crm-actions">{canPlaceHold&&!file.held&&!file.object_deleted_at&&<form method="post" action="/api/hrm/retention" class="crm-actions"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="place_hold"/><input type="hidden" name="scope_kind" value="file"/><input type="hidden" name="source_table" value={file.source_table}/><input type="hidden" name="target_file_id" value={file.file_id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="1000" required aria-label={vi?"Lý do đặt legal hold cho tệp":"File legal hold reason"}/><button class="crm-button secondary small" type="submit">{vi?"Đặt hold":"Hold"}</button></form>}
    {canManage&&file.policy_configured&&file.retention_due_on&&file.retention_due_on<=today&&!file.held&&!file.object_deleted_at&&!file.deletion_state&&<form method="post" action="/api/hrm/retention" class="crm-actions"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="request_delete"/><input type="hidden" name="source_table" value={file.source_table}/><input type="hidden" name="file_id" value={file.file_id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="500" required aria-label={vi?"Lý do đề nghị xóa":"Deletion request reason"}/><button class="crm-button danger small" type="submit">{vi?"Đề nghị xóa":"Request deletion"}</button></form>}
   </div></article>)}</div>
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Hàng chờ xóa có kiểm soát":"Deletion approval queue"}</h2><p class="crm-help">{vi?"Người tạo không thể tự duyệt. System Super Admin thực hiện xóa object sau duyệt; metadata và audit vẫn còn. Hold đang hoạt động hoặc quy tắc đổi sẽ chặn thao tác.":"The requester cannot approve their request. System Super Admin deletes the object after review; metadata and audit remain. Active holds or a changed rule block execution."}</p>
  <div class="crm-list">{d.requests.length===0?<p class="crm-empty">{vi?"Chưa có yêu cầu xóa.":"No deletion requests."}</p>:d.requests.map(request=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{request.employee_code?`${request.employee_code} · `:""}{request.original_name||request.source_file_id}</strong><span class="crm-meta">{categoryLabel(request.category)} · {request.source_table} · v{request.policy_version} · {requestState(request.state)}</span><span class="crm-meta">{vi?"Hạn":"Due"} {request.retention_due_on} · {request.requested_by} · {dateTime(request.requested_at)}</span><p>{request.request_reason}{request.block_reason?` · ${request.block_reason}`:""}{request.completion_detail?` · ${request.completion_detail}`:""}</p></div><div class="crm-actions">
   {request.state==="pending_review"&&canReview&&request.requested_by!==d.user.id&&<form method="post" action="/api/hrm/retention" class="crm-actions"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="review_delete"/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" maxlength="500" required aria-label={vi?"Lý do rà soát":"Review reason"}/><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt xóa":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}
   {d.user.admin&&request.requested_by!==d.user.id&&request.reviewed_by!==d.user.id&&["approved","deleting","retryable"].includes(request.state)&&<form method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="execute_delete"/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button danger small" type="submit">{vi?"Thực hiện / thử lại xóa":"Execute / retry deletion"}</button></form>}
  </div></article>)}</div>
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Dữ liệu hồ sơ và lịch sử":"Structured records and revision history"}</h2><p class="crm-help">{vi?"Danh sách chỉ hiển thị metadata, không có giá trị trường cá nhân. Chỉ hồ sơ có chính sách active, mốc đến hạn, không có hold, file sống hoặc yêu cầu đổi đang chờ mới có thể đề nghị xử lý. Thao tác chỉ ẩn dữ liệu JSON và lịch sử revision của bản ghi; không xóa hồ sơ nhân viên hay audit, còn file riêng tư dùng hàng chờ khác.":"This inventory shows metadata only, never personal field values. A record can be requested only under an active policy after its due date, without a hold, live linked file or pending change request. Disposition redacts that record's JSON and revision payloads; it does not delete the employee shell or audit, and private files use the separate queue."}</p>
  {d.structuredRecords.length===0?<p class="crm-empty">{vi?"Chưa có dữ liệu hồ sơ thuộc pháp nhân.":"No structured records for this legal entity."}</p>:(
   <div class="crm-list">{d.structuredRecords.map((record)=>(
    <article class="crm-row"><div class="crm-onboarding-copy">
      <strong>{record.employee_code} · {recordKindLabel(record.kind)}</strong>
      <span class="crm-meta">{vi?"Trạng thái":"State"} {record.state} · v{record.version} · {vi?"Tạo lúc":"Created"} {dateTime(record.created_at)}{record.effective_to&&<> · {vi?"Hiệu lực đến":"Effective to"} {record.effective_to}</>}</span>
      <span class="crm-meta">{vi?"Đến hạn":"Due"} {record.retention_due_on??"—"} · {record.disposition_state?requestState(record.disposition_state):(record.policy_configured?(vi?"Chưa có yêu cầu":"No request"):(vi?"Chưa có thời hạn active":"No active duration"))}</span>
      {record.redacted===1&&<span class="crm-badge terminal">{vi?"ĐÃ ẨN DỮ LIỆU":"REDACTED"}</span>}
      {record.held===1&&<span class="crm-badge terminal">LEGAL HOLD</span>}
      {record.live_files>0&&<span class="crm-meta">{vi?<>Còn {record.live_files} tệp liên kết cần xử lý riêng</>:<>{record.live_files} live linked file(s) need separate disposition</>}</span>}
      {record.pending_changes>0&&<span class="crm-meta">{vi?<>Còn {record.pending_changes} yêu cầu đổi đang chờ</>:<>{record.pending_changes} pending change request(s)</>}</span>}
    </div>
    {canRequestStructured(record)&&<form class="crm-form" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="request_structured_disposition"/><input type="hidden" name="record_id" value={record.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do đề nghị xử lý":"Disposition request reason"}</span><input class="crm-input" name="reason" maxlength="500" required/><span class="crm-help">{vi?"Chỉ ghi căn cứ ngắn; không sao chép giá trị dữ liệu hồ sơ vào lý do.":"Enter a short basis only; do not copy profile-record values into the reason."}</span></label><button class="crm-button danger small">{vi?"Đề nghị ẩn dữ liệu":"Request data disposition"}</button></form>}
    </article>
   ))}</div>
  )}
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Hàng chờ xử lý dữ liệu hồ sơ":"Structured-record disposition queue"}</h2><div class="crm-list">{d.structuredRequests.length===0?<p class="crm-empty">{vi?"Chưa có yêu cầu xử lý dữ liệu hồ sơ.":"No structured-record disposition requests."}</p>:d.structuredRequests.map(request=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{request.employee_code} · {recordKindLabel(request.record_kind)} · {requestState(request.state)}</strong><span class="crm-meta">{vi?"Hạn":"Due"} {request.retention_due_on} · {vi?"Người đề nghị":"Requested by"} {request.requested_by} · {dateTime(request.requested_at)}{request.reviewed_by?` · ${vi?"Người rà soát":"Reviewed by"} ${request.reviewed_by}`:""}{request.completed_by?` · ${vi?"Thực hiện":"Completed by"} ${request.completed_by}`:""}</span><p>{request.request_reason}{request.block_reason?` · ${request.block_reason}`:""}{request.completion_detail?` · ${request.completion_detail}`:""}</p></div><div class="crm-actions">
    {request.state==="pending_review"&&canReview&&request.requested_by!==d.user.id&&<form class="crm-form crm-actions" method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="review_structured_disposition"/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><button class="crm-button small" name="decision" value="approve">{vi?"Duyệt":"Approve"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}
    {request.state==="approved"&&d.user.admin&&<form method="post" action="/api/hrm/retention"><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="intent" value="execute_structured_disposition"/><input type="hidden" name="request_id" value={request.id}/><input type="hidden" name="version" value={request.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button danger small" type="submit">{vi?"Thực hiện ẩn dữ liệu":"Execute data disposition"}</button></form>}
   </div></article>)}</div>
 </section>
</HrmPage>
