---
import HrmPage from "./HrmPage.astro";
import type { BenefitManagementPage } from "../../lib/hrm/benefit-pages";

const d=Astro.props as BenefitManagementPage,vi=d.vi,prefix=vi?"/vi":"",returnTo=`${prefix}/hrm/benefits`;
const categoryLabel=(value:string)=>({health:vi?"Sức khỏe":"Health",insurance:vi?"Bảo hiểm":"Insurance",wellness:vi?"Sức khỏe tinh thần":"Wellness",family:vi?"Gia đình":"Family",reimbursement:vi?"Hoàn ứng":"Reimbursement",other:vi?"Khác":"Other"}[value]??value);
const stateLabel=(value:string)=>({draft:vi?"Bản nháp":"Draft",active:vi?"Đang áp dụng":"Active",retired:vi?"Đã thay thế":"Retired",submitted:vi?"Chờ HR duyệt":"Pending HR review",approved:vi?"Đã duyệt":"Approved",declined:vi?"Không được duyệt":"Declined",cancelled:vi?"Đã hủy":"Cancelled"}[value]??value);
---
<HrmPage data={d}>
  <section class="crm-notice" role="note"><strong>{vi?"Cấu hình phúc lợi, không phải tính lương":"Configurable benefits, separate from payroll"}</strong><p>{vi?"Mô tả điều kiện là văn bản tham khảo; HR xác minh từng đăng ký. Module không suy ra khoản tiền, không tính điều kiện tự động và không đưa phúc lợi vào payslip.":"Eligibility text is guidance only; HR verifies each enrollment. This module does not infer benefit amounts, calculate eligibility or add benefits to payslips."}</p></section>
  {d.error&&<p class="crm-notice error" role="alert">{vi?"Không thể lưu thay đổi: ":"Could not save: "}{d.error}</p>}
  {d.saved&&<p class="crm-notice success" role="status">{vi?"Đã lưu thay đổi.":"Changes saved."}</p>}
  <section class="crm-sheet">
    <h2 class="crm-h2">{vi?"Tạo phiên bản chính sách":"Create a policy version"}</h2>
    {d.legalEntity?<form class="crm-form" method="post" action="/api/hrm/benefits">
      <input type="hidden" name="intent" value="create_plan"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="legal_entity" value={d.legalEntity}/>
      <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Mã gói":"Plan code"}</span><input class="crm-input" name="plan_code" maxlength="48" required/></label><label class="crm-field"><span>{vi?"Nhóm":"Category"}</span><select class="crm-input" name="category"><option value="health">{categoryLabel("health")}</option><option value="insurance">{categoryLabel("insurance")}</option><option value="wellness">{categoryLabel("wellness")}</option><option value="family">{categoryLabel("family")}</option><option value="reimbursement">{categoryLabel("reimbursement")}</option><option value="other">{categoryLabel("other")}</option></select></label></div>
      <label class="crm-field"><span>{vi?"Tên":"Name"}</span><input class="crm-input" name="name" maxlength="120" required/></label>
      <label class="crm-field"><span>{vi?"Mô tả quyền lợi theo chính sách đã duyệt":"Policy description"}</span><textarea class="crm-input" name="description" maxlength="2000" required rows="3"></textarea></label>
      <label class="crm-field"><span>{vi?"Điều kiện tham gia (văn bản, không tự tính)":"Eligibility text (descriptive, not evaluated)"}</span><textarea class="crm-input" name="eligibility_text" maxlength="2000" required rows="3"></textarea></label>
      <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Hiệu lực từ":"Effective from"}</span><input class="crm-input" type="date" name="effective_from" required/></label><label class="crm-field"><span>{vi?"Hiệu lực đến":"Effective through"}</span><input class="crm-input" type="date" name="effective_to" required/></label></div>
      <button class="crm-button">{vi?"Tạo bản nháp":"Create draft"}</button>
    </form>:<p class="crm-empty">{vi?"Cấu hình pháp nhân HRM trước khi tạo gói.":"Configure the HRM legal entity before creating a plan."}</p>}
  </section>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Phiên bản chính sách":"Policy versions"}</h2>{d.plans.length===0?<p class="crm-empty">{vi?"Chưa có gói phúc lợi. Không có chính sách mặc định.":"No plans exist. No benefit policy is assumed."}</p>:<div class="crm-list">{d.plans.map(plan=><article class="crm-row"><div><strong>{plan.plan_code} · v{plan.version_no} · {plan.name}</strong><p class="crm-meta">{categoryLabel(plan.category)} · {stateLabel(plan.state)} · {plan.legal_entity} · {plan.effective_from} → {plan.effective_to}</p><p>{plan.description}</p><p><strong>{vi?"Điều kiện mô tả":"Eligibility"}:</strong> {plan.eligibility_text}</p><p class="crm-meta">{vi?"Đăng ký chờ/đã duyệt":"Pending/approved enrollments"}: {plan.enrollment_count??0}</p></div>
    {plan.state==="draft"&&d.user.can("hrm.benefits.approve")&&plan.created_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/benefits"><input type="hidden" name="intent" value="activate_plan"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="plan_id" value={plan.id}/><input type="hidden" name="plan_revision" value={plan.revision}/><label class="crm-field"><span>{vi?"Xác nhận đã kiểm tra chính sách":"Independent policy review reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button">{vi?"Kích hoạt phiên bản":"Activate version"}</button></form>}
  </article>)}</div>}</section>
  <section class="crm-sheet"><h2 class="crm-h2">{vi?"Đăng ký nhân viên":"Employee enrollments"}</h2>{d.enrollments.length===0?<p class="crm-empty">{vi?"Chưa có đăng ký.":"No enrollment records."}</p>:<div class="crm-list">{d.enrollments.map(item=><article class="crm-row"><div><strong>{item.employee_code} · {item.display_name} · {item.plan_code} v{item.plan_version_no}</strong><p class="crm-meta">{item.plan_name} · {categoryLabel(item.category)} · {stateLabel(item.state)} · {item.created_at}</p>{item.employee_note&&<p>{vi?"Ghi chú nhân viên: ":"Employee note: "}{item.employee_note}</p>}{item.review_reason&&<p>{vi?"Lý do quyết định: ":"Decision reason: "}{item.review_reason}</p>}</div>
    {item.state==="submitted"&&d.user.can("hrm.benefits.approve")&&item.created_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/benefits"><input type="hidden" name="intent" value="decide_enrollment"/><input type="hidden" name="return_to" value={returnTo}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="enrollment_id" value={item.id}/><input type="hidden" name="enrollment_revision" value={item.revision}/><label class="crm-field"><span>{vi?"Lý do duyệt/từ chối":"Review reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><div class="crm-actions"><button class="crm-button" name="decision" value="approve">{vi?"Duyệt":"Approve"}</button><button class="crm-button danger" name="decision" value="decline">{vi?"Từ chối":"Decline"}</button></div></form>}
  </article>)}</div>}</section>
</HrmPage>
