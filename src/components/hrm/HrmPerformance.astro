---
import HrmPage from "./HrmPage.astro";
import HrmPerformanceLineage from "./HrmPerformanceLineage.astro";
import Command from "./HrmPerformanceFields.astro";
import type { PerformancePage } from "../../lib/hrm/performance-pages";
const d=Astro.props as PerformancePage,vi=d.vi,prefix=vi?"/vi":"",path=`${prefix}/hrm/${d.mode==="self"?"me/":""}performance`,r=d.selected,returnTo=r?`${path}?review=${encodeURIComponent(r.id)}`:path;
const label=(state:string)=>({open:vi?"Chờ tự đánh giá":"Awaiting self-assessment",self_submitted:vi?"Chờ người đánh giá":"Awaiting reviewer",assessed:vi?"Chờ rà soát độc lập":"Awaiting independent review",published:vi?"Đã phát hành":"Published",responded:vi?"Nhân viên đã phản hồi":"Employee responded",closed:vi?"Đã kết thúc":"Closed",cancelled:vi?"Đã hủy":"Cancelled"}[state]??state);
const eventLabel=(event:string)=>({created:vi?"Đã mở kỳ":"Cycle opened",correction_opened:vi?"Đã mở bản điều chỉnh":"Correction opened",submit_self:vi?"Đã gửi tự đánh giá":"Self-assessment submitted",assess:vi?"Người đánh giá đã gửi nhận xét":"Reviewer assessment submitted",request_changes:vi?"Yêu cầu sửa nhận xét":"Assessment returned for changes",reassign:vi?"Đã đổi người đánh giá":"Reviewer reassigned",publish:vi?"Đã duyệt phát hành":"Approved for publication",respond:vi?"Nhân viên đã xác nhận đọc và phản hồi":"Employee acknowledged and responded",close:vi?"Đã kết thúc kỳ":"Cycle closed",cancel:vi?"Đã hủy kỳ":"Cycle cancelled"}[event]??(vi?"Cập nhật đánh giá":"Review updated"));
const timestamp=(value:string|null)=>value?new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"}):"";
const identityAligned=!r?.correction_subject_user_id||r.correction_subject_user_id===r.employee_user_id;
const subject=r?.employee_user_id===d.user.id||r?.correction_subject_user_id===d.user.id,canManage=d.user.can("hrm.performance.manage")&&!subject&&identityAligned&&!r?.superseded,canApprove=d.user.can("hrm.performance.approve")&&!subject&&identityAligned&&!r?.superseded&&r?.created_by!==d.user.id&&r?.assessed_by!==d.user.id;
---
<HrmPage data={d}>
 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Kỳ đánh giá riêng tư":"Private review cycles"}</h2><p class="crm-help">{vi?"Nội dung chỉ dành cho đúng nhân viên, người được giao đánh giá và HR có quyền. Xác nhận đã đọc không có nghĩa đồng ý với kết quả. Đánh giá không tự thay đổi lương, chức danh hay quyền truy cập.":"Content is private to the employee, assigned reviewer and authorized HR. Acknowledging receipt does not mean agreement. Reviews do not change pay, job title or access."}</p>
 {d.reviews.length===0?<p class="crm-empty">{vi?"Chưa có kỳ đánh giá.":"No review cycles yet."}</p>:<div class="crm-list">{d.reviews.map(row=><article class="crm-row"><div><a href={`${path}?review=${encodeURIComponent(row.id)}`}>{row.title}</a><p class="crm-meta">{row.employee_code} · {row.display_name} · {label(row.state)}{row.superseded?` · ${vi?"Bản lưu đã được điều chỉnh":"Archived publication"}`:""}{row.pending_correction?` · ${vi?"Đang có bản điều chỉnh chờ duyệt":"Correction pending"}`:""}{row.correction_attempt?` · ${vi?"Lần điều chỉnh":"Correction attempt"} ${row.correction_attempt}`:""}</p><p class="crm-meta">{row.period_start} – {row.period_end} · {vi?"Hạn":"Due"}: {row.due_on}</p></div></article>)}</div>}
 <div class="crm-actions">{d.page>1&&<a class="crm-button secondary small" href={`${path}?page=${d.page-1}`}>{vi?"Trang trước":"Previous"}</a>}{d.hasMore&&<a class="crm-button secondary small" href={`${path}?page=${d.page+1}`}>{vi?"Trang tiếp":"Next"}</a>}</div>
 </section>
 {d.mode==="team"&&d.user.can("hrm.performance.manage")&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Mở kỳ đánh giá":"Open a review cycle"}</h2><form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="create_review" returnTo={path}/>
 <label class="crm-field"><span>{vi?"Nhân viên":"Employee"}</span><select class="crm-input" name="person_id" required><option value="">{vi?"Chọn nhân viên":"Choose employee"}</option>{d.people.filter(p=>p.user_id!==d.user.id).map(p=><option value={p.id}>{p.employee_code} · {p.display_name} · {p.legal_entity}</option>)}</select></label>
 <div class="crm-form-grid"><label class="crm-field"><span>{vi?"Mã kỳ":"Cycle code"}</span><input class="crm-input" name="cycle_code" maxlength="48" pattern="[A-Za-z0-9][A-Za-z0-9_-]*" required/></label><label class="crm-field"><span>{vi?"Tên kỳ đánh giá":"Review title"}</span><input class="crm-input" name="title" maxlength="160" required/></label></div>
 <div class="crm-form-grid">{[["period_start",vi?"Từ ngày":"Period starts"],["period_end",vi?"Đến ngày":"Period ends"],["due_on",vi?"Hạn hoàn tất":"Completion due"]].map(([name,title])=><label class="crm-field"><span>{title}</span><input class="crm-input" name={name} type="date" required/></label>)}</div>
 <label class="crm-field"><span>{vi?"Người đánh giá (tài khoản Workspace)":"Reviewer (Workspace account)"}</span><select class="crm-input" name="reviewer_user_id" required><option value="">{vi?"Chọn người đánh giá":"Choose reviewer"}</option>{d.reviewers.map(p=><option value={p.user_id}>{p.name}</option>)}</select></label>
 <label class="crm-field"><span>{vi?"Mục tiêu và tiêu chí có thể kiểm tra":"Objectives and verifiable criteria"}</span><textarea class="crm-input" name="objectives" maxlength="4000" rows="4" required/></label>
 <label class="crm-field"><span>{vi?"Bằng chứng cần nêu (sự kiện, ngày, nguồn tham chiếu)":"Evidence required (facts, dates, source references)"}</span><textarea class="crm-input" name="evidence_instructions" maxlength="2000" rows="3" required/></label><button class="crm-button primary">{vi?"Mở kỳ đánh giá":"Open review cycle"}</button>
 </form></section>}
 {r&&<section class="crm-sheet"><h2 class="crm-h2">{r.title}</h2><p class="crm-meta">{r.employee_code} · {r.display_name} · {label(r.state)}</p><h3>{vi?"Mục tiêu":"Objectives"}</h3><p class="crm-help performance-text">{r.objectives}</p><h3>{vi?"Yêu cầu bằng chứng":"Evidence requirements"}</h3><p class="crm-help performance-text">{r.evidence_instructions}</p>
 {r.self_assessment&&<><h3>{d.lineage?.correction?.self_mode==="carry_forward"?(vi?"Tự đánh giá gốc được giữ làm bối cảnh":"Original self-assessment carried as context"):(vi?"Nhân viên tự đánh giá":"Employee self-assessment")}</h3><p class="performance-text">{r.self_assessment}</p><h4>{vi?"Bằng chứng nhân viên":"Employee evidence"}</h4><p class="performance-text">{r.self_evidence}</p></>}
 {r.assessment&&<><h3>{vi?"Nhận xét của người đánh giá":"Reviewer assessment"}</h3><p class="performance-text">{r.assessment}</p><h4>{vi?"Bằng chứng đánh giá":"Reviewer evidence"}</h4><p class="performance-text">{r.assessment_evidence}</p><h3>{vi?"Kế hoạch phát triển":"Development plan"}</h3><p class="performance-text">{r.development_plan}</p></>}
 {r.acknowledged_at&&<><p class="crm-meta">{vi?"Đã xác nhận đọc lúc":"Receipt acknowledged at"}: {timestamp(r.acknowledged_at)}</p><h3>{vi?"Phản hồi của nhân viên":"Employee feedback"}</h3><p class="performance-text">{r.employee_feedback|| (vi?"Không ghi thêm ý kiến.":"No additional comment.")}</p></>}
 <HrmPerformanceLineage data={d}/>
 {subject&&d.user.can("hrm.performance.self")&&!r.superseded&&identityAligned&&r.state==="open"&&<form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="submit_self" returnTo={returnTo} reviewId={r.id} revision={r.revision}/><label class="crm-field"><span>{vi?"Tự đánh giá theo mục tiêu":"Self-assessment against objectives"}</span><textarea class="crm-input" name="assessment" maxlength="4000" rows="4" required/></label><label class="crm-field"><span>{vi?"Bằng chứng: sự kiện, thời điểm, nguồn tham chiếu":"Evidence: facts, dates, source references"}</span><textarea class="crm-input" name="evidence" maxlength="4000" rows="4" required/></label><button class="crm-button primary">{vi?"Gửi tự đánh giá":"Submit self-assessment"}</button></form>}
 {!subject&&r.reviewer_user_id===d.user.id&&d.user.can("hrm.performance.review")&&!r.superseded&&identityAligned&&r.state==="self_submitted"&&<form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="assess" returnTo={returnTo} reviewId={r.id} revision={r.revision}/><label class="crm-field"><span>{vi?"Nhận xét theo mục tiêu":"Assessment against objectives"}</span><textarea class="crm-input" name="assessment" maxlength="4000" rows="4" required/></label><label class="crm-field"><span>{vi?"Bằng chứng đánh giá":"Assessment evidence"}</span><textarea class="crm-input" name="evidence" maxlength="4000" rows="4" required/></label><label class="crm-field"><span>{vi?"Kế hoạch phát triển: hành động, người hỗ trợ, hạn và cách kiểm chứng":"Development plan: actions, support owner, due dates and evidence"}</span><textarea class="crm-input" name="development_plan" maxlength="4000" rows="4" required/></label><p class="crm-help">{vi?"Nhân viên chỉ xem nội dung này sau khi HRM Admin độc lập duyệt phát hành.":"The employee sees this content after independent HRM Admin approval."}</p><button class="crm-button primary">{vi?"Gửi HRM rà soát":"Submit for HRM review"}</button></form>}
 {canApprove&&((r.state==="assessed"?["publish","request_changes"]:r.state==="responded"?["close"]:[]) as string[]).map(action=><form class="crm-form" method="post" action="/api/hrm/performance"><Command intent={action} returnTo={returnTo} reviewId={r.id} revision={r.revision}/>{action==="publish"&&d.lineage?.correction&&<><input type="hidden" name="source_revision" value={d.lineage.correction.source_context?.revision??""}/><label class="crm-field"><span><input type="checkbox" name="source_reviewed" value="1" required/> {vi?"Tôi đã rà soát phiên bản nguồn hiện hành, phản hồi cũ và nguồn tự đánh giá được kế thừa (nếu có).":"I reviewed the current source revision, prior feedback and any carried self-assessment context."}</span></label></>}<label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><textarea class="crm-input" name="reason" maxlength="1000" rows="2" required/></label><button class="crm-button primary">{action==="publish"?(vi?"Duyệt và phát hành":"Approve and publish"):action==="close"?(vi?"Kết thúc kỳ đánh giá":"Close review cycle"):(vi?"Yêu cầu người đánh giá sửa":"Return to reviewer")}</button></form>)}
 {subject&&d.user.can("hrm.performance.self")&&!r.superseded&&identityAligned&&r.state==="published"&&<form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="respond" returnTo={returnTo} reviewId={r.id} revision={r.revision}/><label class="crm-field"><span>{vi?"Phản hồi, ý kiến khác hoặc đề nghị hỗ trợ":"Feedback, disagreement or support requested"}</span><textarea class="crm-input" name="feedback" maxlength="4000" rows="4"/></label><label class="crm-field"><span><input type="checkbox" name="acknowledged" value="1" required/> {vi?"Tôi đã đọc phiên bản này. Xác nhận không đồng nghĩa đồng ý với kết quả.":"I have read this revision. Acknowledgement does not mean agreement with the outcome."}</span></label><button class="crm-button primary">{vi?"Gửi phản hồi và xác nhận đọc":"Send feedback and acknowledge receipt"}</button></form>}
 {canManage&&["open","self_submitted","assessed"].includes(r.state)&&<><form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="reassign" returnTo={returnTo} reviewId={r.id} revision={r.revision}/><label class="crm-field"><span>{vi?"Đổi người đánh giá":"Reassign reviewer"}</span><select class="crm-input" name="reviewer_user_id" required>{d.reviewers.filter(p=>p.user_id!==r.employee_user_id&&p.user_id!==r.reviewer_user_id).map(p=><option value={p.user_id}>{p.name}</option>)}</select></label><label class="crm-field"><span>{vi?"Lý do (nội dung đánh giá cũ chỉ giữ trong lịch sử HR)":"Reason (previous assessment remains in HR history only)"}</span><textarea class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button secondary">{vi?"Đổi người đánh giá":"Reassign reviewer"}</button></form><form class="crm-form" method="post" action="/api/hrm/performance"><Command intent="cancel" returnTo={returnTo} reviewId={r.id} revision={r.revision}/><label class="crm-field"><span>{vi?"Lý do hủy":"Cancellation reason"}</span><textarea class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button secondary">{vi?"Hủy kỳ chưa phát hành":"Cancel unpublished review"}</button></form></>}
 <h3>{vi?"Lịch sử thao tác":"Workflow history"}</h3><ol>{d.events.map(event=><li><span>{eventLabel(event.event_type)}</span> · {timestamp(event.created_at)}</li>)}</ol>
 </section>}
</HrmPage>
<style>.performance-text{white-space:pre-wrap;overflow-wrap:anywhere}form+form{margin-top:1.5rem}h3,h4{margin-top:1.25rem}code{overflow-wrap:anywhere}</style>
