---
import HrmPage from "./HrmPage.astro";
import type { OnboardingManagePage } from "../../lib/hrm/onboarding-pages";
const d=Astro.props as OnboardingManagePage;const vi=d.vi;
const taskExample=JSON.stringify([{key:"complete_profile",title_en:"Complete employee profile",title_vi:"Hoàn thiện hồ sơ nhân viên",instructions_en:"Review your work and contact details. Do not upload identity documents here.",instructions_vi:"Kiểm tra thông tin công việc và liên hệ. Không tải giấy tờ định danh tại đây.",milestone:"Before first day",assignee_kind:"employee",verifier_kind:"hrm_officer",due_offset_days:-2,required:true,allow_waive:false,dependencies:[],evidence_type:"text",action_key:"profile"}],null,2);
const state=(value:string)=>({draft:vi?"Bản nháp":"Draft",reviewed:vi?"Đã rà soát":"Reviewed",active:vi?"Đang áp dụng":"Active",rejected:vi?"Bị từ chối":"Rejected",retired:vi?"Đã ngừng":"Retired",not_started:vi?"Chưa bắt đầu":"Not started",in_progress:vi?"Đang làm":"In progress",submitted:vi?"Đã nộp":"Submitted",verified:vi?"Đã kiểm tra":"Verified",completed:vi?"Hoàn tất":"Completed",blocked:vi?"Đang vướng":"Blocked",waived:vi?"Được miễn":"Waived",cancelled:vi?"Đã hủy":"Cancelled"}[value]||value);
const visibleMembers=d.members.filter(member=>member.enabled&&member.active);
const buddyMembers=visibleMembers.filter(member=>member.roles.some(role=>["employee","people_manager","hrm_officer","hrm_admin"].includes(role)));
const hrMembers=visibleMembers.filter(member=>member.roles.some(role=>["hrm_officer","hrm_admin"].includes(role)));
const adminMembers=visibleMembers.filter(member=>member.roles.includes("hrm_admin"));
const byId=(userId:string|null)=>visibleMembers.find(member=>member.user_id===userId)?.name||"—";
const done=(task:{state:string})=>["verified","completed","waived"].includes(task.state);
const returnTo=`${vi?"/vi":""}/hrm/onboarding`;
const due=(value:string)=>new Date(value).toLocaleDateString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeZone:"Asia/Ho_Chi_Minh"});
---
<HrmPage data={d} current="onboarding-manage">
 <p class="crm-meta">{vi?"Mẫu có phiên bản; mỗi kế hoạch lưu snapshot. Todo không tự cấp quyền, ký giấy tờ hoặc xác nhận hoạt động bên ngoài.":"Templates are versioned and each plan keeps a snapshot. Tasks never grant access, sign legal documents or claim external work was performed."}</p>
 {!d.live&&<div class="crm-notice bad">{vi?"HRM đang đóng. Có thể chuẩn bị/rà soát mẫu; chưa thể tạo kế hoạch cho nhân viên.":"HRM is closed. Templates can be prepared and reviewed; employee plans cannot be created yet."}</div>}
 {d.saved&&<div class="crm-notice good" role="status">{({template_created:vi?"Đã tạo mẫu bản nháp.":"Draft template created.",version_created:vi?"Đã tạo phiên bản mới.":"New version created.",version_saved:vi?"Đã lưu phiên bản bản nháp.":"Draft version saved.",version_reviewed:vi?"Đã rà soát phiên bản.":"Version reviewed.",version_rejected:vi?"Đã từ chối phiên bản.":"Version rejected.",version_activated:vi?"Đã kích hoạt phiên bản.":"Version activated.",plan_created:vi?"Đã tạo kế hoạch bản nháp.":"Draft plan created.",plan_activated:vi?"Đã kích hoạt kế hoạch.":"Plan activated.",plan_cancelled:vi?"Đã hủy kế hoạch.":"Plan cancelled.",dates_rescheduled:vi?"Đã đổi ngày và cập nhật hạn việc chưa hoàn tất.":"Start date and unfinished task deadlines updated.",task_updated:vi?"Đã cập nhật công việc.":"Task updated."} as Record<string,string>)[d.saved]||d.saved}</div>}

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo mẫu onboarding":"Create an onboarding template"}</h2><p class="crm-help">{vi?"Mốc hạn là ngày lịch tính từ ngày bắt đầu; offset âm dành cho việc trước ngày đầu. Phụ thuộc dùng key của công việc, không được tạo chu trình.":"Deadlines use calendar days from the start date; negative offsets are pre-start tasks. Dependencies refer to task keys and cannot contain cycles."}</p>
  <form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="create_template"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><div class="crm-field"><label for="template_key">{vi?"Mã mẫu":"Template key"}</label><input class="crm-input" id="template_key" name="template_key" pattern="[a-z0-9][a-z0-9_-]{2,79}" required maxlength="80"/></div><div class="crm-field"><label for="template_title_en">Title — English</label><input class="crm-input" id="template_title_en" name="title_en" required maxlength="200"/></div><div class="crm-field"><label for="template_title_vi">Tiêu đề — Tiếng Việt</label><input class="crm-input" id="template_title_vi" name="title_vi" required maxlength="200"/></div>
   <div class="crm-field"><label for="applicability_json">{vi?"Đối tượng áp dụng (JSON)":"Applicability filters (JSON)"}</label><textarea class="crm-input" id="applicability_json" name="applicability_json" rows="5" required>{'{"legal_entities":[],"job_titles":[],"locations":[],"employment_statuses":["preboarding","probation","active"]}'}</textarea><span class="crm-help">{vi?"Mảng rỗng không lọc theo trường đó.":"An empty array leaves that dimension unrestricted."}</span></div>
   <div class="crm-field"><label for="tasks_json">{vi?"Danh sách todo (JSON)":"Todo definition (JSON)"}</label><textarea class="crm-input" id="tasks_json" name="tasks_json" rows="16" required>{taskExample}</textarea><span class="crm-help">{vi?"Assignee: employee, manager, buddy, hrm_officer, hrm_admin. Verifier: none, manager, hrm_officer, hrm_admin. Evidence: none, text, pdf. Action: profile, identity, legal, coi, asset, training, custom.":"Assignee: employee, manager, buddy, hrm_officer, hrm_admin. Verifier: none, manager, hrm_officer, hrm_admin. Evidence: none, text, pdf. Action: profile, identity, legal, coi, asset, training, custom."}</span></div>
  </div><button class="crm-button" type="submit">{vi?"Tạo mẫu bản nháp":"Create draft template"}</button></form>
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Mẫu và phiên bản":"Templates and versions"}</h2>
  {d.templates.length===0?<p class="crm-meta">{vi?"Chưa có mẫu onboarding.":"No onboarding templates yet."}</p>:<div class="crm-list">{d.templates.map(template=><article class="crm-row"><div><strong>{vi?template.title_vi:template.title_en}</strong><span class="crm-meta">{template.template_key} · {state(template.state)}{template.current_version_number?` · v${template.current_version_number} (${state(template.current_version_state||"")})`:""}</span></div><a class="crm-button secondary small" href={`${vi?"/vi":""}/hrm/onboarding?selected=${encodeURIComponent(template.id)}`}>{vi?"Mở":"Open"}</a></article>)}</div>}
 </section>

 {d.selectedTemplate&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Phiên bản của mẫu":"Template versions"}</h2>
  {d.versions.map(version=><article class="crm-sheet crm-onboarding-version"><div><strong>v{version.version_number} · {state(version.state)}</strong><span class="crm-meta">{vi?"Người tạo":"Created by"} {version.created_by}{version.reviewed_by?` · ${vi?"Rà soát":"Reviewed"} ${version.reviewed_by}`:""}</span></div>
   {version.state==="draft"&&<form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="save_version"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version_id" value={version.id}/><input type="hidden" name="version" value={version.version}/><input type="hidden" name="template_id" value={d.selectedTemplate}/><label class="crm-field"><span>{vi?"Áp dụng cho (JSON)":"Applicability (JSON)"}</span><textarea class="crm-input" name="applicability_json" rows="4">{version.applicability_json}</textarea></label><label class="crm-field"><span>{vi?"Todo (JSON)":"Tasks (JSON)"}</span><textarea class="crm-input" name="tasks_json" rows="14">{JSON.stringify(JSON.parse(version.tasks_json),null,2)}</textarea></label><button class="crm-button secondary" type="submit">{vi?"Lưu bản nháp":"Save draft"}</button></form>}
   <div class="crm-actions">{version.state==="draft"&&version.created_by!==d.user.id&&<form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="review_version"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version_id" value={version.id}/><input type="hidden" name="version" value={version.version}/><input type="hidden" name="template_id" value={d.selectedTemplate}/><label class="crm-field"><span>{vi?"Lý do rà soát":"Review reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button small" name="decision" value="approve">{vi?"Rà soát đạt":"Approve for activation"}</button><button class="crm-button danger small" name="decision" value="reject">{vi?"Từ chối":"Reject"}</button></form>}{version.state==="reviewed"&&d.user.can("hrm.configure")&&version.created_by!==d.user.id&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="activate_version"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="version_id" value={version.id}/><input type="hidden" name="version" value={version.version}/><input type="hidden" name="template_id" value={d.selectedTemplate}/><button class="crm-button small" type="submit">{vi?"Kích hoạt":"Activate"}</button></form>}</div>
  </article>)}
  {d.templates.find(t=>t.id===d.selectedTemplate)?.state==="active"&&<form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="create_version"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="template_id" value={d.selectedTemplate}/><input type="hidden" name="template_version" value={d.templates.find(t=>t.id===d.selectedTemplate)?.version}/><button class="crm-button secondary" type="submit">{vi?"Tạo phiên bản tiếp theo":"Create next version"}</button></form>}
 </section>}

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Tạo kế hoạch cho đợt làm việc":"Create a plan for an employment period"}</h2><p class="crm-help">{vi?"Kế hoạch bắt đầu ở trạng thái nháp. Xác minh đủ người phụ trách trước khi kích hoạt; HRM không tự cấp quyền ngoài Workspace.":"Plans start as drafts. Confirm that every owner is assigned before activation; HRM never grants access outside Workspace."}</p>
  <form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="create_plan"/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="crm-form-grid"><label class="crm-field"><span>{vi?"Nhân viên/đợt làm việc":"Employee/employment period"}</span><select class="crm-select" name="person_id" required><option value="">{vi?"Chọn nhân viên":"Choose employee"}</option>{d.candidates.filter(person=>!person.has_plan).map(person=><option value={person.id}>{person.employee_code} · {person.legal_name} · {person.job_title} · {person.started_on}</option>)}</select></label><label class="crm-field"><span>{vi?"Mẫu đang hoạt động":"Active template"}</span><select class="crm-select" name="template_id" required><option value="">{vi?"Chọn mẫu":"Choose template"}</option>{d.templates.filter(template=>template.state==="active"&&template.current_version_state==="active").map(template=><option value={template.id}>{template.title_en} / {template.title_vi} · v{template.current_version_number}</option>)}</select></label>
   <label class="crm-field"><span>{vi?"Buddy (nếu mẫu cần)":"Buddy (if required)"}</span><select class="crm-select" name="buddy_user_id"><option value="">{vi?"Chưa gán":"Unassigned"}</option>{buddyMembers.map(member=><option value={member.user_id}>{member.name} · {member.roles.join(", ")}</option>)}</select></label><label class="crm-field"><span>{vi?"HR phụ trách (nếu mẫu cần)":"HR owner (if required)"}</span><select class="crm-select" name="hr_owner_user_id"><option value="">{vi?"Chưa gán":"Unassigned"}</option>{hrMembers.map(member=><option value={member.user_id}>{member.name} · {member.roles.join(", ")}</option>)}</select></label><label class="crm-field"><span>{vi?"HRM Admin phụ trách (nếu mẫu cần)":"HRM Admin owner (if required)"}</span><select class="crm-select" name="admin_owner_user_id"><option value="">{vi?"Chưa gán":"Unassigned"}</option>{adminMembers.map(member=><option value={member.user_id}>{member.name}</option>)}</select></label>
  </div><button class="crm-button" type="submit" disabled={!d.live}>{vi?"Tạo kế hoạch nháp":"Create draft plan"}</button></form>
 </section>

 <section class="crm-sheet"><h2 class="crm-h2">{vi?"Kế hoạch và công việc":"Plans and tasks"}</h2>
  {d.plans.length===0?<p class="crm-meta">{vi?"Chưa có kế hoạch onboarding.":"No onboarding plans yet."}</p>:<div class="crm-list">{d.plans.map(plan=><article class="crm-sheet"><div><strong>{plan.employee_code} · {plan.legal_name}</strong><span class="crm-meta">{plan.job_title} · {plan.department} · {state(plan.state)} · {plan.started_on}</span></div>
   <div class="crm-actions">{plan.state==="draft"&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="activate_plan"/><input type="hidden" name="plan_id" value={plan.id}/><input type="hidden" name="version" value={plan.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit" disabled={!d.live}>{vi?"Kích hoạt":"Activate"}</button></form>}{["draft","active"].includes(plan.state)&&<form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="cancel_plan"/><input type="hidden" name="plan_id" value={plan.id}/><input type="hidden" name="version" value={plan.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do hủy":"Cancellation reason"}</span><input class="crm-input" name="reason" required maxlength="500"/></label><button class="crm-button danger small" type="submit">{vi?"Hủy kế hoạch":"Cancel plan"}</button></form>}</div>
   {plan.state==="active"&&<form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value={d.preview?.plan.id===plan.id?"reschedule":"preview_reschedule"}/><input type="hidden" name="plan_id" value={plan.id}/><input type="hidden" name="version" value={plan.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Đổi ngày bắt đầu — sẽ đổi hạn việc chưa hoàn tất":"Change start date — unfinished deadlines will shift"}</span><input class="crm-input" name="new_start" type="date" value={d.preview?.plan.id===plan.id?d.preview.new_start:plan.started_on} required/></label>{d.preview?.plan.id===plan.id&&<><input type="hidden" name="confirm" value="1"/><p class="crm-help">{vi?"Bản xem trước — ngày hoàn tất giữ nguyên:":"Preview — completed task dates stay unchanged:"}</p><ul>{d.preview.changes.map(change=><li>{vi?change.task.title_vi:change.task.title_en}: {due(change.old_due)} → {due(change.new_due)}</li>)}</ul></>}<button class="crm-button secondary small" type="submit">{d.preview?.plan.id===plan.id?(vi?"Xác nhận đổi ngày":"Confirm reschedule"):(vi?"Xem trước":"Preview")}</button></form>}
   <h3 class="crm-h2">{vi?"Todo":"Tasks"} · {d.tasks.filter(task=>task.plan_id===plan.id&&task.required&&["verified","completed","waived"].includes(task.state)).length}/{d.tasks.filter(task=>task.plan_id===plan.id&&task.required).length} {vi?"bắt buộc":"required done"}</h3><div class="crm-list">{d.tasks.filter(task=>task.plan_id===plan.id).map(task=><article class="crm-row"><div class="crm-onboarding-copy"><strong>{vi?task.title_vi:task.title_en}</strong><span class="crm-meta">{task.task_key} · {task.milestone} · {state(task.state)} · {due(task.due_at)} · {task.required?(vi?"Bắt buộc":"Required"):(vi?"Tùy chọn":"Optional")}</span><span class="crm-meta">{vi?"Người làm":"Owner"}: {byId(task.assignee_user_id)} · {vi?"Người kiểm tra":"Verifier"}: {byId(task.verifier_user_id)}</span>{task.assignee_user_id===d.user.id&&task.instructions_en&&<p>{vi?task.instructions_vi:task.instructions_en}</p>}{task.blocked_reason&&<p>{task.blocked_reason}</p>}{task.review_reason&&<p>{task.review_reason}</p>}{task.evidence_name&&<span class="crm-meta">{task.evidence_name} · {task.evidence_state}</span>}</div>
    <div class="crm-actions">{plan.state==="active"&&task.state==="not_started"&&task.assignee_user_id===d.user.id&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="start"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Bắt đầu":"Start"}</button></form>}
     {plan.state==="active"&&task.state==="submitted"&&(d.user.id===task.verifier_user_id||d.user.can("hrm.onboarding.manage"))&&<><form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="verify"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Xác minh":"Verify"}</button></form><form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="reject"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" required maxlength="1000" aria-label={vi?"Lý do trả lại":"Return reason"}/><button class="crm-button danger small" type="submit">{vi?"Trả lại":"Return"}</button></form></>}
     {plan.state==="active"&&task.state==="submitted"&&task.evidence_file_id&&task.evidence_state==="quarantined"&&(d.user.id===task.verifier_user_id||d.user.can("hrm.onboarding.manage"))&&task.evidence_uploaded_by!==d.user.id&&<form method="post" action={`/api/hrm/legal/files/${encodeURIComponent(task.evidence_file_id)}`} class="crm-actions"><input type="hidden" name="intent" value="review"/><input type="hidden" name="version" value={task.evidence_file_version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={returnTo}/><input class="crm-input" name="reason" required maxlength="500" aria-label={vi?"Lý do rà soát PDF":"PDF review reason"}/><button class="crm-button small" name="decision" value="reviewed">{vi?"Rà soát PDF":"Review PDF"}</button><button class="crm-button danger small" name="decision" value="rejected">{vi?"Từ chối PDF":"Reject PDF"}</button></form>}
     {plan.state==="active"&&task.state==="in_progress"&&(task.assignee_user_id===d.user.id||d.user.can("hrm.onboarding.manage"))&&task.evidence_type==="pdf"&&<form method="post" action="/api/hrm/legal/files/upload" enctype="multipart/form-data" class="crm-form crm-upload"><input type="hidden" name="kind" value="pdf_evidence"/><input type="hidden" name="onboarding_task_id" value={task.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="return_to" value={returnTo}/><label class="crm-field"><span>{vi?"PDF bằng chứng":"PDF evidence"}</span><input class="crm-input" name="file" type="file" accept="application/pdf,.pdf" required/></label><button class="crm-button secondary small" type="submit">{vi?"Tải và nộp":"Upload and submit"}</button></form>}
     {plan.state==="active"&&task.state==="in_progress"&&task.assignee_user_id===d.user.id&&task.evidence_type==="text"&&<form method="post" action="/api/hrm/onboarding" class="crm-form"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="submit"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><textarea class="crm-input" name="submission_text" required maxlength="4000" rows="2" aria-label={vi?"Bằng chứng":"Evidence"}></textarea><button class="crm-button small" type="submit">{vi?"Nộp":"Submit"}</button></form>}
     {task.state==="blocked"&&task.assignee_user_id===d.user.id&&<form method="post" action="/api/hrm/onboarding"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="unblock"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><button class="crm-button small" type="submit">{vi?"Tiếp tục":"Resume"}</button></form>}
     {task.allow_waive===1&&plan.state==="active"&&!done(task)&&<form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value="waive"/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input class="crm-input" name="reason" required maxlength="500" aria-label={vi?"Lý do miễn":"Waiver reason"}/><button class="crm-button danger small" type="submit">{vi?"Miễn việc":"Waive"}</button></form>}
    </div></article>)}</div>
   </article>)}</div>}
 </section>
 {d.reassignment.length>0&&<section class="crm-sheet"><h2 class="crm-h2">{vi?"Hàng chờ phân công lại":"Reassignment queue"}</h2><p class="crm-help">{vi?"Owner hoặc người kiểm tra mất quyền hoạt động. Công việc được giữ nguyên cho tới khi HR phân công người thay thế.":"An owner or verifier lost the required active permission. Tasks remain open until HR assigns a replacement."}</p><div class="crm-list">{d.reassignment.map(task=>{const forVerifier=task.reassignment_for==="verifier",kind=forVerifier?task.verifier_kind:task.assignee_kind,available=visibleMembers.filter(member=>kind==="manager"?member.user_id===task.manager_user_id:kind==="hrm_officer"?member.roles.some(role=>["hrm_officer","hrm_admin"].includes(role)):kind==="hrm_admin"?member.roles.includes("hrm_admin"):member.roles.some(role=>["employee","people_manager","hrm_officer","hrm_admin"].includes(role)));return <article class="crm-row"><div><strong>{task.employee_code} · {task.title_en}</strong><span class="crm-meta">{forVerifier?(vi?"Người kiểm tra":"Verifier"):(vi?"Người làm":"Assignee")} · {byId(forVerifier?task.verifier_user_id:task.assignee_user_id)} · {state(task.state)} · {due(task.due_at)}</span></div><form method="post" action="/api/hrm/onboarding" class="crm-actions"><input type="hidden" name="intent" value="task_action"/><input type="hidden" name="action" value={forVerifier?"reassign_verifier":"reassign"}/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Người thay thế":"Replacement"}</span><select class="crm-select" name="assignee_user_id" required><option value="">{vi?"Chọn người":"Choose a person"}</option>{available.map(member=><option value={member.user_id}>{member.name} · {member.roles.join(", ")}</option>)}</select></label><button class="crm-button small" type="submit">{vi?"Phân công lại":"Reassign"}</button></form></article>})}</div></section>}
</HrmPage>
