---
import type { OffboardingDetailPage } from "../../lib/hrm/offboarding-pages";
import type { CloseoutOutcome } from "../../lib/hrm/closeout-dossiers";
import { parseCloseoutChecks } from "../../lib/hrm/closeout-policies";
import { localDate } from "../../lib/hrm/service";
import { formatPayrollMoney } from "../../lib/hrm/payroll";
const d=Astro.props.data as OffboardingDetailPage,c=d.closeout!,vi=d.vi,caseId=d.offboarding.id;
const path=`${vi?"/vi":""}/hrm/offboarding/${encodeURIComponent(caseId)}`,liveCase=d.offboarding.state==="open",task=d.tasks.find(t=>t.task_key==="payroll_closeout");
const leaveEvent=(value:string)=>({annual_grant:vi?"Cấp phép năm":"Annual grant",accrual:vi?"Tích lũy":"Accrual",manual_adjustment:vi?"Điều chỉnh":"Adjustment",used:vi?"Đã dùng":"Used",returned:vi?"Hoàn lại quỹ":"Returned",carryover:vi?"Chuyển sang kỳ sau":"Carryover",expired:vi?"Hết hạn":"Expired"}[value]??(vi?"Cần kiểm tra":"Needs review"));
const state=(s:string)=>({prepared:vi?"Chờ duyệt":"Prepared",approved:vi?"Đã duyệt":"Approved",rejected:vi?"Bị từ chối":"Rejected",applied:vi?"Đã ghi vào checklist":"Applied to checklist",invalidated:vi?"Phải rà soát lại":"Requires fresh review",quarantined:vi?"Chưa được rà soát":"Awaiting review",reviewed:vi?"Đã rà soát":"Reviewed",closed:vi?"Đã đóng":"Closed",published:vi?"Đã phát hành":"Published",draft:vi?"Nháp":"Draft"}[s]??(vi?"Cần kiểm tra":"Needs review"));
const person=(id:string|null)=>id?.startsWith("system:")?(vi?"Hệ thống":"System"):id?(c.actorLabels[id]??(vi?"Tài khoản không còn khả dụng":"Account unavailable")):(vi?"Chưa rõ":"Unknown");
const utc=(value:string|null)=>value?new Date(value).toLocaleString(vi?"vi-VN":"en-GB",{dateStyle:"medium",timeStyle:"short",timeZone:"Asia/Ho_Chi_Minh"}):"—";
const proofUrl=(id:string)=>`/api/hrm/closeout/files/${encodeURIComponent(id)}?case_id=${encodeURIComponent(caseId)}`;
const usable=c.files.filter(f=>f.state==="reviewed"&&!f.object_deleted_at&&["none","rejected","blocked"].includes(f.disposition_state));
const policy=c.selectedPolicy,checks=policy?parseCloseoutChecks(JSON.parse(policy.checklist_json)):[];
const outcomeRows=(json:string):CloseoutOutcome[]=>{try{const rows=JSON.parse(json);return Array.isArray(rows)?rows:[]}catch{return []}};
const money=(value:unknown,run:Record<string,unknown>)=>typeof value==="number"&&Number.isSafeInteger(value)&&typeof run.currency==="string"&&/^[A-Z]{3}$/.test(run.currency)&&Number.isInteger(run.minor_unit_scale)&&Number(run.minor_unit_scale)>=0&&Number(run.minor_unit_scale)<=3?formatPayrollMoney(value,run.currency,Number(run.minor_unit_scale),vi?"vi":"en"):(vi?"Chưa rõ":"Unknown");
const blockers:Record<string,[string,string]>={identity_mismatch:["Person or employment linkage changed.","Liên kết nhân viên hoặc đợt làm việc đã thay đổi."],entity_mismatch:["The employing entity does not match the issued source.","Pháp nhân không khớp nguồn đã phát hành."],no_payroll_recorded:["No payroll is recorded. This remains unknown; an exemption requires explicit policy and reviewed evidence.","Chưa có payroll được ghi nhận. Đây là thông tin chưa rõ; muốn miễn phải có chính sách tường minh và chứng cứ được duyệt."],profile_change_pending:["A financial profile change still needs review.","Thay đổi hồ sơ liên quan tài chính vẫn chờ duyệt."],claim_unresolved:["A payslip inquiry remains unresolved.","Còn khiếu nại phiếu lương chưa giải quyết."],time_review_pending:["Attendance, adjustment or overtime review is pending.","Công, điều chỉnh hoặc làm thêm còn chờ duyệt."],leave_review_pending:["A leave or leave-cancellation request remains pending.","Yêu cầu phép hoặc hủy phép còn chờ duyệt."],payroll_run_open:["A relevant payroll run is not closed.","Còn kỳ lương liên quan chưa đóng."],time_source_changed:["The latest liability does not match the current locked time snapshot.","Phiếu lương hiện hành chưa khớp bản công đang khóa."],issued_payslip_missing:["An issued payslip is missing.","Thiếu phiếu lương đã phát hành."],correction_chain_invalid:["The issued correction chain needs repair or source review.","Chuỗi phiếu điều chỉnh cần kiểm tra lại nguồn."],issued_checksum_invalid:["An issued snapshot checksum cannot be verified.","Không xác minh được checksum bản đã phát hành."],issued_amount_unknown:["An issued amount is missing or invalid.","Số tiền đã phát hành bị thiếu hoặc sai."],issued_snapshot_invalid:["Issued lines and totals cannot be reconciled.","Không đối soát được cấu phần với tổng tiền đã phát hành."],payroll_amounts_unknown:["Recorded payroll totals do not match the issued snapshot.","Tổng tiền lưu trong payroll không khớp bản đã phát hành."],underpaid:["Recorded receipts are below the latest net amount.","Số đã trả ghi nhận còn thiếu so với phiếu hiện hành."],overpaid:["Recorded receipts exceed the latest net amount.","Số đã trả ghi nhận vượt phiếu hiện hành."],carryover_unreconciled:["Correction carryover does not match ancestor receipts.","Số đã trả chuyển sang phiếu điều chỉnh không khớp lịch sử thanh toán."],final_period_missing:["The recorded final period does not cover the employment ending.","Kỳ lương cuối được ghi nhận chưa bao phủ ngày kết thúc làm việc."]};
---
<section class="crm-sheet" id="financial-closeout">
 <h2 class="crm-h2">{vi?"Hồ sơ quyết toán cuối kỳ":"Final financial review dossier"}</h2>
 <p class="crm-help">{vi?"Thời gian hiển thị theo giờ Việt Nam (UTC+7).":"Times are shown in Vietnam time (UTC+7)."}</p>
 <p>{vi?"Ghi nhận nguồn đã đối soát và quyết định của người có quyền. Hệ thống không trả tiền, nộp thuế hay xác thực giao dịch ngân hàng. Nhân viên và HR không có quyền payroll không thấy phần chứng cứ tài chính riêng tư này.":"Record reconciled sources and an authorized independent decision. This does not execute payments, file taxes or authenticate bank transactions. Employees and HR without payroll authority cannot see this confidential financial evidence."}</p>
 {c.basis.blockers.length>0&&<div class="crm-notice warn"><strong>{vi?"Nguồn cần xử lý":"Source work remains"}</strong><ul>{c.basis.blockers.map(b=><li>{blockers[b]?.[vi?1:0]??(vi?"Nguồn cần được kiểm tra lại.":"The source needs review.")}</li>)}</ul></div>}
 <details class="crm-disclosure"><summary>{vi?"Nguồn lương, công và phép hiện hành":"Current payroll, time and leave sources"}</summary>
  <p class="crm-help">{vi?"Số 0 và thông tin chưa rõ được phân biệt. Bản cũ được giữ nguyên khi có điều chỉnh; nghĩa vụ hiện hành lấy từ phiếu cuối chuỗi. Phép tồn không tự quy thành tiền.":"Zero and unknown remain distinct. Corrections preserve old publications; current liability comes from the latest slip. Leave minutes are not converted into money automatically."}</p>
  <div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>{vi?"Kỳ":"Period"}</th><th>{vi?"Trạng thái":"State"}</th><th>{vi?"Lương ròng đã ghi nhận":"Recorded net"}</th><th>{vi?"Công":"Time"}</th></tr></thead><tbody>{c.basis.basis.payroll_runs.map(r=><tr><td><a href={`${vi?"/vi":""}/hrm/payroll?run=${encodeURIComponent(String(r.id))}`}>{String(r.starts_on)}–{String(r.ends_on)}</a></td><td>{state(String(r.state))}</td><td>{money(r.net_minor,r)}</td><td>{r.time_state==="locked"?(vi?"Đã khóa":"Locked"):(vi?"Cần kiểm tra":"Needs review")}</td></tr>)}</tbody></table></div>
  <h3 class="crm-h3">{vi?"Thanh toán đã được ghi nhận":"Recorded payment confirmations"}</h3><div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>{vi?"Ngày":"Date"}</th><th>{vi?"Số tiền":"Amount"}</th><th>{vi?"Tham chiếu riêng tư":"Private reference"}</th></tr></thead><tbody>{c.basis.basis.payments.map(p=>{const slip=c.basis.basis.payslips.find(s=>s.id===p.payslip_id),run=c.basis.basis.payroll_runs.find(r=>r.id===slip?.run_id);return <tr><td>{String(p.paid_on)}</td><td>{run?money(p.amount_minor,run):(vi?"Chưa rõ":"Unknown")}</td><td class="closeout-break">{String(p.payment_reference)}<br/>{String(p.evidence_reference)}</td></tr>})}</tbody></table></div>
  <h3 class="crm-h3">{vi?"Sổ phép đã ghi nhận":"Recorded leave ledger"}</h3><div class="crm-table-wrap"><table class="crm-table"><thead><tr><th>{vi?"Loại / kỳ":"Type / period"}</th><th>{vi?"Bút toán":"Entry"}</th><th>{vi?"Phút":"Minutes"}</th></tr></thead><tbody>{c.basis.basis.leave_ledger.map(l=><tr><td>{String(l.leave_type_key)} · {String(l.period_key)}</td><td>{leaveEvent(String(l.event_kind))}</td><td>{typeof l.minutes==="number"&&Number.isSafeInteger(l.minutes)?l.minutes:(vi?"Chưa rõ":"Unknown")}</td></tr>)}</tbody></table></div>
 </details>
 <h3 class="crm-h3">{vi?"PDF chứng cứ riêng tư":"Confidential PDF evidence"}</h3>
 {liveCase&&<form class="crm-form" method="post" action="/api/hrm/closeout" enctype="multipart/form-data"><input type="hidden" name="intent" value="upload_file"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Tệp PDF, tối đa 5 MB":"PDF, up to 5 MB"}</span><input class="crm-input" type="file" name="file" accept="application/pdf" required/></label><button class="crm-button secondary">{vi?"Tải chứng cứ":"Upload evidence"}</button></form>}
 {c.files.map(f=><article class="crm-sheet"><h4 class="crm-h3"><a href={proofUrl(f.id)}>{f.original_name}</a> · {state(f.state)}</h4>{(f.object_deleted_at||!["none","rejected","blocked"].includes(f.disposition_state))&&<p class="crm-notice warn">{vi?"Tệp này không đủ điều kiện cho phê duyệt hiện hành.":"This file is unavailable for current approval."}</p>}<p class="crm-meta">{person(f.uploaded_by)} · {utc(f.created_at)} · {f.size_bytes} bytes</p><p class="crm-meta closeout-break">SHA-256: {f.checksum}</p>{f.legal_hold===1&&<p class="crm-notice">{vi?"Đang được giữ theo legal hold của nhân viên.":"Protected by the employee’s legal hold."}</p>}{f.reviewed_by&&<p>{vi?"Người rà soát":"Inspected by"}: {person(f.reviewed_by)} · {utc(f.reviewed_at)} · {f.review_reason}</p>}
  {liveCase&&f.state==="quarantined"&&f.uploaded_by!==d.user.id&&<form class="crm-form" method="post" action="/api/hrm/closeout"><input type="hidden" name="intent" value="review_file"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="file_id" value={f.id}/><input type="hidden" name="version" value={f.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Kết quả kiểm tra PDF":"PDF inspection reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><div class="crm-actions"><button class="crm-button" name="decision" value="reviewed">{vi?"Đã kiểm tra tệp":"Mark inspected"}</button><button class="crm-button secondary" name="decision" value="rejected">{vi?"Từ chối tệp":"Reject file"}</button></div></form>}
 </article>)}
 {liveCase&&<><h3 class="crm-h3">{vi?"Chọn chính sách áp dụng":"Choose the applicable policy"}</h3><form method="get" class="crm-form" action={path}><label class="crm-field"><span>{vi?"Phiên bản đã được duyệt":"Reviewed policy version"}</span><select class="crm-input" name="policy" required><option value="">{vi?"Chọn phiên bản":"Choose version"}</option>{c.policies.filter(p=>p.state==="active").map(p=><option value={p.id} selected={p.id===policy?.id}>{vi?p.title_vi:p.title_en} · v{p.revision} · {p.effective_from}–{p.effective_until}</option>)}</select></label><button class="crm-button secondary">{vi?"Mở checklist chính sách":"Open policy checklist"}</button></form></>}
 {liveCase&&policy&&<section class="crm-sheet" id="closeout-prepare"><h3 class="crm-h3">{vi?policy.title_vi:policy.title_en} · v{policy.revision}</h3><p>{policy.purpose}</p><p class="crm-meta">{policy.jurisdiction} · {policy.effective_from}–{policy.effective_until}</p>{policy.source_file_id&&<p><a href={`/api/hrm/legal/files/${encodeURIComponent(policy.source_file_id)}`}>{vi?"Mở nguồn DOCX được duyệt":"Open reviewed DOCX source"}</a></p>}
  <form method="post" action="/api/hrm/closeout" class="crm-form"><input type="hidden" name="intent" value="prepare"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="policy_id" value={policy.id}/><input type="hidden" name="source_revision" value={c.basis.basis.source_revision}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/>
  {checks.map((check,i)=><fieldset class="crm-sheet"><legend><strong>{vi?check.title_vi:check.title_en}</strong></legend><p>{vi?check.instructions_vi:check.instructions_en}</p><input type="hidden" name={`check_${i}_key`} value={check.key}/><label class="crm-field"><span>{vi?"Kết luận có căn cứ":"Evidenced outcome"}</span><select class="crm-input" name={`check_${i}_outcome`} required><option value="">{vi?"Chọn kết luận":"Choose outcome"}</option><option value="verified">{vi?"Đã kiểm tra theo yêu cầu":"Reviewed under the stated requirement"}</option>{check.allow_not_applicable&&<option value="not_applicable">{vi?"Không áp dụng, có chứng cứ":"Not applicable, with evidence"}</option>}</select></label><label class="crm-field"><span>{vi?"Lý do và phạm vi kiểm tra":"Reason and scope checked"}</span><textarea class="crm-textarea" name={`check_${i}_reason`} rows="2" maxlength="1000" required></textarea></label><label class="crm-field"><span>{vi?"PDF đã được rà soát (1–5 tệp)":"Inspected PDFs (1–5 files)"}</span><select class="crm-input" name={`check_${i}_files`} multiple size="3" required>{usable.map(f=><option value={f.id}>{f.original_name}</option>)}</select></label></fieldset>)}
  {!c.basis.hasPayroll&&policy.allow_no_payroll===1&&<><p class="crm-notice warn">{policy.no_payroll_instructions}</p><label class="crm-field"><span>{vi?"Chứng cứ xin miễn khi chưa có payroll (1–5 PDF)":"No-payroll exemption evidence (1–5 PDFs)"}</span><select class="crm-input" name="no_payroll_files" multiple size="3" required>{usable.map(f=><option value={f.id}>{f.original_name}</option>)}</select></label></>}
  <p class="crm-help">{vi?"Lưu hồ sơ không chốt quyết toán. Người khác có quyền phải rà soát bản nguồn hiện hành. Nếu nguồn đổi, cần lập hồ sơ mới.":"Saving does not clear this case. A different authorized person must review current sources. Source changes require a fresh dossier."}</p><button class="crm-button">{vi?"Lưu để duyệt độc lập":"Save for independent review"}</button></form>
 </section>}
 <h3 class="crm-h3">{vi?"Lịch sử hồ sơ":"Dossier history"}</h3>
 {c.dossiers.map(row=>{const p=c.policies.find(p=>p.id===row.policy_id),current=row.source_revision===c.basis.basis.source_revision&&row.basis_checksum===c.basis.checksum,ready=current&&p?.state==="active"&&p.effective_from<=localDate()&&p.effective_until>=localDate()&&p.effective_from<=d.offboarding.ended_on&&p.effective_until>=d.offboarding.ended_on&&c.basis.blockers.every(b=>b==="no_payroll_recorded"&&p.allow_no_payroll===1&&JSON.parse(row.no_payroll_evidence_json).length>0);return <article class="crm-sheet" id={`financial-dossier-${row.id}`}><h4 class="crm-h3">{state(row.state)} · {p?(vi?p.title_vi:p.title_en):(vi?"Phiên bản được lưu":"Stored version")}</h4><p>{vi?"Người lập":"Prepared by"}: {person(row.prepared_by)} · {utc(row.prepared_at)}</p><p class="crm-meta closeout-break">SHA-256: {row.basis_checksum}</p>{!current&&<p class="crm-notice warn">{vi?"Nguồn đã thay đổi; bản này không thể dùng để chốt.":"Sources changed; this record cannot clear the case."}</p>}
  <ul>{outcomeRows(row.checks_json).map(check=><li><strong>{p?parseCloseoutChecks(JSON.parse(p.checklist_json)).find(x=>x.key===check.key)?.[vi?"title_vi":"title_en"]:check.key}</strong> · {check.outcome==="verified"?(vi?"Đã kiểm tra":"Reviewed"):(vi?"Không áp dụng":"Not applicable")}<p>{check.reason}</p><ul>{check.file_ids.map(id=><li><a href={proofUrl(id)}>{c.files.find(f=>f.id===id)?.original_name??(vi?"Chứng cứ được lưu":"Stored evidence")}</a></li>)}</ul></li>)}</ul>
  {JSON.parse(row.no_payroll_evidence_json).length>0&&<div class="crm-notice warn"><strong>{vi?"Chứng cứ miễn payroll phải duyệt riêng":"No-payroll exemption requires explicit review"}</strong><p>{p?.no_payroll_instructions}</p><ul>{(JSON.parse(row.no_payroll_evidence_json) as string[]).map(id=><li><a href={proofUrl(id)}>{c.files.find(f=>f.id===id)?.original_name??(vi?"Chứng cứ được lưu":"Stored evidence")}</a></li>)}</ul></div>}
  {row.reviewed_by&&<p>{vi?"Người duyệt":"Reviewed by"}: {person(row.reviewed_by)} · {utc(row.reviewed_at)} · {row.review_reason}</p>}{row.applied_at&&<p>{vi?"Đã ghi vào checklist":"Applied to checklist"}: {person(row.applied_by)} · {utc(row.applied_at)}</p>}
  {liveCase&&row.state==="prepared"&&row.prepared_by!==d.user.id&&<><form method="post" action="/api/hrm/closeout" class="crm-form"><input type="hidden" name="intent" value="review"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="dossier_id" value={row.id}/><input type="hidden" name="version" value={row.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="decision" value="approve"/><label class="crm-field"><span>{vi?"Lý do phê duyệt":"Approval reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><label class="crm-check"><input type="checkbox" name="confirmed" value="1" required/><span>{vi?"Tôi đã kiểm tra chính sách, nguồn hiện hành và PDF. Việc duyệt không xác thực ngân hàng hay thay ý kiến chuyên môn.":"I inspected the policy, current sources and PDFs. This review does not authenticate bank activity or replace professional advice."}</span></label><button class="crm-button" disabled={!ready}>{vi?"Duyệt hồ sơ hiện hành":"Approve current dossier"}</button></form><form method="post" action="/api/hrm/closeout" class="crm-form"><input type="hidden" name="intent" value="review"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="dossier_id" value={row.id}/><input type="hidden" name="version" value={row.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><input type="hidden" name="decision" value="reject"/><label class="crm-field"><span>{vi?"Lý do từ chối":"Rejection reason"}</span><input class="crm-input" name="reason" maxlength="1000" required/></label><button class="crm-button secondary">{vi?"Từ chối hồ sơ":"Reject dossier"}</button></form></>}
  {liveCase&&ready&&row.state==="approved"&&row.reviewed_by===d.user.id&&task&&["pending","blocked"].includes(task.state)&&<form class="crm-form" method="post" action={`/api/hrm/offboarding/${encodeURIComponent(caseId)}`}><input type="hidden" name="intent" value="complete"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="task_id" value={task.id}/><input type="hidden" name="version" value={task.version}/><input type="hidden" name="dossier_id" value={row.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do ghi hoàn tất":"Completion reason"}</span><input class="crm-input" name="reason" maxlength="500" required/></label><label class="crm-check"><input type="checkbox" name="confirmed" value="1" required/><span>{vi?"Tôi xác nhận dùng hồ sơ này để ghi hoàn tất bước quyết toán. Thao tác không trả tiền hay cấp lại quyền.":"I confirm applying this dossier to the final financial task. This does not execute payments or restore access."}</span></label><button class="crm-button">{vi?"Ghi hoàn tất bước quyết toán":"Complete final financial task"}</button></form>}
  {["open","completed"].includes(d.offboarding.state)&&["prepared","approved","applied"].includes(row.state)&&<details class="crm-disclosure"><summary>{vi?"Yêu cầu rà soát lại hồ sơ":"Require a fresh review"}</summary><form method="post" action="/api/hrm/closeout" class="crm-form"><input type="hidden" name="intent" value="reopen"/><input type="hidden" name="lang" value={d.lang}/><input type="hidden" name="case_id" value={caseId}/><input type="hidden" name="dossier_id" value={row.id}/><input type="hidden" name="version" value={row.version}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><label class="crm-field"><span>{vi?"Lý do cần bản rà soát mới":"Why a fresh review is needed"}</span><textarea class="crm-textarea" name="reason" rows="2" maxlength="1000" required></textarea></label><label class="crm-check"><input type="checkbox" name="confirmed" value="1" required/><span>{vi?"Tôi xác nhận yêu cầu duyệt lại. Bản cũ được giữ nguyên trong lịch sử; bước tài chính sẽ mở lại, quyền nhân viên không được khôi phục.":"I confirm a fresh review is required. Prior decisions remain in history; the financial task reopens without restoring employee access."}</span></label><button class="crm-button secondary">{vi?"Mở việc rà soát lại":"Reopen financial review"}</button></form></details>}
 </article>})}
</section>
<style>.closeout-break{overflow-wrap:anywhere}fieldset.crm-sheet{min-width:0}select[multiple]{min-height:6rem}</style>
