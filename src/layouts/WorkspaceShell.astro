---
// One shell for every private module.
// Row 1: brand, module tabs (a launcher below 1024px), language and the
// account menu. Row 2: the current module and, for modules without groups,
// its page tabs. A module with groups gets a grouped sidebar (R-05) on wide
// screens and a Menu disclosure on narrow ones. Only entries the person may
// open are listed. Server-rendered links, forms and <details>: no client script.
import "../styles/crm.css";
import "../styles/workspace.css";
import NavIcon from "../components/workspace/NavIcon.astro";
import GroupedMenu, { type MenuGroup } from "../components/workspace/ui/GroupedMenu.astro";
import { type ModuleKey, accountModule, localized, moduleByKey, switchLocale, visibleGroups, visibleLinks, visibleModules } from "../lib/workspace/nav";
import { type WorkspaceUser, roleLabel } from "../lib/workspace/roles";
import { initials, moduleSummaries } from "../lib/workspace/summaries";

interface Props { title: string; lang: "en" | "vi"; user: WorkspaceUser; module: ModuleKey; current?: string }
const { title, lang, user, module, current } = Astro.props;
const vi = lang === "vi";
const label = (item: { en: string; vi: string }) => vi ? item.vi : item.en;
const available = visibleModules(user);
const active = moduleByKey(module);
const allowed = user.can(active.permission);
const links = allowed ? visibleLinks(user, active) : [];
const groups = allowed ? visibleGroups(user, active) : [];
const grouped = groups.length > 0;
const currentLink = links.find((link) => link.key === current);
const pagesLabel = vi ? `Trang trong ${active.vi}` : `${active.en} pages`;
const badges = user.admin ? [roleLabel("admin", vi)] : [...user.roles].map((role) => roleLabel(role, vi));
const menuGroups: MenuGroup[] = groups.map(({ group, links: items }) => ({
  key: group.key, label: label(group),
  items: items.map((link) => ({ key: link.key, label: label(link), href: localized(link.path, vi), icon: link.icon, current: link.key === current })),
}));
const accountLinks = visibleLinks(user, accountModule);
const showAppbar = module !== "home" && (links.length > 0 || grouped);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F4F0E8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Lumi Workspace</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="crm ws">
    <a class="crm-skip" href="#main">{vi ? "Đến nội dung chính" : "Skip to content"}</a>
    <header class="ws-header">
      <div class="ws-top"><div class="ws-wide ws-bar">
        <details class="ws-launcher">
          <summary><NavIcon name="apps" size={20} /><span class="crm-sr">{vi ? "Mở danh sách phân hệ" : "Open the module list"}</span></summary>
          <div class="ws-pop ws-launcher-pop">
            <p class="ws-gmenu-label">{vi ? "Phân hệ" : "Modules"}</p>
            <ul>{available.map((item) => <li><a href={localized(item.path, vi)} aria-current={item.key === module ? "page" : undefined}><NavIcon name={item.icon} size={20} /><span><strong>{label(item)}</strong><span>{moduleSummaries[item.key][vi ? 1 : 0]}</span></span></a></li>)}</ul>
          </div>
        </details>
        <a class="crm-brand" href={localized("/workspace", vi)}><img src="/brand/lumi-fulltext.svg" alt="Lumi" width="86" height="44" /><span>Workspace</span></a>
        <nav class="ws-modules" aria-label={vi ? "Phân hệ" : "Modules"}>
          {available.map((item) => <a href={localized(item.path, vi)} aria-current={item.key === module ? "page" : undefined}><NavIcon name={item.icon} size={18} />{label(item)}</a>)}
        </nav>
        <div class="ws-account">
          <a class="ws-lang" href={switchLocale(Astro.url)} lang={vi ? "en" : "vi"} hreflang={vi ? "en" : "vi"}>{vi ? "English" : "Tiếng Việt"}</a>
          <details class="ws-me">
            <summary aria-label={vi ? `Tài khoản của tôi: ${user.name}` : `My account: ${user.name}`}><span class="ws-avatar" aria-hidden="true">{initials(user.name)}</span><span class="ws-user"><strong>{user.name}</strong><span>{badges.join(" · ")}</span></span></summary>
            <div class="ws-pop ws-me-pop">
              <p class="ws-me-id"><strong>{user.name}</strong><span>{user.email}</span></p>
              <p class="ws-gmenu-label">{label(accountModule)}</p>
              <ul>{accountLinks.map((link) => <li><a href={localized(link.path, vi)} aria-current={module === "account" && link.key === current ? "page" : undefined}><NavIcon name={link.icon} size={18} />{label(link)}</a></li>)}</ul>
              <form method="post" action="/_emdash/api/auth/logout?redirect=%2F"><button type="submit">{vi ? "Đăng xuất" : "Sign out"}</button></form>
            </div>
          </details>
        </div>
      </div></div>
      {showAppbar && <div class="ws-appbar"><div class="ws-wide ws-appbar-in">
        <a class="ws-app-name" href={localized(active.path, vi)}><NavIcon name={active.icon} size={20} />{label(active)}</a>
        {!grouped && <nav class="ws-pages" aria-label={pagesLabel}>
          {links.map((link) => <a href={localized(link.path, vi)} aria-current={link.key === current ? "page" : undefined}><NavIcon name={link.icon} size={18} />{label(link)}</a>)}
        </nav>}
        {grouped && <details class="ws-menu ws-narrow">
          <summary><NavIcon name="menu" size={18} /><span>{vi ? "Trang" : "Pages"}</span>{currentLink && <span class="ws-menu-current">{label(currentLink)}</span>}</summary>
          <GroupedMenu groups={menuGroups} label={pagesLabel} idPrefix="mn" columns />
        </details>}
      </div></div>}
    </header>
    {grouped
      ? <div class="ws-frame">
          <aside class="ws-side"><GroupedMenu groups={menuGroups} label={pagesLabel} idPrefix="sd" /></aside>
          <main id="main" class="crm-main ws-content"><slot /></main>
        </div>
      : <main id="main" class="crm-main"><div class="ws-wide"><slot /></div></main>}
    <footer class="crm-footer"><div class="ws-wide crm-footer-in"><span>Lumi Workspace · {vi ? "Nội bộ, chỉ người được cấp quyền" : "Internal, permitted users only"}</span><span>© 2026 Cloudjet Solutions Pte. Ltd.</span></div></footer>
  </body>
</html>
