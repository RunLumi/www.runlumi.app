---
import "../styles/global.css";

interface Props {
  lang: "en" | "vi";
  title: string;
  description: string;
  canonicalPath: string;
  alternateEnPath?: string | null;
  alternateViPath?: string | null;
  image?: string;
  imageAlt?: string;
  ogType?: "article" | "website";
  noIndex?: boolean;
}

const { lang, title, description, canonicalPath, alternateEnPath = "/", alternateViPath = "/vi", image, imageAlt, ogType = "website", noIndex = false } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const hasAlternates = Boolean(alternateEnPath && alternateViPath);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    {lang === "vi" && <link rel="preload" href="/fonts/geist-vietnamese.woff2" as="font" type="font/woff2" crossorigin />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F4F0E8" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    {!noIndex && image && <meta name="robots" content="max-image-preview:large" />}
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V8Y0WNBFML"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-V8Y0WNBFML");
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {hasAlternates && <link rel="alternate" hreflang="en" href={new URL(alternateEnPath!, Astro.site)} />}
    {hasAlternates && <link rel="alternate" hreflang="vi" href={new URL(alternateViPath!, Astro.site)} />}
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={new URL(alternateEnPath!, Astro.site)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Lumi" />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {image && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {image && <meta property="og:image:width" content="1600" />}
    {image && <meta property="og:image:height" content="900" />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "vi" ? "Bỏ qua đến nội dung" : "Skip to content"}</a>
    <slot />
  </body>
</html>
