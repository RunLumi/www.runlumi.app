---
// CRM pages render inside the shared Workspace shell.
import WorkspaceShell from "./WorkspaceShell.astro";
import type { CrmActor } from "../lib/crm/access";
import type { Lang } from "../lib/crm/i18n";

interface Props { title: string; lang: Lang; actor: CrmActor; current?: "files" | "today" | "leads" | "calendar" | "process" | "pipeline" | "companies" | "contacts" | "new" | "referrals" | "reports" | "commission" | "model" | "api" | "fulfillment" | "admin" | "playbooks" | "offers" }
const { title, lang, current } = Astro.props;
const user = Astro.locals.workspace!;
---
<WorkspaceShell title={title} lang={lang} user={user} module="crm" current={current === "admin" ? "operations" : current}><slot /></WorkspaceShell>
