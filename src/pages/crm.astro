---
import CrmDashboard from "../components/CrmDashboard.astro";
import { crmActor, members, type Lead, type Stage, stages } from "../lib/crm";
import { envFromLocals } from "../lib/ats";
import { activeUser, emdashLoginUrl } from "../lib/admin-auth";

export const prerender = false;
const { DB, CONTENT_DB } = envFromLocals(Astro.locals);
const user = activeUser(Astro.locals);
if (!user) return Astro.redirect(emdashLoginUrl("/crm"), 303);
const actor = await crmActor(Astro.locals, DB);
if (!actor) return new Response("CRM access has not been granted to this EmDash account.", { status: 403 });
const requestedStage = Astro.url.searchParams.get("stage");
const stage = stages.includes(requestedStage as Stage) ? requestedStage : null;
const scope = actor.admin ? { sql: "1 = 1", args: [] as string[] } : { sql: "owner_id = ?", args: [actor.id] };
const where = `${scope.sql}${stage ? " AND stage = ?" : ""}`;
const pageSize = 50;
const requestedPage = Number(Astro.url.searchParams.get("page") ?? "1");
const page = Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const totalCount = await DB.prepare(`SELECT COUNT(*) AS count FROM crm_leads WHERE ${scope.sql}`).bind(...scope.args).first<{count:number}>();
const filteredCount = await DB.prepare(`SELECT COUNT(*) AS count FROM crm_leads WHERE ${where}`).bind(...scope.args, ...(stage ? [stage] : [])).first<{count:number}>();
const stageRows = (await DB.prepare(`SELECT stage, COUNT(*) AS count FROM crm_leads WHERE ${scope.sql} GROUP BY stage`).bind(...scope.args).all<{stage:Stage;count:number}>()).results;
const stageCounts = Object.fromEntries(stages.map((item) => [item, stageRows.find((row) => row.stage === item)?.count ?? 0])) as Record<Stage, number>;
const pageCount = Math.max(1, Math.ceil((filteredCount?.count ?? 0) / pageSize));
const offset = (Math.min(page, pageCount) - 1) * pageSize;
const leads = (await DB.prepare(`SELECT id, company, contact_name, email, phone, source, owner_id, stage, value_vnd, next_action, next_contact_on, lost_reason, version, created_at, updated_at FROM crm_leads WHERE ${where} ORDER BY CASE WHEN next_contact_on IS NULL THEN 1 ELSE 0 END, next_contact_on, updated_at DESC LIMIT ? OFFSET ?`).bind(...scope.args, ...(stage ? [stage] : []), pageSize, offset).all<Lead>()).results;
const team = actor.admin ? await members(DB, CONTENT_DB) : [];
const ownerNames = Object.fromEntries([[actor.id, actor.name] as const, ...team.map((member) => [member.user_id, member.name || member.email] as const)]);
---
<CrmDashboard actor={actor} leads={leads} members={team} ownerNames={ownerNames} totalCount={totalCount?.count ?? 0} stageCounts={stageCounts} page={Math.min(page, pageCount)} pageCount={pageCount} error={Astro.url.searchParams.get("error")} />
