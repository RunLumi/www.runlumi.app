---
import JobsLayout from "../../../layouts/JobsLayout.astro";
import { envFromLocals, formatDate, getJobById, getQuestions, statusLabel } from "../../../lib/ats";

export const prerender = false;
const id = Astro.params.id ?? "";
const { DB } = envFromLocals(Astro.locals);
const job = await getJobById(DB, id);
if (!job) Astro.response.status = 404;
const questions = job ? await getQuestions(DB, job.id) : [];
const questionError = Astro.url.searchParams.get("question_error");
---
<JobsLayout title={job ? `Manage ${job.title} — Lumi hiring desk` : "Job not found"} admin>
  <section class="ats-page">
    <div class="ats-shell">
      {!job ? (
        <div class="ats-card ats-empty">
          <h1>Job not found.</h1>
          <p><a class="ats-button" href="/admin/jobs">Back to jobs</a></p>
        </div>
      ) : (
        <>
          <a class="text-link" href="/admin/jobs">← Jobs</a>
          <div class="application-head" style="margin-top:28px">
            <div>
              <div class="ats-eyebrow">{job.team || "LUMI"} / MANAGE ROLE</div>
              <h1 class="ats-title" style="font-size:clamp(38px,5vw,60px)">{job.title}</h1>
              <div class="job-meta">
                <span class:list={["ats-badge", job.status]}>{statusLabel(job.status)}</span>
                <span>Updated {formatDate(job.updated_at)}</span>
                <a href={`/jobs/${job.slug}`} target="_blank">Public page ↗</a>
              </div>
            </div>
            <div class="ats-toolbar-group">
              {job.status !== "published" && (
                <form method="post" action={`/api/admin/jobs/${job.id}/state`}>
                  <input type="hidden" name="status" value="published" />
                  <button class="ats-button" type="submit">Publish</button>
                </form>
              )}
              {job.status === "published" && (
                <form method="post" action={`/api/admin/jobs/${job.id}/state`}>
                  <input type="hidden" name="status" value="closed" />
                  <button class="ats-button secondary" type="submit">Close role</button>
                </form>
              )}
              {job.status === "closed" && (
                <form method="post" action={`/api/admin/jobs/${job.id}/state`}>
                  <input type="hidden" name="status" value="draft" />
                  <button class="ats-button secondary" type="submit">Return to draft</button>
                </form>
              )}
            </div>
          </div>

          <div class="admin-grid">
            <div class="ats-card admin-panel">
              <h2>Role</h2>
              <form class="ats-form" method="post" action={`/api/admin/jobs/${job.id}/update`}>
                <div class="ats-field">
                  <label for="title">Title *</label>
                  <input class="ats-input" id="title" name="title" value={job.title} required maxlength="160" />
                </div>
                <div class="ats-field">
                  <label for="slug">Slug *</label>
                  <input class="ats-input" id="slug" name="slug" value={job.slug} required maxlength="80" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                  <div class="ats-field">
                    <label for="team">Team</label>
                    <input class="ats-input" id="team" name="team" value={job.team} maxlength="120" />
                  </div>
                  <div class="ats-field">
                    <label for="location">Location</label>
                    <input class="ats-input" id="location" name="location" value={job.location} maxlength="160" />
                  </div>
                  <div class="ats-field">
                    <label for="employment_type">Employment</label>
                    <select class="ats-select" id="employment_type" name="employment_type">
                      {["Full-time","Part-time","Contract","Internship"].map((v) => <option value={v} selected={job.employment_type === v}>{v}</option>)}
                    </select>
                  </div>
                  <div class="ats-field">
                    <label for="workplace_type">Workplace</label>
                    <select class="ats-select" id="workplace_type" name="workplace_type">
                      {["Remote","Hybrid","On-site"].map((v) => <option value={v} selected={job.workplace_type === v}>{v}</option>)}
                    </select>
                  </div>
                </div>
                <div class="ats-field">
                  <label for="summary">Summary *</label>
                  <textarea class="ats-textarea" id="summary" name="summary" required maxlength="500" style="min-height:90px">{job.summary}</textarea>
                </div>
                <div class="ats-field">
                  <label for="description">The work</label>
                  <textarea class="ats-textarea" id="description" name="description" maxlength="12000">{job.description}</textarea>
                </div>
                <div class="ats-field">
                  <label for="responsibilities">What they will own</label>
                  <textarea class="ats-textarea" id="responsibilities" name="responsibilities" maxlength="12000" placeholder="One item per line">{job.responsibilities}</textarea>
                </div>
                <div class="ats-field">
                  <label for="requirements">What matters here</label>
                  <textarea class="ats-textarea" id="requirements" name="requirements" maxlength="12000" placeholder="One item per line">{job.requirements}</textarea>
                </div>
                <div class="ats-field">
                  <label for="application_note">Before you apply</label>
                  <textarea class="ats-textarea" id="application_note" name="application_note" maxlength="6000">{job.application_note}</textarea>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                  <div class="ats-field">
                    <label for="closes_at">Close applications at</label>
                    <input class="ats-input" id="closes_at" name="closes_at" type="datetime-local" value={job.closes_at ? job.closes_at.slice(0,16) : ""} />
                  </div>
                  <div class="ats-field">
                    <label for="sort_order">Sort order</label>
                    <input class="ats-input" id="sort_order" name="sort_order" type="number" value={job.sort_order} />
                  </div>
                </div>
                <button class="ats-button" type="submit">Save role</button>
              </form>
            </div>

            <aside>
              <div class="ats-card admin-panel">
                <div class="ats-toolbar" style="margin-top:0">
                  <h2 style="margin:0">Application test</h2>
                  <span class="ats-count">{questions.length}</span>
                </div>
                {questionError && <div class="ats-notice danger" style="margin-bottom:16px">That question could not be removed because applications already depend on it.</div>}
                <ul class="question-list">
                  {questions.map((q) => (
                    <li>
                      <div style="display:flex;justify-content:space-between;gap:12px">
                        <div>
                          <strong style="color:var(--ats-navy);font-size:13px">{q.prompt}</strong>
                          <div class="ats-help">{q.kind} · {q.required ? "required" : "optional"}</div>
                        </div>
                        <form method="post" action={`/api/admin/questions/${q.id}/delete`}>
                          <input type="hidden" name="job_id" value={job.id} />
                          <button class="ats-link-button" type="submit" style="color:var(--ats-red)">Remove</button>
                        </form>
                      </div>
                    </li>
                  ))}
                </ul>

                <hr class="ats-rule" style="margin-block:22px" />
                <h3>Add question</h3>
                <form class="ats-form" method="post" action={`/api/admin/jobs/${job.id}/questions`}>
                  <div class="ats-field">
                    <label for="kind">Type</label>
                    <select class="ats-select" id="kind" name="kind">
                      <option value="long">Long answer</option>
                      <option value="short">Short answer</option>
                      <option value="file">File upload</option>
                    </select>
                  </div>
                  <div class="ats-field">
                    <label for="prompt">Prompt *</label>
                    <textarea class="ats-textarea" id="prompt" name="prompt" required maxlength="1000" style="min-height:90px"></textarea>
                  </div>
                  <div class="ats-field">
                    <label for="help_text">Guidance</label>
                    <textarea class="ats-textarea" id="help_text" name="help_text" maxlength="1500" style="min-height:72px"></textarea>
                  </div>
                  <label class="ats-check">
                    <input type="checkbox" name="required" value="1" checked />
                    <span>Required</span>
                  </label>
                  <div class="ats-field">
                    <label for="sort_order_q">Order</label>
                    <input class="ats-input" id="sort_order_q" name="sort_order" type="number" value={questions.length * 10} />
                  </div>
                  <button class="ats-button secondary" type="submit">Add question</button>
                </form>
              </div>
            </aside>
          </div>
        </>
      )}
    </div>
  </section>
</JobsLayout>
