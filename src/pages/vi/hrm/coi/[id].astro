---
import HrmCoiDeclaration from "../../../../components/hrm/HrmCoiDeclaration.astro";
import HrmFailure from "../../../../components/hrm/HrmFailure.astro";
import { coiReviewDetailPage } from "../../../../lib/hrm/coi-pages";
export const prerender=false;
let data;
try{data=await coiReviewDetailPage(Astro,"vi",Astro.params.id??"");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Rà soát xung đột lợi ích",error:error instanceof Error?error.message:"internal_error",status:typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500};Astro.response.status=data.status}
---
{"declaration" in data?<HrmCoiDeclaration {...data}/>:<HrmFailure data={data}/>}
