---
import HrmOnboardingManage from "../../../../components/hrm/HrmOnboardingManage.astro";
import HrmFailure from "../../../../components/hrm/HrmFailure.astro";
import { onboardingManagePage } from "../../../../lib/hrm/onboarding-pages";
export const prerender=false;
let data;
try{data=await onboardingManagePage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Kế hoạch onboarding",error:error instanceof Error?error.message:"internal_error",status:typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500};Astro.response.status=data.status}
---
{"templates" in data?<HrmOnboardingManage {...data}/>:<HrmFailure data={data}/>}
