---
import HrmPeople from "../../../../components/hrm/HrmPeople.astro";import HrmFailure from "../../../../components/hrm/HrmFailure.astro";import {peoplePage} from "../../../../lib/hrm/pages";
export const prerender=false;let data;try{data=await peoplePage(Astro,"vi")}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Nhân sự",error:error instanceof Error?error.message:"internal_error",status: typeof error === "object" && error !== null && "status" in error ? Number(error.status) : 500};Astro.response.status=data.status}
---
{ "people" in data ? <HrmPeople {...data}/> : <HrmFailure data={data}/> }
