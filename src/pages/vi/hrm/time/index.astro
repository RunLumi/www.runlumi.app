---
import HrmTime from "../../../../components/hrm/HrmTime.astro";
import { timeManagePage } from "../../../../lib/hrm/time-pages";
export const prerender=false;let data;try{data=await timeManagePage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Lịch và chấm công",error:error instanceof Error?error.message:"internal_error"};Astro.response.status=typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500}
---
<HrmTime {...data}/>
