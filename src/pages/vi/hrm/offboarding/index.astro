---
import HrmOffboarding from "../../../../components/hrm/HrmOffboarding.astro";
import HrmFailure from "../../../../components/hrm/HrmFailure.astro";
import { HrmError } from "../../../../lib/hrm/fields";
import { offboardingListPage } from "../../../../lib/hrm/offboarding-pages";
export const prerender=false;
let data;
try{data=await offboardingListPage(Astro,"vi")}
catch(error){const user=Astro.locals.workspace!;const status=error instanceof HrmError?error.status:500;Astro.response.status=status;data={lang:"vi",vi:true,user,title:"Nghỉ việc",error:error instanceof HrmError?error.message:"internal_error",status}}
---
{"cases" in data?<HrmOffboarding {...data}/>:<HrmFailure data={data}/>}
