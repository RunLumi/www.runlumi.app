---
import HrmMyTraining from "../../../../../components/hrm/HrmMyTraining.astro";
import { HrmError } from "../../../../../lib/hrm/fields";
import { myTrainingPage } from "../../../../../lib/hrm/training-pages";
export const prerender=false;
let data;
try{data=await myTrainingPage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Đào tạo của tôi",live:user.hrmEnabled===true,courses:[],assignments:[],evidence:{},saved:"",error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmMyTraining {...data}/>
