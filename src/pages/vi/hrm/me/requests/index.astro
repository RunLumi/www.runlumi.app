---
import HrmMyRequests from "../../../../../components/hrm/HrmMyRequests.astro";
import { HrmError } from "../../../../../lib/hrm/fields";
import { myRequestsPage } from "../../../../../lib/hrm/employee-service-pages";
export const prerender=false;
let data;
try{data=await myRequestsPage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Yêu cầu HR của tôi",live:user.hrmEnabled===true,error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmMyRequests {...data}/>
