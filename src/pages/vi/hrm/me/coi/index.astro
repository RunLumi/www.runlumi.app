---
import HrmCoiMine from "../../../../../components/hrm/HrmCoiMine.astro";
import HrmFailure from "../../../../../components/hrm/HrmFailure.astro";
import { myCoiPage } from "../../../../../lib/hrm/coi-pages";
export const prerender=false;
let data;
try{data=await myCoiPage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Khai báo COI của tôi",error:error instanceof Error?error.message:"internal_error",status:typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500};Astro.response.status=data.status}
---
{"declarations" in data?<HrmCoiMine {...data}/>:<HrmFailure data={data}/>}
