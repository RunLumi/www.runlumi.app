---
import HrmLegalIssue from "../../../../../components/hrm/HrmLegalIssue.astro";
import HrmFailure from "../../../../../components/hrm/HrmFailure.astro";
import { legalIssuePage } from "../../../../../lib/hrm/legal-pages";
export const prerender=false;
let data;
try{data=await legalIssuePage(Astro,"vi",Astro.params.id??"");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Tài liệu của tôi",error:error instanceof Error?error.message:"internal_error",status:typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500};Astro.response.status=data.status}
---
{"id" in data?<HrmLegalIssue {...data}/>:<HrmFailure data={data}/>}
