---
import HrmReports from "../../../../components/hrm/HrmReports.astro";
import { HrmError } from "../../../../lib/hrm/fields";
import { reportsPage } from "../../../../lib/hrm/report-pages";
export const prerender=false;
let data;
try{data=await reportsPage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Báo cáo HRM",live:user.hrmEnabled===true,legalEntity:"",generatedAt:"",period:"",department:null,departments:[],groups:[],policies:[],snapshots:[],snapshotPage:1,hasMoreSnapshots:false,schedules:[],schedulePage:1,hasMoreSchedules:false,saved:"",error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmReports {...data}/>
