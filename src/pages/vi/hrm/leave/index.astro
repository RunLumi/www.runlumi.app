---
import HrmLeave from "../../../../components/hrm/HrmLeave.astro";
import { leaveManagePage } from "../../../../lib/hrm/time-pages";
export const prerender=false;let data;try{data=await leaveManagePage(Astro,"vi");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"vi",vi:true,user,title:"Chính sách phép và đơn nghỉ",error:error instanceof Error?error.message:"internal_error"};Astro.response.status=typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500}
