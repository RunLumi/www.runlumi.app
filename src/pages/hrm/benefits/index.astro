---
import HrmBenefits from "../../../components/hrm/HrmBenefits.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { benefitManagementPage } from "../../../lib/hrm/benefit-pages";
export const prerender=false;
let data;
try{data=await benefitManagementPage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"Benefits management",live:user.hrmEnabled===true,plans:[],enrollments:[],legalEntity:"",saved:"",error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmBenefits {...data}/>
