---
import HrmAssets from "../../../components/hrm/HrmAssets.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { assetRegisterPage } from "../../../lib/hrm/asset-pages";
export const prerender=false;
let data;
try{data=await assetRegisterPage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"Asset register",live:user.hrmEnabled===true,error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmAssets {...data}/>
