---
import HrmMyBenefits from "../../../../components/hrm/HrmMyBenefits.astro";
import { HrmError } from "../../../../lib/hrm/fields";
import { myBenefitsPage } from "../../../../lib/hrm/benefit-pages";
export const prerender=false;
let data;
try{data=await myBenefitsPage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"My benefits",live:user.hrmEnabled===true,plans:[],enrollments:[],saved:"",error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmMyBenefits {...data}/>
