---
import HrmLeave from "../../../../components/hrm/HrmLeave.astro";
import { myLeavePage } from "../../../../lib/hrm/time-pages";
export const prerender=false;let data;try{data=await myLeavePage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"My leave requests",error:error instanceof Error?error.message:"internal_error"};Astro.response.status=typeof error==="object"&&error!==null&&"status" in error?Number(error.status):500}
---
<HrmLeave {...data}/>
