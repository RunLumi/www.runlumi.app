---
import HrmNotifications from "../../../components/hrm/HrmNotifications.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { notificationsPage } from "../../../lib/hrm/employee-service-pages";
export const prerender=false;
let data;
try{data=await notificationsPage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"HRM notifications",live:user.hrmEnabled===true,error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmNotifications {...data}/>
