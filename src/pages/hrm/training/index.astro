---
import HrmTraining from "../../../components/hrm/HrmTraining.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { trainingManagementPage } from "../../../lib/hrm/training-pages";
export const prerender=false;
let data;
try{data=await trainingManagementPage(Astro,"en");if(data instanceof Response)return data}catch(error){const user=Astro.locals.workspace!;data={lang:"en",vi:false,user,title:"Training and certificates",live:user.hrmEnabled===true,courses:[],assignments:[],evidence:{},people:[],legalEntity:"",saved:"",error:error instanceof HrmError?error.message:"internal_error",status:error instanceof HrmError?error.status:500};Astro.response.status=data.status}
---
<HrmTraining {...data}/>
