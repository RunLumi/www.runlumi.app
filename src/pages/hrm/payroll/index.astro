---
import HrmPayroll from "../../../components/hrm/HrmPayroll.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { payrollDeskPage } from "../../../lib/hrm/payroll-pages";
export const prerender = false;
let data;
try { data = await payrollDeskPage(Astro, "en"); if (data instanceof Response) return data; }
catch (error) { const user = Astro.locals.workspace!; data = { lang: "en", vi: false, user, title: "Payroll and payslips", live: user.hrmEnabled === true, error: error instanceof HrmError ? error.message : "internal_error", status: error instanceof HrmError ? error.status : 500 }; Astro.response.status = data.status; }
---
<HrmPayroll {...data}/>
