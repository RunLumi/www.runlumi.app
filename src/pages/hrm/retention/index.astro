---
import HrmRetention from "../../../components/hrm/HrmRetention.astro";
import HrmFailure from "../../../components/hrm/HrmFailure.astro";
import { HrmError } from "../../../lib/hrm/fields";
import { retentionPage } from "../../../lib/hrm/retention-pages";
export const prerender=false;
const user=Astro.locals.workspace;
if(!user||(!user.can("hrm.retention.manage")&&!user.can("hrm.retention.review")&&!user.can("hrm.legalhold.manage")))return new Response("Forbidden",{status:403,headers:{"Cache-Control":"private, no-store"}});
let data;
try{data=await retentionPage(Astro,"en")}
catch(error){const status=error instanceof HrmError?error.status:500;Astro.response.status=status;data={lang:"en",vi:false,user,title:"Retention and legal holds",error:error instanceof HrmError?error.message:"internal_error",status}}
---
{"policies" in data?<HrmRetention {...data}/>:<HrmFailure data={data}/>}
