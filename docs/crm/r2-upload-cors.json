{
  "rules": [
    {
      "allowed": {
        "origins": ["https://runlumi.app", "https://www.runlumi.app", "https://landing.runlumi.app"],
        "methods": ["PUT"],
        "headers": ["Content-Type", "Content-Length", "If-None-Match"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 300
    }
  ]
}
