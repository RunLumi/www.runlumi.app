{
  "name": "landing.runlumi.app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "node scripts/check-src.mjs",
    "test": "node --test --import ./scripts/test-setup.mjs \"tests/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 tests/integration/crm.integration.test.mjs tests/integration/workspace.integration.test.mjs tests/integration/directory.integration.test.mjs tests/integration/api.integration.test.mjs",
    "deploy": "node scripts/preflight.mjs && npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lumi-jobs --local",
    "db:migrate": "wrangler d1 migrations apply lumi-jobs --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "6.0.5",
    "@emdash-cms/cloudflare": "0.38.0",
    "astro": "^7.3.3",
    "emdash": "0.38.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@emnapi/runtime": "1.11.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csstype": "3.2.3",
    "typescript": "5.9.3",
    "wrangler": "^4.135.0"
  },
  "emdash": {
    "label": "Lumi Journal",
    "schema": ".emdash/seed.json",
    "seed": ".emdash/seed.json",
    "url": "https://runlumi.app"
  }
}
