{
  "name": "landing.runlumi.app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "node scripts/check-src.mjs",
    "test": "node --experimental-strip-types --test --import ./scripts/test-setup.mjs \"tests/**/*.test.ts\"",
    "test:files:prepare": "node scripts/prepare-crm-upload-test.mjs",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:finance": "RUNLUMI_INTEGRATION_SCOPE=finance node scripts/run-integration.mjs",
    "test:integration:hrm": "RUNLUMI_INTEGRATION_SCOPE=hrm node scripts/run-integration.mjs",
    "test:integration:hrm:p1": "RUNLUMI_INTEGRATION_SCOPE=hrm-p1 node scripts/run-integration.mjs",
    "test:integration:hrm:p3": "RUNLUMI_INTEGRATION_SCOPE=hrm-p3 node scripts/run-integration.mjs",
    "test:integration:hrm:p4": "RUNLUMI_INTEGRATION_SCOPE=hrm-p4 node scripts/run-integration.mjs",
    "test:integration:hrm:p5": "RUNLUMI_INTEGRATION_SCOPE=hrm-p5 node scripts/run-integration.mjs",
    "deploy": "node scripts/preflight.mjs && npm run build && node scripts/release.mjs",
    "release": "node scripts/release.mjs",
    "ci:verify": "npm run lint && npm test && npm run build",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lumi-jobs --local",
    "db:migrate": "wrangler d1 migrations apply lumi-jobs --remote",
    "test:integration:hrm:journey": "RUNLUMI_INTEGRATION_SCOPE=hrm-journey node scripts/run-integration.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/react": "6.0.5",
    "@emdash-cms/cloudflare": "0.38.0",
    "astro": "^7.3.3",
    "aws4fetch": "1.0.20",
    "emdash": "0.38.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@emnapi/runtime": "1.11.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "csstype": "3.2.3",
    "typescript": "5.9.3",
    "wrangler": "^4.135.0"
  },
  "emdash": {
    "label": "Lumi Journal",
    "schema": ".emdash/seed.json",
    "seed": ".emdash/seed.json",
    "url": "https://runlumi.app"
  }
}
