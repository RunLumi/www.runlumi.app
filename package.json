{
  "name": "landing.runlumi.app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "node scripts/check-src.mjs",
    "test": "node --test --import ./scripts/test-setup.mjs \"tests/**/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply lumi-jobs --local",
    "db:migrate": "wrangler d1 migrations apply lumi-jobs --remote"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.2",
    "astro": "^7.3.3",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "wrangler": "^4.135.0"
  }
}
