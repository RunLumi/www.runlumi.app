{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runlumi",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "runlumi.app/*",
      "zone_name": "runlumi.app"
    },
    {
      "pattern": "www.runlumi.app/*",
      "zone_name": "runlumi.app"
    },
    {
      "pattern": "landing.runlumi.app/*",
      "zone_name": "runlumi.app"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Lark digest at 08:37 Vietnam time Monday–Saturday, configurable HRM asset
  // reminder sweep daily at 08:40, and Lark retry safety pass every ten minutes.
  "triggers": {
    "crons": ["37 1 * * MON-SAT", "40 1 * * *", "*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumi-jobs",
      "database_id": "baffed60-2a53-4a8a-b680-684852edbb81",
      "migrations_dir": "migrations"
    },
    {
      "binding": "CONTENT_DB",
      "database_name": "lumi-content",
      "database_id": "25a3ae96-bbbd-4356-9cf7-afb39926a9ad"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "lumi-job-files"
    },
    {
      "binding": "BLOG_MEDIA",
      "bucket_name": "lumi-blog-media"
    }
  ]
}
